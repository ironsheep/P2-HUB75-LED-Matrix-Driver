CON ' ---- Timing ----

' clock is setup in top-level file

    ' Shortest CLK pulse each chip accepts, high and low alike, in ns (DOCs/ChipCharacteristicsMatrix.md,
    ' "Datasheet Clock and /OE Ratings"): 20 ns on every chip in the table
    MIN_CLK_PULSE_NS              = 20

    ' Highest clock each chip is rated for, one chip alone, in Hz (same table). The 20 ns pulses
    ' cap every chip at 25 MHz.
    RATED_CLK_HZ_FM6124           = 30_000_000
    RATED_CLK_HZ_FM6126A          = 30_000_000
    RATED_CLK_HZ_ICN2038S         = 30_000_000
    RATED_CLK_HZ_ICN2037          = 30_000_000
    RATED_CLK_HZ_MBI5124GP        = 25_000_000

    ' In a chain each chip's SDO feeds the next chip's SDI, so a clock period must also cover the
    ' slowest CLK-to-SDO delay plus the SDI setup time (each chip's switching characteristics).
    ' MBI5124 V0.01 pp.9-10, the 3.3 V row (the row its /OE minimum uses): 50 + 3 ns. Clocked
    ' faster (22.3 MHz), a chain of two MBI5124GP panels lost the bit handed into each panel on
    ' some images. ICN2037 V2.0: 35 + 5 ns; ICN2038S V1.1: 30 + 5 ns. The FM6124 and FM6126A
    ' delays have not been read (DOCs/plans/PUNCH-LIST.md), so their rating alone applies.
    ICN2037_CLK_TO_SDO_MAX_NS     = 35
    ICN2037_SDI_SETUP_NS          = 5
    ICN2038S_CLK_TO_SDO_MAX_NS    = 30
    ICN2038S_SDI_SETUP_NS         = 5
    MBI5124_CLK_TO_SDO_MAX_NS     = 50
    MBI5124_SDI_SETUP_NS          = 3

    ' Highest clock the driver uses for each chip, in Hz: its rating, or its chain limit when lower
    MAX_CLK_HZ_FM6124             = RATED_CLK_HZ_FM6124
    MAX_CLK_HZ_FM6126A            = RATED_CLK_HZ_FM6126A
    MAX_CLK_HZ_ICN2038S           = RATED_CLK_HZ_ICN2038S <# (NS_PER_SECOND / (ICN2038S_CLK_TO_SDO_MAX_NS + ICN2038S_SDI_SETUP_NS))
    MAX_CLK_HZ_ICN2037            = RATED_CLK_HZ_ICN2037 <# (NS_PER_SECOND / (ICN2037_CLK_TO_SDO_MAX_NS + ICN2037_SDI_SETUP_NS))
    MAX_CLK_HZ_MBI5124GP          = RATED_CLK_HZ_MBI5124GP <# (NS_PER_SECOND / (MBI5124_CLK_TO_SDO_MAX_NS + MBI5124_SDI_SETUP_NS))
    MAX_CLK_HZ_UNRATED            = 20_000_000

    ' The column loop (shiftColumns), 7 instructions of 2 clocks each with both WAITX at D = 0.
    ' CLK is high from DRVH to the next DRVL: DRVH, WAITX, SETBYTE = 6 clocks. It is low from
    ' DRVL to DRVH: DRVL, ALTGB, GETBYTE, WAITX = 8 clocks. A WAITX of D extends its half by D.
    LOOP_HIGH_FIXED_CLOCKS        = 6
    LOOP_LOW_FIXED_CLOCKS         = 8
    BASE_LOOP_CYCLES              = LOOP_HIGH_FIXED_CLOCKS + LOOP_LOW_FIXED_CLOCKS

CON ' ---- OE-weighted bit planes: the /OE smart pin, brightness and the refresh model ----

    ' /OE is a P_PULSE smart pin owned by the refresh cog (p2kbArchSmartPin00100PulseCycleOutput).
    ' A pulse starts at the next base period after Y is written, and the base period counter runs
    ' free, so the base period X[15:0] is one clock: a pulse starts within a clock of its WYPIN,
    ' whatever the counter's phase. X[31:16] = 0, so the output is high for all Y base periods,
    ' that is for Y clocks; inverted, so the pin idles HIGH (blank) and goes LOW (lit) for the
    ' pulse. P_OE lets the smart pin drive the pin. Y carries the plane's lit time in clocks.
    OE_PIN_MODE                   = P_PULSE | P_OE | P_INVERT_OUTPUT
    OE_BASE_PERIOD_CLOCKS         = 1           ' X: base period 1 clock, compare field 0

    ' T is one 16-bit operand of the cog's brightness multiply (p2kbPasm2Mul)
    MAX_OE_UNIT_CLOCKS            = $FFFF

    ' Brightness b scales the lit time inside a slot that does not change: plane k's slot is
    ' 2^k x T clocks, and it is lit for 2^k x L of them, L = T x b / FULL_BRIGHTNESS (never below
    ' the chip's minimum /OE). 256 is no reduction, 0 is off. Row timing, and so the refresh
    ' rate, is the same at every b.
    FULL_BRIGHTNESS               = 256
    BRIGHTNESS_SHIFT              = 8           ' divide by FULL_BRIGHTNESS

    ' Shortest /OE pulse each chip accepts, in ns (DOCs/ChipCharacteristicsMatrix.md, "Datasheet
    ' Clock and /OE Ratings"). ICN2037: its datasheets disagree (V1.1 60 ns, V2.0 40 ns), and 60
    ' holds for both. MBI5124GP: the 3.3 V row. A chip with no rating in the table uses
    ' MIN_OE_NS_UNRATED, and start() says so.
    MIN_OE_NS_FM6124              = 30
    MIN_OE_NS_FM6126A             = 40
    MIN_OE_NS_ICN2038S            = 40
    MIN_OE_NS_ICN2037             = 60
    MIN_OE_NS_MBI5124GP           = 50
    MIN_OE_NS_UNRATED             = 50

    ' Refresh model overheads (estimates, in clocks, as in test_hub75_oe_bcm.spin2): the fixed cost
    ' of a SETQ+RDLONG row load on top of one clock per long, and the clocks from the end of a
    ' shift to the WYPIN that lights the plane (end of clock, IN poll, address, LATCH pulse)
    ROW_LOAD_SETUP_CLOCKS         = 24
    LATCH_SEQUENCE_CLOCKS         = 64

    ' Fixed-point reports: x100 values print with one decimal
    NS_PER_SECOND                 = 1_000_000_000
    FIXED_POINT_SCALE             = 100
    PERCENT_X100_SCALE            = 10_000
    FRACTION_DIVISOR              = 10

#IFDEF HUB75_INSTRUMENT
CON ' ---- Instrumentation strobes (compiled only when HUB75_INSTRUMENT is defined) ----

' Special unused P2 pins used to send timing marks to a Logic Analyzer and to the monitor
' smart pins of isp_hub75_instrument.spin2. Only the refresh cog of a single adapter drives
' them, and only when the adapter does not use them itself (start() checks the base pin).
' Each mark is one pulse (two OUTNOTs):
'  P08 - posted set taken: the refresh cog took a newly posted PWM frame set, so the
'        set it shows (driverShowing) changed. A repost of the set already shown does not mark
'  P09 - frame start: the cog began showing a PWM frame set (all rows, all planes)
'  P10 - row start: the cog began the planes of one row address
'  P11 - plane latch: the cog latched one row of one bit plane
    MTX_LA_XTRA_PINS_BASE         = 8
    MTX_LA_XT_P08                 = MTX_LA_XTRA_PINS_BASE + 0
    MTX_LA_XT_P09                 = MTX_LA_XTRA_PINS_BASE + 1
    MTX_LA_XT_P10                 = MTX_LA_XTRA_PINS_BASE + 2
    MTX_LA_XT_P11                 = MTX_LA_XTRA_PINS_BASE + 3
    LA_PINS_SPAN                  = 3           ' P08..P11 -> 4 pins
#ENDIF

CON ' ---- Data ----

' bits within a swapped color byte (red and blue trade places)
    RED_BIT                       = 2
    GREEN_BIT                     = 1

' Driver command codes (caller writes one into driverCommand):
'  CMD_DONE            - no frame set posted yet: the panel stays blank
'  CMD_SHOW_PWM_BUFFER - show the PWM frame set in driverArgument (taken at the next frame start)
    #0, CMD_DONE, CMD_SHOW_PWM_BUFFER

    ' driverShowing before the driver has taken a posted PWM frame set (no hub frame set lives at 0)
    NO_FRAME_SET                  = 0

    ' The hub longs handed to the refresh cog, in ptra order (ptrCommand onward in VAR):
    '  HUB_PTR_COMMAND    - @driverCommand
    '  HUB_PTR_ARGUMENT   - @driverArgument, the posted frame set
    '  HUB_PTR_SHOWING    - @driverShowing, written by the cog at each frame start
    '  HUB_PTR_BRIGHTNESS - @brightnessScale, read by the cog at each frame start
    #0, HUB_PTR_COMMAND, HUB_PTR_ARGUMENT, HUB_PTR_SHOWING, HUB_PTR_BRIGHTNESS

CON ' ---- HUB75 pin layout offsets (relative to adapter base pin) ----

    PIN_OFST_CLK                  = 0           ' CLK   pin = basePin + 0
    PIN_OFST_OE                   = 1           ' /OE   pin = basePin + 1
    PIN_OFST_LATCH                = 2           ' LATCH pin = basePin + 2
    PIN_OFST_A                    = 3           ' addr A pin = basePin + 3
    PIN_OFST_R1                   = 8           ' color R1 pin = basePin + 8
    ' the colour pins from R1 on: R1 G1 B1 R2 G2 B2 (offsets from R1)
    COLOR_OFST_G                  = 1           ' G1 = R1 + 1
    COLOR_OFST_B                  = 2           ' B1 = R1 + 2
    COLOR_OFST_RGB2               = 3           ' R2, G2, B2 = R1, G1, B1 + 3

    ' ADDPINS spans (count - 1 of contiguous pins in each group)
    ROW_ADDR_PINS_SPAN            = 4           ' A..E -> 5 pins
    COLOR_PINS_SPAN               = 5           ' R1..B2 -> 6 pins
    CONTROL_PINS_SPAN             = 2           ' CLK,OE,LATCH -> 3 pins

CON ' ---- Scan-geometry, buffer packing and driver flags ----

    BITS_PER_BYTE                 = 8           ' bits in a byte
    HALF_DIVISOR                  = 2           ' split-in-half divisor
    LATCH_OVERLAP_COLS            = 3           ' latch overlaps last 3 columns
    HZ_PER_MHZ                    = 1_000_000   ' Hz in one MHz
    HALVE_SHIFT                   = 1           ' shift right by one: halve
    DRIVER_FLAGS_MASK             = $ff00       ' driver-flag byte within driverConfig

    ' The driver cog is held as its cog ID + COG_HANDLE_BIAS, so that COG_NOT_STARTED (0) can
    ' mean "no driver cog" (cog 0 is a valid cog ID). panel.spin2 follows the same convention.
    COG_HANDLE_BIAS               = 1
    COG_NOT_STARTED               = 0

    ' scan row counts by address-line mode (rowAddressCount)
    ROWS_ABCDE                    = 32          ' A-E address lines -> 32 rows
    ROWS_ABCD                     = 16          ' A-D address lines -> 16 rows
    ROWS_ABC                      = 8           ' A-C address lines -> 8 rows

    ' DAT-initial placeholder column count (overwritten by start())
    DFLT_COLUMN_CLOCK_COUNT       = 64                            ' default columns total

    ' driver COG internal buffer size: the line buffer, whose size is the driver limit
    ' hub75Bffrs.LINE_BUFFER_BYTES (the startup panel-limit check reads the same value)
    MAX_COG_BUFFER_SIZE_IN_LONGS  = (hub75Bffrs.LINE_BUFFER_BYTES + hub75Bffrs.BYTES_PER_LONG - 1) / hub75Bffrs.BYTES_PER_LONG

CON ' ---- Row-address bitmask + one-row step (per pin-group x per addr-mode) ----

' Pin groups by 16-bit region within the 32-bit port:
'   LO16  = pins  0-15  (also pins 32-47 of port B)
'   HI16  = pins 16-31  (also pins 48-63 of port B)

    ' --- LO16 (low 16 pins) ---
    MASK_ADDR_LO16_ABCDE          = %00000000_00000000_00000000_11111000
    MASK_ADDR_LO16_ABCD           = %00000000_00000000_00000000_01111000
    MASK_ADDR_LO16_ABC            = %00000000_00000000_00000000_00111000
    ADDR_VAL_ONE_LO16             = $0000_0008  ' 1 in upper 5 bits of byte

    ' --- HI16 (high 16 pins) ---
    MASK_ADDR_HI16_ABCDE          = %00000000_11111000_00000000_00000000
    MASK_ADDR_HI16_ABCD           = %00000000_01111000_00000000_00000000
    MASK_ADDR_HI16_ABC            = %00000000_00111000_00000000_00000000
    ADDR_VAL_ONE_HI16             = $0008_0000  ' 1 in upper 5 bits of byte

CON ' ---- COGINIT / inline-PASM timing + FM6126A register init ----

    COGINIT_FREE_COG              = 16          ' COGINIT: start in any free cog
    COL_GROUP_MASK                = $0F         ' 16-column-group index mask
    FM6126_REG11_NUM              = 11          ' FM6126A control register 11
    FM6126_REG12_NUM              = 12          ' FM6126A control register 12
    FM6126_REG12_HI_BIT           = 9           ' reg12 bit set high during load

    ' WAITX settle/timing tick counts
    WAITX_SETTLE_TICKS            = 6           ' data-settle wait
    WAITX_LATCH_SETTLE_TICKS      = 3           ' 2 + 3 x clk latch settle
    WAITX_EOBYTE_TICKS            = 2           ' end-of-byte loop wait
    FM6126_CLK_HIGH_TICKS         = 511         ' FM6126A clock-high wait
    FM6126_CLK_LOW_TICKS          = 500         ' FM6126A clock-low wait
    FM6126_REG_GAP_TICKS          = 50          ' delay between register loads

    ' MBI5124 configuration register, one value per LED colour, MSB first (MBI5124 datasheet
    ' V0.01, p.12 "Definition of Configuration Register"). Each chip takes 16 bits, one per output.
    MBI5124_CFG_RED               = $7D6B       ' red LEDs
    MBI5124_CFG_GREEN             = $F16B       ' green LEDs
    MBI5124_CFG_BLUE              = $ED6B       ' blue LEDs
    MBI5124_CHIP_STAGES           = 16          ' shift stages (outputs) in one chip
    MBI5124_CHIP_STAGE_MASK       = MBI5124_CHIP_STAGES - 1   ' a stage's place within its chip
    MBI5124_CFG_MSBIT             = MBI5124_CHIP_STAGES - 1   ' first bit shifted into each chip
    MBI5124_WRITE_CFG_EDGES       = 4           ' CLK rising edges while LE is high: write configuration (p.12)

CON ' ---- SETR self-modify encodings + pack shifts ----

    ' SETR re-targets colorOutInst's SETBYTE byte selector (%1000110 = SETBYTE op)
    SETR_SETBYTE_BYTE1            = %1000110_01 ' setbyte #1 (pins 8-15 of the port)
    SETR_SETBYTE_BYTE2            = %1000110_10 ' setbyte #2 (pins 16-23 of the port)
    SETR_SETBYTE_BYTE3            = %1000110_11 ' setbyte #3 (pins 24-31 of the port)

    OUT_RGB_BYTE_POS              = 3           ' SETBYTE pos for RGB output byte
    COLOR_NIBBLE_SHIFT            = 3           ' shift from the RGB1 bits to the RGB2 bits of a byte

    COG_RAM_FIT_LIMIT             = 496         ' last usable cog-RAM long for FIT
    COGBFFR_AUTOINC_FLAG          = $200        ' pointer auto-increment flag bit

OBJ ' ---- Objects Needed ----

    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    color       : "isp_hub75_color"
    hwEnum      : "isp_hub75_hwEnums"                               ' hub75 attachment, set up constants

DAT ' ---- Brightness (singleton: every adapter's refresh cog reads it once per frame) ----

    brightnessScale         LONG    FULL_BRIGHTNESS     ' b, 0-256: L = T x b / 256; 0 = never lit

VAR ' ---- Per-adapter instance state ----
    LONG    cog                                                     ' driver cog ID + COG_HANDLE_BIAS, or COG_NOT_STARTED
    LONG    bPinsClaimed                                            ' TRUE once start() has chosen this adapter's pins: stop() releases them
    LONG    instanceID
    LONG    chainIndex

    LONG    ptrCommand                                              ' ptra[HUB_PTR_COMMAND]
    LONG    ptrArgument                                             ' ptra[HUB_PTR_ARGUMENT]  @driverArgument
    LONG    ptrShowing                                              ' ptra[HUB_PTR_SHOWING]  @driverShowing
    LONG    ptrBrightness                                           ' ptra[HUB_PTR_BRIGHTNESS]  @brightnessScale
    ' write values here to pass to driver
    LONG    driverCommand
    LONG    driverArgument
    ' written by the driver: hub address of the PWM frame set it is showing (NO_FRAME_SET until
    ' it has taken its first posted set); the frame set it names is never written by a converter
    LONG    driverShowing

    LONG    driverConfig
    LONG    driverFlags
    LONG    eChipType
    LONG    bSwapRB
    LONG    bInitPanel
    LONG    bScan_1_4
    LONG    maxChainColumns
    LONG    maxDisplayColumns
    LONG    maxDisplayRows
    LONG    maxPanelColumns
    LONG    pwmBufferCount

    ' individual pins
    LONG    basePin
    LONG    panelPinA
    LONG    panelPinR1
    LONG    panelPinCLK
    LONG    panelPinLATCH
    LONG    panelPinOE
    ' pin groups
    LONG    panelRowAddrPins
    LONG    panelColorPins
    LONG    panelControlPins
#IFDEF HUB75_INSTRUMENT
    ' pins for Logic Analysis (LA) connector
    LONG    laPin08
    LONG    laPin09
    LONG    laPin10
    LONG    laPin11
    LONG    laPinGroup
#ENDIF

' --------------------------------------------------------------------------------------------------
PUB null()
'' Prevent this object from being used as a top-level file.
''

PUB start(nID, nChainIdx) : startedCog | columnClockHz, panelCount, colorDepthPlanes, cogBufferLongs, oeUnitNs, rawCogId, widthInPanels, heightInPanels, clocksPerColumn, ...
                                         shiftClocks, rowLoadClocks, jValue, refreshX100, dutyX100, targetHz, bTargetMet
'' Set up PASM2 driver variables and start a new cog running the matrix driver.
''
'' The refresh cog shows OE-weighted bit planes: per row address it loads, shifts and latches
'' each plane once, MSB first, and lights plane k for 2^k periods of the /OE unit T. start()
'' picks T for the display's DISPn_TARGET_REFRESH_HZ: the brightest T (the smallest j, with
'' T = S / 2^j and S the clocks to shift one row) whose predicted refresh meets the target,
'' never shorter than the panel chip's minimum /OE pulse. If no j meets the target it uses the
'' largest and prints the rate it reaches.
''
'' Aborts (and so never returns) when the /OE unit T is longer than the brightness multiply's
'' 16-bit operand, or when no cog is free to run the driver (after printing a debug message).
''
'' @param nID - instance identifier, shown in debug messages
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns startedCog - cog ID + 1 (never 0) of the driver cog; aborts when no cog is free

' Local Variables:
' @local columnClockHz - the column clock rate, Hz, for the debug output
' @local panelCount - number of panels in the chain
' @local colorDepthPlanes - the display's color depth: bit planes per frame set
' @local cogBufferLongs - size of the driver cog's line buffer, in longs
' @local oeUnitNs - the /OE unit T in nanoseconds, for the debug output
' @local rawCogId - the cog ID COGINIT returned (negative when no cog is free: the failure flag is bit 31)
' @local widthInPanels - number of panels across the display width
' @local heightInPanels - number of panels across the display height
' @local clocksPerColumn - system clocks per column clock of the shift loop
' @local shiftClocks - S: system clocks to shift one row of one plane
' @local rowLoadClocks - estimated clocks to SETQ+RDLONG one row into cog RAM
' @local jValue - the j chosen (T = S / 2^j)
' @local refreshX100 - predicted refresh rate at the chosen T, Hz x100
' @local dutyX100 - predicted lit share at the chosen T, percent x100
' @local targetHz - the display's refresh target (DISPn_TARGET_REFRESH_HZ), Hz
' @local bTargetMet - TRUE if the chosen T reaches the target

  chainIndex := nChainIdx
  instanceID := nID
  stop()
  pwmBufferCount := hub75Bffrs.colorDepth(chainIndex)

  maxDisplayRows, maxDisplayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  _, maxPanelColumns := hub75Bffrs.panelSizeInPixels(chainIndex)       ' the panel's row count is not needed here
  panelCount := hub75Bffrs.maxPanels(chainIndex)
  maxChainColumns := maxPanelColumns * panelCount       ' the chain length: panel count x panel columns
  debug("RG3: #", udec_(instanceID), " -START- ", udec(maxChainColumns))

  ' New P2 Eval Board HUB75 Adapter:
  ' the user-selected location: one of 0, 16 and 32
  basePin := hub75Bffrs.pinBase(chainIndex)
  panelPinCLK       := basePin + PIN_OFST_CLK
  panelPinOE        := basePin + PIN_OFST_OE
  panelPinLATCH     := basePin + PIN_OFST_LATCH

  panelPinA         := basePin + PIN_OFST_A
  panelPinR1        := basePin + PIN_OFST_R1

  panelRowAddrPins  := panelPinA ADDPINS ROW_ADDR_PINS_SPAN
  panelColorPins    := panelPinR1 ADDPINS COLOR_PINS_SPAN
  panelControlPins  := panelPinCLK ADDPINS CONTROL_PINS_SPAN
  bPinsClaimed := TRUE                                  ' from here stop() releases these pins

#IFDEF HUB75_INSTRUMENT
  laPin08         := MTX_LA_XT_P08
  laPin09         := MTX_LA_XT_P09
  laPin10         := MTX_LA_XT_P10
  laPin11         := MTX_LA_XT_P11
  laPinGroup      := laPin08 ADDPINS LA_PINS_SPAN

  ' tell our backend driver; the strobes run only if this adapter's own pins (base to R1..B2)
  ' stay clear of P08..P11, so an adapter at base 0 keeps its colour lines to itself
  pinGrpLAXT      := laPinGroup
  pinLAXT_08      := laPin08
  pinLAXT_09      := laPin09
  pinLAXT_10      := laPin10
  pinLAXT_11      := laPin11
  strobesEnabled  := (basePin > MTX_LA_XT_P11)
  if strobesEnabled == FALSE
    debug("RG3: instrument strobes P", udec_(MTX_LA_XT_P08), "-P", udec_(MTX_LA_XT_P11), " are this adapter's own pins (base P", udec_(basePin), "): strobes off")
#ENDIF

  pinLedOE        := panelPinOE
  pinLedCLK       := panelPinCLK
  pinLedLATCH     := panelPinLATCH
  pinGrpAddr      := panelRowAddrPins
  pinGrpColor     := panelColorPins

  colorDepthPlanes := hub75Bffrs.colorDepth(chainIndex)
  debug("RG3:  CONFIG ColorDepth = ", udec_long_(colorDepthPlanes))

  driverConfig, eChipType := hub75Bffrs.getDriverFlags(chainIndex)
  debug("RG3:  CONFIG ", ubin_word(eChipType))
  debug("RG3:  CONFIG ", ubin_word(driverConfig))
  if eChipType == hwEnum.CHIP_FM6126A
    debug("  -- FM6126A")
  elseif eChipType == hwEnum.CHIP_MBI5124GP
    debug("  -- MBI5124GP")
  elseif eChipType == hwEnum.CHIP_GS6238S
    debug("  -- GS6238S")
  elseif eChipType == hwEnum.CHIP_DP5125D
    debug("  -- DP5125D")
  elseif eChipType == hwEnum.CHIP_FM6124 or eChipType == hwEnum.CHIP_UNK_LAT_END_ENCL
    if eChipType == hwEnum.CHIP_FM6124
      debug("  -- FM6124")
  elseif eChipType == hwEnum.CHIP_ICN2037 or eChipType == hwEnum.CHIP_ICN2038S or eChipType == hwEnum.CHIP_UNK_LAT_END_ENCL_SLO_CLK
    if eChipType == hwEnum.CHIP_ICN2037
      debug("  -- ICN2037")
    elseif eChipType == hwEnum.CHIP_ICN2038S
      debug("  -- ICN2038S")
  ' the column clock: each half of the pulse at least MIN_CLK_PULSE_NS, the whole at most the chip's rating
  clocksPerColumn := columnLoopClocks(eChipType)
  columnClockHz := clkfreq / clocksPerColumn
  debug("RG3:  TIMING cycles/bit=", udec_(clocksPerColumn), " waitLo=", udec_(waitCyclesLow), " waitHi=", udec_(waitCyclesHigh), ", CLK high ", udec_(LOOP_HIGH_FIXED_CLOCKS + waitCyclesHigh), " low ", udec_(LOOP_LOW_FIXED_CLOCKS + waitCyclesLow), " clocks, ", udec_(columnClockHz / HZ_PER_MHZ), ".", udec_((columnClockHz // HZ_PER_MHZ) / (HZ_PER_MHZ / FRACTION_DIVISOR)), " MHz")
  heightInPanels, widthInPanels := hub75Bffrs.displaySizeInPanels(chainIndex)
  debug("  -- ", udec_(panelCount), " panel(s), wh=(", udec_(widthInPanels), "x", udec_(heightInPanels), "), pixels wh=(", udec_(maxDisplayColumns), "x", udec_(maxDisplayRows), ")")
  debug("  -- chain in panels (", udec_(panelCount), "), cols/pnl=(", udec_(maxPanelColumns), "), cols/chain (", udec_(maxChainColumns), ")")

  cogBufferLongs := MAX_COG_BUFFER_SIZE_IN_LONGS
  debug("RG3:  BFFR CogBuffer[", udec_(cogBufferLongs), " longs]=", uhex_long_(@cogBuffer))

  driverFlags := driverConfig & DRIVER_FLAGS_MASK
  ' if following flags are set...
  bOverlapLatch := (driverFlags & hwEnum.LAT_POSN_OVERLAP) <> 0
  bLatchEnclosed := (driverFlags & hwEnum.LAT_STYLE_OFFSET) == 0
  bInitPanel := (driverFlags & hwEnum.INIT_PANEL_REQUIRED) <> 0
  ' post value of panel needing swap so we can do correct color fixes
  bSwapRB := (driverFlags & hwEnum.RB_SWAP) <> 0
  ' post value of our need to alter our scan from 1/16, 1/32 to 1/8
  bScan_1_4 := (driverFlags & hwEnum.SCAN_4) <> 0

  debug("RG3:  CONFIG (intrp) ", ubin_word(driverConfig))
  debug("  -- ", ubin_word(driverFlags))
  debug("  -- ", ubin_byte(bOverlapLatch))
  debug("  -- ", ubin_byte(bLatchEnclosed))
  debug("  -- ", ubin_byte(bInitPanel))
  debug("  -- ", ubin_byte(bSwapRB))
  debug("  -- ", ubin_byte(bScan_1_4))

  ' when using a panel w/FM6126A chips we have to issue a reset!
  '   before attempting to use the panel
  if bInitPanel == TRUE
    setupPins()
    if eChipType == hwEnum.CHIP_MBI5124GP
      resetPanelMBI5124()
    elseif eChipType == hwEnum.CHIP_FM6126A
      resetPanelFM6126()

  ' configure our driver: which port, and which half of it, holds this adapter's pins. The values
  ' are written into the one DAT template that every adapter's COGINIT copies from, so they are
  ' valid only because start() calls run one after another (never two at once).
  case hub75Bffrs.pinBase(chainIndex)
    hwEnum.PIN_GROUP_P0_P15:
      debug("- I/O P00 - P15")
      bSetLowPins := TRUE
      bUsePortA := TRUE
    hwEnum.PIN_GROUP_P16_P31:
      debug("RG3: - I/O P16 - P31")
      bSetLowPins := FALSE
      bUsePortA := TRUE
    hwEnum.PIN_GROUP_P32_P47:
      debug("RG3: - I/O P32 - P47")
      bSetLowPins := TRUE
      bUsePortA := FALSE

  ' the row-address bits within the port, and one row address as a step
  if bSetLowPins == TRUE
    if hub75Bffrs.addressLines(chainIndex) == hwEnum.ADDR_ABCDE
      maskAddr    := MASK_ADDR_LO16_ABCDE                     ' pins at 00-15 A/B-pins
      rowAddressCount   := ROWS_ABCDE
    elseif hub75Bffrs.addressLines(chainIndex) == hwEnum.ADDR_ABCD
      maskAddr    := MASK_ADDR_LO16_ABCD                      ' pins at 00-15 A/B-pins
      rowAddressCount   := ROWS_ABCD
    else  '  == hwEnum.ADDR_ABC
      maskAddr    := MASK_ADDR_LO16_ABC                       ' pins at 00-15 A/B-pins
      rowAddressCount   := ROWS_ABC
    addrValue1  := ADDR_VAL_ONE_LO16                            ' 1 but in upper 5-bits of byte
  else
    if hub75Bffrs.addressLines(chainIndex) == hwEnum.ADDR_ABCDE
      maskAddr    := MASK_ADDR_HI16_ABCDE                     ' pins at 16-31 A/B-pins
      rowAddressCount   := ROWS_ABCDE
    elseif hub75Bffrs.addressLines(chainIndex) == hwEnum.ADDR_ABCD
      maskAddr    := MASK_ADDR_HI16_ABCD                      ' pins at 16-31 A/B-pins
      rowAddressCount   := ROWS_ABCD
    else  '  == hwEnum.ADDR_ABC
      maskAddr    := MASK_ADDR_HI16_ABC                       ' pins at 16-31 A/B-pins
      rowAddressCount   := ROWS_ABC
    addrValue1  := ADDR_VAL_ONE_HI16                          ' 1 but in upper 5-bits of byte
  debug("RG3:  --    ", ubin_long(maskAddr))
  debug("RG3:  -- ", sdec_long(bSetLowPins, bUsePortA))

  ' one row is what one row address shifts: the entire chain, not the display width
  columnClockCount := maxChainColumns
  if bScan_1_4 == TRUE
    columnClockCount := maxChainColumns * hub75Bffrs.SCAN_4_COLUMN_FACTOR    ' a SCAN_4 panel shifts twice its width per row address
  ' frame-set layout: plane-major (plane 0 = MSB), each plane rowAddressCount rows of rowSizeBytes
  rowSizeBytes := columnClockCount * hub75Bffrs.BYTES_PER_COLUMN_CLOCK
  rowLongsLessOne := ((rowSizeBytes + hub75Bffrs.BYTES_PER_LONG - 1) / hub75Bffrs.BYTES_PER_LONG) - 1
  planeSizeBytes := hub75Bffrs.pwmFrameSizeInBytes(chainIndex)
  planeCount := pwmBufferCount
  firstPulseWeight := 1 << (pwmBufferCount - 1)
  debug("RG3:  ", udec(rowAddressCount, columnClockCount, rowSizeBytes, planeSizeBytes, planeCount))

  ' the /OE unit T for the display's refresh target
  shiftClocks := columnClockCount * clocksPerColumn
  rowLoadClocks := rowLongsLessOne + 1 + ROW_LOAD_SETUP_CLOCKS
  minOeClocks := oeMinimumClocks(eChipType)
  targetHz := hub75Bffrs.targetRefreshHz(chainIndex)
  oeUnitClocks, jValue, refreshX100, bTargetMet := chooseOeUnit(shiftClocks, rowLoadClocks, targetHz)
  if oeUnitClocks > MAX_OE_UNIT_CLOCKS
    debug("HUB75: DISP", udec_(chainIndex), ": the /OE unit T = ", udec_(oeUnitClocks), " clocks is longer than the brightness multiply's 16-bit operand (", udec_(MAX_OE_UNIT_CLOCKS), " clocks); startup stopped")
    abort
  ' plane k's slot is 2^k x T at every brightness: the cog halves the MSB's slot for each plane
  firstSlotClocks := firstPulseWeight * oeUnitClocks
  if bTargetMet == FALSE
    debug("HUB75: DISP", udec_(chainIndex), ": DISP", udec_(chainIndex), "_TARGET_REFRESH_HZ = ", udec_(targetHz), " Hz is out of reach for this display; running at ", udec_(refreshX100 / FIXED_POINT_SCALE), ".", udec_((refreshX100 // FIXED_POINT_SCALE) / FRACTION_DIVISOR), " Hz, its fastest (j = ", udec_(jValue), ")")
  dutyX100 := dutyX100For(oeUnitClocks, modelRowClocks(oeUnitClocks, shiftClocks, rowLoadClocks))
  oeUnitNs := muldiv64(oeUnitClocks, NS_PER_SECOND, clkfreq)
  debug("RG3:  REFRESH S = ", udec_(shiftClocks), " clocks, T = ", udec_(oeUnitClocks), " clocks (", udec_(oeUnitNs), " ns), j = ", udec_(jValue), ", min /OE ", udec_(minOeClocks), " clocks, target ", udec_(targetHz), " Hz")
  debug("RG3:  MODEL refresh ", udec_(refreshX100 / FIXED_POINT_SCALE), ".", udec_((refreshX100 // FIXED_POINT_SCALE) / FRACTION_DIVISOR), " Hz, lit ", udec_(dutyX100 / FIXED_POINT_SCALE), ".", udec_((dutyX100 // FIXED_POINT_SCALE) / FRACTION_DIVISOR), "% at brightness ", udec_(FULL_BRIGHTNESS))
  ' the overlapped latch rises before the last LATCH_OVERLAP_COLS columns (a row is always wider)
  columnsBeforeLatch := columnClockCount - LATCH_OVERLAP_COLS
  if bOverlapLatch == TRUE
    debug("RG3:  LATCH overlapped: high over the last ", udec_(LATCH_OVERLAP_COLS), " columns")
  elseif bLatchEnclosed == TRUE
    debug("RG3:  LATCH at end, enclosed")
  else
    debug("RG3:  LATCH at end, offset")

  ' cog 0 lets go of every adapter pin BEFORE the refresh cog starts: each cog's DIR and OUT
  ' are OR'd at the pin, and a pinclear after COGINIT could undo the cog's WRPIN of /OE
  pinclear(panelRowAddrPins)
  pinclear(panelColorPins)
  pinclear(panelControlPins)

  ' pass values to our driver
  ptrCommand := @driverCommand
  ptrArgument := @driverArgument
  ptrShowing := @driverShowing
  ptrBrightness := @brightnessScale
  driverShowing := NO_FRAME_SET                                                    ' nothing taken yet
  driverCommand := CMD_DONE                                                        ' nothing posted yet

  ' when no cog is free COGINIT's result is negative: the failure flag lands in bit 31 (measured
  ' $8000_000F on the P2, not -1), so test the sign; the stored value is cog ID + 1 so that 0
  ' means "not started"
  rawCogId := COGINIT(COGINIT_FREE_COG, @drive_matrix, @ptrCommand)
  if rawCogId < 0
    debug("- Matrix: pasm cog start failed!")
    abort
  cog := rawCogId + COG_HANDLE_BIAS
  startedCog := cog

PUB stop()
'' Stop the driver cog and release all HUB75 pins, including the /OE smart pin (pinclear
'' resets its mode). The pins are released only once start() has chosen them: before that
'' there are no pins of ours to release.
''

  if cog <> COG_NOT_STARTED
    COGSTOP(cog - COG_HANDLE_BIAS)
    cog := COG_NOT_STARTED

  if bPinsClaimed == TRUE
    pinclear(panelRowAddrPins)
    pinclear(panelColorPins)
    pinclear(panelControlPins)

' --------------------------------------------------------------------------------------------------
PUB fillByteForColor(color3bit) : fillByte | swappedColor, redBit, greenBit, blueBit
'' Return the frame-set byte that shows a 3-bit color on both halves of the panel (RGB1 and
'' RGB2), with this panel's red/blue swap applied. A frame set whose every byte is this value
'' shows the color at full level.
''
'' @param color3bit - 3-bit RGB color value (color.BASE_RED, BASE_GREEN, BASE_BLUE, or a mix)
'' @returns fillByte - the byte for every column clock of every row of every plane

' Local Variables:
' @local swappedColor - clamped, swap-corrected 3-bit color value
' @local redBit - extracted red channel bit
' @local greenBit - extracted green channel bit
' @local blueBit - extracted blue channel bit

  swappedColor := 0 #> color3bit <# color.BASE_WHITE
  if bSwapRB == TRUE
    ' if our driver says Red and Blue are swapped let's do so!
    redBit := (swappedColor & color.BASE_RED) > 0 ? 1 : 0
    greenBit := (swappedColor & color.BASE_GREEN) > 0 ? 1 : 0
    blueBit := (swappedColor & color.BASE_BLUE) > 0 ? 1 : 0
    swappedColor := (redBit << RED_BIT) | (greenBit << GREEN_BIT) | blueBit
  fillByte := (swappedColor << COLOR_NIBBLE_SHIFT) | swappedColor

PUB cmdWritePwmBuffer(pBuffer)
'' Request that the driver display the given PWM frame set (returns immediately).
''
'' @param pBuffer - hub address of the PWM frame set to display

  driverArgument := pBuffer
  driverCommand := CMD_SHOW_PWM_BUFFER
  ' the driver keeps showing this set until another is posted; it takes the set at its next
  ' frame start and then names it in driverShowing (see showingFrameSet())

PUB showingFrameSet() : pFrameSet
'' Return the hub address of the PWM frame set the driver is showing: the set it took at its
'' latest frame start, or NO_FRAME_SET before it has taken one. A posted set is taken when
'' this equals the posted address.
''
'' @returns pFrameSet - hub address of the PWM frame set on display (NO_FRAME_SET before the first)

  pFrameSet := driverShowing

PUB setBrightness(newBrightness)
'' Set the brightness scale b that every refresh cog reads once per frame. b scales how long
'' each bit plane is lit inside its slot, not the colour values: plane k is lit for 2^k x L
'' clocks of its 2^k x T slot, L = T x b / 256, so the light is in proportion to b and the row
'' timing and refresh rate do not change. 256 is no reduction; 0 is off (/OE never pulses). L is
'' never shorter than the panel chip's minimum /OE pulse, so below that point every b but 0
'' gives the same floor brightness (on a display whose T is already at the minimum, that is
'' every b but 0). Values outside 0-256 are clamped.
''
'' @param newBrightness - the desired brightness value [0-256]

  brightnessScale := 0 #> newBrightness <# FULL_BRIGHTNESS

PUB getBrightness() : nBrightness
'' Return the brightness scale b the refresh cogs use.
''
'' @returns nBrightness - the brightness value [0-256]

  nBrightness := brightnessScale

PRI setupPins()
' Configure all HUB75 panel pins as outputs with default states.
'

  debug("* Driver Set up Pins")
  ' Enable all comm & address pins as outputs, set default states:
  PINLOW(panelPinCLK)
  PINLOW(panelPinLATCH)
  PINHIGH(panelPinOE)                                  ' high! (/OE)
  PINLOW(panelRowAddrPins)
  PINLOW(panelColorPins)

PRI resetPanelMBI5124() | stageCount, stageIdx, bitIdx, redPinWord, greenPinWord, bluePinWord, pinBits
' Write the configuration register of every MBI5124 in the chain (MBI5124 datasheet V0.01,
' p.12): shift each colour's register value into every chip on that colour's data lines, all
' three colours at once, then raise LE for four CLK rising edges (the "write configuration"
' command). Every chip in a chain must hold the value for its LED colour; one chip is 16 shift
' stages, and a chain is a whole number of chips, so repeating the 16-bit value MSB first leaves
' each chip with its own copy. Runs before the refresh cog owns the pins.

' Local Variables:
' @local stageCount - shift stages on one data line of the chain (2x the columns for SCAN_4)
' @local stageIdx - shift stage being clocked
' @local bitIdx - register bit being shifted (MSB first within each chip)
' @local redPinWord - register value for the chips on the R data lines (blue's when R/B are swapped)
' @local greenPinWord - register value for the chips on the G data lines
' @local bluePinWord - register value for the chips on the B data lines (red's when R/B are swapped)
' @local pinBits - the six data-pin levels for this stage: R1 G1 B1 R2 G2 B2

  debug("* Driver MBI5124 Init")

  stageCount := maxChainColumns
  if bScan_1_4 == TRUE
    stageCount *= hub75Bffrs.SCAN_4_COLUMN_FACTOR
  redPinWord := MBI5124_CFG_RED
  greenPinWord := MBI5124_CFG_GREEN
  bluePinWord := MBI5124_CFG_BLUE
  if bSwapRB == TRUE
    redPinWord := MBI5124_CFG_BLUE
    bluePinWord := MBI5124_CFG_RED

  PINHIGH(panelPinOE)                                  ' outputs off throughout
  PINLOW(panelPinLATCH)
  PINLOW(panelPinCLK)
  repeat stageIdx from 0 to stageCount - 1
    bitIdx := MBI5124_CFG_MSBIT - (stageIdx & MBI5124_CHIP_STAGE_MASK)
    pinBits := redPinWord.[bitIdx] | (greenPinWord.[bitIdx] << COLOR_OFST_G) | (bluePinWord.[bitIdx] << COLOR_OFST_B)
    PINWRITE(panelColorPins, pinBits | (pinBits << COLOR_OFST_RGB2))
    PINHIGH(panelPinCLK)                               ' rising edge shifts the bit in
    PINLOW(panelPinCLK)

  ' the write-configuration command: LE high across four CLK rising edges, stored when LE falls
  PINHIGH(panelPinLATCH)
  repeat MBI5124_WRITE_CFG_EDGES
    PINHIGH(panelPinCLK)
    PINLOW(panelPinCLK)
  PINLOW(panelPinLATCH)
  PINLOW(panelColorPins)

PRI resetPanelFM6126() | maxPhysicalCols, last11Cols, last12Cols, lPinOE, lPinLATCH, lPinCLK, lPinA, lPanelRowAddrPins, lPanelColorPins
' Reset FM6126A panel driver chips by writing control registers 11 and 12 via inline PASM2.
'

' Local Variables:
' @local maxPhysicalCols - total number of physical display columns
' @local last11Cols - column index where register 11 latching begins
' @local last12Cols - column index where register 12 latching begins
' @local lPinOE - local copy of output enable pin number
' @local lPinLATCH - local copy of latch pin number
' @local lPinCLK - local copy of clock pin number
' @local lPinA - local copy of address line A pin number
' @local lPanelRowAddrPins - local copy of row address pin group
' @local lPanelColorPins - local copy of color data pin group

' NOTE: 16 longs total avail to inline pasm: params + return + local
'  --> 9/16 used
  debug("* Driver FM6126A Init")

  maxPhysicalCols := maxChainColumns
  last11Cols      := maxPhysicalCols - (FM6126_REG11_NUM+1)
  last12Cols      := maxPhysicalCols - (FM6126_REG12_NUM+1)
  lPinOE          := panelPinOE
  lPinLATCH       := panelPinLATCH
  lPinCLK         := panelPinCLK
  lPinA           := panelPinA
  lPanelRowAddrPins := panelRowAddrPins
  lPanelColorPins   := panelColorPins

  ORG
                    ' init control pins
                    DRVL    lPanelRowAddrPins
                    DRVL    lPinA
                    DRVL    lPanelColorPins
                    DRVH    lPinOE
                    DRVL    lPinOE
                    DRVH    lPinOE
                    DRVL    lPinLATCH
                    DRVL    lPinCLK
                    ' execute init sequence - write reg #11
                    XOR     columnIdx, columnIdx
                    REP     @.end11, maxPhysicalCols
                     MOV    bitIdx, columnIdx
                     AND    bitIdx, #COL_GROUP_MASK wz
                     WAITX  #WAITX_SETTLE_TICKS                     ' let data settle
    if_z             DRVL   lPanelColorPins
    if_nz            DRVH   lPanelColorPins
                     WAITX  #WAITX_SETTLE_TICKS                     ' let data settle
                     ' mark the data: drive latch during last 11 columns
                     CMP    columnIdx, last11Cols   wcz
    if_c_or_z        DRVL   lPinLATCH
    if_nc_and_nz     DRVH   lPinLATCH
                     WAITX  #WAITX_SETTLE_TICKS
                     ADD    columnIdx, #1
                     ' clock the data
                     DRVH   lPinCLK
                     WAITX  #FM6126_CLK_HIGH_TICKS                  ' clock-high wait
                     DRVL   lPinCLK
                     WAITX  #FM6126_CLK_LOW_TICKS
.end11
                    ' end reg 11 setup
                    WAITX   #WAITX_SETTLE_TICKS
                    DRVL    lPinLATCH

                    WAITX   #FM6126_REG_GAP_TICKS                   ' delay between register loads

                    ' execute init sequence - write reg #12
                    XOR     columnIdx, columnIdx
                    REP     @.end12, maxPhysicalCols
                     MOV    bitIdx, columnIdx
                     AND    bitIdx, #COL_GROUP_MASK
                     CMP    bitIdx, #FM6126_REG12_HI_BIT wz
                     WAITX  #WAITX_SETTLE_TICKS                     ' let data settle
    if_z             DRVH   lPanelColorPins
    if_nz            DRVL   lPanelColorPins
                     WAITX  #WAITX_SETTLE_TICKS                     ' let data settle
                     ' mark the data: drive latch during last 12 columns
                     CMP    columnIdx, last12Cols   wcz
    if_c_or_z        DRVL   lPinLATCH
    if_nc_and_nz     DRVH   lPinLATCH
                     WAITX  #WAITX_SETTLE_TICKS
                     ADD    columnIdx, #1
                     ' clock the data
                     DRVH   lPinCLK
                     WAITX  #FM6126_CLK_HIGH_TICKS
                     DRVL   lPinCLK
                     WAITX  #FM6126_CLK_LOW_TICKS
.end12
                    ' end reg 12 setup
                    WAITX   #WAITX_SETTLE_TICKS
                    DRVL    lPinLATCH

                    ' end the setup effort
                    DRVL    lPinOE
                    RET

columnIdx       LONG    0
bitIdx          LONG    0

  END

PRI nsToClocks(durationNs) : durationClocks
' Return a duration in system clocks at clkfreq, rounded up: durationClocks clocks last at
' least durationNs.
'
' @param durationNs - the duration, in nanoseconds
' @returns durationClocks - the duration, in clocks

  durationClocks := muldiv64(clkfreq, durationNs, NS_PER_SECOND)
  if muldiv64(durationClocks, NS_PER_SECOND, durationNs) < clkfreq
    durationClocks++

PRI columnLoopClocks(eChip) : loopClocks | maxHz, minPulseClocks, minPeriodClocks, extraClocks
' Set the column loop's two WAITX extensions (waitCyclesLow, waitCyclesHigh) and return the loop's
' clocks per column. Each half of the CLK pulse is at least MIN_CLK_PULSE_NS (rounded up in
' clocks) and the whole period is at least one clock period of the chip's highest clock the
' driver uses (MAX_CLK_HZ_*: its rating, or its chain limit when lower; rounded up); any extra
' clocks that maximum needs are shared between the halves. A chip with no rating in the table
' uses MAX_CLK_HZ_UNRATED and says so.
'
' @param eChip - hwEnum.CHIP_* of the panels
' @returns loopClocks - system clocks per column clock

' Local Variables:
' @local maxHz - the highest clock the driver uses for the chip (its rating or chain limit), Hz
' @local minPulseClocks - MIN_CLK_PULSE_NS in clocks
' @local minPeriodClocks - the shortest period maxHz allows, in clocks
' @local extraClocks - clocks maxHz needs beyond the two minimum pulses

  case eChip
    hwEnum.CHIP_FM6124:
      maxHz := MAX_CLK_HZ_FM6124
    hwEnum.CHIP_FM6126A:
      maxHz := MAX_CLK_HZ_FM6126A
    hwEnum.CHIP_ICN2038S:
      maxHz := MAX_CLK_HZ_ICN2038S
    hwEnum.CHIP_ICN2037:
      maxHz := MAX_CLK_HZ_ICN2037
    hwEnum.CHIP_MBI5124GP:
      maxHz := MAX_CLK_HZ_MBI5124GP
    other:
      maxHz := MAX_CLK_HZ_UNRATED
      debug("HUB75: DISP", udec_(chainIndex), ": this panel chip has no clock rating in the driver's table; the clock is held to ", udec_(MAX_CLK_HZ_UNRATED / HZ_PER_MHZ), " MHz")
  minPulseClocks := nsToClocks(MIN_CLK_PULSE_NS)
  waitCyclesHigh := 0 #> (minPulseClocks - LOOP_HIGH_FIXED_CLOCKS)
  waitCyclesLow := 0 #> (minPulseClocks - LOOP_LOW_FIXED_CLOCKS)
  minPeriodClocks := (clkfreq + maxHz - 1) / maxHz
  extraClocks := minPeriodClocks - (BASE_LOOP_CYCLES + waitCyclesHigh + waitCyclesLow)
  if extraClocks > 0
    waitCyclesLow += extraClocks / HALF_DIVISOR
    waitCyclesHigh += extraClocks - (extraClocks / HALF_DIVISOR)
  loopClocks := BASE_LOOP_CYCLES + waitCyclesHigh + waitCyclesLow

PRI oeMinimumClocks(eChip) : minClocks | minNs
' Return the chip's shortest /OE pulse in system clocks, rounded up at clkfreq. A chip with no
' rating in the table uses MIN_OE_NS_UNRATED and says so.
'
' @param eChip - hwEnum.CHIP_* of the panels
' @returns minClocks - shortest legal /OE pulse, in clocks

' Local Variables:
' @local minNs - the chip's shortest /OE pulse, in nanoseconds

  case eChip
    hwEnum.CHIP_FM6124:
      minNs := MIN_OE_NS_FM6124
    hwEnum.CHIP_FM6126A:
      minNs := MIN_OE_NS_FM6126A
    hwEnum.CHIP_ICN2038S:
      minNs := MIN_OE_NS_ICN2038S
    hwEnum.CHIP_ICN2037:
      minNs := MIN_OE_NS_ICN2037
    hwEnum.CHIP_MBI5124GP:
      minNs := MIN_OE_NS_MBI5124GP
    other:
      minNs := MIN_OE_NS_UNRATED
      debug("HUB75: DISP", udec_(chainIndex), ": this panel chip has no /OE rating in the driver's table; the shortest /OE pulse is set to ", udec_(MIN_OE_NS_UNRATED), " ns")
  minClocks := muldiv64(clkfreq, minNs, NS_PER_SECOND)
  ' round up: minClocks clocks must last at least minNs
  if muldiv64(minClocks, NS_PER_SECOND, minNs) < clkfreq
    minClocks++

PRI chooseOeUnit(shiftClocks, loadClocks, targetHz) : oeUnit, jValue, refreshX100, bTargetMet | jIdx, candidateUnit, candidateRefresh
' Choose the /OE unit T: the smallest j (the brightest) whose predicted refresh meets the
' target, with T = S / 2^j clamped up to the chip's minimum. If none does, the largest j (the
' colour depth: no plane is lit longer than one shift) and its refresh.
'
' @param shiftClocks - S: clocks to shift one row of one plane
' @param loadClocks - estimated clocks to load one row
' @param targetHz - the display's refresh target (DISPn_TARGET_REFRESH_HZ), Hz
' @returns oeUnit - T, in clocks
' @returns jValue - the j chosen
' @returns refreshX100 - predicted refresh rate at T, Hz x100
' @returns bTargetMet - TRUE if the target is met

' Local Variables:
' @local jIdx - the j being tried
' @local candidateUnit - T for jIdx
' @local candidateRefresh - predicted refresh rate for candidateUnit, Hz x100

  bTargetMet := FALSE
  jValue := planeCount
  oeUnit := minOeClocks #> (shiftClocks >> planeCount)
  refreshX100 := refreshX100For(modelRowClocks(oeUnit, shiftClocks, loadClocks))
  repeat jIdx from 0 to planeCount
    candidateUnit := minOeClocks #> (shiftClocks >> jIdx)
    candidateRefresh := refreshX100For(modelRowClocks(candidateUnit, shiftClocks, loadClocks))
    if candidateRefresh >= targetHz * FIXED_POINT_SCALE
      oeUnit := candidateUnit
      jValue := jIdx
      refreshX100 := candidateRefresh
      bTargetMet := TRUE
      quit

PRI modelRowClocks(oeUnit, shiftClocks, loadClocks) : rowClocks | pulseWeightNow
' Return the model's clocks for one row address: every plane is loaded, shifted and latched
' once and given a light slot of 2^k x T (lit for all of it at brightness 256, for b/256 of it
' at b), and the next plane loads and shifts during the slot, so each plane costs the longer of
' its slot and the next load + shift, plus the latch sequence. The pulse starts within a clock
' of its WYPIN, so the model has no start latency term; the row cost is the same at every b.
'
' @param oeUnit - T in clocks
' @param shiftClocks - S: clocks to shift one row of one plane
' @param loadClocks - estimated clocks to load one row
' @returns rowClocks - clocks per row address

' Local Variables:
' @local pulseWeightNow - 2^k for the plane being added

  rowClocks := 0
  pulseWeightNow := firstPulseWeight
  repeat planeCount
    rowClocks += ((pulseWeightNow * oeUnit) #> (loadClocks + shiftClocks)) + LATCH_SEQUENCE_CLOCKS
    pulseWeightNow >>= 1

PRI refreshX100For(rowClocks) : refreshX100
' Return the frame rate for a given row cost.
'
' @param rowClocks - clocks per row address
' @returns refreshX100 - predicted refresh rate for that row cost, Hz x100

  refreshX100 := muldiv64(clkfreq, FIXED_POINT_SCALE, rowClocks * rowAddressCount)

PRI dutyX100For(oeUnit, rowClocks) : dutyX100
' Return the share of time the panel is lit at full brightness: (2^N - 1) x T per row over
' the row cost.
'
' @param oeUnit - T in clocks
' @param rowClocks - clocks per row address
' @returns dutyX100 - lit share, percent x100

  dutyX100 := muldiv64(((firstPulseWeight << 1) - 1) * oeUnit, PERCENT_X100_SCALE, rowClocks)

' --------------------------------------------------------------------------------------------------
'
DAT ' ---- Driver assembly code ----
'-------+-----+---------+-------+---------------+-------+-----------------------+
                    ORG     0       ' COG code

{ OE-weighted bit planes. One cog owns every adapter pin; /OE is its P_PULSE smart pin.

    frame:  take the posted frame set, name it in driverShowing, read brightness b
    row:      for each row address r (0 .. rows-1)
    plane:      for each plane k, MSB first (pulse weight 2^(N-1) .. 1)
                  load plane k's row r into cogBuffer      (the previous plane may still be lit)
                  then, in the chip's latch style (test_hub75_oe_bcm.spin2 refreshCog):
                    at end:     shift every column; wait dark; row address; LATCH pulse;
                                a settle gap when enclosed, none when offset
                    overlapped: shift all but the last LATCH_OVERLAP_COLS; wait dark; LATCH high;
                                shift the rest; LATCH low; row address
                  WYPIN 2^k x L on /OE: lit for 2^k x L clocks, L = T x b / 256, and the
                  plane's slot of 2^k x T clocks starts (the CT1 event target)
  "Wait dark" waits until the previous plane's slot is over (CT1 event) and then its pulse
  (IN high). The row address changes only while /OE is off, and a latch never happens while
  it is on. The slot does not depend on b, so neither does the row timing.
}
drive_matrix
                    debug("MTX: --Start--")
                    rdlong  pCommand, ptra[HUB_PTR_COMMAND]
                    rdlong  pArgument, ptra[HUB_PTR_ARGUMENT]
                    rdlong  pShowing, ptra[HUB_PTR_SHOWING]
                    rdlong  pBrightness, ptra[HUB_PTR_BRIGHTNESS]

#IFDEF HUB75_INSTRUMENT
                    ' LA INSTRUMENTATION
                    or      strobesEnabled, strobesEnabled  wz  ' Q: may this cog drive P08..P11?
    if_nz           wrpin   ##P_LOW_1MA, pinGrpLAXT ' set these to P_LOW_1MA for best Analyzer capture no noise at 1.7v threshold
    if_nz           drvl    pinGrpLAXT
                    ' no: the adapter owns these pins, so each strobe instruction becomes a NOP
    if_z            mov     strobeTakenA, #0
    if_z            mov     strobeTakenB, #0
    if_z            mov     strobeFrameA, #0
    if_z            mov     strobeFrameB, #0
    if_z            mov     strobeRowA, #0
    if_z            mov     strobeRowB, #0
    if_z            mov     strobeLatchA, #0
    if_z            mov     strobeLatchB, #0
    if_z            mov     strobeOvlpLatchA, #0
    if_z            mov     strobeOvlpLatchB, #0
#ENDIF

                    ' latch at end, offset: no settle gap between LATCH falling and /OE going low,
                    ' so the gap instruction becomes a NOP (all-zero encoding, p2kbPasm2Nop)
                    or      bLatchEnclosed, bLatchEnclosed  wz
    if_z            mov     enclosedSettleInst, #0

                    ' point the colour and address writes at the adapter's port, and the colour
                    ' write at the byte of the port that holds R1..B2
                    or      bUsePortA, bUsePortA  wz
    if_nz           setd    colorOutInst, #OUTA
    if_nz           setd    addrOutInst, #OUTA
    if_z            setd    colorOutInst, #OUTB
    if_z            setd    addrOutInst, #OUTB
                    or      bSetLowPins, bSetLowPins  wz    ' Q: using low 16 bits?
    if_nz           setr    colorOutInst, #SETR_SETBYTE_BYTE1 ' yes: R1..B2 are pins 8-13 of the port
    if_z            setr    colorOutInst, #SETR_SETBYTE_BYTE3 ' no: R1..B2 are pins 24-29 of the port

                    ' address, colour, CLK and LATCH: plain outputs of this cog, all low
                    drvl    pinGrpAddr
                    drvl    pinGrpColor
                    drvl    pinLedCLK
                    drvl    pinLedLATCH

                    ' /OE: configure the P_PULSE smart pin DIRL -> WRPIN -> WXPIN -> DIRH
                    ' (p2kbArchSmartPins); each WYPIN later starts one pulse. It idles blank.
                    dirl    pinLedOE
                    wrpin   ##OE_PIN_MODE, pinLedOE
                    wxpin   #OE_BASE_PERIOD_CLOCKS, pinLedOE ' X[15:0] = 1 clock, X[31:16] = 0: lit for Y clocks
                    dirh    pinLedOE
                    mov     pulseStarted, #0                ' no pulse yet: nothing to wait for
                    ' no slot yet either: a CT1 target already passed fires at once (p2kbPasm2Addct1),
                    ' so the first plane's wait returns at once
                    getct   slotEnd                         ' (p2kbPasm2Getct)
                    addct1  slotEnd, #0

frameStart
                    ' a frame set is taken only here, at the start of a whole frame
                    rdlong  nextCommand, pCommand
                    cmp     nextCommand, #CMD_SHOW_PWM_BUFFER  wz
    if_nz           jmp     #frameStart                     ' nothing posted yet: the panel stays blank
                    rdlong  frameSetAddr, pArgument
#IFDEF HUB75_INSTRUMENT
                    cmp     frameSetAddr, showingPrior  wz  ' Q: a newly posted set?
strobeTakenA if_nz  outnot  pinLAXT_08                      ' P08: posted set taken (driverShowing changes)
strobeTakenB if_nz  outnot  pinLAXT_08
                    mov     showingPrior, frameSetAddr
#ENDIF
                    ' this frame set is the one on display from here: name it for the converters,
                    ' which write only the set that is not named here
                    wrlong  frameSetAddr, pShowing
#IFDEF HUB75_INSTRUMENT
strobeFrameA        outnot  pinLAXT_09                      ' P09: frame start
strobeFrameB        outnot  pinLAXT_09
#ENDIF
                    ' brightness, once per frame: L = T x b / 256, never below the chip's minimum.
                    ' It sets only Y, the lit clocks of each pulse, so a pulse still lit from the
                    ' previous frame keeps its own length.
                    rdlong  brightnessNow, pBrightness
                    mov     litUnitClocks, oeUnitClocks
                    mul     litUnitClocks, brightnessNow    ' 16 x 16 bits: T <= $FFFF, b <= 256 (p2kbPasm2Mul)
                    shr     litUnitClocks, #BRIGHTNESS_SHIFT
                    fge     litUnitClocks, minOeClocks      ' (p2kbPasm2Fge)
                    mov     firstLitClocks, litUnitClocks
                    mul     firstLitClocks, firstPulseWeight ' the MSB's lit clocks: 2^(N-1) x L, both <= $FFFF

                    mov     rowHubAddr, frameSetAddr
                    mov     rowAddr, #0
                    mov     rowsLeft, rowAddressCount
rowLoop
#IFDEF HUB75_INSTRUMENT
strobeRowA          outnot  pinLAXT_10                      ' P10: row start
strobeRowB          outnot  pinLAXT_10
#ENDIF
                    mov     planeHubAddr, rowHubAddr
                    mov     litClocks, firstLitClocks
                    mov     slotClocks, firstSlotClocks
                    mov     planesLeft, planeCount
planeLoop
                    ' load this plane's row into cog RAM (p2kbPasm2SetqBlockOps: one long per
                    ' clock). It touches no pin, so it runs while the previous plane is lit.
                    setq    rowLongsLessOne
                    rdlong  cogBuffer, planeHubAddr
                    mov     byteOffset, #0
                    tjnz    bOverlapLatch, #overlapPlane   ' the chip's latch style (p2kbPasm2Tjnz)

                    ' latch at end (ICN2037, ICN2038S, FM6124, MBI5124GP ...), prototype
                    ' refreshCog "Latch at end": shift every column; once the previous plane is
                    ' dark set the row address and pulse LATCH; enclosed leaves a settle gap
                    ' before /OE goes low, offset lights at once
                    mov     columnsToShift, columnClockCount       ' one row address: the whole chain (2x for SCAN_4)
                    call    #shiftColumns
                    waitx   #WAITX_EOBYTE_TICKS
                    drvl    pinLedCLK                       ' end the last column's clock pulse
                    call    #waitPanelDark
                    call    #emitAddress
#IFDEF HUB75_INSTRUMENT
strobeLatchA        outnot  pinLAXT_11                      ' P11: plane latch
strobeLatchB        outnot  pinLAXT_11
#ENDIF
                    drvh    pinLedLATCH
                    waitx   #WAITX_LATCH_SETTLE_TICKS
                    drvl    pinLedLATCH
enclosedSettleInst  waitx   #WAITX_LATCH_SETTLE_TICKS       ' enclosed only: a NOP for offset (patched at start)
                    jmp     #lightPlane

overlapPlane
                    ' overlapped latch (FM6126A, GS6238S, DP5125D), prototype refreshCog
                    ' overlapPlane: LATCH is high while the last LATCH_OVERLAP_COLS columns clock
                    ' in. The previous plane must be dark before LATCH rises; the row address
                    ' changes after the latch, as the old core did.
                    mov     columnsToShift, columnsBeforeLatch
                    call    #shiftColumns
                    waitx   #WAITX_EOBYTE_TICKS
                    drvl    pinLedCLK                       ' end the clock pulse before the wait, so it is not held high through it
                    call    #waitPanelDark
#IFDEF HUB75_INSTRUMENT
strobeOvlpLatchA    outnot  pinLAXT_11                      ' P11: plane latch
strobeOvlpLatchB    outnot  pinLAXT_11
#ENDIF
                    drvh    pinLedLATCH
                    mov     columnsToShift, #LATCH_OVERLAP_COLS
                    call    #shiftColumns
                    waitx   #WAITX_EOBYTE_TICKS
                    drvl    pinLedCLK                       ' end the last column's clock pulse
                    drvl    pinLedLATCH
                    call    #emitAddress

lightPlane
                    ' light the row for litClocks: with a one-clock base period the pulse starts
                    ' within a clock and IN rises when it is over
                    ' (p2kbArchSmartPin00100PulseCycleOutput). Brightness 0 never lights.
                    tjz     brightnessNow, #startSlot
                    wypin   litClocks, pinLedOE
                    mov     pulseStarted, #1                ' a pulse is now outstanding
startSlot
                    ' the plane's slot, 2^k x T at every brightness, ends at the CT1 event
                    ' (p2kbPasm2Addct1); waitPanelDark waits for it before the next latch
                    getct   slotEnd
                    addct1  slotEnd, slotClocks
                    add     planeHubAddr, planeSizeBytes
                    shr     litClocks, #HALVE_SHIFT         ' next plane has half the weight
                    shr     slotClocks, #HALVE_SHIFT
                    djnz    planesLeft, #planeLoop

                    add     rowHubAddr, rowSizeBytes
                    add     rowAddr, addrValue1
                    djnz    rowsLeft, #rowLoop
                    jmp     #frameStart

' --------------------------------------------------------------------------------------------------
' subroutines
'
' shiftColumns: clock columnsToShift bytes of cogBuffer, from byteOffset on, out to R1..B2.
' 7 instructions of 2 clocks (p2kbPasm2Waitx: WAITX is 2 + D) plus the two WAITX extensions.
' CLK is high from DRVH to the next DRVL: DRVH, WAITX, SETBYTE = LOOP_HIGH_FIXED_CLOCKS +
' waitCyclesHigh. It is low from DRVL to DRVH: DRVL, ALTGB, GETBYTE, WAITX = LOOP_LOW_FIXED_CLOCKS
' + waitCyclesLow (p2kbPasm2Altgb: ALTGB alters the next instruction, so it stays next to GETBYTE).
' Each pass puts out the byte fetched in the pass before, so the first byte is fetched before the
' loop and the loop's last fetch is one byte past the columns shifted: byteOffset is stepped back.
' CLK is left high; the caller ends the last pulse. columnsToShift is never 0: a row is always
' wider than LATCH_OVERLAP_COLS columns.
shiftColumns
                    altgb   byteOffset, pCogBffrIncr        ' first byte of cogBuffer, index advances
                    getbyte colorByte, 0-0, #0-0
                    rep     @shiftEnd, columnsToShift
colorOutInst        setbyte OUTA, colorByte, #OUT_RGB_BYTE_POS  ' this column's data, set while CLK is high; port and byte set at start
                    drvl    pinLedCLK                       ' CLK low: the high half ends
                    altgb   byteOffset, pCogBffrIncr        ' next byte of cogBuffer, index advances
                    getbyte colorByte, 0-0, #0-0
                    waitx   waitCyclesLow                   ' low time (data setup)
                    drvh    pinLedCLK                       ' rising edge clocks the data in
                    waitx   waitCyclesHigh                  ' clock high time
shiftEnd
                    sub     byteOffset, #1                  ' undo the loop's one byte of look-ahead
                    ret

' emitAddress: put rowAddr on A..E and let it settle. Called only while the panel is dark.
emitAddress
                    setq    maskAddr
addrOutInst         muxq    OUTA, rowAddr                   ' port set at start
                    waitx   #WAITX_LATCH_SETTLE_TICKS       ' let the address settle
                    ret

' waitPanelDark: return once the previous plane's slot and its light pulse have both ended.
' WAITCT1 waits for the CT1 event the slot set, then clears it (p2kbPasm2Waitct1); each slot is
' waited on once. TESTP reads the smart pin's IN (p2kbPasm2Testp), which P_PULSE raises when Y
' reaches 0 and WXPIN/WYPIN lower (p2kbArchSmartPins), so after the last pulse it returns at once.
waitPanelDark
                    waitct1
                    cmp     pulseStarted, #0            wz
    if_z            ret
waitPanelDarkPoll
                    testp   pinLedOE                    wc
    if_nc           jmp     #waitPanelDarkPoll
                    ret

' INITIALIZED data

' --------------------------------------------------------------------------------------------------
'   The following variables are populated from the initialization SPIN code before this driver starts
'
' Driver Config Values
bSetLowPins             LONG                    FALSE                                     ' T/F where T means R1..B2 are pins 8-13 of the port, F means pins 24-29
bUsePortA               LONG                    FALSE                                     ' T/F where T means we are using portA vs. portB
bOverlapLatch           LONG                    FALSE                                     ' T/F where T means LATCH high over the last LATCH_OVERLAP_COLS columns
bLatchEnclosed          LONG                    FALSE                                     ' T/F where T means latch at end, enclosed; F means offset

' Clock-frequency-independent timing values (calculated at init)
waitCyclesLow       LONG    0       ' extra cycles for CLK low phase (data setup)
waitCyclesHigh      LONG    0       ' extra cycles for CLK high phase (clock pulse)

' the row-address field and one row address as a step, within the port
maskAddr                LONG                    MASK_ADDR_HI16_ABCD                       ' pins at 16-31 A/B-pins
' PINS A 00-15  USE $0000_0008
' PINS A 16-31  USE $0008_0000
' PINS B 32-47  USE $0000_0008
' PINS B 48-63  USE $0008_0000
addrValue1              LONG                    ADDR_VAL_ONE_HI16                         ' 1 but in upper 5-bits of byte
'
rowAddressCount         LONG                    ROWS_ABCD                                 ' row addresses per frame (8/16/32)
columnClockCount        LONG                    DFLT_COLUMN_CLOCK_COUNT                   ' column clocks per row address
columnsBeforeLatch      LONG                    DFLT_COLUMN_CLOCK_COUNT - LATCH_OVERLAP_COLS ' overlapped latch: columns shifted before LATCH rises
pCogBffrIncr            LONG                    cogBuffer + COGBFFR_AUTOINC_FLAG          ' pointer to CogBuffer with auto-increment flag set

' frame-set geometry
rowLongsLessOne         LONG                    0                                         ' SETQ count for one row
rowSizeBytes            LONG                    0                                         ' hub bytes per row
planeSizeBytes          LONG                    0                                         ' hub bytes per plane (one PWM frame)
planeCount              LONG                    0                                         ' bit planes (the colour depth)
firstPulseWeight        LONG                    0                                         ' 2^(planes-1): the MSB's pulse count

' /OE timing
oeUnitClocks            LONG                    0                                         ' T: the /OE unit at brightness 256
minOeClocks             LONG                    0                                         ' the chip's shortest /OE pulse, in clocks
firstSlotClocks         LONG                    0                                         ' 2^(planes-1) x T: the MSB's slot at every brightness

#IFDEF HUB75_INSTRUMENT
pinGrpLAXT              LONG                    0                                         ' MTX_LA_XT_P08_11 pinGroup
pinLAXT_08              LONG                    0                                         ' MTX_LA_XT_P08 pin - posted set taken
showingPrior            LONG                    0                                         ' the set named at the previous frame start (P08 marks a change)
pinLAXT_09              LONG                    0                                         ' MTX_LA_XT_P09 pin - frame start
pinLAXT_10              LONG                    0                                         ' MTX_LA_XT_P10 pin - row start
pinLAXT_11              LONG                    0                                         ' MTX_LA_XT_P11 pin - plane latch
strobesEnabled          LONG                    FALSE                                     ' T/F where T means this cog may drive P08..P11
#ENDIF
pinLedOE                LONG                    0                                         ' MTX_LED_PIN_OE (the P_PULSE smart pin)
pinLedLATCH             LONG                    0                                         ' MTX_LED_PIN_LATCH
pinLedCLK               LONG                    0                                         ' MTX_LED_PIN_CLK
pinGrpAddr              LONG                    0                                         ' A..E as a pin group
pinGrpColor             LONG                    0                                         ' R1..B2 as a pin group

' --------------------------------------------------------------------------------------------------
'line buffer of hub75Bffrs.LINE_BUFFER_BYTES bytes, each %00bgrbgr where byte is 00{rgb2}{rgb1}
ALIGNL
cogBuffer
                        ' one row of one plane, loaded from the frame set by SETQ+RDLONG
                        LONG                    0[MAX_COG_BUFFER_SIZE_IN_LONGS]           ' sized from hub75Bffrs.LINE_BUFFER_BYTES

                ' UNINITIALIZED data
                '
                ' basic driver variables
                pCommand                        RES     1                                 ' @driverCommand
                pArgument                       RES     1                                 ' @driverArgument
                pShowing                        RES     1                                 ' @driverShowing
                pBrightness                     RES     1                                 ' @brightnessScale
                nextCommand                     RES     1                                 ' the command read at a frame start
                frameSetAddr                    RES     1                                 ' the frame set on display
                brightnessNow                   RES     1                                 ' b for this frame
                litUnitClocks                   RES     1                                 ' L = T x b / 256, at least minOeClocks
                firstLitClocks                  RES     1                                 ' 2^(planes-1) x L: the MSB's lit clocks this frame
                pulseStarted                    RES     1                                 ' nonzero while a pulse may be outstanding
                slotEnd                         RES     1                                 ' the CT1 target: when this plane's slot ends

                ' variables
                rowHubAddr                      RES     1                                 ' plane 0's copy of this row
                rowAddr                         RES     1                                 ' current row address, in port position
                rowsLeft                        RES     1                                 ' row addresses left in this frame
                planeHubAddr                    RES     1                                 ' this plane's copy of this row
                litClocks                       RES     1                                 ' 2^k x L: the lit clocks of the plane being shifted
                slotClocks                      RES     1                                 ' 2^k x T: the slot of the plane being shifted
                planesLeft                      RES     1                                 ' planes left in this row
                columnsToShift                  RES     1                                 ' REP count for shiftColumns
                byteOffset                      RES     1                                 ' next byte of cogBuffer
                colorByte                       RES     1                                 ' the byte being output
    '

                FIT     COG_RAM_FIT_LIMIT

CON ' ---- License ----

