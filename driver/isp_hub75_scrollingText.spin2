CON ' ---- Scroll Direction ----
    {Spin2_Doc_CON}
    ' Scrolling direction values:
    '  DIR_UNKNOWN  - direction not yet set
    '  DIR_TO_LEFT  - scroll text toward the left
    '  DIR_TO_RIGHT - scroll text toward the right
    '  DIR_UP       - scroll text upward
    '  DIR_DOWN     - scroll text downward
    ' Allocation: distinct identity. The directions start at 10, apart from the SCROLL_* duration
    ' modes (from 0), the other parameter of the same scroll calls, so swapped arguments are detectable.
    #10, DIR_UNKNOWN, DIR_TO_LEFT, DIR_TO_RIGHT, DIR_UP, DIR_DOWN

CON ' ---- Scroll Duration ----
    {Spin2_Doc_CON}
    ' Scrolling duration modes:
    '  SCROLL_UNKNOWN       - duration mode not yet set
    '  SCROLL_FOREVER       - scroll continuously
    '  SCROLL_ONCE          - scroll one pass then stop
    '  SCROLL_ONCE_TO_CLEAR - scroll one pass to clear the region
    '  SCROLL_N_TIMES       - scroll a specified number of passes
    ' Allocation: arbitrary. The modes start at 0 (SCROLL_UNKNOWN, unset); the DIR_* values start
    ' at 10 so the two parameters of the same calls never overlap.
    #0, SCROLL_UNKNOWN, SCROLL_FOREVER, SCROLL_ONCE, SCROLL_ONCE_TO_CLEAR, SCROLL_N_TIMES

CON ' ---- Internal Sizing ----

    ' the scroll buffer: MAX_SCROLL_LINES lines of MAX_CHARS_PER_LINE characters
    MAX_CHARS_PER_LINE           = 10
    MAX_SCROLL_LINES             = 3
    MAX_SCROLL_CHARS_TO_BUFFER   = MAX_CHARS_PER_LINE * MAX_SCROLL_LINES

    ' the character buffer is held in whole LONGs
    MAX_SCROLL_CHAR_BYTES        = (((MAX_SCROLL_CHARS_TO_BUFFER + hub75Bffrs.BYTES_PER_LONG - 1) / hub75Bffrs.BYTES_PER_LONG) * hub75Bffrs.BYTES_PER_LONG)
    MAX_SCROLL_CHAR_LONGS        = (MAX_SCROLL_CHAR_BYTES / hub75Bffrs.BYTES_PER_LONG)

    ' loop-count clamp for repeated scrolling: the most repeats SCROLL_N_TIMES takes
    MAX_SCROLL_LOOP_COUNT        = 10

    ' fewest characters a scroll window shows
    MIN_VISIBLE_CHARS            = 1

    ' scrolling up or down shows one more, partly visible, character beside the window's characters
    PARTIAL_CHARS_UP_DOWN        = 1

    ' character literal (the background / off-pixel color is color.CBLACK)
    SPACE_CHAR                   = $20                              ' ASCII space

CON ' ---- Dithered Text ----
    {Spin2_Doc_CON}

    ' dithered-font brightness reduction
    DITHER_BRIGHTNESS_PCT        = 36                               ' brightness percent for dithered pixels

OBJ

    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    hwEnum      : "isp_hub75_hwEnums"
    pixels      : "isp_hub75_screenUtils"
    color       : "isp_hub75_color"                                 ' cRainbow, which is drawn pixel by pixel
    fonts       : "isp_hub75_fonts"
    colorUtils  : "isp_hub75_colorUtils"
    cube        : "isp_hub75_cube"                                  ' the cube's faces, for face-centric regions

DAT ' ---- Class-Static Data ----

    instanceNumber  BYTE    0

VAR ' ---- Instance Variables ----

    LONG    chainIdx
    ' our scrolling support - currently 1 scrolling region
    LONG    scrollChars[MAX_SCROLL_CHAR_LONGS]
    LONG    scrollTextColor
    LONG    nCharsToScroll                                      ' set when scrolling text is specified
    LONG    topRow                                              ' set when scrolling text is specified
    LONG    leftColumn                                          ' set when scrolling text is specified
    LONG    windowWidthInPix                                    ' set when scrolling text is specified

    BYTE    maxVisibleChars                                     ' set when scrolling text is specified

    LONG    maxTextColumns                                      ' specs from display object
    LONG    maxDisplayColumns                                   ' specs from buffer chain table
    LONG    eFaceHome                                           ' the cube face the region is homed on, or NO_FACE for display coordinates
    LONG    faceHomeTurn                                        ' the region's frame -> its home frame: quarter turns
    LONG    faceHomeAddRow                                      ' ... and the row added after them
    LONG    faceHomeAddColumn                                   ' ... and the column added after them
    BYTE    charWidthInPix
    BYTE    charHeightInPix
    BYTE    horizontalGapInPix

    BYTE    selectedTextFont
    LONG    bFontIsDithered

    LONG    remainingPixToScroll
    LONG    charHzPixOffset                                     ' offset into "charWidthInPix + horizontalGapInPix" field
    LONG    charVtPixOffset                                     ' offset from top of char
    LONG    firstVisCharIdx                                     ' index into list of scrolling chars, head of left-scrolling or window-tail of right-scrolling

    LONG    nScrollTimes                                        ' configure before use!
    BYTE    eScrollMode                                         ' configure before use!
    BYTE    eScrollDirection                                    ' configure before use!
    BYTE    instanceID

    ' moving the last frame instead of drawing it again (see animateScroll())
    LONG    windowSlot                                          ' the watched window (hub75Bffrs.watchWindow()), or NO_WINDOW_SLOT
    LONG    bHasFrame                                           ' TRUE when the window holds the frame drawn last
    LONG    lastFirstVisCharIdx                                 ' firstVisCharIdx the last frame was drawn with
    LONG    lastCharHzPixOffset                                 ' charHzPixOffset the last frame was drawn with
    LONG    lastCharVtPixOffset                                 ' charVtPixOffset the last frame was drawn with

PUB null()
'' This is not a top level object
''

PUB initialize(nChainIdx)
'' Initialize this scroller instance for the given chain index.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)

    chainIdx := nChainIdx
    nCharsToScroll := 0
    eScrollMode := SCROLL_UNKNOWN
    nScrollTimes := 0
    instanceID := ++instanceNumber
    windowSlot := hub75Bffrs.NO_WINDOW_SLOT
    bHasFrame := FALSE
    remainingPixToScroll := 0
    maxDisplayColumns := hub75Bffrs.maxDisplayColumns(chainIdx)
    eFaceHome := cube.NO_FACE

PUB setFontInfo(nTextColumns, charWidth, charHeight, horizontalGap, textFont)
'' Update cached font metrics when the active font changes.
''
'' @param nTextColumns - maximum number of text columns for this font
'' @param charWidth - character width in pixels
'' @param charHeight - character height in pixels
'' @param horizontalGap - horizontal gap in pixels between characters
'' @param textFont - font identifier to select

    maxTextColumns := nTextColumns
    charWidthInPix := charWidth
    charHeightInPix := charHeight
    horizontalGapInPix := horizontalGap
    selectedTextFont := textFont
    bFontIsDithered := fonts.isDitheredFont(selectedTextFont)
    bHasFrame := FALSE                                              ' the next step draws the whole window in the new font

PUB isIdle() : bIdle
'' Return T/F where T means this scroller instance is idle.
''
'' @returns bIdle - TRUE if scroller is idle, FALSE otherwise

    bIdle := (nCharsToScroll == 0)

PUB release()
'' Mark this scroller instance as available for reuse.
''

    nCharsToScroll := 0
    stopWatching()

PUB configureScrollLoopMode(loopMode)
'' Specify scrolling text duration using a default count of zero.
''
'' @param loopMode - scrolling duration mode (SCROLL_FOREVER, SCROLL_ONCE, etc.)

    configureScrollLoopCount(loopMode, 0)

PUB configureScrollLoopCount(loopMode, repeatCount) | clampedCount
'' Specify scrolling text duration and repeat count.
''
'' An unrecognised loopMode leaves the scrolling duration mode as it was.
''
'' @param loopMode - scrolling duration mode (SCROLL_FOREVER, SCROLL_ONCE, etc.)
'' @param repeatCount - number of times to scroll when loopMode is SCROLL_N_TIMES

' Local Variables:
' @local clampedCount - the repeatCount value clamped to valid range

    debug("cslm() #", udec_(instanceID), " mode=", udec_(loopMode))
    clampedCount := 0 #> repeatCount <# MAX_SCROLL_LOOP_COUNT
    case loopMode
        SCROLL_FOREVER, SCROLL_ONCE:
            eScrollMode := loopMode                     ' these two take no repeat count
        SCROLL_ONCE_TO_CLEAR:
            eScrollMode := loopMode
            nScrollTimes := 0
        SCROLL_N_TIMES:
            eScrollMode := loopMode
            nScrollTimes := clampedCount

    if loopMode <> SCROLL_FOREVER
        if loopMode == SCROLL_ONCE_TO_CLEAR
            remainingPixToScroll := (nCharsToScroll * (charWidthInPix + horizontalGapInPix))
            if eScrollDirection == DIR_TO_RIGHT
                ' scrolling right the text starts charWidthInPix - 1 pixels into its first field (charHzPixOffset
                ' starts at the field's last pixel), so the window is clear that many steps later
                remainingPixToScroll += charWidthInPix - 1
            if eScrollDirection == DIR_UP or eScrollDirection == DIR_DOWN
                remainingPixToScroll := charHeightInPix
        elseif loopMode == SCROLL_N_TIMES
            remainingPixToScroll := (((nCharsToScroll * (charWidthInPix + horizontalGapInPix)) * nScrollTimes) - horizontalGapInPix) - windowWidthInPix
            if eScrollDirection == DIR_UP or eScrollDirection == DIR_DOWN
                remainingPixToScroll := (charHeightInPix + pixels.GLYPH_BLANK_ROWS) * nScrollTimes  ' blank row of pixels between rows
        else
            remainingPixToScroll := ((nCharsToScroll * (charWidthInPix + horizontalGapInPix)) - horizontalGapInPix) - windowWidthInPix
            if eScrollDirection == DIR_UP or eScrollDirection == DIR_DOWN
                remainingPixToScroll := charHeightInPix + pixels.GLYPH_BLANK_ROWS         ' blank row of pixels between rows

    ' the mode decides what a sideways window shows past the text (the text again, or spaces), and
    ' the window on screen was drawn before this mode was set: draw it again for this mode
    redrawLastFrame()

PUB scrollTextAtRCOfColor(row, column, widthInChars, pZString, direction, rgbColor)
'' Place scrolling text at row, column from a zero-terminated string using the given direction and color.
'' Uses display coordinates. Aborts if direction is not one of the four scroll directions (and the
'' scroller is idle and the string is not empty); nothing is scrolled when it does.
''
'' @param row - top row of the scrolling region
'' @param column - left column of the scrolling region
'' @param widthInChars - width of the visible scroll window in characters
'' @param pZString - pointer to zero-terminated string to scroll
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, DIR_UP, DIR_DOWN)
'' @param rgbColor - combined RGB color value

    beginScroll(cube.NO_FACE, cube.QTURN_NONE, 0, 0, row, column, widthInChars, pZString, direction, rgbColor)

PUB scrollFaceTextAtRCOfColor(eHomeFace, homeTurn, homeAddRow, homeAddColumn, row, column, widthInChars, pZString, direction, rgbColor)
'' Place scrolling text on a face of the cube from a zero-terminated string using the given
'' direction and color: the face-coordinate mode of this scroller. Row and column are face
'' coordinates in the frame the object was homed from; every pixel is carried into the home
'' frame and folded across the cube's edges before it is drawn, so the region can run off a
'' face's edge and continue on the neighbouring face. The display object finds the home
'' (isp_hub75_display.faceHomeOf()); this call only draws. Aborts if direction is not one of the
'' four scroll directions (and the scroller is idle and the string is not empty); nothing is
'' scrolled when it does.
''
'' @param eHomeFace - the face (hwEnum.FACE_TOP .. FACE_RIGHT) the region is homed on
'' @param homeTurn - clockwise quarter turns from the region's frame to the home frame
'' @param homeAddRow - row added after that turn
'' @param homeAddColumn - column added after that turn
'' @param row - top row of the scrolling region on the face
'' @param column - left column of the scrolling region on the face
'' @param widthInChars - width of the visible scroll window in characters
'' @param pZString - pointer to zero-terminated string to scroll
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, DIR_UP, DIR_DOWN)
'' @param rgbColor - combined RGB color value

    beginScroll(eHomeFace, homeTurn, homeAddRow, homeAddColumn, row, column, widthInChars, pZString, direction, rgbColor)

PUB animateScroll()
'' Perform one scroll animation step if scrolling is not yet complete.
''

    if isScrollingComplete() == FALSE
        ' if scrolling left then head is next loosing left most pixel (offset dictates)
        '   and tail if moving left most pixel onscreen
        ' else (moving right) then head is moving rightmost pixel on screen
        '   while tail is loosing right most pixel (offset dictates)
        ' all chars are in the char buffer "scrollChars"

        ' place char bits: move the last frame one pixel and draw the new edge when that gives the
        ' same pixels as drawing the whole window, else draw the whole window
        hub75Bffrs.setDrawingOwner(chainIdx, windowSlot)
        if isShiftStep() == TRUE
            shiftStep()
        else
            drawWholeWindow(eScrollDirection)
        noteFrameDrawn()
        hub75Bffrs.setDrawingOwner(chainIdx, hub75Bffrs.NO_WINDOW_SLOT)
        if eScrollDirection == DIR_TO_LEFT
            charHzPixOffset++                           ' we showed one just now
            ' if finished scrolling first char offscreen then reset to show head of next char
            if charHzPixOffset > charWidthInPix + horizontalGapInPix - 1
                charHzPixOffset := 0
                firstVisCharIdx++
                if firstVisCharIdx > nCharsToScroll - 1 and eScrollMode <> SCROLL_ONCE_TO_CLEAR
                    firstVisCharIdx := 0
        elseif eScrollDirection == DIR_TO_RIGHT
            charHzPixOffset--                           ' we showed one just now
            ' if finished scrolling first char offscreen then reset to show head of next char
            if charHzPixOffset < 0
                charHzPixOffset := charWidthInPix + horizontalGapInPix - 1
                firstVisCharIdx--
                if firstVisCharIdx < 0 and eScrollMode <> SCROLL_ONCE_TO_CLEAR
                    firstVisCharIdx += nCharsToScroll           ' a text shorter than the window starts below -1
        elseif eScrollDirection == DIR_UP
            charVtPixOffset++                           ' we showed one just now
            if charVtPixOffset >= charHeightInPix - 1 + pixels.GLYPH_BLANK_ROWS  ' blank row of pixels between rows
                charVtPixOffset := 0
        elseif eScrollDirection == DIR_DOWN
            charVtPixOffset--                           ' we showed one just now
            if charVtPixOffset < 0
                charVtPixOffset := charHeightInPix - 1 + pixels.GLYPH_BLANK_ROWS  ' blank row of pixels between rows

        if eScrollMode <> SCROLL_FOREVER
            if remainingPixToScroll > 0
                remainingPixToScroll--
                if remainingPixToScroll == 0
                    nCharsToScroll := 0  ' force IDLE to report true now
                    stopWatching()

PUB isScrollingComplete() : bComplete
'' Return T/F where T means that all scrolling movement is complete.
''
'' @returns bComplete - TRUE if scrolling is complete, FALSE otherwise

    bComplete := remainingPixToScroll <= 0
    ' if 'foreever' we are never done!
    if eScrollMode == SCROLL_FOREVER
        bComplete := FALSE

    if bComplete == TRUE
        debug("stx:isc() #", udec_(instanceID), " scroll Complete")

#IFDEF HUB75_INSTRUMENT
PUB refreshGeometry()
'' Instrument build only: read the display's width again, after a self-test has replaced the
'' adapter's layout (hub75Bffrs testRelayout()) or put it back.
''

    maxDisplayColumns := hub75Bffrs.maxDisplayColumns(chainIdx)
    stopWatching()                                                  ' the layout changed: draw the whole window next step
#ENDIF

PRI beginScroll(eHomeFace, homeTurn, homeAddRow, homeAddColumn, row, column, widthInChars, pZString, direction, rgbColor)
' Start scrolling text on an idle scroller and place its first window of characters. The
' display-centric and the face-centric entries both come here: a face-centric region keeps its
' home (face and transform) while it scrolls, and a display-centric one keeps no face. Aborts
' when the scroller is idle, the string is not empty and direction is not DIR_TO_LEFT,
' DIR_TO_RIGHT, DIR_UP or DIR_DOWN (eScrollDirection is then DIR_UNKNOWN and nothing is drawn).
'
' @param eHomeFace - the face (hwEnum.FACE_*) the region is homed on, or NO_FACE for display coordinates
' @param homeTurn - clockwise quarter turns from the region's frame to the home frame
' @param homeAddRow - row added after that turn
' @param homeAddColumn - column added after that turn
' @param row - top row of the scrolling region
' @param column - left column of the scrolling region
' @param widthInChars - width of the visible scroll window in characters
' @param pZString - pointer to zero-terminated string to scroll
' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, DIR_UP, DIR_DOWN)
' @param rgbColor - combined RGB color value

    if isIdle() == TRUE
        debug("stx:starcoc() #", udec_(instanceID), " [", zstr_(pZString), "](", udec_(widthInChars), ")")
        stopWatching()
        ' a new scroll starts in the default mode: the region may last have scrolled for another line
        ' (display picks a free scroller), and its mode is set after this start (configureScrollLoopMode())
        eScrollMode := SCROLL_UNKNOWN
        nScrollTimes := 0
        scrollTextColor := rgbColor

        ' where the pixels go: display coordinates are held to the display's right edge; face
        ' coordinates are folded onto the cube, which has no such edge
        eFaceHome := eHomeFace
        faceHomeTurn := homeTurn
        faceHomeAddRow := homeAddRow
        faceHomeAddColumn := homeAddColumn

        ' our string length is smaller of length given or our receiving buffer length
        nCharsToScroll := strsize(pZString) <# MAX_SCROLL_CHAR_BYTES

        ' visible chars is our window size constrained by our font max text columns
        maxVisibleChars := MIN_VISIBLE_CHARS #> widthInChars <# maxTextColumns

        ' our pix length is char-width + gap-between-chars
        windowWidthInPix := (maxVisibleChars * (charWidthInPix + horizontalGapInPix)) - horizontalGapInPix

        ' remainingPix is our number of pix yet off screen to right (or to left if scrolling that direction)
        remainingPixToScroll := ((nCharsToScroll * (charWidthInPix + horizontalGapInPix)) - horizontalGapInPix) - windowWidthInPix
        if direction == DIR_UP or direction == DIR_DOWN
            remainingPixToScroll := charHeightInPix     ' + 1 we are doing a blank row of pixels between rows

        if nCharsToScroll > 0
            bytemove(@scrollChars, pZString, nCharsToScroll)
            topRow := row
            leftColumn := column
            case direction
                DIR_TO_LEFT:
                    ' showing left-most chars first
                    eScrollDirection := direction
                    firstVisCharIdx := 0
                    charHzPixOffset := 0
                DIR_TO_RIGHT:
                    ' showing right-most chars first
                    eScrollDirection := direction
                    firstVisCharIdx := nCharsToScroll - maxVisibleChars
                    charHzPixOffset := charWidthInPix + horizontalGapInPix - 1
                DIR_UP:
                    eScrollDirection := direction
                    firstVisCharIdx := 0
                    charVtPixOffset := 0                ' start with full text on screen
                DIR_DOWN:
                    eScrollDirection := direction
                    firstVisCharIdx := 0
                    charVtPixOffset := 0                ' start with full text on screen
                other:
                    eScrollDirection := DIR_UNKNOWN
                    debug("stx:bad scroll direction, abort")
                    abort
        '
        ' place window chars on screen, and watch the window so later steps can move this frame
        '
        if direction == DIR_TO_LEFT or direction == DIR_TO_RIGHT or direction == DIR_UP or direction == DIR_DOWN
            if nCharsToScroll > 0
                startWatching()
            hub75Bffrs.setDrawingOwner(chainIdx, windowSlot)
            drawWholeWindow(direction)
            noteFrameDrawn()
            hub75Bffrs.setDrawingOwner(chainIdx, hub75Bffrs.NO_WINDOW_SLOT)
        ' reset scroll offset to beginning
        if direction == DIR_TO_LEFT
            charHzPixOffset++                           ' we showed first window content just now
        elseif direction == DIR_TO_RIGHT
            charHzPixOffset--                           ' we showed first window content just now
            if charHzPixOffset < 0
                charHzPixOffset := charWidthInPix + horizontalGapInPix - 1
                firstVisCharIdx--
        elseif direction == DIR_UP
            charVtPixOffset++                           ' we showed first window content just now
        elseif direction == DIR_DOWN
            charVtPixOffset--                           ' we showed first window content just now
            if charVtPixOffset < 0
                charVtPixOffset := charHeightInPix - 1 + pixels.GLYPH_BLANK_ROWS  ' blank row of pixels between rows
    else
        debug("stx:scrollTxAtRCOfClr() - NOT IDLE!")

PRI drawWholeWindow(direction)
' Draw every pixel of the window from the text, at the scroll state as it stands: the drawing
' every step did before frames were moved, and still the reference for a moved frame.
'
' @param direction - DIR_TO_LEFT, DIR_TO_RIGHT, DIR_UP or DIR_DOWN

    if direction == DIR_TO_LEFT or direction == DIR_TO_RIGHT
        placeColrCharsHzOfstAtRC(topRow, leftColumn, charHzPixOffset, windowWidthInPix, firstVisCharIdx, scrollTextColor)
    elseif direction == DIR_UP or direction == DIR_DOWN
        placeColrCharsVtOfstAtRC(topRow, leftColumn, charVtPixOffset, scrollTextColor)

PRI textCharIdx(charIdx) : actCharIdx
' Return the index into the text of the character a sideways window position shows. In every mode
' but SCROLL_ONCE_TO_CLEAR the text repeats end to end, so an index past either end is taken
' around the text as many times as it needs (a window can hold the text more than twice). In
' SCROLL_ONCE_TO_CLEAR the index is returned as it is, and outside the text it shows a space.
'
' @param charIdx - character position counted from the start of the text, may be past either end
' @returns actCharIdx - the text index to show (outside 0 .. nCharsToScroll - 1 only in SCROLL_ONCE_TO_CLEAR)

    actCharIdx := charIdx
    if eScrollMode <> SCROLL_ONCE_TO_CLEAR and nCharsToScroll > 0
        actCharIdx := ((charIdx // nCharsToScroll) + nCharsToScroll) // nCharsToScroll    ' floor modulo: a negative index wraps too

PRI redrawLastFrame()
' Draw a sideways window again at the scroll state its last frame was drawn with, so the frame on
' screen is the one the current loop mode gives: past the text a window shows the text again,
' except in SCROLL_ONCE_TO_CLEAR, where it shows spaces. The scroll state is not changed, so the
' next step still moves this frame one pixel (isShiftStep()). An up or down window does not
' depend on the mode, and a scroller with no frame on screen has nothing to draw again.

    if bHasFrame == TRUE and (eScrollDirection == DIR_TO_LEFT or eScrollDirection == DIR_TO_RIGHT)
        hub75Bffrs.setDrawingOwner(chainIdx, windowSlot)
        placeColrCharsHzOfstAtRC(topRow, leftColumn, lastCharHzPixOffset, windowWidthInPix, lastFirstVisCharIdx, scrollTextColor)
        hub75Bffrs.markWindowClean(windowSlot)
        hub75Bffrs.setDrawingOwner(chainIdx, hub75Bffrs.NO_WINDOW_SLOT)

PRI startWatching() | lastColumn
' Watch the pixels this region draws (hub75Bffrs.watchWindow()), so a later step can move the
' frame it drew instead of drawing it again, and draws it again whenever something else wrote
' there. Only a display-centric region whose glyph rows are drawn as runs (isGlyphRun()) is
' watched, and only when its pixels lie on panels of the display; any other draws every step.
' Sideways the pixels are the window; up and down they are maxVisibleChars + 1 characters, side by
' side, cut at the display's right edge (placeColrCharsVtOfstAtRC()).

' Local Variables:
' @local lastColumn - the rightmost column the region draws

    stopWatching()
    if isGlyphRun(scrollTextColor) == TRUE
        if eScrollDirection == DIR_UP or eScrollDirection == DIR_DOWN
            lastColumn := verticalLastColumn()
        else
            lastColumn := leftColumn + windowWidthInPix - 1
        windowSlot := hub75Bffrs.watchWindow(chainIdx, topRow, leftColumn, topRow + charHeightInPix - 1, lastColumn)

PRI verticalLastColumn() : lastColumn
' Return the rightmost column an up or down region draws: maxVisibleChars + 1 characters side by
' side from leftColumn, cut at the display's right edge (placeColrCharsVtOfstAtRC()).
'
' @returns lastColumn - the rightmost column the region draws

    lastColumn := ((leftColumn + ((maxVisibleChars + PARTIAL_CHARS_UP_DOWN) * charWidthInPix)) <# maxDisplayColumns) - 1

PRI stopWatching()
' Stop watching this region's pixels (startWatching()), and forget the frame drawn last.

    hub75Bffrs.unwatchWindow(windowSlot)
    windowSlot := hub75Bffrs.NO_WINDOW_SLOT
    bHasFrame := FALSE

PRI noteFrameDrawn()
' Record that the window now holds the frame for the scroll state as it stands: the state is kept
' to tell whether the next step moves it by one pixel (isShiftStep()), and the window is clean.

    lastFirstVisCharIdx := firstVisCharIdx
    lastCharHzPixOffset := charHzPixOffset
    lastCharVtPixOffset := charVtPixOffset
    bHasFrame := TRUE
    hub75Bffrs.markWindowClean(windowSlot)

PRI isShiftStep() : bShift | fieldPix
' Return TRUE when this step can move the last frame by one pixel and draw only the new edge:
' the window is watched and clean (nothing else wrote into it since the last frame), and the
' scroll state is exactly one pixel on from the state that frame was drawn with. A step that
' wraps the text or the glyph rows, the first step after a font change, and any step after
' something wrote into the window draw the whole window instead (drawWholeWindow()).
'
' @returns bShift - TRUE to move the frame

' Local Variables:
' @local fieldPix - pixels from one character's left edge to the next (width and gap)

    bShift := FALSE
    if bHasFrame == TRUE and hub75Bffrs.isWindowClean(windowSlot) == TRUE
        fieldPix := charWidthInPix + horizontalGapInPix
        case eScrollDirection
            DIR_TO_LEFT:
                bShift := (charHzPixOffset == lastCharHzPixOffset + 1 and firstVisCharIdx == lastFirstVisCharIdx) or (charHzPixOffset == 0 and lastCharHzPixOffset == fieldPix - 1 and firstVisCharIdx == lastFirstVisCharIdx + 1)
            DIR_TO_RIGHT:
                bShift := (charHzPixOffset == lastCharHzPixOffset - 1 and firstVisCharIdx == lastFirstVisCharIdx) or (charHzPixOffset == fieldPix - 1 and lastCharHzPixOffset == 0 and firstVisCharIdx == lastFirstVisCharIdx - 1)
            DIR_UP:
                bShift := charVtPixOffset == lastCharVtPixOffset + 1
            DIR_DOWN:
                bShift := charVtPixOffset == lastCharVtPixOffset - 1
#IFDEF HUB75_INSTRUMENT
    ' the row-run self-test's reference draws the whole window every step, so its comparison
    ' checks each moved frame against the frame drawing the whole window gives
    if pixels.isPerPixelReference() == TRUE
        bShift := FALSE
#ENDIF

PRI shiftStep() | rowIdx, lastColumn
' Move the last frame one pixel the way the text moves and draw the one new column (sideways) or
' row (up and down) from the text: the same pixels drawWholeWindow() would draw for this state.

' Local Variables:
' @local rowIdx - window row being moved
' @local lastColumn - the rightmost column the region draws

    case eScrollDirection
        DIR_TO_LEFT:
            repeat rowIdx from 0 to charHeightInPix - 1
                pixels.shiftRowLeft(chainIdx, topRow + rowIdx, leftColumn, leftColumn + windowWidthInPix - 1)
            drawEdgeColumn(windowWidthInPix - 1)
        DIR_TO_RIGHT:
            repeat rowIdx from 0 to charHeightInPix - 1
                pixels.shiftRowRight(chainIdx, topRow + rowIdx, leftColumn, leftColumn + windowWidthInPix - 1)
            drawEdgeColumn(0)
        DIR_UP:
            lastColumn := verticalLastColumn()
            pixels.shiftRowsUp(chainIdx, topRow, topRow + charHeightInPix - 1, leftColumn, lastColumn)
            drawEdgeRow(charHeightInPix - 1)
        DIR_DOWN:
            lastColumn := verticalLastColumn()
            pixels.shiftRowsDown(chainIdx, topRow, topRow + charHeightInPix - 1, leftColumn, lastColumn)
            drawEdgeRow(0)

PRI drawEdgeColumn(windowColumn) | fieldPix, stripPix, actCharIdx, bitIdx, cChar, pChrBitmap, packedFg, packedHalf, packedBlack
' Draw one column of the window from the text, as placeColrCharsHzOfstAtRC() draws it for this
' state: window column x shows pixel charHzPixOffset + x of the characters from
' firstVisCharIdx on, each character's width then its gap; the character index wraps around the
' text (textCharIdx(), except SCROLL_ONCE_TO_CLEAR), and past the text it is a space.
'
' @param windowColumn - column within the window (0 at its left)

' Local Variables:
' @local fieldPix - pixels from one character's left edge to the next (width and gap)
' @local stripPix - pixel of the characters from firstVisCharIdx on that the column shows
' @local actCharIdx - the character the column falls in
' @local bitIdx - the column within that character's field (a gap when past its width)
' @local cChar - that character
' @local pChrBitmap - hub address of the character's bitmap, or pixels.NO_GLYPH for a black gap
' @local packedFg - the full-brightness color's corrected bytes, packed
' @local packedHalf - the reduced-brightness color's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed

    fieldPix := charWidthInPix + horizontalGapInPix
    stripPix := charHzPixOffset + windowColumn
    actCharIdx := textCharIdx((stripPix / fieldPix) + firstVisCharIdx)
    bitIdx := stripPix // fieldPix
    ' before or after the text the column shows a space
    cChar := SPACE_CHAR
    if actCharIdx >= 0 and actCharIdx < nCharsToScroll
        cChar := BYTE[@scrollChars][actCharIdx]
    pChrBitmap := pixels.NO_GLYPH
    if bitIdx < charWidthInPix
        pChrBitmap := fonts.getCharAddrForFont(selectedTextFont, cChar)
    _, packedFg, packedHalf, packedBlack, _ := glyphSetup(scrollTextColor)
    drawGlyphSlice(topRow, leftColumn + windowColumn, charHeightInPix, 1, pChrBitmap, bitIdx, 0, packedFg, packedHalf, packedBlack)

PRI drawEdgeRow(windowRow) | charIdx, column, nPixels, cChar, pChrBitmap, packedFg, packedHalf, packedBlack
' Draw one row of the region from the text, as placeColrCharsVtOfstAtRC() draws it for this state:
' characters 0 .. maxVisibleChars side by side, charWidthInPix apart and cut at the display's right
' edge, each showing glyph row (windowRow + charVtPixOffset) +// (charHeightInPix + pixels.GLYPH_BLANK_ROWS).
'
' @param windowRow - row within the region (0 at its top)

' Local Variables:
' @local charIdx - character slot being drawn
' @local column - its left column
' @local nPixels - its pixels on the display
' @local cChar - its character
' @local pChrBitmap - hub address of the character's bitmap
' @local packedFg - the full-brightness color's corrected bytes, packed
' @local packedHalf - the reduced-brightness color's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed

    _, packedFg, packedHalf, packedBlack, _ := glyphSetup(scrollTextColor)
    repeat charIdx from 0 to maxVisibleChars + PARTIAL_CHARS_UP_DOWN - 1
        column := leftColumn + (charIdx * charWidthInPix)
        nPixels := charWidthInPix <# (maxDisplayColumns - column)
        if nPixels > 0
            cChar := BYTE[@scrollChars][charIdx]
            if charIdx > nCharsToScroll - 1
                cChar := SPACE_CHAR
            pChrBitmap := fonts.getCharAddrForFont(selectedTextFont, cChar)
            drawGlyphSlice(topRow + windowRow, column, 1, nPixels, pChrBitmap, 0, (windowRow + charVtPixOffset) +// (charHeightInPix + pixels.GLYPH_BLANK_ROWS), packedFg, packedHalf, packedBlack)

PRI drawGlyphSlice(row, column, nBlockRows, nPixels, pChrBitmap, firstBit, firstGlyphRow, packedFg, packedHalf, packedBlack) | blockRow, pixelIdx
' Draw part of a glyph (screenUtils copyGlyphRows()): one block when it lies inside one cell, else
' pixel by pixel as one-pixel blocks, which never cross a cell.
'
' @param row - top row of the part, as mounted
' @param column - left column of the part, as mounted
' @param nBlockRows - rows of the part
' @param nPixels - pixels in each row of the part
' @param pChrBitmap - hub address of the character's bitmap, or pixels.NO_GLYPH for a black gap
' @param firstBit - bit index (from the glyph's left edge) of each row's first pixel
' @param firstGlyphRow - glyph row shown in the part's first row
' @param packedFg - the full-brightness color's corrected bytes, packed
' @param packedHalf - the reduced-brightness color's corrected bytes, packed
' @param packedBlack - black's corrected bytes, packed

' Local Variables:
' @local blockRow - row of the part drawn pixel by pixel
' @local pixelIdx - pixel of that row

    if pixels.copyGlyphRows(chainIdx, row, column, nBlockRows, nPixels, pChrBitmap, bFontIsDithered, charWidthInPix, charHeightInPix, firstBit, firstGlyphRow, packedFg, packedHalf, packedBlack) == hwEnum.E_NOT_ONE_BLOCK
        repeat blockRow from 0 to nBlockRows - 1
            repeat pixelIdx from 0 to nPixels - 1
                pixels.copyGlyphRows(chainIdx, row + blockRow, column + pixelIdx, 1, 1, pChrBitmap, bFontIsDithered, charWidthInPix, charHeightInPix, firstBit + pixelIdx, firstGlyphRow + blockRow, packedFg, packedHalf, packedBlack)

PRI plotFacePixel(faceRow, faceColumn, rgbColor) | displayRow, displayColumn
' Draw one pixel of a face-centric region: carry it into the region's home frame, fold it across
' the cube's edges onto the face that holds it, and draw it there; a pixel in a corner gap is not
' drawn. The display-centric path does not come here.
'
' @param faceRow - pixel row in the region's frame (may run past the face's edges)
' @param faceColumn - pixel column in the region's frame (may run past the face's edges)
' @param rgbColor - combined RGB color value

' Local Variables:
' @local displayRow - display row the pixel lands on, or NO_DISPLAY_PIXEL
' @local displayColumn - display column the pixel lands on

    displayRow, displayColumn := cube.homeFoldToDisplay(chainIdx, eFaceHome, faceHomeTurn, faceHomeAddRow, faceHomeAddColumn, faceRow, faceColumn)
    if displayRow <> cube.NO_DISPLAY_PIXEL
        pixels.drawPixelAtRC(chainIdx, displayRow, displayColumn, rgbColor)

PRI placeColrCharsHzOfstAtRC(row, column, hzPixOffset, windowWidth, startCharIdx, rgbColor) | charIdx, maxCharIdx, actCharIdx, endColumn, remainWindowPix, headWidthInPix, tailWidthInPix, hzInsetInPix, cChar, pChrBitmap
' Write character bitmaps to screen with possible fractional first and last characters for horizontal scrolling.
'
' @param row - top row for character placement
' @param column - left column for character placement
' @param hzPixOffset - horizontal pixel offset into the leading character
' @param windowWidth - visible window width in pixels
' @param startCharIdx - index of the first character to display
' @param rgbColor - combined RGB color value

' Local Variables:
' @local charIdx - window character slot being placed
' @local maxCharIdx - last window character slot placed
' @local actCharIdx - actual character index accounting for wrap-around
' @local endColumn - column position after last placed character
' @local remainWindowPix - window pixels not yet placed
' @local headWidthInPix - pixels of the character about to be placed (the leading one is partly cut off)
' @local tailWidthInPix - pixels of a trailing character cut off by the window's right edge
' @local hzInsetInPix - pixels skipped from the left edge of the character about to be placed
' @local cChar - the character about to be placed
' @local pChrBitmap - hub address of the character's bitmap

    maxCharIdx := (hzPixOffset > 0) ? maxVisibleChars : maxVisibleChars - 1
    headWidthInPix := charWidthInPix + horizontalGapInPix - hzPixOffset
    if maxCharIdx == 0
        headWidthInPix := charWidthInPix                ' a one-character window: its only character has no gap after it
    tailWidthInPix := 0
    remainWindowPix := windowWidth
    endColumn := column
    hzInsetInPix := hzPixOffset

    ' for width of visible window
    repeat charIdx from 0 to maxCharIdx
        ' calc index of next char to display
        actCharIdx := textCharIdx(charIdx + startCharIdx)
        ' if we have only a trailing char left
        if remainWindowPix < charWidthInPix
            ' set char-to-paint width to size of remaining window width
            tailWidthInPix := remainWindowPix
            headWidthInPix := 0                         ' kill all head display

        ' before or after the text (a window wider than the text, or the end scrolling off) a
        ' character is a space; the buffer is never read outside the text
        cChar := SPACE_CHAR
        if actCharIdx >= 0 and actCharIdx < nCharsToScroll
            cChar := BYTE[@scrollChars][actCharIdx]
        ' get pointer to character bitmap
        pChrBitmap := fonts.getCharAddrForFont(selectedTextFont, cChar)
        ' if we've some character to show, then draw full or partial character
        if headWidthInPix > 0
            ' place full/partial first char
            endColumn := placeBitmapFrontAtRCWithColor(row, endColumn, hzInsetInPix, headWidthInPix, pChrBitmap, rgbColor)
            ' count this many pix placed
            remainWindowPix -= headWidthInPix
            ' form here on (until last char) we do full char width placements
            ' the window's last character has no gap after it (the gap would land outside the window)
            headWidthInPix := (charIdx + 1 == maxCharIdx) ? charWidthInPix : charWidthInPix + horizontalGapInPix
            hzInsetInPix := 0                           ' reset this to full char
        if tailWidthInPix > 0
            ' place partial last char
            endColumn := placeBitmapBackAtRCWithColor(row, endColumn, hzInsetInPix, tailWidthInPix, pChrBitmap, rgbColor)
            ' count this many pix placed
            remainWindowPix -= tailWidthInPix

PRI placeColrCharsVtOfstAtRC(row, column, vtPixOffset, rgbColor) | charIdx, endColumn, cChar, pChrBitmap
' Write character bitmaps to screen with vertical pixel offset for vertical scrolling.
'
' @param row - top row for character placement
' @param column - left column for character placement
' @param vtPixOffset - vertical pixel offset into the character: 0 to the character height, where the height is the black row between lines
' @param rgbColor - combined RGB color value

' Local Variables:
' @local charIdx - window character slot being placed
' @local endColumn - column position after last placed character
' @local cChar - the character being placed
' @local pChrBitmap - hub address of the character's bitmap

    endColumn := column

    ' for the window's characters and the partly visible one beside them
    repeat charIdx from 0 to maxVisibleChars + PARTIAL_CHARS_UP_DOWN - 1
        ' calc index of next char to display
        cChar := BYTE[@scrollChars][charIdx]
        ' if we are scrolling end of text off screen then chars beyond text are ' ' chars
        if charIdx > nCharsToScroll - 1
            cChar := SPACE_CHAR
        ' get pointer to character bitmap
        pChrBitmap := fonts.getCharAddrForFont(selectedTextFont, cChar)
        ' draw full character but vertical pixels rotated
        endColumn := placeColrBitmapVtOffsetAtRC(row, endColumn, vtPixOffset, pChrBitmap, rgbColor)

PRI isGlyphRun(rgbColor) : bRunRows
' Return TRUE when the glyph rows (and spaces) of a display-centric region are drawn as runs:
' FALSE for a face-centric region (its pixels fold one by one), for cRainbow, for a font wider
' than pixels.GLYPH_RUN_PIXELS, and while the instrument build's self-test draws its reference.
'
' @param rgbColor - combined RGB color value
' @returns bRunRows - TRUE to draw runs, FALSE to draw pixel by pixel

    bRunRows := eFaceHome == cube.NO_FACE and charWidthInPix <= pixels.GLYPH_RUN_PIXELS and pixels.isRunDrawable(rgbColor) == TRUE

PRI placeSpaceAtRC(row, column, widthInPix) : endColumn | colIdx, rowIdx, packedBlack
' Write blank pixels for inter-character spacing at the given position: on a display-centric
' region one column run per column (screenUtils fillColumnRun()).
'
' @param row - top row for the space
' @param column - left column for the space
' @param widthInPix - width of the space in pixels
' @returns endColumn - column position after the placed space

' Local Variables:
' @local colIdx - current column being drawn
' @local rowIdx - current row being drawn
' @local packedBlack - black's corrected bytes, packed

    ' an empty space keeps the pixel loop's behaviour exactly (a repeat from..to with to < from steps down)
    if widthInPix > 0 and isGlyphRun(color.CBLACK) == TRUE
        packedBlack := pixels.packedColorOf(chainIdx, color.CBLACK)
        ' the whole gap as one block when it lies inside one cell, else one column run per column
        if blitGlyph(row, column, widthInPix, 0, 0, pixels.NO_GLYPH, packedBlack, packedBlack, packedBlack) == FALSE
            repeat colIdx from column to widthInPix - 1 + column
                pixels.fillColumnRun(chainIdx, colIdx, row, charHeightInPix, packedBlack)
    else
        repeat colIdx from column to widthInPix - 1 + column
            ' the face/flat choice is made once per column, not per pixel
            if eFaceHome == cube.NO_FACE
                repeat rowIdx from row to charHeightInPix - 1 + row
                    pixels.drawPixelAtRC(chainIdx, rowIdx, colIdx, color.CBLACK)
            else
                repeat rowIdx from row to charHeightInPix - 1 + row
                    plotFacePixel(rowIdx, colIdx, color.CBLACK)

    endColumn := column + widthInPix

PRI placeBitmapFrontAtRCWithColor(row, column, bitInset, nFieldBits, pChrBitmap, rgbColor) : endColumn | cBitIdx, cByteIdx, cRowBits, pixColor, colOffset, pixColumn, pixRow, cBitOffset, nCharBits, nGapBits, pixVal, ditheredRGBColor, nBitsToSkip, bRunRows, packedFg, packedHalf, packedBlack, runColors[pixels.GLYPH_RUN_PIXELS], bDrawnAsBlock
' Draw the leading (front) portion of a character bitmap at the given position with color. On a
' display-centric region each glyph row is one run (screenUtils copyRowRun()).
'
' @param row - top row for bitmap placement
' @param column - left column for bitmap placement
' @param bitInset - number of bits to skip from the left edge of the character
' @param nFieldBits - total field width in bits including gap
' @param pChrBitmap - hub address of the character's bitmap
' @param rgbColor - combined RGB color value
' @returns endColumn - column position after the placed bitmap

' Local Variables:
' @local cBitIdx - current bit index within the character row
' @local cByteIdx - current byte/row index within the bitmap
' @local cRowBits - bitmap bits for the current row
' @local pixColor - resolved pixel color for the current pixel
' @local colOffset - column offset from the starting column
' @local pixColumn - absolute column of the current pixel
' @local pixRow - absolute row of the current pixel
' @local cBitOffset - computed bit offset for extracting pixel value
' @local nCharBits - number of actual character bits to draw (excluding gap)
' @local nGapBits - columns of gap after the character: none when the field holds only the character
' @local pixVal - extracted pixel value from dithered bitmap
' @local ditheredRGBColor - reduced brightness color for dithered pixels
' @local nBitsToSkip - character bits that fall left of the region's left edge and are not drawn
' @local bRunRows - TRUE when each glyph row is drawn as one run
' @local packedFg - the full-brightness color's corrected bytes, packed
' @local packedHalf - the reduced-brightness color's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed
' @local bDrawnAsBlock - TRUE when the whole glyph was drawn as one block (blitGlyph())
' @local runColors - one glyph row's packed colors, one LONG per pixel

    ' the field is the character's columns from bitInset, then the gap when there is room for it:
    ' the window's last character is given no gap, so its field holds only the character
    nCharBits := (nFieldBits > 0) ? nFieldBits <# (charWidthInPix - bitInset) : 0
    nGapBits := nFieldBits - nCharBits
    endColumn := column + nCharBits                                           ' point to gap locn
    ' dont paint beyond our left edge: the bits left of it are skipped once here, not tested per pixel
    nBitsToSkip := 0 #> (leftColumn - column)
    if nCharBits > 0 and nBitsToSkip < charWidthInPix
        bRunRows, packedFg, packedHalf, packedBlack, ditheredRGBColor := glyphSetup(rgbColor)
        ' the whole glyph as one block when it lies inside one cell, else row by row
        bDrawnAsBlock := FALSE
        if bRunRows == TRUE
            bDrawnAsBlock := blitGlyph(row, column + nBitsToSkip, charWidthInPix - nBitsToSkip, bitInset + nBitsToSkip, 0, pChrBitmap, packedFg, packedHalf, packedBlack)
        if bDrawnAsBlock == FALSE and bFontIsDithered == TRUE
            repeat cByteIdx from 0 to charHeightInPix - 1
                cRowBits := WORD[pChrBitmap][cByteIdx]
                pixRow := row + cByteIdx
                ' from right edge of char to left
                colOffset := nBitsToSkip
                repeat cBitIdx from bitInset + nBitsToSkip to bitInset + charWidthInPix - 1  ' 4-0, 4-1, 4-2, 4-3, 4-4
                    cBitOffset := cBitIdx * fonts.DITH_BITS_PER_PIX
                    pixVal := (cRowBits & (fonts.DITH_PIX_MASK >> cBitOffset)) >> (fonts.DITH_PIX_TOP_SHIFT - cBitOffset)
                    pixColor := rgbColor
                    if pixVal <> fonts.DITH_PIX_FULL
                        pixColor := (pixVal == fonts.DITH_PIX_HALF) ? ditheredRGBColor : color.CBLACK
                    pixColumn := column + colOffset
                    if bRunRows == TRUE
                        runColors[colOffset - nBitsToSkip] := ditheredPacked(pixVal, packedFg, packedHalf, packedBlack)
                    elseif eFaceHome == cube.NO_FACE
                        pixels.drawPixelAtRC(chainIdx, pixRow, pixColumn, pixColor)
                    else
                        plotFacePixel(pixRow, pixColumn, pixColor)
                    colOffset++
                if bRunRows == TRUE
                    pixels.copyRowRun(chainIdx, pixRow, column + nBitsToSkip, charWidthInPix - nBitsToSkip, @runColors)
        elseif bDrawnAsBlock == FALSE
            repeat cByteIdx from 0 to charHeightInPix - 1
                cRowBits := BYTE[pChrBitmap][cByteIdx]
                pixRow := row + cByteIdx
                ' from right edge of char to left
                colOffset := nBitsToSkip
                repeat cBitIdx from bitInset + nBitsToSkip to bitInset + charWidthInPix - 1  ' 4-0, 4-1, 4-2, 4-3, 4-4
                    cBitOffset := (charWidthInPix - 1) - cBitIdx
                    pixColor := cRowBits & (1 << cBitOffset) > 0 ? rgbColor : color.CBLACK
                    pixColumn := column + colOffset
                    if bRunRows == TRUE
                        runColors[colOffset - nBitsToSkip] := cRowBits & (1 << cBitOffset) > 0 ? packedFg : packedBlack
                    elseif eFaceHome == cube.NO_FACE
                        pixels.drawPixelAtRC(chainIdx, pixRow, pixColumn, pixColor)
                    else
                        plotFacePixel(pixRow, pixColumn, pixColor)
                    colOffset++
                if bRunRows == TRUE
                    pixels.copyRowRun(chainIdx, pixRow, column + nBitsToSkip, charWidthInPix - nBitsToSkip, @runColors)

    if nGapBits > 0
        ' place vert space after 1st char
        endColumn := placeSpaceAtRC(row, endColumn, nGapBits)

PRI placeBitmapBackAtRCWithColor(row, column, bitInset, nCharBits, pChrBitmap, rgbColor) : endColumn | cBitIdx, cByteIdx, cRowBits, pixColor, colOffset, pixColumn, pixRow, cBitOffset, pixVal, ditheredRGBColor, nBitsToDraw, bRunRows, packedFg, packedHalf, packedBlack, runColors[pixels.GLYPH_RUN_PIXELS], bDrawnAsBlock
' Draw the trailing (back) portion of a character bitmap at the given position with color. On a
' display-centric region each glyph row is one run (screenUtils copyRowRun()).
'
' @param row - top row for bitmap placement
' @param column - left column for bitmap placement
' @param bitInset - number of bits to skip from the left edge of the character
' @param nCharBits - number of character bits to draw
' @param pChrBitmap - hub address of the character's bitmap
' @param rgbColor - combined RGB color value
' @returns endColumn - column position after the placed bitmap

' Local Variables:
' @local cBitIdx - current bit index within the character row
' @local cByteIdx - current byte/row index within the bitmap
' @local cRowBits - bitmap bits for the current row
' @local pixColor - resolved pixel color for the current pixel
' @local colOffset - column offset from the starting column
' @local pixColumn - absolute column of the current pixel
' @local pixRow - absolute row of the current pixel
' @local cBitOffset - computed bit offset for extracting pixel value
' @local pixVal - extracted pixel value from dithered bitmap
' @local ditheredRGBColor - reduced brightness color for dithered pixels
' @local nBitsToDraw - character bits to draw: all of them, or on a display region those left of the display's right edge
' @local bRunRows - TRUE when each glyph row is drawn as one run
' @local packedFg - the full-brightness color's corrected bytes, packed
' @local packedHalf - the reduced-brightness color's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed
' @local bDrawnAsBlock - TRUE when the whole glyph was drawn as one block (blitGlyph())
' @local runColors - one glyph row's packed colors, one LONG per pixel

    endColumn := column + nCharBits
    ' dont paint off edge of matrix: a display region stops at the display's right edge, so the
    ' bit count is cut once here; a face region has no such edge (the cube folds its pixels)
    nBitsToDraw := nCharBits
    if eFaceHome == cube.NO_FACE
        nBitsToDraw := nCharBits <# (maxDisplayColumns - column)
    if nBitsToDraw > 0
        bRunRows, packedFg, packedHalf, packedBlack, ditheredRGBColor := glyphSetup(rgbColor)
        ' the whole glyph as one block when it lies inside one cell, else row by row
        bDrawnAsBlock := FALSE
        if bRunRows == TRUE
            bDrawnAsBlock := blitGlyph(row, column, nBitsToDraw, bitInset, 0, pChrBitmap, packedFg, packedHalf, packedBlack)
        if bDrawnAsBlock == FALSE and bFontIsDithered == TRUE
            repeat cByteIdx from 0 to charHeightInPix - 1
                cRowBits := WORD[pChrBitmap][cByteIdx]
                pixRow := row + cByteIdx
                ' from right edge of char to left
                colOffset := nCharBits - 1
                repeat cBitIdx from bitInset to bitInset + nBitsToDraw - 1     ' 4-0, 4-1, 4-2, 4-3, 4-4
                    cBitOffset := cBitIdx * fonts.DITH_BITS_PER_PIX
                    pixVal := (cRowBits & (fonts.DITH_PIX_MASK >> cBitOffset)) >> (fonts.DITH_PIX_TOP_SHIFT - cBitOffset)
                    pixColor := rgbColor
                    if pixVal <> fonts.DITH_PIX_FULL
                        pixColor := (pixVal == fonts.DITH_PIX_HALF) ? ditheredRGBColor : color.CBLACK
                    pixColumn := column + (nCharBits - 1) - colOffset
                    if bRunRows == TRUE
                        runColors[(nCharBits - 1) - colOffset] := ditheredPacked(pixVal, packedFg, packedHalf, packedBlack)
                    elseif eFaceHome == cube.NO_FACE
                        pixels.drawPixelAtRC(chainIdx, pixRow, pixColumn, pixColor)
                    else
                        plotFacePixel(pixRow, pixColumn, pixColor)
                    colOffset--
                if bRunRows == TRUE
                    pixels.copyRowRun(chainIdx, pixRow, column, nBitsToDraw, @runColors)
        elseif bDrawnAsBlock == FALSE
            repeat cByteIdx from 0 to charHeightInPix - 1
                cRowBits := BYTE[pChrBitmap][cByteIdx]
                pixRow := row + cByteIdx
                ' from right edge of char to left
                colOffset := nCharBits - 1
                repeat cBitIdx from bitInset to bitInset + nBitsToDraw - 1       ' 4-0, 4-1, 4-2, 4-3, 4-4
                    cBitOffset := (charWidthInPix - 1) - cBitIdx
                    pixColor := cRowBits & (1 << cBitOffset) > 0 ? rgbColor : color.CBLACK
                    pixColumn := column + (nCharBits - 1) - colOffset
                    if bRunRows == TRUE
                        runColors[(nCharBits - 1) - colOffset] := cRowBits & (1 << cBitOffset) > 0 ? packedFg : packedBlack
                    elseif eFaceHome == cube.NO_FACE
                        pixels.drawPixelAtRC(chainIdx, pixRow, pixColumn, pixColor)
                    else
                        plotFacePixel(pixRow, pixColumn, pixColor)
                    colOffset--
                if bRunRows == TRUE
                    pixels.copyRowRun(chainIdx, pixRow, column, nBitsToDraw, @runColors)

PRI placeColrBitmapVtOffsetAtRC(row, column, vtPixOffset, pChrBitmap, rgbColor) : endColumn | cBitIdx, rowIdx, cByteIdx, cRowBits, pixColor, pixRow, cBitOffset, colOffset, pixColumn, pixVal, ditheredRGBColor, nBitsToDraw, bRunRows, packedFg, packedHalf, packedBlack, runColors[pixels.GLYPH_RUN_PIXELS], bDrawnAsBlock
' Draw a character bitmap vertically offset by the given pixel amount, painting black for the extra row.
' On a display-centric region each glyph row is one run (screenUtils copyRowRun()).
'   special NOTE: show bitmap vertically offset by {vtPixOffset}
'   BUT!!!   vtPixOffset is 0-charHeight (meaning 1 more than rows of pixels)
'   for this extra row of pixels we paint black!
'
' @param row - top row for bitmap placement
' @param column - left column for bitmap placement
' @param vtPixOffset - vertical pixel offset into the character: 0 to the character height, where the height is the black row between lines
' @param pChrBitmap - hub address of the character's bitmap
' @param rgbColor - combined RGB color value
' @returns endColumn - column position after the placed bitmap

' Local Variables:
' @local cBitIdx - current bit index within the character row
' @local rowIdx - current row index in the drawing loop
' @local cByteIdx - computed byte index after applying vertical offset
' @local cRowBits - bitmap bits for the current row
' @local pixColor - resolved pixel color for the current pixel
' @local pixRow - absolute row of the current pixel
' @local cBitOffset - computed bit offset for extracting pixel value
' @local colOffset - column offset from the starting column
' @local pixColumn - absolute column of the current pixel
' @local pixVal - extracted pixel value from dithered bitmap
' @local ditheredRGBColor - reduced brightness color for dithered pixels
' @local nBitsToDraw - character bits to draw: all of them, or on a display region those left of the display's right edge
' @local bRunRows - TRUE when each glyph row is drawn as one run
' @local packedFg - the full-brightness color's corrected bytes, packed
' @local packedHalf - the reduced-brightness color's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed
' @local bDrawnAsBlock - TRUE when the whole glyph was drawn as one block (blitGlyph())
' @local runColors - one glyph row's packed colors, one LONG per pixel

    endColumn := column + charWidthInPix
    ' dont paint off edge of matrix: a display region stops at the display's right edge, so the
    ' bit count is cut once here; a face region has no such edge (the cube folds its pixels)
    nBitsToDraw := charWidthInPix
    if eFaceHome == cube.NO_FACE
        nBitsToDraw := charWidthInPix <# (maxDisplayColumns - column)
    if nBitsToDraw > 0
        bRunRows, packedFg, packedHalf, packedBlack, ditheredRGBColor := glyphSetup(rgbColor)
        ' the whole glyph as one block when it lies inside one cell, else row by row
        bDrawnAsBlock := FALSE
        if bRunRows == TRUE
            bDrawnAsBlock := blitGlyph(row, column, nBitsToDraw, 0, vtPixOffset, pChrBitmap, packedFg, packedHalf, packedBlack)
        if bDrawnAsBlock == FALSE and bFontIsDithered == TRUE
            repeat rowIdx from 0 to charHeightInPix - 1
                pixRow := row + rowIdx
                cByteIdx := (rowIdx + vtPixOffset) +// (charHeightInPix + pixels.GLYPH_BLANK_ROWS)  ' [0-(charHeight-1), and charHeight] where charHeight means black row of pixels
                if cByteIdx > charHeightInPix - 1
                    cRowBits := 0                                               ' no 1 bits (all BG color)
                else
                    cRowBits := WORD[pChrBitmap][cByteIdx]
                ' from right edge of char to left
                colOffset := charWidthInPix - 1
                repeat cBitIdx from 0 to nBitsToDraw - 1                       ' 4-0, 4-1, 4-2, 4-3, 4-4
                    cBitOffset := cBitIdx * fonts.DITH_BITS_PER_PIX
                    pixVal := (cRowBits & (fonts.DITH_PIX_MASK >> cBitOffset)) >> (fonts.DITH_PIX_TOP_SHIFT - cBitOffset)
                    pixColor := rgbColor
                    if pixVal <> fonts.DITH_PIX_FULL
                        pixColor := (pixVal == fonts.DITH_PIX_HALF) ? ditheredRGBColor : color.CBLACK
                    pixColumn := column + (charWidthInPix - 1) - colOffset
                    if bRunRows == TRUE
                        runColors[(charWidthInPix - 1) - colOffset] := ditheredPacked(pixVal, packedFg, packedHalf, packedBlack)
                    elseif eFaceHome == cube.NO_FACE
                        pixels.drawPixelAtRC(chainIdx, pixRow, pixColumn, pixColor)
                    else
                        plotFacePixel(pixRow, pixColumn, pixColor)
                    colOffset--
                if bRunRows == TRUE
                    pixels.copyRowRun(chainIdx, pixRow, column, nBitsToDraw, @runColors)
        elseif bDrawnAsBlock == FALSE
            repeat rowIdx from 0 to charHeightInPix - 1
                pixRow := row + rowIdx
                cByteIdx := (rowIdx + vtPixOffset) +// (charHeightInPix + pixels.GLYPH_BLANK_ROWS)  ' [0-(charHeight-1), and charHeight] where charHeight means black row of pixels
                if cByteIdx > charHeightInPix - 1
                    cRowBits := 0                                                 ' no 1 bits (all BG color)
                else
                    cRowBits := BYTE[pChrBitmap][cByteIdx]
                ' from right edge of char to left
                colOffset := charWidthInPix - 1
                repeat cBitIdx from 0 to nBitsToDraw - 1                         ' 4-0, 4-1, 4-2, 4-3, 4-4
                    cBitOffset := (charWidthInPix - 1) - cBitIdx
                    pixColor := cRowBits & (1 << cBitOffset) > 0 ? rgbColor : color.CBLACK
                    pixColumn := column + (charWidthInPix - 1) - colOffset
                    if bRunRows == TRUE
                        runColors[(charWidthInPix - 1) - colOffset] := cRowBits & (1 << cBitOffset) > 0 ? packedFg : packedBlack
                    elseif eFaceHome == cube.NO_FACE
                        pixels.drawPixelAtRC(chainIdx, pixRow, pixColumn, pixColor)
                    else
                        plotFacePixel(pixRow, pixColumn, pixColor)
                    colOffset--
                if bRunRows == TRUE
                    pixels.copyRowRun(chainIdx, pixRow, column, nBitsToDraw, @runColors)

PRI blitGlyph(row, column, nPixels, firstBit, vtPixOffset, pChrBitmap, packedFg, packedHalf, packedBlack) : bDrawn
' Draw this region's glyph (or gap) as one block when it lies on the display inside one cell
' (screenUtils copyGlyphBlock(), in this region's font). Returns FALSE, drawing nothing, otherwise.
'
' @param row - top row of the block, as mounted
' @param column - left column of the block, as mounted
' @param nPixels - pixels in each row of the block
' @param firstBit - bit index (from the glyph's left edge) of each row's first pixel
' @param vtPixOffset - vertical pixel offset into the character: 0 to the character height, where the height is the black row between lines
' @param pChrBitmap - hub address of the character's bitmap, or pixels.NO_GLYPH for a black gap
' @param packedFg - the full-brightness color's corrected bytes, packed
' @param packedHalf - the reduced-brightness color's corrected bytes, packed
' @param packedBlack - black's corrected bytes, packed
' @returns bDrawn - TRUE when the block was drawn

    bDrawn := pixels.copyGlyphBlock(chainIdx, row, column, charHeightInPix, nPixels, pChrBitmap, bFontIsDithered, charWidthInPix, firstBit, vtPixOffset, packedFg, packedHalf, packedBlack) == hwEnum.SUCCESS

PRI glyphSetup(rgbColor) : bRunRows, packedFg, packedHalf, packedBlack, ditheredRGBColor
' Prepare one character's glyph rows: the reduced-brightness color (dithered fonts only), whether
' the rows are drawn as runs (isGlyphRun()), and when they are, the packed corrected bytes of the
' full, reduced and black colors. The packed colors are 0 when the rows go pixel by pixel.
'
' @param rgbColor - combined RGB color value
' @returns bRunRows - TRUE when each glyph row is drawn as one run
' @returns packedFg - the full-brightness color's corrected bytes, packed
' @returns packedHalf - the reduced-brightness color's corrected bytes, packed (the full color's for other fonts)
' @returns packedBlack - black's corrected bytes, packed
' @returns ditheredRGBColor - reduced brightness color for dithered pixels (rgbColor for other fonts)

    packedFg := packedHalf := packedBlack := 0
    ditheredRGBColor := rgbColor
    if bFontIsDithered == TRUE
        ditheredRGBColor := colorUtils.reducedBrightnessOfCValue(rgbColor, DITHER_BRIGHTNESS_PCT)  ' dithered-pixel brightness
    bRunRows := isGlyphRun(rgbColor)
    if bRunRows == TRUE
        packedFg := pixels.packedColorOf(chainIdx, rgbColor)
        packedHalf := packedFg
        if bFontIsDithered == TRUE
            packedHalf := pixels.packedColorOf(chainIdx, ditheredRGBColor)
        packedBlack := pixels.packedColorOf(chainIdx, color.CBLACK)

PRI ditheredPacked(pixVal, packedFg, packedHalf, packedBlack) : packedColor
' Return the packed color of one dithered-font pixel from its 2-bit value: full, reduced or black,
' as the pixel-by-pixel step chooses rgbColor, ditheredRGBColor or color.CBLACK.
'
' @param pixVal - the pixel's 2-bit value from the dithered font
' @param packedFg - the full-brightness color's corrected bytes, packed
' @param packedHalf - the reduced-brightness color's corrected bytes, packed
' @param packedBlack - black's corrected bytes, packed
' @returns packedColor - the pixel's corrected bytes, packed

    packedColor := packedFg
    if pixVal <> fonts.DITH_PIX_FULL
        packedColor := (pixVal == fonts.DITH_PIX_HALF) ? packedHalf : packedBlack

