CON ' ---- Public constants ----
    {Spin2_Doc_CON}

    ' rainbow mapping: spread 360 degrees across 60 columns (6 deg/column)
    DEGREES_PER_COLUMN  = 6

    ' RGB channel byte offsets within a packed pixel triple
    RED_BYTE_OFST       = 0
    GREEN_BYTE_OFST     = 1
    BLUE_BYTE_OFST      = 2

CON ' ---- Packed colors and runs ----
    {Spin2_Doc_CON}

    ' A packed color (packedColorOf(), packedCorrectedRgb()) holds the three screen-buffer bytes
    ' of one pixel, already corrected: red in bits 0-7, green in bits 8-15, blue in bits 16-23.
    PACKED_GREEN_SHIFT  = 8
    PACKED_BLUE_SHIFT   = 16
    BYTES_PER_LONG_SHIFT = 2                     ' a color-list index -> its byte offset (one LONG per pixel)

    ' widest glyph row drawn as one run (the widest font is 8 pixels); a wider one goes pixel by pixel
    GLYPH_RUN_PIXELS    = 16

CON ' ---- Private run constants ----

    ' how a run walks the display (writeRun()):
    '  RUN_ALONG_ROW       - along a display row, as mounted; held to the display like each pixel
    '  RUN_DOWN_COLUMN     - down a display column, as mounted; held to the display like each pixel
    '  RUN_ALONG_LAYOUT_ROW - along a row of the display as its panels are laid out (rotation not
    '                        applied); a pixel outside the layout is not drawn
    #0, RUN_ALONG_ROW, RUN_DOWN_COLUMN, RUN_ALONG_LAYOUT_ROW

    ' the pixels of a run take one packed color, not one each from a list
    NO_COLOR_LIST       = 0

    ' a run of this many pixels is one pixel write, with no cell walk
    ONE_PIXEL           = 1

    ' copyRowRun() has a color list, so writeRun()'s single packed color is not used
    NO_PACKED_COLOR     = 0

    ' index in a color list of the run's first pixel
    FIRST_RUN_PIXEL     = 0

    ' fewest rows and columns a fillLayoutArea() rectangle needs to be filled by row runs
    MIN_RUN_PIXELS      = 1

OBJ ' ---- Objects used by this object ----

    color       : "isp_hub75_color"
    colorUtils  : "isp_hub75_colorUtils"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"

PUB null()
'' This is not a top level object
''

PUB drawPixelAtRC(nChainIdx, row, column, rgbColor) | xlatedColor
'' Place an rgbColor pixel at the specified row and column (display coordinates, as the
'' display is mounted).
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @param rgbColor - combined RGB color value

' Local Variables:
' @local xlatedColor - translated color after special-color handling

    xlatedColor := rgbColor
    if rgbColor == color.cRainbow
        xlatedColor := colorUtils.rgbColorFromDegrees(DEGREES_PER_COLUMN * (column + 1))             ' replace '360 / 64' with 6 [was resulting in 5 vs. 6]

    drawPixelAtRCwithRGB(nChainIdx, row, column, colorUtils.rgbForCValue(xlatedColor))

PUB drawPixelAtRCwithRGB(nChainIdx, row, column, red, green, blue) | pColor
'' Place an r,g,b color pixel at the specified row and column (display coordinates, as the
'' display is mounted). Pixel-by-pixel drawing reaches the screen buffer here, through the one
'' address rule, pixelAddressAtRC(): the pixel is held to the mounted size, display rotation is
'' applied, then the pixel goes through hub75Bffrs.displayPixelAddress(). A pixel in a cell of
'' the display's grid that holds no panel is not drawn.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @param red - red channel value
'' @param green - green channel value
'' @param blue - blue channel value

' Local Variables:
' @local pColor - pointer to the pixel within the screen buffer

    pColor := pixelAddressAtRC(nChainIdx, row, column)
    if pColor <> hub75Bffrs.NO_PIXEL
        BYTE[pColor][RED_BYTE_OFST] := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_RED, red)
        BYTE[pColor][GREEN_BYTE_OFST] := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_GREEN, green)
        BYTE[pColor][BLUE_BYTE_OFST] := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_BLUE, blue)

PUB pixelAddressAtRC(nChainIdx, row, column) : pPixel
'' Return the hub address of the pixel at the specified row and column (display coordinates, as
'' the display is mounted). This is the one address rule of the drawing path: the pixel is held
'' to the mounted size, then looked up in the cell address tables that hwBufferAccess builds at
'' startup from its one rule (display rotation, then hub75Bffrs.displayPixelAddress()).
'' drawPixelAtRCwithRGB() writes through it, and the run primitives (fillRowRun(),
'' fillColumnRun(), copyRowRun()) take each cell's start address and step from the same tables
'' (hub75Bffrs.mountedPixelRun()), so the rotation and arrow rules are written nowhere else.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @returns pPixel - hub address of the pixel's red byte, or hub75Bffrs.NO_PIXEL when no panel holds the pixel

    pPixel := hub75Bffrs.mountedPixelAddress(nChainIdx, row, column)
#IFDEF HUB75_CORRUPT_PIXEL_ADDRESS
  ' falsification build only: one pixel early (never before the buffer's start), so the
  ' self-test's address-rule comparison must report FAIL
  if pPixel <> hub75Bffrs.NO_PIXEL and pPixel > hub75Bffrs.displayBufferAddress(nChainIdx)
    pPixel -= hub75Bffrs.bytesPerColor(nChainIdx)
#ENDIF

PUB packedColorOf(nChainIdx, rgbColor) : packedColor
'' Return the packed screen-buffer bytes of a 24-bit color on the nChainIdx adapter: the color
'' split into red, green and blue and each corrected through the adapter's color table, the bytes
'' drawPixelAtRCwithRGB() writes (see PACKED_GREEN_SHIFT). The value is taken as a color as it
'' stands: cRainbow is not one color (its hue follows the column), so callers that honour it draw
'' it pixel by pixel through drawPixelAtRC().
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param rgbColor - combined RGB color value
'' @returns packedColor - the corrected red, green and blue bytes, packed

    packedColor := packedCorrectedRgb(nChainIdx, colorUtils.rgbForCValue(rgbColor))

PUB packedCorrectedRgb(nChainIdx, red, green, blue) : packedColor
'' Return the packed screen-buffer bytes of one r,g,b color on the nChainIdx adapter: each channel
'' corrected through the adapter's color table, as drawPixelAtRCwithRGB() corrects it.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param red - red channel value
'' @param green - green channel value
'' @param blue - blue channel value
'' @returns packedColor - the corrected red, green and blue bytes, packed

    packedColor := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_RED, red)
    packedColor |= colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_GREEN, green) << PACKED_GREEN_SHIFT
    packedColor |= colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_BLUE, blue) << PACKED_BLUE_SHIFT

PUB fillRowRun(nChainIdx, row, firstColumn, nColumns, packedColor)
'' Write one color along a run of one display row (display coordinates, as mounted): nColumns
'' pixels from firstColumn rightward. It writes exactly the bytes drawPixelAtRCwithRGB() would
'' write pixel by pixel, including at the edges: the row, and each end of the run, are held to the
'' mounted size as that method holds each pixel. The run is split where it crosses into the next
'' cell of the display's grid; in each cell the address of its first pixel and the step to the next
'' come from the one address rule, pixelAddressAtRC(), and the pixels are written with that step.
'' A cell that holds no panel is skipped. A run of one pixel is one pixel write.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param firstColumn - pixel column of the run's first (leftmost) pixel, as mounted
'' @param nColumns - number of pixels in the run (nothing is written when less than 1)
'' @param packedColor - the pixels' corrected bytes, packed (packedColorOf())

    writeRun(nChainIdx, row, firstColumn, nColumns, RUN_ALONG_ROW, NO_COLOR_LIST, packedColor)

PUB fillColumnRun(nChainIdx, column, firstRow, nRows, packedColor)
'' Write one color down a run of one display column (display coordinates, as mounted): nRows
'' pixels from firstRow downward. fillRowRun() with the axes exchanged: the same bytes as pixel by
'' pixel, the same hold to the display, one start address and step per cell.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param column - pixel column on the display, as mounted
'' @param firstRow - pixel row of the run's first (top) pixel, as mounted
'' @param nRows - number of pixels in the run (nothing is written when less than 1)
'' @param packedColor - the pixels' corrected bytes, packed (packedColorOf())

    writeRun(nChainIdx, firstRow, column, nRows, RUN_DOWN_COLUMN, NO_COLOR_LIST, packedColor)

PUB copyRowRun(nChainIdx, row, firstColumn, nColumns, pPackedColors)
'' Write a run of one display row (display coordinates, as mounted) whose pixels each have their
'' own color: nColumns pixels from firstColumn rightward, pixel i taking the packed color
'' LONG[pPackedColors][i]. A glyph row or an image row is one such run: one start address and step
'' per cell, as fillRowRun(). It writes exactly the bytes drawPixelAtRCwithRGB() would write
'' drawing the pixels left to right: off the display each pixel is held to the edge, so the edge
'' pixel ends with the color of the last pixel held onto it, and a row off the display is held to
'' the edge row.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param firstColumn - pixel column of the run's first (leftmost) pixel, as mounted
'' @param nColumns - number of pixels in the run (nothing is written when less than 1)
'' @param pPackedColors - hub address of nColumns LONGs: each pixel's corrected bytes, packed (packedColorOf())

    writeRun(nChainIdx, row, firstColumn, nColumns, RUN_ALONG_ROW, pPackedColors, NO_PACKED_COLOR)

PUB fillLayoutArea(nChainIdx, topRow, leftColumn, nRows, nColumns, rgbColor) | xlatedColor, red, green, blue, row, column, pColor, bByPixel, packedColor
'' Fill a rectangle of the display as its panels are laid out with rgbColor, skipping display
'' rotation. For work that does not depend on how the display is mounted, such as filling a
'' whole panel: callers locate a panel with hub75Bffrs.layoutAreaOfPanel(), which maps the
'' panel position as mounted to its layout rectangle. A pixel outside the layout, or in a cell
'' that holds no panel, is not drawn.
'' The rectangle is written row by row, each row one run (one start address and step per cell);
'' cRainbow, whose hue follows the layout column, is written pixel by pixel, column by column.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param topRow - layout row of the rectangle's top-left pixel (display rotation not applied)
'' @param leftColumn - layout column of the rectangle's top-left pixel
'' @param nRows - height of the rectangle in pixels
'' @param nColumns - width of the rectangle in pixels
'' @param rgbColor - combined RGB color value

' Local Variables:
' @local xlatedColor - translated color after special-color handling
' @local red - corrected red byte for the current column
' @local green - corrected green byte for the current column
' @local blue - corrected blue byte for the current column
' @local row - layout row being filled
' @local column - layout column being filled
' @local pColor - pointer to the pixel within the screen buffer
' @local bByPixel - TRUE to fill pixel by pixel (cRainbow, an empty rectangle, or the self-test's reference)
' @local packedColor - the fill color's corrected bytes, packed (row runs)

    ' an empty rectangle keeps the pixel loop's behaviour exactly (a repeat from..to with to < from steps down)
    bByPixel := rgbColor == color.cRainbow or nRows < MIN_RUN_PIXELS or nColumns < MIN_RUN_PIXELS
#IFDEF HUB75_INSTRUMENT
  if bPerPixelReference == TRUE
    bByPixel := TRUE
#ENDIF
  if bByPixel == FALSE
    packedColor := packedColorOf(nChainIdx, rgbColor)
    repeat row from topRow to topRow + nRows - 1
      writeRun(nChainIdx, row, leftColumn, nColumns, RUN_ALONG_LAYOUT_ROW, NO_COLOR_LIST, packedColor)
  else
    repeat column from leftColumn to leftColumn + nColumns - 1
      if column == leftColumn or rgbColor == color.cRainbow
        xlatedColor := rgbColor
        if rgbColor == color.cRainbow
          xlatedColor := colorUtils.rgbColorFromDegrees(DEGREES_PER_COLUMN * (column + 1))
        red, green, blue := colorUtils.rgbForCValue(xlatedColor)
        red := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_RED, red)
        green := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_GREEN, green)
        blue := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_BLUE, blue)
      repeat row from topRow to topRow + nRows - 1
        pColor := hub75Bffrs.displayPixelAddress(nChainIdx, row, column)
        if pColor <> hub75Bffrs.NO_PIXEL
          BYTE[pColor][RED_BYTE_OFST] := red
          BYTE[pColor][GREEN_BYTE_OFST] := green
          BYTE[pColor][BLUE_BYTE_OFST] := blue

PUB isRunDrawable(rgbColor) : bRun
'' Return TRUE when pixels of rgbColor may be drawn by runs: FALSE for cRainbow (its hue follows
'' the column, so drawPixelAtRC() draws it pixel by pixel) and, in the instrument build, while the
'' row-run self-test draws its pixel-by-pixel reference (setPerPixelReference()).
''
'' @param rgbColor - combined RGB color value
'' @returns bRun - TRUE to draw by runs, FALSE to draw pixel by pixel

    bRun := rgbColor <> color.cRainbow
#IFDEF HUB75_INSTRUMENT
  if bPerPixelReference == TRUE
    bRun := FALSE
#ENDIF

#IFDEF HUB75_INSTRUMENT
DAT ' ---- Row-run self-test switch (instrument build only) ----

    ' TRUE while the row-run self-test draws its reference image: every primitive that has a
    ' run form draws pixel by pixel instead. Shared by every screenUtils instance.
    bPerPixelReference  LONG    FALSE

PUB setPerPixelReference(bPerPixel)
'' Instrument build only: make every primitive that has a run form draw pixel by pixel (TRUE),
'' or by runs again (FALSE), so the row-run self-test can draw the same picture both ways and
'' compare the screen buffers.
''
'' @param bPerPixel - TRUE to draw pixel by pixel, FALSE to draw by runs

    bPerPixelReference := bPerPixel

PUB isPerPixelReference() : bPerPixel
'' Instrument build only: TRUE while the row-run self-test draws its pixel-by-pixel reference.
''
'' @returns bPerPixel - TRUE to draw pixel by pixel, FALSE to draw by runs

    bPerPixel := bPerPixelReference
#ENDIF

PRI writeRun(nChainIdx, row, column, nPixels, eRunMode, pColors, packedColor) | sizeRows, sizeColumns, cellRows, cellColumns, crossIdx, alongIdx, firstAlongIdx, lastAlongIdx, cellPixels, cellLastIdx, pPixel, stride, pixelColor, lastWrittenIdx
' Write a run of pixels: along a display row or down a display column as mounted, or along a row
' of the layout (eRunMode). The run is split at each cell boundary (a cell is one panel), and
' each cell's part is written with the start address and signed step that cellRunStart() takes
' from the one address rule. As mounted, the coordinate across the run and each end of the run
' are held to the display, as drawPixelAtRCwithRGB() holds each pixel; with a color list the last
' pixel written takes the color of the run's last pixel, which is the last held onto it. Along a
' layout row, pixels outside the layout are not drawn, as displayPixelAddress() does not draw
' them. A run of one pixel as mounted is one pixel write.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param row - pixel row of the run's first pixel
' @param column - pixel column of the run's first pixel
' @param nPixels - number of pixels in the run (nothing is written when less than 1)
' @param eRunMode - RUN_ALONG_ROW, RUN_DOWN_COLUMN or RUN_ALONG_LAYOUT_ROW
' @param pColors - hub address of one packed color per pixel, or NO_COLOR_LIST
' @param packedColor - the packed color of every pixel, when pColors is NO_COLOR_LIST

' Local Variables:
' @local sizeRows - total rows the run is held or clipped to
' @local sizeColumns - total columns the run is held or clipped to
' @local cellRows - pixel rows of one cell
' @local cellColumns - pixel columns of one cell
' @local crossIdx - the run's coordinate across its axis (its row, for a row run)
' @local alongIdx - the coordinate along the run of the next pixel to write
' @local firstAlongIdx - the coordinate along the run of its first pixel, before holding
' @local lastAlongIdx - the coordinate along the run of its last pixel written
' @local cellPixels - pixels of one cell along the run's axis
' @local cellLastIdx - the coordinate along the run of the last pixel in the current cell
' @local pPixel - pointer to the pixel being written, or NO_PIXEL for a cell with no panel
' @local stride - signed bytes from one pixel of the run to the next, within the current cell
' @local pixelColor - packed color of the pixel being written
' @local lastWrittenIdx - color-list index, before the replacement, of the last pixel written

    if nPixels == ONE_PIXEL and eRunMode <> RUN_ALONG_LAYOUT_ROW
        ' one pixel: the address rule holds it to the display; no cell walk
        pPixel := pixelAddressAtRC(nChainIdx, row, column)
        if pPixel <> hub75Bffrs.NO_PIXEL
            pixelColor := packedColor
            if pColors <> NO_COLOR_LIST
                pixelColor := LONG[pColors][FIRST_RUN_PIXEL]
            writePacked(pPixel, pixelColor)
    elseif nPixels > 0
        if eRunMode == RUN_ALONG_LAYOUT_ROW
            sizeRows, sizeColumns, _ := hub75Bffrs.layoutSizeAndRotation(nChainIdx)     ' the rotation is not needed here
            cellRows, cellColumns := hub75Bffrs.layoutCellSizeInPixels(nChainIdx)
            crossIdx := row
            firstAlongIdx := column
            alongIdx := 0 #> column
            lastAlongIdx := (column + nPixels - 1) <# sizeColumns - 1
            if row < 0 or row > sizeRows - 1
                lastAlongIdx := alongIdx - 1                    ' the row is outside the layout: nothing is drawn
            cellPixels := cellColumns
        else
            sizeRows, sizeColumns := hub75Bffrs.displaySizeInPixels(nChainIdx)
            cellRows, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
            if eRunMode == RUN_DOWN_COLUMN
                crossIdx := 0 #> column <# sizeColumns - 1
                firstAlongIdx := row
                alongIdx := 0 #> row <# sizeRows - 1
                lastAlongIdx := 0 #> (row + nPixels - 1) <# sizeRows - 1
                cellPixels := cellRows
            else
                crossIdx := 0 #> row <# sizeRows - 1
                firstAlongIdx := column
                alongIdx := 0 #> column <# sizeColumns - 1
                lastAlongIdx := 0 #> (column + nPixels - 1) <# sizeColumns - 1
                cellPixels := cellColumns
        ' the color-list index of the last pixel written (its color is replaced by the run's last)
        lastWrittenIdx := lastAlongIdx - firstAlongIdx
        repeat while alongIdx <= lastAlongIdx
            ' the last pixel of the run in this cell: the cell's last pixel, or the run's when sooner
            cellLastIdx := ((((alongIdx / cellPixels) + 1) * cellPixels) - 1) <# lastAlongIdx
            pPixel, stride := cellRunStart(nChainIdx, crossIdx, alongIdx, eRunMode, cellLastIdx > alongIdx)
            if pPixel <> hub75Bffrs.NO_PIXEL
                writeCellPart(pPixel, stride, cellLastIdx - alongIdx + 1, pColors, packedColor, alongIdx - firstAlongIdx, lastWrittenIdx, nPixels - 1)
            alongIdx := cellLastIdx + 1

PRI cellRunStart(nChainIdx, crossIdx, alongIdx, eRunMode, bNeedStride) : pPixel, stride | pNextPixel, rightStep, downStep
' Return where one cell's part of a run starts and how it steps: the address of its first pixel
' and the signed bytes to the next pixel along the run. As mounted both come from one lookup in
' the cell address tables (hub75Bffrs.mountedPixelRun(), built from the one address rule); along
' a layout row from two hub75Bffrs.displayPixelAddress() calls. So the display rotation, the
' panel's arrow and the buffer slot are applied by that rule and never restated. Within one cell the step is constant, because one cell is one panel and the panel's
' native coordinates follow its viewed coordinates by a fixed rotation: +3 or -3 bytes for a run
' along native rows, +/- native columns x 3 for a run along native columns.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param crossIdx - the run's coordinate across its axis
' @param alongIdx - the coordinate along the run of the cell part's first pixel
' @param eRunMode - RUN_ALONG_ROW, RUN_DOWN_COLUMN or RUN_ALONG_LAYOUT_ROW
' @param bNeedStride - TRUE when the cell part has more than one pixel
' @returns pPixel - hub address of the first pixel's red byte, or NO_PIXEL when the cell holds no panel
' @returns stride - signed bytes from one pixel of the run to the next (0 when not needed)

' Local Variables:
' @local pNextPixel - hub address of the second pixel of the cell part (along a layout row)
' @local rightStep - signed bytes to the pixel at the right, within the cell (as mounted)
' @local downStep - signed bytes to the pixel below, within the cell (as mounted)

    stride := 0
    if eRunMode == RUN_ALONG_LAYOUT_ROW
        pPixel := hub75Bffrs.displayPixelAddress(nChainIdx, crossIdx, alongIdx)
        if bNeedStride == TRUE and pPixel <> hub75Bffrs.NO_PIXEL
            pNextPixel := hub75Bffrs.displayPixelAddress(nChainIdx, crossIdx, alongIdx + 1)
            stride := pNextPixel - pPixel
    elseif eRunMode == RUN_DOWN_COLUMN
        ' one lookup gives the start and the step: the step down a column within the cell
        pPixel, _, downStep := hub75Bffrs.mountedPixelRun(nChainIdx, alongIdx, crossIdx)
        if bNeedStride == TRUE
            stride := downStep
    else
        pPixel, rightStep, _ := hub75Bffrs.mountedPixelRun(nChainIdx, crossIdx, alongIdx)
        if bNeedStride == TRUE
            stride := rightStep
#IFDEF HUB75_CORRUPT_ROW_RUN
    ' falsification build only: one byte short of the true step, so the row-run self-test must
    ' report FAIL (the writes stay inside the true run's span, so nothing outside it is touched)
    if stride > 0
      stride--
    else
      stride++
#ENDIF

PRI writeCellPart(pPixel, stride, nPixels, pColors, packedColor, colorIdx, lastWrittenIdx, lastColorIdx) | pixelColor, pByte, pColor
' Write one cell's part of a run, in PASM: nPixels pixels from pPixel, stride bytes apart, each
' three screen-buffer bytes from a packed color. With a color list, pixel i of the part takes
' LONG[pColors][colorIdx + i], except that from color-list index lastWrittenIdx on it takes
' LONG[pColors][lastColorIdx]: the last pixel written is the one every held pixel lands on, and
' it ends with the run's last color (see writeRun()).
'
' @param pPixel - hub address of the first pixel's red byte
' @param stride - signed bytes from one pixel to the next
' @param nPixels - pixels to write (at least one)
' @param pColors - hub address of the run's packed colors, or NO_COLOR_LIST
' @param packedColor - the packed color of every pixel, when pColors is NO_COLOR_LIST
' @param colorIdx - color-list index of the part's first pixel
' @param lastWrittenIdx - color-list index, before the replacement, of the run's last pixel written
' @param lastColorIdx - color-list index of the run's last pixel

' Local Variables:
' @local pixelColor - packed color of the pixel being written, shifted as each byte is written
' @local pByte - hub address of the byte being written
' @local pColor - hub address of the pixel's entry in the color list

    org
.nextPixel
                mov     pixelColor, packedColor
                tjz     pColors, #.writePixel
                cmps    colorIdx, lastWrittenIdx    wc
    if_nc       mov     colorIdx, lastColorIdx              ' the last pixel written takes the run's last color
                mov     pColor, colorIdx
                shl     pColor, #BYTES_PER_LONG_SHIFT
                add     pColor, pColors
                rdlong  pixelColor, pColor
                add     colorIdx, #1
.writePixel
                mov     pByte, pPixel
                add     pByte, #RED_BYTE_OFST
                wrbyte  pixelColor, pByte
                mov     pByte, pPixel
                add     pByte, #GREEN_BYTE_OFST
                shr     pixelColor, #PACKED_GREEN_SHIFT
                wrbyte  pixelColor, pByte
                mov     pByte, pPixel
                add     pByte, #BLUE_BYTE_OFST
                shr     pixelColor, #PACKED_BLUE_SHIFT - PACKED_GREEN_SHIFT
                wrbyte  pixelColor, pByte
                add     pPixel, stride
                djnz    nPixels, #.nextPixel
    end

PRI writePacked(pPixel, packedColor)
' Write one pixel's three screen-buffer bytes from a packed color.
'
' @param pPixel - hub address of the pixel's red byte
' @param packedColor - the pixel's corrected bytes, packed

    BYTE[pPixel][RED_BYTE_OFST] := packedColor
    BYTE[pPixel][GREEN_BYTE_OFST] := packedColor >> PACKED_GREEN_SHIFT
    BYTE[pPixel][BLUE_BYTE_OFST] := packedColor >> PACKED_BLUE_SHIFT

