CON ' ---- Public constants ----
    {Spin2_Doc_CON}

    ' rainbow mapping: spread 360 degrees across 60 columns (6 deg/column)
    DEGREES_PER_COLUMN  = 6

    ' RGB channel byte offsets within a packed pixel triple
    RED_BYTE_OFST       = 0
    GREEN_BYTE_OFST     = 1
    BLUE_BYTE_OFST      = 2

CON ' ---- Packed colors and runs ----
    {Spin2_Doc_CON}

    ' A packed color (packedColorOf(), packedCorrectedRgb()) holds the three screen-buffer bytes
    ' of one pixel, already corrected: red in bits 0-7, green in bits 8-15, blue in bits 16-23.
    PACKED_GREEN_SHIFT  = colorUtils.PACKED_GREEN_SHIFT
    PACKED_BLUE_SHIFT   = colorUtils.PACKED_BLUE_SHIFT
    BYTES_PER_LONG_SHIFT = 2                     ' a color-list index -> its byte offset (one LONG per pixel)

    ' copyGlyphBlock(): the glyph address that draws every pixel black (a gap), and the blank rows
    ' after a glyph's last row (the black row between lines when text scrolls up or down)
    NO_GLYPH            = 0
    GLYPH_BLANK_ROWS    = 1

    ' widest glyph row drawn as one run (the widest font is 8 pixels); a wider one goes pixel by pixel
    GLYPH_RUN_PIXELS    = 16

CON ' ---- Private run constants ----

    ' how a run walks the display (writeRun()):
    '  RUN_ALONG_ROW       - along a display row, as mounted; held to the display like each pixel
    '  RUN_DOWN_COLUMN     - down a display column, as mounted; held to the display like each pixel
    '  RUN_ALONG_LAYOUT_ROW - along a row of the display as its panels are laid out (rotation not
    '                        applied); a pixel outside the layout is not drawn
    #0, RUN_ALONG_ROW, RUN_DOWN_COLUMN, RUN_ALONG_LAYOUT_ROW

    ' the pixels of a run take one packed color, not one each from a list
    NO_COLOR_LIST       = 0

    ' a run of this many pixels is one pixel write, with no cell walk
    ONE_PIXEL           = 1

    ' copyRowRun() has a color list, so writeRun()'s single packed color is not used
    NO_PACKED_COLOR     = 0

    ' index in a color list of the run's first pixel
    FIRST_RUN_PIXEL     = 0

    ' fewest rows and columns a fillLayoutArea() rectangle needs to be filled by row runs
    MIN_RUN_PIXELS      = 1

OBJ ' ---- Objects used by this object ----

    color       : "isp_hub75_color"
    colorUtils  : "isp_hub75_colorUtils"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    fonts       : "isp_hub75_fonts"                                 ' the dithered pixel codec, for glyph blocks

PUB null()
'' This is not a top level object
''

PUB drawPixelAtRC(nChainIdx, row, column, rgbColor) | xlatedColor, pPixel
'' Place an rgbColor pixel at the specified row and column (display coordinates, as the
'' display is mounted).
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @param rgbColor - combined RGB color value

' Local Variables:
' @local xlatedColor - translated color after special-color handling
' @local pPixel - pointer to the pixel within the screen buffer

    xlatedColor := rgbColor
    if rgbColor == color.cRainbow
        xlatedColor := colorUtils.rgbColorFromDegrees(DEGREES_PER_COLUMN * (column + 1))             ' replace '360 / 64' with 6 [was resulting in 5 vs. 6]

    pPixel := pixelAddressAtRC(nChainIdx, row, column)
    if pPixel <> hub75Bffrs.NO_PIXEL
        writePacked(pPixel, colorUtils.packedCorrectedColor(nChainIdx, xlatedColor))
        hub75Bffrs.noteDrawn(nChainIdx, row, column, row, column)

PUB drawPixelAtRCwithRGB(nChainIdx, row, column, red, green, blue) | pColor
'' Place an r,g,b color pixel at the specified row and column (display coordinates, as the
'' display is mounted). Pixel-by-pixel drawing reaches the screen buffer here, through the one
'' address rule, pixelAddressAtRC(): the pixel is held to the mounted size, display rotation is
'' applied, then the pixel goes through hub75Bffrs.displayPixelAddress(). A pixel in a cell of
'' the display's grid that holds no panel is not drawn.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @param red - red channel value
'' @param green - green channel value
'' @param blue - blue channel value

' Local Variables:
' @local pColor - pointer to the pixel within the screen buffer

    pColor := pixelAddressAtRC(nChainIdx, row, column)
    if pColor <> hub75Bffrs.NO_PIXEL
        writePacked(pColor, colorUtils.packedCorrectedRgb(nChainIdx, red, green, blue))
        hub75Bffrs.noteDrawn(nChainIdx, row, column, row, column)

PUB pixelAddressAtRC(nChainIdx, row, column) : pPixel
'' Return the hub address of the pixel at the specified row and column (display coordinates, as
'' the display is mounted). This is the one address rule of the drawing path: the pixel is held
'' to the mounted size, then looked up in the cell address tables that hwBufferAccess builds at
'' startup from its one rule (display rotation, then hub75Bffrs.displayPixelAddress()).
'' drawPixelAtRCwithRGB() writes through it, and the run primitives (fillRowRun(),
'' fillColumnRun(), copyRowRun()) take each cell's start address and step from the same tables
'' (hub75Bffrs.mountedPixelRun()), so the rotation and arrow rules are written nowhere else.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @returns pPixel - hub address of the pixel's red byte, or hub75Bffrs.NO_PIXEL when no panel holds the pixel

    pPixel := hub75Bffrs.mountedPixelAddress(nChainIdx, row, column)
#IFDEF HUB75_CORRUPT_PIXEL_ADDRESS
  ' falsification build only: one pixel early (never before the buffer's start), so the
  ' self-test's address-rule comparison must report FAIL
  if pPixel <> hub75Bffrs.NO_PIXEL and pPixel > hub75Bffrs.displayBufferAddress(nChainIdx)
    pPixel -= hub75Bffrs.bytesPerColor(nChainIdx)
#ENDIF

PUB packedColorOf(nChainIdx, rgbColor) : packedColor
'' Return the packed screen-buffer bytes of a 24-bit color on the nChainIdx adapter: the color
'' split into red, green and blue and each corrected through the adapter's color table, the bytes
'' drawPixelAtRCwithRGB() writes (see PACKED_GREEN_SHIFT). The value is taken as a color as it
'' stands: cRainbow is not one color (its hue follows the column), so callers that honour it draw
'' it pixel by pixel through drawPixelAtRC().
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param rgbColor - combined RGB color value
'' @returns packedColor - the corrected red, green and blue bytes, packed

    packedColor := colorUtils.packedCorrectedColor(nChainIdx, rgbColor)

PUB packedCorrectedRgb(nChainIdx, red, green, blue) : packedColor
'' Return the packed screen-buffer bytes of one r,g,b color on the nChainIdx adapter: each channel
'' corrected through the adapter's color table, as drawPixelAtRCwithRGB() corrects it.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param red - red channel value
'' @param green - green channel value
'' @param blue - blue channel value
'' @returns packedColor - the corrected red, green and blue bytes, packed

    packedColor := colorUtils.packedCorrectedRgb(nChainIdx, red, green, blue)

PUB fillRowRun(nChainIdx, row, firstColumn, nColumns, packedColor)
'' Write one color along a run of one display row (display coordinates, as mounted): nColumns
'' pixels from firstColumn rightward. It writes exactly the bytes drawPixelAtRCwithRGB() would
'' write pixel by pixel, including at the edges: the row, and each end of the run, are held to the
'' mounted size as that method holds each pixel. The run is split where it crosses into the next
'' cell of the display's grid; in each cell the address of its first pixel and the step to the next
'' come from the one address rule, pixelAddressAtRC(), and the pixels are written with that step.
'' A cell that holds no panel is skipped. A run of one pixel is one pixel write.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param firstColumn - pixel column of the run's first (leftmost) pixel, as mounted
'' @param nColumns - number of pixels in the run (nothing is written when less than 1)
'' @param packedColor - the pixels' corrected bytes, packed (packedColorOf())

    writeRun(nChainIdx, row, firstColumn, nColumns, RUN_ALONG_ROW, NO_COLOR_LIST, packedColor)

PUB fillColumnRun(nChainIdx, column, firstRow, nRows, packedColor)
'' Write one color down a run of one display column (display coordinates, as mounted): nRows
'' pixels from firstRow downward. fillRowRun() with the axes exchanged: the same bytes as pixel by
'' pixel, the same hold to the display, one start address and step per cell.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param column - pixel column on the display, as mounted
'' @param firstRow - pixel row of the run's first (top) pixel, as mounted
'' @param nRows - number of pixels in the run (nothing is written when less than 1)
'' @param packedColor - the pixels' corrected bytes, packed (packedColorOf())

    writeRun(nChainIdx, firstRow, column, nRows, RUN_DOWN_COLUMN, NO_COLOR_LIST, packedColor)

PUB copyRowRun(nChainIdx, row, firstColumn, nColumns, pPackedColors)
'' Write a run of one display row (display coordinates, as mounted) whose pixels each have their
'' own color: nColumns pixels from firstColumn rightward, pixel i taking the packed color
'' LONG[pPackedColors][i]. A glyph row or an image row is one such run: one start address and step
'' per cell, as fillRowRun(). It writes exactly the bytes drawPixelAtRCwithRGB() would write
'' drawing the pixels left to right: off the display each pixel is held to the edge, so the edge
'' pixel ends with the color of the last pixel held onto it, and a row off the display is held to
'' the edge row.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param firstColumn - pixel column of the run's first (leftmost) pixel, as mounted
'' @param nColumns - number of pixels in the run (nothing is written when less than 1)
'' @param pPackedColors - hub address of nColumns LONGs: each pixel's corrected bytes, packed (packedColorOf())

    writeRun(nChainIdx, row, firstColumn, nColumns, RUN_ALONG_ROW, pPackedColors, NO_PACKED_COLOR)

PUB fillLayoutArea(nChainIdx, topRow, leftColumn, nRows, nColumns, rgbColor) | xlatedColor, red, green, blue, row, column, pColor, bByPixel, packedColor
'' Fill a rectangle of the display as its panels are laid out with rgbColor, skipping display
'' rotation. For work that does not depend on how the display is mounted, such as filling a
'' whole panel: callers locate a panel with hub75Bffrs.layoutAreaOfPanel(), which maps the
'' panel position as mounted to its layout rectangle. A pixel outside the layout, or in a cell
'' that holds no panel, is not drawn.
'' The rectangle is written row by row, each row one run (one start address and step per cell);
'' cRainbow, whose hue follows the layout column, is written pixel by pixel, column by column.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param topRow - layout row of the rectangle's top-left pixel (display rotation not applied)
'' @param leftColumn - layout column of the rectangle's top-left pixel
'' @param nRows - height of the rectangle in pixels
'' @param nColumns - width of the rectangle in pixels
'' @param rgbColor - combined RGB color value

' Local Variables:
' @local xlatedColor - translated color after special-color handling
' @local red - corrected red byte for the current column
' @local green - corrected green byte for the current column
' @local blue - corrected blue byte for the current column
' @local row - layout row being filled
' @local column - layout column being filled
' @local pColor - pointer to the pixel within the screen buffer
' @local bByPixel - TRUE to fill pixel by pixel (cRainbow, an empty rectangle, or the self-test's reference)
' @local packedColor - the fill color's corrected bytes, packed (row runs)

    hub75Bffrs.noteAllDrawn(nChainIdx)                                      ' layout coordinates: not placed as mounted
    ' an empty rectangle keeps the pixel loop's behaviour exactly (a repeat from..to with to < from steps down)
    bByPixel := rgbColor == color.cRainbow or nRows < MIN_RUN_PIXELS or nColumns < MIN_RUN_PIXELS
#IFDEF HUB75_INSTRUMENT
  if bPerPixelReference == TRUE
    bByPixel := TRUE
#ENDIF
  if bByPixel == FALSE
    packedColor := packedColorOf(nChainIdx, rgbColor)
    repeat row from topRow to topRow + nRows - 1
      writeRun(nChainIdx, row, leftColumn, nColumns, RUN_ALONG_LAYOUT_ROW, NO_COLOR_LIST, packedColor)
  else
    repeat column from leftColumn to leftColumn + nColumns - 1
      if column == leftColumn or rgbColor == color.cRainbow
        xlatedColor := rgbColor
        if rgbColor == color.cRainbow
          xlatedColor := colorUtils.rgbColorFromDegrees(DEGREES_PER_COLUMN * (column + 1))
        red, green, blue := colorUtils.rgbForCValue(xlatedColor)
        red := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_RED, red)
        green := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_GREEN, green)
        blue := colorUtils.correctedSingleColor(nChainIdx, colorUtils.LED_BLUE, blue)
      repeat row from topRow to topRow + nRows - 1
        pColor := hub75Bffrs.displayPixelAddress(nChainIdx, row, column)
        if pColor <> hub75Bffrs.NO_PIXEL
          BYTE[pColor][RED_BYTE_OFST] := red
          BYTE[pColor][GREEN_BYTE_OFST] := green
          BYTE[pColor][BLUE_BYTE_OFST] := blue

PUB copyGlyphBlock(nChainIdx, row, column, nRows, nPixels, pGlyph, bDithered, charWidth, firstBit, vtOffset, packedFg, packedHalf, packedBlack) : bDrawn
'' Draw a glyph as one block when the whole block lies on the display inside one cell
'' (hub75Bffrs.mountedBlockRun()): one address lookup, then all its rows in one PASM call. Block
'' row r shows glyph row (r + vtOffset) +// (nRows + GLYPH_BLANK_ROWS), the last of which is blank;
'' pixel i of a row shows bit firstBit + i, decided as the text paths decide it pixel by pixel (one
'' bit per pixel, or the dithered codec in fonts). pGlyph NO_GLYPH draws every pixel black. It
'' writes exactly the bytes the row-by-row path writes. Returns FALSE, drawing nothing, when the
'' block reaches past an edge or crosses a cell boundary; the caller then draws it row by row.
'' The same as copyGlyphRows() with as many block rows as glyph rows.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - top row of the block, as mounted
'' @param column - left column of the block, as mounted
'' @param nRows - glyph rows (the font's character height), and rows of the block
'' @param nPixels - pixels in each row of the block
'' @param pGlyph - hub address of the glyph's rows (BYTE rows, or WORD rows when dithered), or NO_GLYPH
'' @param bDithered - TRUE for a dithered font
'' @param charWidth - the font's character width in pixels
'' @param firstBit - bit index (from the glyph's left edge) of each row's first pixel
'' @param vtOffset - rows the glyph is turned up by (0 when not scrolling up or down)
'' @param packedFg - the full-brightness color's corrected bytes, packed
'' @param packedHalf - the reduced-brightness color's corrected bytes, packed (dithered fonts)
'' @param packedBlack - black's corrected bytes, packed
'' @returns bDrawn - TRUE when the block was drawn

    bDrawn := copyGlyphRows(nChainIdx, row, column, nRows, nPixels, pGlyph, bDithered, charWidth, nRows, firstBit, vtOffset, packedFg, packedHalf, packedBlack)

PUB copyGlyphRows(nChainIdx, row, column, nBlockRows, nPixels, pGlyph, bDithered, charWidth, nGlyphRows, firstBit, firstGlyphRow, packedFg, packedHalf, packedBlack) : bDrawn | pPixel, rightStep, downStep
'' Draw nBlockRows rows of a glyph as one block when the whole block lies on the display inside one
'' cell: block row r shows glyph row (r + firstGlyphRow) +// (nGlyphRows + GLYPH_BLANK_ROWS), the
'' last of which is blank, each pixel decided as copyGlyphBlock() decides it. A scrolling region
'' uses it to draw the one new row of a step. Returns FALSE, drawing nothing, when the block
'' reaches past an edge or crosses a cell boundary. The rows are written by one PASM call
'' (blitGlyphBlock()), which uses PR0-PR7 as scratch.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - top row of the block, as mounted
'' @param column - left column of the block, as mounted
'' @param nBlockRows - rows of the block
'' @param nPixels - pixels in each row of the block
'' @param pGlyph - hub address of the glyph's rows (BYTE rows, or WORD rows when dithered), or NO_GLYPH
'' @param bDithered - TRUE for a dithered font
'' @param charWidth - the font's character width in pixels
'' @param nGlyphRows - the font's character height
'' @param firstBit - bit index (from the glyph's left edge) of each row's first pixel
'' @param firstGlyphRow - glyph row shown in the block's first row (before the wrap)
'' @param packedFg - the full-brightness color's corrected bytes, packed
'' @param packedHalf - the reduced-brightness color's corrected bytes, packed (dithered fonts)
'' @param packedBlack - black's corrected bytes, packed
'' @returns bDrawn - TRUE when the block was drawn

' Local Variables:
' @local pPixel - hub address of the block's top-left pixel
' @local rightStep - signed bytes to the pixel at the right
' @local downStep - signed bytes to the pixel below

    pPixel, rightStep, downStep := hub75Bffrs.mountedBlockRun(nChainIdx, row, column, nBlockRows, nPixels)
    bDrawn := pPixel <> hub75Bffrs.NO_PIXEL
    if bDrawn == TRUE
        hub75Bffrs.noteDrawn(nChainIdx, row, column, row + nBlockRows - 1, column + nPixels - 1)
        blitGlyphBlock(pPixel, rightStep, downStep, nBlockRows, nPixels, pGlyph, bDithered, charWidth, firstBit, nGlyphRows, firstGlyphRow, packedFg, packedHalf, packedBlack)

PUB shiftRowLeft(nChainIdx, row, firstColumn, lastColumn) | cellColumns, column, cellEdge, nPixels, pPixel, rightStep
'' Move the pixels of one display row (display coordinates, as mounted) one place left: pixel c
'' takes pixel c + 1's bytes for c from firstColumn to lastColumn - 1; pixel lastColumn is left
'' as it was. Written cell by cell in PASM (copyPixels()); the pixel at a cell's right edge comes
'' from the next cell. The span must lie on panels of the display (hub75Bffrs.watchWindow()).
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - display row, as mounted
'' @param firstColumn - leftmost column of the span
'' @param lastColumn - rightmost column of the span

' Local Variables:
' @local cellColumns - pixel columns of one mounted cell
' @local column - column being written
' @local cellEdge - last column of the cell that holds column
' @local nPixels - pixels moved within that cell
' @local pPixel - hub address of the column's pixel
' @local rightStep - signed bytes to the pixel at the right, within the cell

    hub75Bffrs.noteDrawn(nChainIdx, row, firstColumn, row, lastColumn)
    _, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
    column := firstColumn
    repeat while column < lastColumn
        cellEdge := (((column / cellColumns) + 1) * cellColumns) - 1
        if cellEdge > column
            ' column .. (cellEdge or lastColumn) - 1 take their right neighbour in the same cell
            nPixels := (cellEdge <# lastColumn) - column
            pPixel, rightStep, _ := hub75Bffrs.mountedPixelRun(nChainIdx, row, column)
            copyPixels(pPixel + rightStep, rightStep, pPixel, rightStep, nPixels)
            column += nPixels
        else
            ' the cell's last column takes the next cell's first
            copyPixels(pixelAddressAtRC(nChainIdx, row, column + 1), 0, pixelAddressAtRC(nChainIdx, row, column), 0, ONE_PIXEL)
            column++

PUB shiftRowRight(nChainIdx, row, firstColumn, lastColumn) | cellColumns, column, cellEdge, nPixels, pPixel, rightStep
'' Move the pixels of one display row one place right: pixel c takes pixel c - 1's bytes for c
'' from lastColumn down to firstColumn + 1; pixel firstColumn is left as it was. As shiftRowLeft(),
'' mirrored.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - display row, as mounted
'' @param firstColumn - leftmost column of the span
'' @param lastColumn - rightmost column of the span

' Local Variables:
' @local cellColumns - pixel columns of one mounted cell
' @local column - column being written
' @local cellEdge - first column of the cell that holds column
' @local nPixels - pixels moved within that cell
' @local pPixel - hub address of the column's pixel
' @local rightStep - signed bytes to the pixel at the right, within the cell

    hub75Bffrs.noteDrawn(nChainIdx, row, firstColumn, row, lastColumn)
    _, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
    column := lastColumn
    repeat while column > firstColumn
        cellEdge := (column / cellColumns) * cellColumns
        if cellEdge < column
            ' column down to (cellEdge or firstColumn) + 1 take their left neighbour in the same cell
            nPixels := column - (cellEdge #> firstColumn)
            pPixel, rightStep, _ := hub75Bffrs.mountedPixelRun(nChainIdx, row, column)
            copyPixels(pPixel - rightStep, -rightStep, pPixel, -rightStep, nPixels)
            column -= nPixels
        else
            ' the cell's first column takes the previous cell's last
            copyPixels(pixelAddressAtRC(nChainIdx, row, column - 1), 0, pixelAddressAtRC(nChainIdx, row, column), 0, ONE_PIXEL)
            column--

PUB shiftRowsUp(nChainIdx, topRow, bottomRow, firstColumn, lastColumn) | row, cellColumns
'' Move a rectangle of the display one row up: row r takes row r + 1 for r from topRow to
'' bottomRow - 1, over columns firstColumn to lastColumn; row bottomRow is left as it was. The
'' rectangle must lie on panels of the display (hub75Bffrs.watchWindow()).
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param topRow - top row of the rectangle, as mounted
'' @param bottomRow - bottom row of the rectangle
'' @param firstColumn - left column of the rectangle
'' @param lastColumn - right column of the rectangle

' Local Variables:
' @local row - row being written
' @local cellColumns - pixel columns of one mounted cell

    hub75Bffrs.noteDrawn(nChainIdx, topRow, firstColumn, bottomRow, lastColumn)
    _, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
    if bottomRow > topRow                                                   ' a repeat from..to with to < from would step down
        repeat row from topRow to bottomRow - 1
            copyRowSpan(nChainIdx, cellColumns, row + 1, row, firstColumn, lastColumn)

PUB shiftRowsDown(nChainIdx, topRow, bottomRow, firstColumn, lastColumn) | row, cellColumns
'' Move a rectangle of the display one row down: row r takes row r - 1 for r from bottomRow down
'' to topRow + 1; row topRow is left as it was. As shiftRowsUp(), mirrored.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param topRow - top row of the rectangle, as mounted
'' @param bottomRow - bottom row of the rectangle
'' @param firstColumn - left column of the rectangle
'' @param lastColumn - right column of the rectangle

' Local Variables:
' @local row - row being written
' @local cellColumns - pixel columns of one mounted cell

    hub75Bffrs.noteDrawn(nChainIdx, topRow, firstColumn, bottomRow, lastColumn)
    _, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
    if bottomRow > topRow                                                   ' a repeat from..to with to > from would step up
        repeat row from bottomRow to topRow + 1
            copyRowSpan(nChainIdx, cellColumns, row - 1, row, firstColumn, lastColumn)

PUB fillMountedArea(nChainIdx, topRow, leftColumn, nRows, nColumns, packedColor) | sizeRows, sizeColumns, cellRows, cellColumns, blockTop, blockLeft, blockRows, blockColumns, pPixel, rightStep, downStep
'' Fill a rectangle of the display (display coordinates, as mounted) with one packed color: one
'' block per cell it covers, each from one address lookup (hub75Bffrs.mountedBlockRun()), its
'' rows written in PASM. The rectangle must lie on the display (callers hold or clip it first); a
'' cell that holds no panel is not drawn, as a run does not draw it. Nothing is drawn when the
'' rectangle is empty.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param topRow - display row of the rectangle's top-left pixel, as mounted
'' @param leftColumn - display column of the rectangle's top-left pixel, as mounted
'' @param nRows - height of the rectangle in pixels
'' @param nColumns - width of the rectangle in pixels
'' @param packedColor - the fill color's corrected bytes, packed (packedColorOf())

' Local Variables:
' @local sizeRows - display height, as mounted
' @local sizeColumns - display width, as mounted
' @local cellRows - pixel rows of one mounted cell
' @local cellColumns - pixel columns of one mounted cell
' @local blockTop - top row of the block in the current cell
' @local blockLeft - left column of the block in the current cell
' @local blockRows - rows of the block in the current cell
' @local blockColumns - columns of the block in the current cell
' @local pPixel - hub address of the block's top-left pixel, or NO_PIXEL for a cell with no panel
' @local rightStep - signed bytes to the pixel at the right
' @local downStep - signed bytes to the pixel below

    sizeRows, sizeColumns := hub75Bffrs.displaySizeInPixels(nChainIdx)
    cellRows, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
    if nRows > 0 and nColumns > 0 and topRow >= 0 and leftColumn >= 0 and topRow + nRows <= sizeRows and leftColumn + nColumns <= sizeColumns
        hub75Bffrs.noteDrawn(nChainIdx, topRow, leftColumn, topRow + nRows - 1, leftColumn + nColumns - 1)
        blockTop := topRow
        repeat while blockTop < topRow + nRows
            ' rows from blockTop to the end of its cell, or of the rectangle when sooner
            blockRows := ((((blockTop / cellRows) + 1) * cellRows) <# (topRow + nRows)) - blockTop
            blockLeft := leftColumn
            repeat while blockLeft < leftColumn + nColumns
                blockColumns := ((((blockLeft / cellColumns) + 1) * cellColumns) <# (leftColumn + nColumns)) - blockLeft
                pPixel, rightStep, downStep := hub75Bffrs.mountedBlockRun(nChainIdx, blockTop, blockLeft, blockRows, blockColumns)
                if pPixel <> hub75Bffrs.NO_PIXEL
                    fillBlock(pPixel, rightStep, downStep, blockRows, blockColumns, packedColor)
                blockLeft += blockColumns
            blockTop += blockRows

PUB plotPacked(pContext, row, column, packedColor) | ctxRows, ctxColumns, ctxCellRows, ctxCellColumns, ctxGridColumns, ctxOffsets, ctxRightSteps, ctxDownSteps, ctxBuffer
'' Write one pixel in one packed color, in PASM, through a plot context (hub75Bffrs.plotContext()):
'' the pixel is held to the display as mounted, then its address comes from the cell address
'' tables, exactly as pixelAddressAtRC() gives it; a pixel in a cell with no panel is not drawn.
'' For shapes drawn pixel by pixel in one color (lines, circles): take the context and the packed
'' color once per shape. PR0-PR7 are scratch.
''
'' @param pContext - hub address of a filled plot context (hub75Bffrs.PLOT_CONTEXT_LONGS LONGs)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @param packedColor - the pixel's corrected bytes, packed (packedColorOf())

' Local Variables:
' @local ctxRows - display rows, as mounted (read from the context, as are the rest)
' @local ctxColumns - display columns, as mounted
' @local ctxCellRows - pixel rows of one mounted cell
' @local ctxCellColumns - pixel columns of one mounted cell
' @local ctxGridColumns - cells across the mounted grid
' @local ctxOffsets - this adapter's cell offset table
' @local ctxRightSteps - this adapter's right step table
' @local ctxDownSteps - this adapter's down step table
' @local ctxBuffer - the screen buffer address

    org
                setq    #hub75Bffrs.PLOT_CONTEXT_LONGS - 1
                rdlong  ctxRows, pContext                   ' the whole context, in PLOT_CTX_* order
                ' hold the pixel to the display, as mountedPixelAddress() holds it
                fges    row, #0
                mov     pr0, ctxRows
                sub     pr0, #1
                fles    row, pr0
                fges    column, #0
                mov     pr0, ctxColumns
                sub     pr0, #1
                fles    column, pr0
                ' its cell, and its row and column within the cell
                qdiv    row, ctxCellRows
                getqx   pr1                                 ' cell row
                getqy   pr2                                 ' row within the cell
                qdiv    column, ctxCellColumns
                getqx   pr3                                 ' cell column
                getqy   pr4                                 ' column within the cell
                mul     pr1, ctxGridColumns
                add     pr1, pr3
                shl     pr1, #BYTES_PER_LONG_SHIFT          ' the cell's entry, in bytes
                mov     pr3, ctxOffsets
                add     pr3, pr1
                rdlong  pr5, pr3                            ' the cell's offset
                cmps    pr5, #0                     wc
    if_c        jmp     #.noPanel                           ' NO_CELL_OFFSET: no panel holds the pixel
                mov     pr3, ctxDownSteps
                add     pr3, pr1
                rdlong  pr6, pr3
                mov     pr3, ctxRightSteps
                add     pr3, pr1
                rdlong  pr7, pr3
                muls    pr2, pr6                            ' row within the cell x down step
                muls    pr4, pr7                            ' column within the cell x right step
                add     pr5, ctxBuffer
                add     pr5, pr2
                add     pr5, pr4                            ' the pixel's red byte
                mov     pr0, packedColor
                mov     pr3, pr5
                add     pr3, #RED_BYTE_OFST
                wrbyte  pr0, pr3
                mov     pr3, pr5
                add     pr3, #GREEN_BYTE_OFST
                shr     pr0, #PACKED_GREEN_SHIFT
                wrbyte  pr0, pr3
                mov     pr3, pr5
                add     pr3, #BLUE_BYTE_OFST
                shr     pr0, #PACKED_BLUE_SHIFT - PACKED_GREEN_SHIFT
                wrbyte  pr0, pr3
.noPanel
    end

PUB isRunDrawable(rgbColor) : bRun
'' Return TRUE when pixels of rgbColor may be drawn by runs: FALSE for cRainbow (its hue follows
'' the column, so drawPixelAtRC() draws it pixel by pixel) and, in the instrument build, while the
'' row-run self-test draws its pixel-by-pixel reference (setPerPixelReference()).
''
'' @param rgbColor - combined RGB color value
'' @returns bRun - TRUE to draw by runs, FALSE to draw pixel by pixel

    bRun := rgbColor <> color.cRainbow
#IFDEF HUB75_INSTRUMENT
  if bPerPixelReference == TRUE
    bRun := FALSE
#ENDIF

#IFDEF HUB75_INSTRUMENT
DAT ' ---- Row-run self-test switch (instrument build only) ----

    ' TRUE while the row-run self-test draws its reference image: every primitive that has a
    ' run form draws pixel by pixel instead. Shared by every screenUtils instance.
    bPerPixelReference  LONG    FALSE

PUB setPerPixelReference(bPerPixel)
'' Instrument build only: make every primitive that has a run form draw pixel by pixel (TRUE),
'' or by runs again (FALSE), so the row-run self-test can draw the same picture both ways and
'' compare the screen buffers.
''
'' @param bPerPixel - TRUE to draw pixel by pixel, FALSE to draw by runs

    bPerPixelReference := bPerPixel

PUB isPerPixelReference() : bPerPixel
'' Instrument build only: TRUE while the row-run self-test draws its pixel-by-pixel reference.
''
'' @returns bPerPixel - TRUE to draw pixel by pixel, FALSE to draw by runs

    bPerPixel := bPerPixelReference
#ENDIF

PRI writeRun(nChainIdx, row, column, nPixels, eRunMode, pColors, packedColor) | sizeRows, sizeColumns, cellRows, cellColumns, crossIdx, alongIdx, firstAlongIdx, lastAlongIdx, cellPixels, cellLastIdx, pPixel, stride, pixelColor, lastWrittenIdx
' Write a run of pixels: along a display row or down a display column as mounted, or along a row
' of the layout (eRunMode). The run is split at each cell boundary (a cell is one panel), and
' each cell's part is written with the start address and signed step that cellRunStart() takes
' from the one address rule. As mounted, the coordinate across the run and each end of the run
' are held to the display, as drawPixelAtRCwithRGB() holds each pixel; with a color list the last
' pixel written takes the color of the run's last pixel, which is the last held onto it. Along a
' layout row, pixels outside the layout are not drawn, as displayPixelAddress() does not draw
' them. A run of one pixel as mounted is one pixel write.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param row - pixel row of the run's first pixel
' @param column - pixel column of the run's first pixel
' @param nPixels - number of pixels in the run (nothing is written when less than 1)
' @param eRunMode - RUN_ALONG_ROW, RUN_DOWN_COLUMN or RUN_ALONG_LAYOUT_ROW
' @param pColors - hub address of one packed color per pixel, or NO_COLOR_LIST
' @param packedColor - the packed color of every pixel, when pColors is NO_COLOR_LIST

' Local Variables:
' @local sizeRows - total rows the run is held or clipped to
' @local sizeColumns - total columns the run is held or clipped to
' @local cellRows - pixel rows of one cell
' @local cellColumns - pixel columns of one cell
' @local crossIdx - the run's coordinate across its axis (its row, for a row run)
' @local alongIdx - the coordinate along the run of the next pixel to write
' @local firstAlongIdx - the coordinate along the run of its first pixel, before holding
' @local lastAlongIdx - the coordinate along the run of its last pixel written
' @local cellPixels - pixels of one cell along the run's axis
' @local cellLastIdx - the coordinate along the run of the last pixel in the current cell
' @local pPixel - pointer to the pixel being written, or NO_PIXEL for a cell with no panel
' @local stride - signed bytes from one pixel of the run to the next, within the current cell
' @local pixelColor - packed color of the pixel being written
' @local lastWrittenIdx - color-list index, before the replacement, of the last pixel written

    ' tell the window watch what this run writes (held to the display there, as the run is held here)
    if nPixels > 0
        if eRunMode == RUN_ALONG_LAYOUT_ROW
            hub75Bffrs.noteAllDrawn(nChainIdx)                              ' layout coordinates: not placed as mounted
        elseif eRunMode == RUN_DOWN_COLUMN
            hub75Bffrs.noteDrawn(nChainIdx, row, column, row + nPixels - 1, column)
        else
            hub75Bffrs.noteDrawn(nChainIdx, row, column, row, column + nPixels - 1)
    if nPixels == ONE_PIXEL and eRunMode <> RUN_ALONG_LAYOUT_ROW
        ' one pixel: the address rule holds it to the display; no cell walk
        pPixel := pixelAddressAtRC(nChainIdx, row, column)
        if pPixel <> hub75Bffrs.NO_PIXEL
            pixelColor := packedColor
            if pColors <> NO_COLOR_LIST
                pixelColor := LONG[pColors][FIRST_RUN_PIXEL]
            writePacked(pPixel, pixelColor)
    elseif nPixels > 0
        if eRunMode == RUN_ALONG_LAYOUT_ROW
            sizeRows, sizeColumns, _ := hub75Bffrs.layoutSizeAndRotation(nChainIdx)     ' the rotation is not needed here
            cellRows, cellColumns := hub75Bffrs.layoutCellSizeInPixels(nChainIdx)
            crossIdx := row
            firstAlongIdx := column
            alongIdx := 0 #> column
            lastAlongIdx := (column + nPixels - 1) <# sizeColumns - 1
            if row < 0 or row > sizeRows - 1
                lastAlongIdx := alongIdx - 1                    ' the row is outside the layout: nothing is drawn
            cellPixels := cellColumns
        else
            sizeRows, sizeColumns := hub75Bffrs.displaySizeInPixels(nChainIdx)
            cellRows, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIdx)
            if eRunMode == RUN_DOWN_COLUMN
                crossIdx := 0 #> column <# sizeColumns - 1
                firstAlongIdx := row
                alongIdx := 0 #> row <# sizeRows - 1
                lastAlongIdx := 0 #> (row + nPixels - 1) <# sizeRows - 1
                cellPixels := cellRows
            else
                crossIdx := 0 #> row <# sizeRows - 1
                firstAlongIdx := column
                alongIdx := 0 #> column <# sizeColumns - 1
                lastAlongIdx := 0 #> (column + nPixels - 1) <# sizeColumns - 1
                cellPixels := cellColumns
        ' the color-list index of the last pixel written (its color is replaced by the run's last)
        lastWrittenIdx := lastAlongIdx - firstAlongIdx
        repeat while alongIdx <= lastAlongIdx
            ' the last pixel of the run in this cell: the cell's last pixel, or the run's when sooner
            cellLastIdx := ((((alongIdx / cellPixels) + 1) * cellPixels) - 1) <# lastAlongIdx
            pPixel, stride := cellRunStart(nChainIdx, crossIdx, alongIdx, eRunMode, cellLastIdx > alongIdx)
            if pPixel <> hub75Bffrs.NO_PIXEL
                writeCellPart(pPixel, stride, cellLastIdx - alongIdx + 1, pColors, packedColor, alongIdx - firstAlongIdx, lastWrittenIdx, nPixels - 1)
            alongIdx := cellLastIdx + 1

PRI cellRunStart(nChainIdx, crossIdx, alongIdx, eRunMode, bNeedStride) : pPixel, stride | pNextPixel, rightStep, downStep
' Return where one cell's part of a run starts and how it steps: the address of its first pixel
' and the signed bytes to the next pixel along the run. As mounted both come from one lookup in
' the cell address tables (hub75Bffrs.mountedPixelRun(), built from the one address rule); along
' a layout row from two hub75Bffrs.displayPixelAddress() calls. So the display rotation, the
' panel's arrow and the buffer slot are applied by that rule and never restated. Within one cell the step is constant, because one cell is one panel and the panel's
' native coordinates follow its viewed coordinates by a fixed rotation: +3 or -3 bytes for a run
' along native rows, +/- native columns x 3 for a run along native columns.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param crossIdx - the run's coordinate across its axis
' @param alongIdx - the coordinate along the run of the cell part's first pixel
' @param eRunMode - RUN_ALONG_ROW, RUN_DOWN_COLUMN or RUN_ALONG_LAYOUT_ROW
' @param bNeedStride - TRUE when the cell part has more than one pixel
' @returns pPixel - hub address of the first pixel's red byte, or NO_PIXEL when the cell holds no panel
' @returns stride - signed bytes from one pixel of the run to the next (0 when not needed)

' Local Variables:
' @local pNextPixel - hub address of the second pixel of the cell part (along a layout row)
' @local rightStep - signed bytes to the pixel at the right, within the cell (as mounted)
' @local downStep - signed bytes to the pixel below, within the cell (as mounted)

    stride := 0
    if eRunMode == RUN_ALONG_LAYOUT_ROW
        pPixel := hub75Bffrs.displayPixelAddress(nChainIdx, crossIdx, alongIdx)
        if bNeedStride == TRUE and pPixel <> hub75Bffrs.NO_PIXEL
            pNextPixel := hub75Bffrs.displayPixelAddress(nChainIdx, crossIdx, alongIdx + 1)
            stride := pNextPixel - pPixel
    elseif eRunMode == RUN_DOWN_COLUMN
        ' one lookup gives the start and the step: the step down a column within the cell
        pPixel, _, downStep := hub75Bffrs.mountedPixelRun(nChainIdx, alongIdx, crossIdx)
        if bNeedStride == TRUE
            stride := downStep
    else
        pPixel, rightStep, _ := hub75Bffrs.mountedPixelRun(nChainIdx, crossIdx, alongIdx)
        if bNeedStride == TRUE
            stride := rightStep
#IFDEF HUB75_CORRUPT_ROW_RUN
    ' falsification build only: one byte short of the true step, so the row-run self-test must
    ' report FAIL (the writes stay inside the true run's span, so nothing outside it is touched)
    if stride > 0
      stride--
    else
      stride++
#ENDIF

PRI writeCellPart(pPixel, stride, nPixels, pColors, packedColor, colorIdx, lastWrittenIdx, lastColorIdx) | pixelColor, pByte, pColor
' Write one cell's part of a run, in PASM: nPixels pixels from pPixel, stride bytes apart, each
' three screen-buffer bytes from a packed color. With a color list, pixel i of the part takes
' LONG[pColors][colorIdx + i], except that from color-list index lastWrittenIdx on it takes
' LONG[pColors][lastColorIdx]: the last pixel written is the one every held pixel lands on, and
' it ends with the run's last color (see writeRun()).
'
' @param pPixel - hub address of the first pixel's red byte
' @param stride - signed bytes from one pixel to the next
' @param nPixels - pixels to write (at least one)
' @param pColors - hub address of the run's packed colors, or NO_COLOR_LIST
' @param packedColor - the packed color of every pixel, when pColors is NO_COLOR_LIST
' @param colorIdx - color-list index of the part's first pixel
' @param lastWrittenIdx - color-list index, before the replacement, of the run's last pixel written
' @param lastColorIdx - color-list index of the run's last pixel

' Local Variables:
' @local pixelColor - packed color of the pixel being written, shifted as each byte is written
' @local pByte - hub address of the byte being written
' @local pColor - hub address of the pixel's entry in the color list

    org
.nextPixel
                mov     pixelColor, packedColor
                tjz     pColors, #.writePixel
                cmps    colorIdx, lastWrittenIdx    wc
    if_nc       mov     colorIdx, lastColorIdx              ' the last pixel written takes the run's last color
                mov     pColor, colorIdx
                shl     pColor, #BYTES_PER_LONG_SHIFT
                add     pColor, pColors
                rdlong  pixelColor, pColor
                add     colorIdx, #1
.writePixel
                mov     pByte, pPixel
                add     pByte, #RED_BYTE_OFST
                wrbyte  pixelColor, pByte
                mov     pByte, pPixel
                add     pByte, #GREEN_BYTE_OFST
                shr     pixelColor, #PACKED_GREEN_SHIFT
                wrbyte  pixelColor, pByte
                mov     pByte, pPixel
                add     pByte, #BLUE_BYTE_OFST
                shr     pixelColor, #PACKED_BLUE_SHIFT - PACKED_GREEN_SHIFT
                wrbyte  pixelColor, pByte
                add     pPixel, stride
                djnz    nPixels, #.nextPixel
    end

PRI blitGlyphBlock(pPixel, rightStep, downStep, nBlockRows, nPixels, pGlyph, bDithered, charWidth, firstBit, nGlyphRows, firstGlyphRow, packedFg, packedHalf, packedBlack) | rowIdx, glyphRow
' Write a glyph block, in PASM: nBlockRows rows from pPixel, downStep bytes apart, each of nPixels
' pixels rightStep bytes apart. Row r shows glyph row (r + firstGlyphRow) // (nGlyphRows + GLYPH_BLANK_ROWS),
' 0 bits for the blank row or for NO_GLYPH; pixel i shows bit firstBit + i as the row-by-row path
' decides it. One bit per pixel: bit (charWidth - 1 - index), held to its low five bits as
' Spin2's << holds a shift, set means packedFg. Dithered (two bits per pixel from the top): value
' DITH_PIX_FULL is packedFg, DITH_PIX_HALF packedHalf, any other packedBlack, and a pixel past the
' row's sixteen bits is packedBlack. PR0-PR7 are scratch.
'
' @param pPixel - hub address of the top-left pixel's red byte
' @param rightStep - signed bytes from one pixel to the next along a row
' @param downStep - signed bytes from one row to the next
' @param nBlockRows - rows of the block (at least one)
' @param nPixels - pixels in each row (at least one)
' @param pGlyph - hub address of the glyph's rows, or NO_GLYPH
' @param bDithered - TRUE for a dithered font (WORD rows)
' @param charWidth - the font's character width in pixels
' @param firstBit - bit index (from the glyph's left edge) of each row's first pixel
' @param nGlyphRows - the font's character height
' @param firstGlyphRow - glyph row shown in the block's first row (before the wrap)
' @param packedFg - the full-brightness color's corrected bytes, packed
' @param packedHalf - the reduced-brightness color's corrected bytes, packed
' @param packedBlack - black's corrected bytes, packed

' Local Variables:
' @local rowIdx - block row being drawn
' @local glyphRow - glyph row shown in that block row

    rowIdx := 0
    org
.nextRow
                ' which glyph row this block row shows (the last of the period is blank)
                mov     glyphRow, rowIdx
                add     glyphRow, firstGlyphRow
                mov     pr0, nGlyphRows
                add     pr0, #GLYPH_BLANK_ROWS
                qdiv    glyphRow, pr0
                getqy   glyphRow
                mov     pr4, #0                             ' row bits: 0 for the blank row or a gap
                tjz     pGlyph, #.haveRowBits
                cmp     glyphRow, nGlyphRows        wc
    if_nc       jmp     #.haveRowBits
                mov     pr0, pGlyph
                tjz     bDithered, #.byteRow
                add     pr0, glyphRow
                add     pr0, glyphRow                       ' a dithered row is one WORD
                rdword  pr4, pr0
                jmp     #.haveRowBits
.byteRow
                add     pr0, glyphRow
                rdbyte  pr4, pr0
.haveRowBits
                mov     pr5, pPixel                         ' the row's pixel
                mov     pr6, nPixels                        ' pixels left in the row
                mov     pr7, firstBit                       ' the pixel's bit index
.nextPixel
                mov     pr1, packedBlack
                tjnz    bDithered, #.ditheredPixel
                mov     pr3, charWidth
                sub     pr3, #1
                sub     pr3, pr7
                testb   pr4, pr3                    wc      ' TESTB reads the bit number's low five bits
    if_c        mov     pr1, packedFg
                jmp     #.writePixel
.ditheredPixel
                mov     pr3, pr7
                shl     pr3, #fonts.DITH_BITS_PER_PIX_SHIFT
                cmp     pr3, #fonts.DITH_PIX_TOP_SHIFT  wcz
    if_a        jmp     #.writePixel                        ' past the row's bits: black
                subr    pr3, #fonts.DITH_PIX_TOP_SHIFT
                mov     pr0, pr4
                shr     pr0, pr3
                and     pr0, #fonts.DITH_PIX_VALUE_MASK
                cmp     pr0, #fonts.DITH_PIX_FULL   wz
    if_z        mov     pr1, packedFg
                cmp     pr0, #fonts.DITH_PIX_HALF   wz
    if_z        mov     pr1, packedHalf
.writePixel
                mov     pr2, pr5
                add     pr2, #RED_BYTE_OFST
                wrbyte  pr1, pr2
                mov     pr2, pr5
                add     pr2, #GREEN_BYTE_OFST
                shr     pr1, #PACKED_GREEN_SHIFT
                wrbyte  pr1, pr2
                mov     pr2, pr5
                add     pr2, #BLUE_BYTE_OFST
                shr     pr1, #PACKED_BLUE_SHIFT - PACKED_GREEN_SHIFT
                wrbyte  pr1, pr2
                add     pr5, rightStep
                add     pr7, #1
                djnz    pr6, #.nextPixel
                add     pPixel, downStep
                add     rowIdx, #1
                cmp     rowIdx, nBlockRows          wz
    if_nz       jmp     #.nextRow
    end

PRI fillBlock(pPixel, rightStep, downStep, nRows, nColumns, packedColor) | rowsLeft
' Fill a block in one color, in PASM: nRows rows from pPixel, downStep bytes apart, each of
' nColumns pixels rightStep bytes apart. PR0-PR3 are scratch.
'
' @param pPixel - hub address of the block's top-left pixel's red byte
' @param rightStep - signed bytes from one pixel to the next along a row
' @param downStep - signed bytes from one row to the next
' @param nRows - rows (at least one)
' @param nColumns - pixels in each row (at least one)
' @param packedColor - the color's corrected bytes, packed

' Local Variables:
' @local rowsLeft - rows still to fill

    rowsLeft := nRows
    org
.nextRow
                mov     pr0, pPixel                         ' the row's pixel
                mov     pr1, nColumns                       ' pixels left in the row
.nextPixel
                mov     pr2, packedColor
                mov     pr3, pr0
                add     pr3, #RED_BYTE_OFST
                wrbyte  pr2, pr3
                mov     pr3, pr0
                add     pr3, #GREEN_BYTE_OFST
                shr     pr2, #PACKED_GREEN_SHIFT
                wrbyte  pr2, pr3
                mov     pr3, pr0
                add     pr3, #BLUE_BYTE_OFST
                shr     pr2, #PACKED_BLUE_SHIFT - PACKED_GREEN_SHIFT
                wrbyte  pr2, pr3
                add     pr0, rightStep
                djnz    pr1, #.nextPixel
                add     pPixel, downStep
                djnz    rowsLeft, #.nextRow
    end

PRI copyRowSpan(nChainIdx, cellColumns, sourceRow, row, firstColumn, lastColumn) | column, nPixels, pSource, sourceStep, pPixel, rightStep
' Copy columns firstColumn to lastColumn of one display row onto another, cell by cell in PASM
' (copyPixels()): the two rows can lie in different cells, each with its own step.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param cellColumns - pixel columns of one mounted cell (hub75Bffrs.cellSizeInPixels())
' @param sourceRow - display row copied from, as mounted
' @param row - display row copied to, as mounted
' @param firstColumn - leftmost column copied
' @param lastColumn - rightmost column copied

' Local Variables:
' @local column - first column of the part being copied
' @local nPixels - pixels of the part (to the end of its cell, or of the span when sooner)
' @local pSource - hub address of the part's first source pixel
' @local sourceStep - signed bytes to the next source pixel
' @local pPixel - hub address of the part's first destination pixel
' @local rightStep - signed bytes to the next destination pixel

    column := firstColumn
    repeat while column <= lastColumn
        nPixels := ((((column / cellColumns) + 1) * cellColumns) <# (lastColumn + 1)) - column
        pSource, sourceStep, _ := hub75Bffrs.mountedPixelRun(nChainIdx, sourceRow, column)
        pPixel, rightStep, _ := hub75Bffrs.mountedPixelRun(nChainIdx, row, column)
        copyPixels(pSource, sourceStep, pPixel, rightStep, nPixels)
        column += nPixels

PRI copyPixels(pSource, sourceStep, pPixel, pixelStep, nPixels)
' Copy screen pixels, in PASM: nPixels pixels' three bytes from pSource (sourceStep bytes apart) to
' pPixel (pixelStep bytes apart), first pixel first, so a span copied onto itself shifted by one
' pixel reads each pixel before it is overwritten when the steps point the way of the shift.
' PR0-PR1 are scratch.
'
' @param pSource - hub address of the first source pixel's red byte
' @param sourceStep - signed bytes from one source pixel to the next
' @param pPixel - hub address of the first destination pixel's red byte
' @param pixelStep - signed bytes from one destination pixel to the next
' @param nPixels - pixels to copy (at least one)

    org
.nextPixel
                mov     pr1, pSource
                add     pr1, #RED_BYTE_OFST
                rdbyte  pr0, pr1
                mov     pr1, pPixel
                add     pr1, #RED_BYTE_OFST
                wrbyte  pr0, pr1
                mov     pr1, pSource
                add     pr1, #GREEN_BYTE_OFST
                rdbyte  pr0, pr1
                mov     pr1, pPixel
                add     pr1, #GREEN_BYTE_OFST
                wrbyte  pr0, pr1
                mov     pr1, pSource
                add     pr1, #BLUE_BYTE_OFST
                rdbyte  pr0, pr1
                mov     pr1, pPixel
                add     pr1, #BLUE_BYTE_OFST
                wrbyte  pr0, pr1
                add     pSource, sourceStep
                add     pPixel, pixelStep
                djnz    nPixels, #.nextPixel
    end

PRI writePacked(pPixel, packedColor)
' Write one pixel's three screen-buffer bytes from a packed color.
'
' @param pPixel - hub address of the pixel's red byte
' @param packedColor - the pixel's corrected bytes, packed

    BYTE[pPixel][RED_BYTE_OFST] := packedColor
    BYTE[pPixel][GREEN_BYTE_OFST] := packedColor >> PACKED_GREEN_SHIFT
    BYTE[pPixel][BLUE_BYTE_OFST] := packedColor >> PACKED_BLUE_SHIFT

