'' =================================================================================================
''
''   File....... demo_hub75_quadPanel.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 morganization of a quad-panel display
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Feb 2025
''   Updated.... 06 Oct 2026
''
'' =================================================================================================


CON ' ---- Timing ----

    CLK_FREQ = 335_000_000                                        ' system freq as a constant 2.985 nSec
    'CLK_FREQ = 250_000_000                                        ' system freq as a constant 2.985 nSec
    _clkfreq = CLK_FREQ                                           ' set system clock

CON ' ---- Debug Settings ----

    DEBUG_COGS = %11111111
    DEBUG_BAUD = 2_000_000

CON ' ---- Panel ID Layout ----

    HUE_SPAN = 256                                                ' a hue is a 0..HUE_SPAN position around the colour circle
    PANEL_HUE_OFFSET = 1                                          ' each panel's hue is this many panels past its index
    ASCII_ZERO = $30                                              ' the character '0'
    ARROW_ROW = 2                                                 ' panel text row of the up arrow
    ARROW_COLUMN = 7                                              ' panel text column of the up arrow
    ID_ROW = 4                                                    ' panel text row of the panel ID "Pn"
    ID_COLUMN = 7                                                 ' panel text column of the panel ID "Pn"

OBJ ' ---- Objects ----

    color       : "isp_hub75_color"
    colorUtils  : "isp_hub75_colorUtils"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    display     : "isp_hub75_display"

DAT ' ---- Panel Messages ----

    panelIdMessage  BYTE    "Pn",0
    panelArrow      BYTE    "^",0

VAR ' ---- Per-instance State ----

    LONG    chainIndex
    LONG    textSize

PUB main()
'' Start underlying drivers and run the panel identification demo.
''

  debug("Demo: HUB75 Quad Panel Demo")

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(hub75Bffrs.HUB75_ADAPTER_1)

  ' Run panel identification demo with centered numbers
  demoPanelColors()
  debug("Demo: Panel Colors... HALT")
  repeat

PRI demoPanelColors() | panelIndex, panelHueWidth, panelColor, hueIndex
' Color each panel with a distinct hue and display centered panel ID and arrow.
'

' Local Variables:
' @local panelIndex - index of the current panel
' @local panelHueWidth - hue degrees per panel
' @local panelColor - RGB color value for panel fill
' @local hueIndex - adjusted hue index for color selection

  panelHueWidth := HUE_SPAN / hub75Bffrs.maxPanels(chainIndex)

  ' set up text subsystem
  'textSize := display.TEXT_FONT_5x7
  textSize := display.TEXT_FONT_8x8A
  'textSize := display.TEXT_FONT_8x8B
  display.setTextFont(textSize)                                   ' font size
  display.setTextColor(color.cWhite)
  display.setCursor(0, 0)                                         ' start at top left, with one pixel of spacing

  ' start with blank screen on which to draw
  display.clearScreenBuffer()

  panelIndex := 0

  ' color individual panels with CENTERED panel ID and up arrow
  ' For 128x64 panel with 8x8 font: 16 chars wide, 8 chars tall
  ' Center "Pn" (2 chars) at row 4, col 7
  ' Arrow "^" above at row 2, col 7 (centered above the "P")
  repeat panelIndex from 0 to hub75Bffrs.maxPanels(chainIndex) - 1
    ' color the panel with distinct colors
    hueIndex := panelIndex + PANEL_HUE_OFFSET
    if hueIndex > hub75Bffrs.maxPanels(chainIndex) - 1
      hueIndex -= hub75Bffrs.maxPanels(chainIndex)
    panelColor := colorUtils.rgbColorFromDegrees(panelHueWidth * hueIndex)
    display.fillPanel(panelIndex, panelColor)

    ' Draw up arrow CENTERED above panel number (row 2, col 7)
    display.setCursorOnPanel(ARROW_ROW, ARROW_COLUMN, panelIndex)
    display.setTextAtCursor(@panelArrow)

    ' Number the panel CENTERED (row 4, col 7 for "Pn")
    display.setCursorOnPanel(ID_ROW, ID_COLUMN, panelIndex)
    BYTE [@panelIdMessage][1] := panelIndex + ASCII_ZERO
    display.setTextAtCursor(@panelIdMessage)

  display.commitScreenToPanelSet()

CON ' ---- License ----

