'' =================================================================================================
''
''   File....... demo_hub75_5x7font.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 matrix  full 5x7 font set
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2022
''   Updated.... 06 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

    DEBUG_BAUD  = 2_000_000

CON ' ---- Display Layout ----

    CHARS_PER_ROW       = 10                                        ' characters in one row of the character grid
    BYTES_PER_ROW       = 11                                        ' CHARS_PER_ROW plus the zero terminator
    NBR_ROWS_64         = 13                                        ' rows in the character grid
    ROWS_PER_SCREEN_64  = 10                                        ' rows shown on a 64x64 panel (two screens)
    SCREEN_COUNT_64     = 2                                         ' screens the 64x64 panel splits the grid into
    TALL_PANEL_ROWS     = 32                                        ' a panel taller than this is a 64x64
    DIGITS_ROW          = 5                                         ' grid row holding the digits 0-9
    SCREEN_A_LAST_ROW   = 3                                         ' 64x32: first screen shows rows 0 to this
    SCREEN_B_LAST_ROW   = 8                                         ' 64x32: second screen shows DIGITS_ROW to this
    SCREEN_C_FIRST_ROW  = 9                                         ' 64x32: third screen shows these rows ...
    SCREEN_C_LAST_ROW   = 11                                        ' ... to this, under the digits row
    SCREEN_C_DIGITS_LN  = 0                                         ' 64x32: screen line where the digits row goes
    SCREEN_C_FIRST_LN   = 1                                         ' 64x32: screen line where SCREEN_C_FIRST_ROW goes
    PAGE_SECONDS        = 10                                        ' seconds each screen is shown
    MS_PER_SECOND       = 1000

OBJ ' ---- Objects ----

    color           : "isp_hub75_color"
    display         : "isp_hub75_display"
    hub75Bffrs      : "isp_hub75_hwBufferAccess"

DAT ' ---- Character Grid ----

    ' 10 rows (really 9.6, 10 chars + term. in each row)
    charSet     BYTE    0[NBR_ROWS_64 * BYTES_PER_ROW]

VAR ' ---- Per-instance State ----

    LONG    chainIndex

PUB main() | vertPixelCount
'' Run demo displaying the full 5x7 font character set on the HUB75 LED matrix.
''

' Local Variables:
' @local vertPixelCount - vertical pixel count of the display

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(hub75Bffrs.HUB75_ADAPTER_1)

  initCharacterSet()

  vertPixelCount := hub75Bffrs.maxDisplayRows(chainIndex)
  if vertPixelCount > TALL_PANEL_ROWS
    demoFont64x64()                                     ' never returns
  else
    demoFont64x32()                                     ' never returns

PRI initCharacterSet() | nBytesFilled
' Initialize the character set buffer with printable ASCII characters arranged in rows.
'

' Local Variables:
' @local nBytesFilled - number of bytes filled so far in current row

  bytefill(@charSet, 0, NBR_ROWS_64 * BYTES_PER_ROW)
  ' 1.5 rows
  fillCharSet(0, 0, $20, $2f)                           ' special chars (16)
  ' 1.0 rows
  nBytesFilled := fillCharSet(2, 0, $3a, $40)           ' special chars (7)
  fillCharSet(2, nBytesFilled, $7e, $7f)                ' special chars (3)
  ' 1.0 rows
  nBytesFilled := fillCharSet(3, 0, $5b, $60)           ' special chars (6)
  fillCharSet(3, nBytesFilled, $7b, $7d)                ' special chars (3)

  ' 1.0 rows
  fillCharSet(5, 0, $30, $39)                           ' 0-9
  ' 2.6 rows
  fillCharSet(6, 0, $41, $5a)                           ' UPPER CASE A-Z
  ' 2.6 rows
  fillCharSet(9, 0, $61, $7a)                           ' LOWER CASE A-Z

PRI demoFont64x32() | textSize, nRow, nScreenRow
' Display the full 5x7 font character set on a 64x32 panel in multiple screens.
'

' Local Variables:
' @local textSize - selected font size constant
' @local nRow - current character row index
' @local nScreenRow - current screen row position for display output

  textSize := display.TEXT_FONT_5x7

  display.clearScreen()
  display.setTextFont(textSize)                         ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing

  repeat
    ' 3.5 rows
    display.clearScreenBuffer()
    nScreenRow := 0
    repeat nRow from 0 TO SCREEN_A_LAST_ROW
      display.setColoredTextAtLnCol(nScreenRow, 0, @BYTE[@charSet][nRow * BYTES_PER_ROW], color.cYellow)
      nScreenRow++

    ' update our screen
    display.commitScreenToPanelSet()
    waitSec(PAGE_SECONDS)

    nScreenRow := 0
    display.clearScreenBuffer()
    repeat nRow from DIGITS_ROW TO SCREEN_B_LAST_ROW
      display.setColoredTextAtLnCol(nScreenRow, 0, @BYTE[@charSet][(nRow) * BYTES_PER_ROW], color.cOrange)
      nScreenRow++

    ' update our screen
    display.commitScreenToPanelSet()
    waitSec(PAGE_SECONDS)

    nScreenRow := SCREEN_C_DIGITS_LN
    display.clearScreenBuffer()
    nRow := DIGITS_ROW
    display.setColoredTextAtLnCol(nScreenRow, 0, @BYTE[@charSet][(nRow) * BYTES_PER_ROW], color.cOrange)
    nScreenRow := SCREEN_C_FIRST_LN
    repeat nRow from SCREEN_C_FIRST_ROW TO SCREEN_C_LAST_ROW
      display.setColoredTextAtLnCol(nScreenRow, 0, @BYTE[@charSet][(nRow) * BYTES_PER_ROW], color.cOrange)
      nScreenRow++

    ' update our screen
    display.commitScreenToPanelSet()
    waitSec(PAGE_SECONDS)

PRI demoFont64x64() | textSize, nRow, nRows1stScreen
' Display the full 5x7 font character set on a 64x64 panel in two screens.
'

' Local Variables:
' @local textSize - selected font size constant
' @local nRow - current character row index
' @local nRows1stScreen - number of rows displayed on the first screen

  textSize := display.TEXT_FONT_5x7
  nRows1stScreen := ROWS_PER_SCREEN_64 / SCREEN_COUNT_64

  display.clearScreen()
  display.setTextFont(textSize)                         ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing

  repeat
    display.clearScreenBuffer()
    repeat nRow from 0 TO DIGITS_ROW                    ' includes the digits 0-9 row on this screen too
      display.setColoredTextAtLnCol(nRow, 0, @BYTE[@charSet][nRow * BYTES_PER_ROW], color.cYellow)

    ' update our screen
    display.commitScreenToPanelSet()
    waitSec(PAGE_SECONDS)

    display.clearScreenBuffer()
    repeat nRow from nRows1stScreen TO NBR_ROWS_64 - 1
      display.setColoredTextAtLnCol(nRow - nRows1stScreen, 0, @BYTE[@charSet][(nRow) * BYTES_PER_ROW], color.cOrange)

    ' update our screen
    display.commitScreenToPanelSet()
    waitSec(PAGE_SECONDS)

PRI fillCharSet(startRow, startCol, startHex, stopHex) : nCount | nCharIdx, nChar, nRow, nCol, nIdx
' Fill the character set buffer with a range of ASCII characters starting at the given row and column.
'
' @param startRow - starting row in the character set grid
' @param startCol - starting column offset within the row
' @param startHex - first ASCII code to place
' @param stopHex - last ASCII code to place
' @returns nCount - number of characters placed

' Local Variables:
' @local nCharIdx - linear index into the character grid
' @local nChar - current ASCII character code being placed
' @local nRow - computed row for current character
' @local nCol - computed column for current character
' @local nIdx - byte index into the charSet buffer

  nCharIdx := (startRow * CHARS_PER_ROW) + startCol
  nCount := (stopHex + 1) - startHex
  repeat nChar from startHex TO stopHex
    nRow := nCharIdx / CHARS_PER_ROW
    nCol := nCharIdx +// CHARS_PER_ROW
    nIdx := (nRow * BYTES_PER_ROW) + nCol
    BYTE [@charSet][nIdx] := nChar
    nCharIdx++

PRI waitSec(countSeconds)
' Wait for the specified number of seconds.
'
' @param countSeconds - number of seconds to wait

  repeat countSeconds
    waitms(MS_PER_SECOND)

