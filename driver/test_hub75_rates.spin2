PUB main() : workerCog | nCommitsBefore, instrumentStatus, takeCheckStatus
'' Start adapter 1 and the instrument, run every phase of the workload, report, and end the session.
''
'' @returns workerCog - cog ID + 1 of the display driver (display.start() aborts when no cog is free)

' Local Variables:
' @local nCommitsBefore - commits posted before the take check started
' @local instrumentStatus - instrument.SUCCESS if the instrument started a monitor, or the reason it did not
' @local takeCheckStatus - instrument.SUCCESS if the take check started

  debug("R", zstr_(@dbgHub75Workload), "-")

  workerCog := display.start(display.HUB75_ADAPTER_1)
  ' display.start() aborts with a message when no cog is free, so a return here is a started cog
  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)
  colorDepth := hub75Bffrs.colorDepth(chainIndex)
  debug("R", zstr_(@dbgColourDepth), " ", udec_(colorDepth), " ", zstr_(@dbgBitsAdapterBaseP), "P", udec_(hub75Bffrs.pinBase(chainIndex)))
  runColourTableTest()
  runRowRunTest()
  runScrollOracleTest()
  instrumentStatus := instrument.start(hub75Bffrs.pinBase(chainIndex), latchesPerRefresh())
  if instrumentStatus <> instrument.SUCCESS
    debug("R", zstr_(@dbgInstrumentNotStartedStatu), " ", sdec_(instrumentStatus), ")", zstr_(@dbgDrawAndCommitTimesOnly), "y")
  nCommitsBefore := commitsPosted()
  takeCheckStatus := instrument.startTakeCheck(rowsPerRefresh() - 1)
  runPatterns()
  runWorkload()
  runHandshakeTrace()
  refuseNullFrameSet()
  runBrightnessSteps()
  runTearingTest()
  if takeCheckStatus == instrument.SUCCESS
    reportTakeCheck(nCommitsBefore)
  instrument.stop()
  display.stop()
  debug("E", zstr_(@dbgEndSession), "N")

PRI runScrollOracleTest() | caseIdx, boundaryIdx, nSteps, nFailed, nCompared, scrollHash, staticHash
' Scroll ORACLE_TEXT along a whole text line in each ORACLE_* case and, at each character boundary
' in oracleBoundaries, compare the screen buffer with the line's expected characters drawn as static
' text. SCROLL ORACLE PASS only if every compared frame is identical. The font is put back and the
' screen buffer cleared afterwards.
'
' Local Variables:
' @local caseIdx - ORACLE_* case being run
' @local boundaryIdx - entry of oracleBoundaries being compared
' @local nSteps - animation steps to the boundary being compared
' @local nFailed - frames that differed
' @local nCompared - frames compared
' @local scrollHash - hash of the screen buffer holding the scroller's frame
' @local staticHash - hash of the screen buffer holding the static text

  debug("R", zstr_(@dbgScrollOracleSelfTest), "-")
  nFailed := 0
  nCompared := 0
  display.setTextFont(display.TEXT_FONT_5x7)
  repeat caseIdx from 0 to ORACLE_CASE_COUNT - 1
    repeat boundaryIdx from 0 to ORACLE_STEP_COUNT - 1
      nSteps := LONG[@oracleBoundaries][boundaryIdx] * ORACLE_FIELD_PIX
      if caseIdx == ORACLE_RIGHT_FOREVER
        nSteps += ORACLE_RIGHT_LEAD
      scrollHash := scrolledFrameHash(caseIdx, nSteps)
      buildOracleLine(caseIdx, LONG[@oracleBoundaries][boundaryIdx])
      display.clearScreenBuffer()
      display.setColoredTextAtLnCol(ORACLE_LINE, 0, @oracleExpected, RUN_TEST_COLOR)
      staticHash := screenHash()
      nCompared++
      if scrollHash <> staticHash
        nFailed++
        debug("R", zstr_(@dbgScrollOracle), " ", zstr_(oracleLabel(caseIdx)), " after ", udec_(nSteps), " ", zstr_(@dbgStepsFailTheFrameDiffers), "[", zstr_(@oracleExpected), "]")
  display.setTextFont(display.TEXT_FONT_DEFAULT)
  display.clearScreenBuffer()
  if nFailed == 0
    debug("R", zstr_(@dbgScrollOraclePass), " ", udec_(nCompared), " ", zstr_(@dbgFramesIdenticalToTheStati), "t")
  else
    debug("R", zstr_(@dbgScrollOracleFail), " ", udec_(nFailed), " of ", udec_(nCompared), " ", zstr_(@dbgFramesDifferFromTheStatic), "t")

PRI scrolledFrameHash(caseIdx, nSteps) : frameHash | scrollerID
' Start the case's scroller on a cleared buffer, step it nSteps times, hash the screen buffer, and
' free the scroller.
'
' @param caseIdx - ORACLE_* case
' @param nSteps - animation steps before the hash
' @returns frameHash - hash of the screen buffer (screenHash())

' Local Variables:
' @local scrollerID - the scroller the case started

  display.clearScreenBuffer()
  if caseIdx == ORACLE_RIGHT_FOREVER
    scrollerID := display.scrollColoredTextOnLn(ORACLE_LINE, @oracleText, display.DIR_TO_RIGHT, RUN_TEST_COLOR)
  else
    scrollerID := display.scrollColoredTextOnLn(ORACLE_LINE, @oracleText, display.DIR_TO_LEFT, RUN_TEST_COLOR)
  if caseIdx == ORACLE_LEFT_CLEAR
    display.configureScrollLoopMode(scrollerID, display.SCROLL_ONCE_TO_CLEAR)
  else
    display.configureScrollLoopMode(scrollerID, display.SCROLL_FOREVER)
  repeat nSteps
    display.animateScroll()
  frameHash := screenHash()
  display.releaseScroller(scrollerID)

PRI buildOracleLine(caseIdx, nBoundary) | nColumns, nChars, firstChar, columnIdx, charIdx
' Build in oracleExpected the characters the case's line shows at its nBoundary-th character
' boundary: the text from its first visible character on, repeating end to end in SCROLL_FOREVER,
' and spaces outside the text in SCROLL_ONCE_TO_CLEAR. A left scroll starts with the text's first
' character at the left of the line and moves on one character per boundary; a right scroll starts
' with the text's last character at the right of the line and moves back one per boundary.
'
' @param caseIdx - ORACLE_* case
' @param nBoundary - character boundaries passed

' Local Variables:
' @local nColumns - characters the line holds
' @local nChars - characters in the text
' @local firstChar - text index of the line's first character (may lie outside the text)
' @local columnIdx - line character being set
' @local charIdx - text index that character shows

  nColumns := display.numberTextColumns() <# ORACLE_MAX_COLUMNS
  nChars := strsize(@oracleText)
  if caseIdx == ORACLE_RIGHT_FOREVER
    firstChar := nChars - nColumns - nBoundary
  else
    firstChar := nBoundary
  repeat columnIdx from 0 to nColumns - 1
    charIdx := firstChar + columnIdx
    if caseIdx <> ORACLE_LEFT_CLEAR
      charIdx := ((charIdx // nChars) + nChars) // nChars
    if charIdx >= 0 and charIdx < nChars
      oracleExpected[columnIdx] := oracleText[charIdx]
    else
      oracleExpected[columnIdx] := " "
  oracleExpected[nColumns] := 0

PRI screenHash() : bufferHash | pScreen, longIdx
' Return a hash of the adapter's whole screen buffer: each long rotated in by HASH_ROTATE bits.
'
' @returns bufferHash - the hash

' Local Variables:
' @local pScreen - hub address of the screen buffer
' @local longIdx - long being added

  pScreen := hub75Bffrs.displayBufferAddress(chainIndex)
  bufferHash := 0
  repeat longIdx from 0 to hub75Bffrs.displaySizeInLongs(chainIndex) - 1
    bufferHash := (bufferHash rol HASH_ROTATE) ^ LONG[pScreen][longIdx]

PRI oracleLabel(caseIdx) : pLabel
' Return the printable name of a scroll oracle case.
'
' @param caseIdx - ORACLE_* case
' @returns pLabel - zero-terminated name

  case caseIdx
    ORACLE_LEFT_FOREVER:
      pLabel := string("left forever")
    ORACLE_RIGHT_FOREVER:
      pLabel := string("right forever")
    other:
      pLabel := string("left to clear")

PRI runColourTableTest() | depthIdx, gammaCase, bGamma, ledIdx, nCaseMismatches, nMismatches, nCompared
' Compare the colour table with the old per-pixel function for every input 0-255: a scratch table
' for each depth 3-8 with gamma off and on, then the adapter's live table (all three channels) at
' the gamma setting it was built with. Every mismatch is printed. COLOUR TABLE PASS only if there
' were none.
'

' Local Variables:
' @local depthIdx - depth being compared
' @local gammaCase - GAMMA_CASE_* being compared
' @local bGamma - TRUE for gamma on
' @local ledIdx - colour channel being read from the live table
' @local nCaseMismatches - mismatches in the case just compared
' @local nMismatches - mismatches in all cases
' @local nCompared - entries compared in all cases

  nMismatches := 0
  nCompared := 0
  debug("R", zstr_(@dbgColourTableSelfTest), "-")
#IFDEF HUB75_CORRUPT_COLOUR_TABLE
  debug("R", zstr_(@dbgHub75CorruptColourTableIs), "L")
#ENDIF
  repeat depthIdx from TABLE_DEPTH_FIRST to TABLE_DEPTH_LAST
    repeat gammaCase from GAMMA_CASE_OFF to GAMMA_CASE_COUNT - 1
      bGamma := (gammaCase == GAMMA_CASE_ON)
      colorUtils.fillColorTable(@scratchTable, depthIdx, bGamma)
      nCaseMismatches := compareTable(depthIdx, bGamma, FALSE, colorUtils.LED_RED)
      debug("R", zstr_(@dbgColourTableScratchDepth), " ", udec_(depthIdx), " gamma ", zstr_(gammaLabel(bGamma)), ": ", udec_(nCaseMismatches), " ", zstr_(@dbgMismatchesOf), " ", udec_(LEVEL_COUNT))
      nMismatches += nCaseMismatches
      nCompared += LEVEL_COUNT

  bGamma := colorUtils.isGammaEnabled()
  repeat ledIdx from colorUtils.LED_RED to colorUtils.LED_BLUE
    nCaseMismatches := compareTable(colorDepth, bGamma, TRUE, ledIdx)
    debug("R", zstr_(@dbgColourTableLiveDepth), " ", udec_(colorDepth), " gamma ", zstr_(gammaLabel(bGamma)), " channel ", udec_(ledIdx), ": ", udec_(nCaseMismatches), " ", zstr_(@dbgMismatchesOf), " ", udec_(LEVEL_COUNT))
    nMismatches += nCaseMismatches
    nCompared += LEVEL_COUNT

  nCaseMismatches := comparePacking()
  debug("R", zstr_(@dbgColourPackingPackedcorrec), " ", udec_(nCaseMismatches), " ", zstr_(@dbgMismatchesOf), " ", udec_(LEVEL_COUNT * PACKING_FORMS))
  nMismatches += nCaseMismatches
  nCompared += LEVEL_COUNT * PACKING_FORMS

  if nMismatches == 0
    debug("R", zstr_(@dbgColourTablePass), " ", udec_(nCompared), " ", zstr_(@dbgEntriesComparedWithTheOld), "r")
  else
    debug("R", zstr_(@dbgColourTableFail), " ", udec_(nMismatches), " of ", udec_(nCompared), " ", zstr_(@dbgEntriesDifferFromTheOld), "n")

PRI comparePacking() : nMismatches | levelIdx, red, green, blue, expected, packedByValue, packedByChannels
' Compare colorUtils' packed conversions with correctedSingleColor(), channel by channel, for 256
' colors whose three channels vary independently: red rises, green falls, blue steps by an odd
' stride. Both packed forms are compared; the first difference is printed.
'
' @returns nMismatches - packed results that differ

' Local Variables:
' @local levelIdx - color being compared
' @local red - its red value
' @local green - its green value
' @local blue - its blue value
' @local expected - the three corrected channels, packed by hand
' @local packedByValue - packedCorrectedColor() of the combined value
' @local packedByChannels - packedCorrectedRgb() of the three values

  nMismatches := 0
  repeat levelIdx from 0 to LEVEL_COUNT - 1
    red := levelIdx
    green := colorUtils.MAX_COLOR_VALUE - levelIdx
    blue := (levelIdx * PACKING_BLUE_STRIDE) // LEVEL_COUNT
    expected := colorUtils.correctedSingleColor(chainIndex, colorUtils.LED_RED, red)
    expected |= colorUtils.correctedSingleColor(chainIndex, colorUtils.LED_GREEN, green) << colorUtils.PACKED_GREEN_SHIFT
    expected |= colorUtils.correctedSingleColor(chainIndex, colorUtils.LED_BLUE, blue) << colorUtils.PACKED_BLUE_SHIFT
    packedByValue := colorUtils.packedCorrectedColor(chainIndex, colorUtils.cValueForRGB(red, green, blue))
    packedByChannels := colorUtils.packedCorrectedRgb(chainIndex, red, green, blue)
    if packedByValue <> expected or packedByChannels <> expected
      if nMismatches == 0
        debug("R", zstr_(@dbgColourPackingMismatchFirs), " ", udec_(red), ",", udec_(green), ",", udec_(blue), ":", zstr_(@dbgExpected), " ", uhex_long_(expected), ",", zstr_(@dbgByValue), " ", uhex_long_(packedByValue), ",", zstr_(@dbgByChannels), " ", uhex_long_(packedByChannels))
      nMismatches += (packedByValue <> expected ? 1 : 0) + (packedByChannels <> expected ? 1 : 0)

PRI compareTable(nDepthInBits, bGamma, bLive, ledIdx) : nMismatches | levelIdx, storedByte, expectedByte
' Compare one table with referenceStored() for every input 0-255, printing each mismatch: the
' scratch table, or (bLive) the adapter's table as correctedSingleColor() reads it for ledIdx.
'
' @param nDepthInBits - color depth in bits per channel (3-8)
' @param bGamma - TRUE for gamma on
' @param bLive - TRUE to read the adapter's table, FALSE to read the scratch table
' @param ledIdx - colour channel read from the live table
' @returns nMismatches - entries that differ from the old function

' Local Variables:
' @local levelIdx - 8-bit input being compared
' @local storedByte - the table's stored byte for the input
' @local expectedByte - the old function's output for the input

  nMismatches := 0
  repeat levelIdx from 0 to colorUtils.MAX_COLOR_VALUE
    if bLive == TRUE
      storedByte := colorUtils.correctedSingleColor(chainIndex, ledIdx, levelIdx)
    else
      storedByte := BYTE[@scratchTable][levelIdx]
    expectedByte := referenceStored(nDepthInBits, bGamma, levelIdx)
    if storedByte <> expectedByte
      debug("R", zstr_(@dbgColourTableMismatchDepth), " ", udec_(nDepthInBits), " gamma ", zstr_(gammaLabel(bGamma)), " input ", udec_(levelIdx), ": stored ", udec_(storedByte), ",", zstr_(@dbgOldFunction), " ", udec_(expectedByte))
      nMismatches++

PRI referenceStored(nDepthInBits, bGamma, levelIdx) : storedByte | nPwmFrames, pGamma
' Reference copy of the old per-pixel function (colorUtils correctedSingleColor() with brightness
' 256, then colorAtDesiredBitWidth()): optional gamma, then (v * frames) / 255 << (8 - depth),
' with the frame count (1 << depth) - 1 the old code took from its PWM_FRAMES_nBIT constants.
'
' @param nDepthInBits - color depth in bits per channel (3-8)
' @param bGamma - TRUE for gamma on
' @param levelIdx - 8-bit input
' @returns storedByte - the byte the old code stored

' Local Variables:
' @local nPwmFrames - PWM frames of the depth
' @local pGamma - the gamma curve table

  pGamma, _, _ := colorUtils.gammaPtrs()
  storedByte := levelIdx
  if bGamma == TRUE
    storedByte := BYTE[pGamma][storedByte]
  nPwmFrames := (1 << nDepthInBits) - 1
  storedByte := (storedByte * nPwmFrames) / colorUtils.MAX_COLOR_VALUE
  storedByte <<= colorUtils.SOURCE_COLOR_BITS - nDepthInBits

PRI gammaLabel(bGamma) : pLabel
' Return the printable name of a gamma case.
'
' @param bGamma - TRUE for gamma on
' @returns pLabel - zero-terminated name

  if bGamma == TRUE
    pLabel := string("on")
  else
    pLabel := string("off")

PRI runRowRunTest() | startMs, layoutIdx, rotationIdx, arrowIdx, caseIdx, nCaseMismatches, firstOffset, nCaptured, bWindowed, nOracleMismatches, nOracleCompared, nMismatches, nFailedCases, nCases, nRefused, nSkipped, pLayout, pRotation, pArrow, pCase, lastCaseIdx, pNote
' Compare every run primitive with the pixel-by-pixel path it replaces, byte for byte, on three
' layouts x four display rotations x four arrows (the cases after FULL_SET_CASES on one arrow per
' layout and rotation), and compare the address rule with the old one on each. The adapter's own
' layout, font and cursor are put back and the screen buffer cleared afterwards. ROW RUN PASS only
' if no case and no address differ, no case drew nothing, and no layout was refused.
'

' Local Variables:
' @local startMs - millisecond count (getms()) when the test began
' @local layoutIdx - LAYOUT_* under test
' @local rotationIdx - entry of testRotations under test
' @local arrowIdx - entry of testArrows under test
' @local caseIdx - ROW_CASE_* being compared
' @local nCaseMismatches - bytes that differ in the case just compared
' @local firstOffset - first differing byte offset in the case just compared, or NO_OFFSET
' @local nCaptured - longs the reference drawing changed in the case just compared
' @local bWindowed - TRUE when the case was compared in windows (it changed more than CAPTURE_LONGS longs)
' @local lastCaseIdx - last case run on the layout under test
' @local pNote - printable note saying whether the case was compared in windows
' @local nOracleMismatches - address-rule points that differ on the layout just compared
' @local nOracleCompared - address-rule points compared on the layout just compared
' @local nMismatches - differing bytes and address points in all cases
' @local nFailedCases - cases and layouts that failed
' @local nCases - cases compared
' @local nRefused - layouts testRelayout() refused
' @local nSkipped - layouts not run because the adapter has a different number of panels than they need
' @local pLayout - printable name of the layout
' @local pRotation - printable name of the rotation
' @local pArrow - printable name of the arrow
' @local pCase - printable name of the case

  startMs := getms()
  nMismatches := nFailedCases := nCases := nRefused := nSkipped := 0
  debug("R", zstr_(@dbgRowRunSelfTest), "-")
#IFDEF HUB75_CORRUPT_ROW_RUN
  debug("R", zstr_(@dbgHub75CorruptRowRunIs), ")")
#ENDIF
#IFDEF HUB75_CORRUPT_PIXEL_ADDRESS
  debug("R", zstr_(@dbgHub75CorruptPixelAddressI), "L")
#ENDIF
  repeat layoutIdx from 0 to TEST_LAYOUT_COUNT - 1
    pLayout := layoutLabel(layoutIdx)
    repeat rotationIdx from 0 to ROTATION_COUNT - 1
      pRotation := rotationLabel(rotationIdx)
      repeat arrowIdx from 0 to ARROW_COUNT - 1
        pArrow := arrowLabel(arrowIdx)
        buildTestSentences(layoutIdx, LONG[@testArrows][arrowIdx])
        if layoutIdx <> LAYOUT_OWN and hub75Bffrs.maxPanels(chainIndex) <> L_LAYOUT_PANELS
          ' an L is drawn with exactly L_LAYOUT_PANELS panels, and a relayout keeps the adapter's count
          if rotationIdx == 0 and arrowIdx == 0
            debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), ":", zstr_(@dbgNotRunItNeeds), " ", udec_(L_LAYOUT_PANELS), " ", zstr_(@dbgPanelsAndThisAdapterHas), " ", udec_(hub75Bffrs.maxPanels(chainIndex)))
          nSkipped++
        elseif hub75Bffrs.testRelayout(chainIndex, @testSentences, LONG[@testRotations][rotationIdx]) <> hub75Bffrs.RELAYOUT_DONE
          debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), " ", zstr_(pRotation), " arrow ", zstr_(pArrow), ":", zstr_(@dbgFailLayoutRefusedMessageA), ")")
          nRefused++
        else
          display.refreshGeometry()
          nOracleMismatches, nOracleCompared := compareAddressRule()
          if nOracleMismatches == 0
            debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), " ", zstr_(pRotation), " arrow ", zstr_(pArrow), " ", zstr_(@dbgAddressRulePass), " ", udec_(nOracleCompared), " ", zstr_(@dbgPointsEqualTheOldRule), "e")
          else
            debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), " ", zstr_(pRotation), " arrow ", zstr_(pArrow), " ", zstr_(@dbgAddressRuleFail), " ", udec_(nOracleMismatches), " of ", udec_(nOracleCompared), " ", zstr_(@dbgPointsDifferFromTheOld), "e")
            nMismatches += nOracleMismatches
            nFailedCases++
          lastCaseIdx := FULL_SET_CASES - 1
          if isReducedLayout(layoutIdx, rotationIdx, arrowIdx) == TRUE
            lastCaseIdx := ROW_CASE_COUNT - 1
          repeat caseIdx from 0 to lastCaseIdx
            pCase := rowCaseLabel(caseIdx)
            nCaseMismatches, firstOffset, nCaptured, bWindowed := runRowRunCase(caseIdx, layoutIdx + rotationIdx)
            pNote := windowedNote(bWindowed)
            nCases++
            if nCaptured == 0
              debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), " ", zstr_(pRotation), " arrow ", zstr_(pArrow), " ", zstr_(pCase), ":", zstr_(@dbgFailTheReferenceDrewNothi), "d")
              nFailedCases++
            elseif nCaseMismatches == 0
              debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), " ", zstr_(pRotation), " arrow ", zstr_(pArrow), " ", zstr_(pCase), ": PASS, ", udec_(nCaptured), " ", zstr_(@dbgLongsDrawnBufferIdentical), "l", zstr_(pNote))
            else
              debug("R", zstr_(@dbgRowRun), " ", zstr_(pLayout), " ", zstr_(pRotation), " arrow ", zstr_(pArrow), " ", zstr_(pCase), ": FAIL, ", udec_(nCaseMismatches), " ", zstr_(@dbgBytesDifferFirstAtByte), " ", udec_(firstOffset), " (", udec_(nCaptured), " ", zstr_(@dbgLongsDrawn), ")", zstr_(pNote))
              nMismatches += nCaseMismatches
              nFailedCases++

  ' the adapter's own layout, font and cursor back, drawing by runs again, and nothing left in the buffer
  hub75Bffrs.testRestoreLayout(chainIndex)
  display.refreshGeometry()
  display.setTextFont(display.TEXT_FONT_DEFAULT)
  display.homeCursor()
  pixels.setPerPixelReference(FALSE)
  display.clearScreenBuffer()
  if nFailedCases == 0 and nRefused == 0
    debug("R", zstr_(@dbgRowRunPass), " ", udec_(nCases), " ", zstr_(@dbgCasesIdenticalByteForByte), " ", udec_(nSkipped), " ", zstr_(@dbgLayoutsNotRunPanelCount), " ", udec_((getms() - startMs) / MS_PER_SECOND), " s")
  else
    debug("R", zstr_(@dbgRowRunFail), " ", udec_(nFailedCases), " failed, ", udec_(nRefused), " ", zstr_(@dbgLayoutsRefused), " ", udec_(nMismatches), " ", zstr_(@dbgDifferingBytesAndPoints), " ", udec_(nCases), " ", zstr_(@dbgCasesRun), "n")

PRI buildTestSentences(layoutIdx, arrowWord) | cablePos, sentence
' Fill testSentences with one layout's wiring sentences, every panel's arrow replaced by arrowWord.
'
' @param layoutIdx - LAYOUT_* under test
' @param arrowWord - hwEnum.ARROW_* every panel is given

' Local Variables:
' @local cablePos - cable position being filled
' @local sentence - the sentence at that cable position

  repeat cablePos from 0 to hub75Bffrs.MAX_CABLE_POSITIONS - 1
    sentence := hwEnum.NO_PANEL
    case layoutIdx
      LAYOUT_OWN:
        sentence := LONG[@ownSentences][cablePos]
      LAYOUT_WIDE_L:
        if cablePos < L_LAYOUT_PANELS
          sentence := LONG[@wideLSentences][cablePos]
      other:
        if cablePos < L_LAYOUT_PANELS
          sentence := LONG[@tallLSentences][cablePos]
    if sentence <> hwEnum.NO_PANEL
      sentence := (sentence & !hwEnum.ARROW_MASK) | arrowWord
    LONG[@testSentences][cablePos] := sentence

PRI isReducedLayout(layoutIdx, rotationIdx, arrowIdx) : bReduced
' Return TRUE for the one arrow per layout and rotation on which the cases after FULL_SET_CASES
' run: the arrow steps with the rotation, so each layout meets all four arrows and all four rotations.
'
' @param layoutIdx - LAYOUT_* under test
' @param rotationIdx - entry of testRotations under test
' @param arrowIdx - entry of testArrows under test
' @returns bReduced - TRUE to run every case on this layout

  bReduced := arrowIdx == (layoutIdx + rotationIdx) // ARROW_COUNT

PRI runRowRunCase(caseIdx, caseVariant) : nMismatches, firstOffset, nCaptured, bWindowed
' Draw one case pixel by pixel on the background and record it, then draw it by runs on the
' background and compare the whole screen buffer with the record, byte for byte. A case that
' changes more than CAPTURE_LONGS longs is compared in windows instead (compareWindowed()).
'
' @param caseIdx - ROW_CASE_* to compare
' @param caseVariant - a number that varies from layout to layout (the panel filled, the BMP's turn)
' @returns nMismatches - bytes of the screen buffer that differ
' @returns firstOffset - byte offset of the first that differs, or NO_OFFSET
' @returns nCaptured - longs the pixel-by-pixel drawing changed
' @returns bWindowed - TRUE when the case was compared in windows

  pixels.setPerPixelReference(TRUE)
  fillBackground()
  drawRowRunCase(caseIdx, caseVariant)
  nCaptured, bWindowed := captureScreen()
  finishRowRunCase(caseIdx)
  if bWindowed == FALSE
    pixels.setPerPixelReference(FALSE)
    fillBackground()
    drawRowRunCase(caseIdx, caseVariant)
    nMismatches, firstOffset := compareScreen(nCaptured)
    finishRowRunCase(caseIdx)
  else
    nMismatches, firstOffset := compareWindowed(caseIdx, caseVariant)

PRI compareWindowed(caseIdx, caseVariant) : nMismatches, firstOffset | pScreen, nLongs, windowStart, windowFirst, windowEnd, longIdx, expectedLong
' Compare a case window by window: draw it pixel by pixel, copy CAPTURE_AREA_LONGS longs from
' the first long at or after the window's start that differs from the background, draw it by
' runs, and compare every byte from the window's start to the copy's end (before the copy, the
' background). Repeat from the copy's end until the whole buffer is compared.
'
' @param caseIdx - ROW_CASE_* to compare
' @param caseVariant - a number that varies from layout to layout (see runRowRunCase())
' @returns nMismatches - bytes of the screen buffer that differ
' @returns firstOffset - byte offset of the first that differs, or NO_OFFSET

' Local Variables:
' @local pScreen - hub address of the screen buffer
' @local nLongs - longs in the screen buffer
' @local windowStart - first long of the window
' @local windowFirst - first long of the window that the pixel-by-pixel drawing changed
' @local windowEnd - long after the window's copy
' @local longIdx - long being compared
' @local expectedLong - the value the long must hold

  nMismatches := 0
  firstOffset := NO_OFFSET
  pScreen := hub75Bffrs.displayBufferAddress(chainIndex)
  nLongs := hub75Bffrs.displaySizeInLongs(chainIndex)
  windowStart := 0
  repeat while windowStart < nLongs
    pixels.setPerPixelReference(TRUE)
    fillBackground()
    drawRowRunCase(caseIdx, caseVariant)
    windowFirst := windowStart
    repeat while windowFirst < nLongs
      if LONG[pScreen][windowFirst] <> BACKGROUND_LONG
        quit
      windowFirst++
    windowEnd := (windowFirst + CAPTURE_AREA_LONGS) <# nLongs
    longmove(@captureArea, pScreen + (windowFirst * hub75Bffrs.BYTES_PER_LONG), windowEnd - windowFirst)
    finishRowRunCase(caseIdx)
    pixels.setPerPixelReference(FALSE)
    fillBackground()
    drawRowRunCase(caseIdx, caseVariant)
    repeat longIdx from windowStart to windowEnd - 1
      expectedLong := BACKGROUND_LONG
      if longIdx >= windowFirst
        expectedLong := LONG[@captureArea][longIdx - windowFirst]
      nMismatches, firstOffset := countByteDiffs(longIdx, LONG[pScreen][longIdx], expectedLong, nMismatches, firstOffset)
    finishRowRunCase(caseIdx)
    windowStart := windowEnd

PRI drawRowRunCase(caseIdx, caseVariant) | displayRows, displayColumns, cellRows, cellColumns, bandIdx, bandStart, panelIdx, layoutRows, layoutColumns, layoutCellRows, layoutCellColumns, orientation, panelRow, panelColumn
' Draw one case through the drawing API. Which path draws it (pixel by pixel or runs) is chosen
' by screenUtils.setPerPixelReference().
'
' @param caseIdx - ROW_CASE_* to draw
' @param caseVariant - a number that varies from layout to layout (see runRowRunCase())

' Local Variables:
' @local displayRows - display height in pixels, as mounted
' @local displayColumns - display width in pixels, as mounted
' @local cellRows - pixel rows of one panel as the viewer sees it
' @local cellColumns - pixel columns of one panel as the viewer sees it
' @local bandIdx - band being drawn (line and column cases)
' @local bandStart - first row (column) of that band
' @local panelIdx - panel position being drawn on (clip and box cases)
' @local layoutRows - display height as laid out (fill-area case)
' @local layoutColumns - display width as laid out
' @local layoutCellRows - one cell's height as laid out
' @local layoutCellColumns - one cell's width as laid out
' @local orientation - 7-segment orientation being placed
' @local panelRow - display row of a panel's top-left pixel (scroll cases)
' @local panelColumn - display column of a panel's top-left pixel (scroll cases)

  displayRows, displayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  cellRows, cellColumns := hub75Bffrs.cellSizeInPixels(chainIndex)
  case caseIdx
    ROW_CASE_LINES:
      repeat bandIdx from 0 to LINE_BAND_COUNT - 1
        bandStart := lineBandStart(bandIdx, displayRows, cellRows)
        display.drawLineOfColor(bandStart + BAND_OFST_ONE_CELL, RUN_INSET, bandStart + BAND_OFST_ONE_CELL, cellColumns - 1 - RUN_INSET, RUN_TEST_COLOR)
        display.drawLineOfColor(bandStart + BAND_OFST_TWO_CELLS, cellColumns - RUN_BOUNDARY_REACH, bandStart + BAND_OFST_TWO_CELLS, cellColumns + RUN_BOUNDARY_REACH, RUN_TEST_COLOR)
        display.drawLineOfColor(bandStart + BAND_OFST_FULL, displayColumns - 1, bandStart + BAND_OFST_FULL, FIRST_COLUMN, RUN_TEST_COLOR)
        if displayColumns >= cellColumns * THREE_CELLS
          display.drawLineOfColor(bandStart + BAND_OFST_THREE_CELLS, cellColumns / CELL_HALVES, bandStart + BAND_OFST_THREE_CELLS, (cellColumns * (THREE_CELLS - 1)) + (cellColumns / CELL_HALVES), RUN_TEST_COLOR)
        display.drawLineOfColor(bandStart + BAND_OFST_ONE_PIXEL, cellColumns - 1, bandStart + BAND_OFST_ONE_PIXEL, cellColumns - 1, RUN_TEST_COLOR)
      display.drawLineOfColor(displayRows - 1, FIRST_COLUMN, displayRows - 1, displayColumns - 1, RUN_TEST_COLOR)
    ROW_CASE_OFF_DISPLAY:
      display.drawLineOfColor(OFF_LINE_START_BEFORE, -OFF_DISTANCE, OFF_LINE_START_BEFORE, cellColumns + RUN_BOUNDARY_REACH, RUN_TEST_COLOR)
      display.drawLineOfColor(OFF_LINE_END_AFTER, displayColumns - OFF_DISTANCE, OFF_LINE_END_AFTER, displayColumns + OFF_DISTANCE, RUN_TEST_COLOR)
      display.drawLineOfColor(OFF_LINE_ALL_BEFORE, -OFF_DISTANCE, OFF_LINE_ALL_BEFORE, FIRST_COLUMN - 1, RUN_TEST_COLOR)
      display.drawLineOfColor(-OFF_DISTANCE, RUN_INSET, -OFF_DISTANCE, cellColumns, RUN_TEST_COLOR)
      display.drawLineOfColor(displayRows + OFF_DISTANCE, displayColumns - OFF_DISTANCE, displayRows + OFF_DISTANCE, displayColumns + OFF_DISTANCE, RUN_TEST_COLOR)
    ROW_CASE_PANEL_CLIP:
      repeat panelIdx from 0 to hub75Bffrs.maxPanels(chainIndex) - 1
        display.drawPanelLineOfColor(panelIdx, CLIP_LINE_BOTH, -OFF_DISTANCE, CLIP_LINE_BOTH, cellColumns - 1 + OFF_DISTANCE, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, CLIP_LINE_AFTER, cellColumns - OFF_DISTANCE, CLIP_LINE_AFTER, cellColumns + OFF_DISTANCE, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, CLIP_LINE_BEFORE, -OFF_DISTANCE, CLIP_LINE_BEFORE, OFF_DISTANCE, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, LINE_BEFORE_PANEL, FIRST_COLUMN, LINE_BEFORE_PANEL, cellColumns - 1, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, cellRows, FIRST_COLUMN, cellRows, cellColumns - 1, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, cellRows - 1, OFF_DISTANCE, cellRows - 1, FIRST_COLUMN, RUN_TEST_COLOR)
    ROW_CASE_COLUMNS:
      repeat bandIdx from 0 to LINE_BAND_COUNT - 1
        bandStart := lineBandStart(bandIdx, displayColumns, cellColumns)
        display.drawLineOfColor(RUN_INSET, bandStart + BAND_OFST_ONE_CELL, cellRows - 1 - RUN_INSET, bandStart + BAND_OFST_ONE_CELL, RUN_TEST_COLOR)
        display.drawLineOfColor(cellRows - RUN_BOUNDARY_REACH, bandStart + BAND_OFST_TWO_CELLS, cellRows + RUN_BOUNDARY_REACH, bandStart + BAND_OFST_TWO_CELLS, RUN_TEST_COLOR)
        display.drawLineOfColor(displayRows - 1, bandStart + BAND_OFST_FULL, FIRST_ROW, bandStart + BAND_OFST_FULL, RUN_TEST_COLOR)
        if displayRows >= cellRows * THREE_CELLS
          display.drawLineOfColor(cellRows / CELL_HALVES, bandStart + BAND_OFST_THREE_CELLS, (cellRows * (THREE_CELLS - 1)) + (cellRows / CELL_HALVES), bandStart + BAND_OFST_THREE_CELLS, RUN_TEST_COLOR)
        display.drawLineOfColor(cellRows - 1, bandStart + BAND_OFST_ONE_PIXEL, cellRows - 1, bandStart + BAND_OFST_ONE_PIXEL, RUN_TEST_COLOR)
      display.drawLineOfColor(FIRST_ROW, displayColumns - 1, displayRows - 1, displayColumns - 1, RUN_TEST_COLOR)
    ROW_CASE_COLUMN_OFF:
      display.drawLineOfColor(-OFF_DISTANCE, OFF_LINE_START_BEFORE, cellRows + RUN_BOUNDARY_REACH, OFF_LINE_START_BEFORE, RUN_TEST_COLOR)
      display.drawLineOfColor(displayRows - OFF_DISTANCE, OFF_LINE_END_AFTER, displayRows + OFF_DISTANCE, OFF_LINE_END_AFTER, RUN_TEST_COLOR)
      display.drawLineOfColor(-OFF_DISTANCE, OFF_LINE_ALL_BEFORE, FIRST_ROW - 1, OFF_LINE_ALL_BEFORE, RUN_TEST_COLOR)
      display.drawLineOfColor(RUN_INSET, -OFF_DISTANCE, cellRows, -OFF_DISTANCE, RUN_TEST_COLOR)
      display.drawLineOfColor(displayRows - OFF_DISTANCE, displayColumns + OFF_DISTANCE, displayRows + OFF_DISTANCE, displayColumns + OFF_DISTANCE, RUN_TEST_COLOR)
    ROW_CASE_COLUMN_CLIP:
      repeat panelIdx from 0 to hub75Bffrs.maxPanels(chainIndex) - 1
        display.drawPanelLineOfColor(panelIdx, -OFF_DISTANCE, CLIP_LINE_BOTH, cellRows - 1 + OFF_DISTANCE, CLIP_LINE_BOTH, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, cellRows - OFF_DISTANCE, CLIP_LINE_AFTER, cellRows + OFF_DISTANCE, CLIP_LINE_AFTER, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, -OFF_DISTANCE, CLIP_LINE_BEFORE, OFF_DISTANCE, CLIP_LINE_BEFORE, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, FIRST_ROW, LINE_BEFORE_PANEL, cellRows - 1, LINE_BEFORE_PANEL, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, FIRST_ROW, cellColumns, cellRows - 1, cellColumns, RUN_TEST_COLOR)
        display.drawPanelLineOfColor(panelIdx, OFF_DISTANCE, cellColumns - 1, FIRST_ROW, cellColumns - 1, RUN_TEST_COLOR)
    ROW_CASE_BOXES:
      display.drawBoxOfColor(BOX_INSET, cellColumns - 1, BOX_NARROW_COLUMNS, displayRows - (BOX_INSET * BOTH_SIDES), TRUE, RUN_TEST_COLOR)
      display.drawBoxOfColor(cellRows - 1, BOX_INSET, displayColumns - (BOX_INSET * BOTH_SIDES), BOX_WIDE_ROWS, TRUE, RUN_TEST_COLOR)
      display.drawBoxOfColor(BOX_OUTLINE_INSET, BOX_OUTLINE_INSET, displayColumns - (BOX_OUTLINE_INSET * BOTH_SIDES), displayRows - (BOX_OUTLINE_INSET * BOTH_SIDES), FALSE, RUN_TEST_COLOR)
      display.drawBoxOfColor(BOX_DOT_POSITION, BOX_DOT_POSITION, ONE_PIXEL, ONE_PIXEL, TRUE, RUN_TEST_COLOR)
      repeat panelIdx from 0 to hub75Bffrs.maxPanels(chainIndex) - 1
        display.drawPanelBoxOfColor(panelIdx, -RUN_BOUNDARY_REACH, cellColumns - OFF_DISTANCE, BOX_NARROW_COLUMNS, OFF_DISTANCE, TRUE, RUN_TEST_COLOR)
        display.drawPanelBoxOfColor(panelIdx, cellRows - BOX_WIDE_ROWS, -RUN_BOUNDARY_REACH, OFF_DISTANCE, OFF_DISTANCE, TRUE, RUN_TEST_COLOR)
        display.drawPanelBoxOfColor(panelIdx, BOX_INSET, -OFF_DISTANCE, cellColumns, cellRows, FALSE, RUN_TEST_COLOR)
    ROW_CASE_TEXT_5X7, ROW_CASE_TEXT_DITHERED, ROW_CASE_TEXT_8X8:
      display.setTextFont(rowCaseFont(caseIdx))
      display.setColoredTextAtLnCol(FIRST_TEXT_LINE, FIRST_TEXT_COLUMN, @runText, RUN_TEST_COLOR)
      display.setColoredTextAtLnCol(display.numberTextLines() - 1, display.numberTextColumns() - TEXT_TAIL_CHARS, @tailText, RUN_TEST_COLOR)
    ROW_CASE_SCROLL_LEFT .. ROW_CASE_SCROLL_CLEAR:
      ' each region is placed on a panel that every layout has, so it always draws something:
      ' the last panel in reading order is in the bottom cell row, P0 is the first panel, and
      ' edgePanelRow() finds a panel in the rightmost cell column
      display.setTextFont(rowCaseFont(caseIdx))
      _, panelColumn := hub75Bffrs.offsetToPanel(chainIndex, hub75Bffrs.maxPanels(chainIndex) - 1)    ' its row is the bottom cell row
      case caseIdx
        ROW_CASE_SCROLL_LEFT:
          display.scrollTextAtRCOfColor(displayRows - SCROLL_EDGE_OVERLAP, panelColumn + cellColumns - SCROLL_CELL_REACH, SCROLL_WINDOW_CHARS, @scrollText, display.DIR_TO_LEFT, RUN_TEST_COLOR)
        ROW_CASE_SCROLL_RIGHT:
          display.scrollTextAtRCOfColor(edgePanelRow(displayColumns, cellColumns) + cellRows - SCROLL_EDGE_OVERLAP, displayColumns - SCROLL_CELL_REACH, SCROLL_WINDOW_CHARS, @scrollText, display.DIR_TO_RIGHT, RUN_TEST_COLOR)
        ROW_CASE_SCROLL_UP:
          panelRow, panelColumn := hub75Bffrs.offsetToPanel(chainIndex, PANEL_P0)
          display.scrollTextAtRCOfColor(panelRow + cellRows - SCROLL_EDGE_OVERLAP, panelColumn + cellColumns - SCROLL_CELL_REACH, SCROLL_WINDOW_CHARS, @scrollText, display.DIR_UP, RUN_TEST_COLOR)
        ROW_CASE_SCROLL_IN_LEFT .. ROW_CASE_SCROLL_IN_DOWN:
          ' inside P0, so every glyph lies in one cell and is drawn as one block
          panelRow, panelColumn := hub75Bffrs.offsetToPanel(chainIndex, PANEL_P0)
          scrollCaseRegion := display.scrollTextAtRCOfColor(panelRow + RUN_INSET, panelColumn + RUN_INSET, SCROLL_WINDOW_CHARS, @scrollText, LONG[@insideDirections][caseIdx - ROW_CASE_SCROLL_IN_LEFT], RUN_TEST_COLOR)
          if caseIdx == ROW_CASE_SCROLL_IN_UP
            ' an up scroll ends after one glyph height, on the step that wraps the rows and draws
            ' the whole window; scrolling on, the comparison lands on a step that moves the frame
            display.configureScrollLoopMode(scrollCaseRegion, display.SCROLL_FOREVER)
        ROW_CASE_SCROLL_OVERDRAW:
          ' steps that move the frame, then a box drawn over the window and a cleared buffer: each
          ' must make the next step draw the whole window again
          panelRow, panelColumn := hub75Bffrs.offsetToPanel(chainIndex, PANEL_P0)
          display.scrollTextAtRCOfColor(panelRow + RUN_INSET, panelColumn + RUN_INSET, SCROLL_WINDOW_CHARS, @scrollText, display.DIR_TO_LEFT, RUN_TEST_COLOR)
          repeat OVERDRAW_STEPS
            display.animateScroll()
          display.drawBoxOfColor(panelRow + RUN_INSET + OVERDRAW_BOX_INSET, panelColumn + RUN_INSET + OVERDRAW_BOX_INSET, OVERDRAW_BOX_SIZE, OVERDRAW_BOX_SIZE, TRUE, OVERDRAW_COLOR)
          repeat OVERDRAW_STEPS
            display.animateScroll()
          display.clearScreenBuffer()
        ROW_CASE_SCROLL_CLEAR:
          ' the window is drawn as the scroll starts, before its mode is set; setting the mode must
          ' draw it again, or every later step moves a frame of the wrong mode
          panelRow, panelColumn := hub75Bffrs.offsetToPanel(chainIndex, PANEL_P0)
          scrollCaseRegion := display.scrollTextAtRCOfColor(panelRow + RUN_INSET, panelColumn + RUN_INSET, CLEAR_WINDOW_CHARS, @scrollText, display.DIR_TO_LEFT, RUN_TEST_COLOR)
          display.configureScrollLoopMode(scrollCaseRegion, display.SCROLL_ONCE_TO_CLEAR)
        other:
          display.scrollTextAtRCOfColor(displayRows - SCROLL_EDGE_OVERLAP, panelColumn + RUN_INSET, SCROLL_WINDOW_CHARS, @scrollText, display.DIR_DOWN, RUN_TEST_COLOR)
      repeat SCROLL_COMPARE_STEPS
        display.animateScroll()
      if caseIdx == ROW_CASE_SCROLL_IN_UP
        ' it scrolls forever: free it now (its pixels stay for the comparison), so the next
        ' drawing of this case, and every later case, starts with no scroller running
        display.releaseScroller(scrollCaseRegion)
    ROW_CASE_FILL_PANEL:
      display.fillPanel(caseVariant // hub75Bffrs.maxPanels(chainIndex), RUN_TEST_COLOR)
    ROW_CASE_FILL_AREA:
      layoutRows, layoutColumns, _ := hub75Bffrs.layoutSizeAndRotation(chainIndex)     ' the rotation is not needed
      layoutCellRows, layoutCellColumns := hub75Bffrs.layoutCellSizeInPixels(chainIndex)
      pixels.fillLayoutArea(chainIndex, -FILL_EDGE_REACH, layoutCellColumns - FILL_RECT_REACH, FILL_RECT_ROWS, layoutCellColumns + (FILL_RECT_REACH * BOTH_SIDES), RUN_TEST_COLOR)
      pixels.fillLayoutArea(chainIndex, layoutRows - FILL_EDGE_REACH, layoutColumns - FILL_RECT_REACH, FILL_CORNER_ROWS, FILL_CORNER_COLUMNS, RUN_TEST_COLOR)
      pixels.fillLayoutArea(chainIndex, layoutCellRows + FILL_EDGE_REACH, layoutCellColumns / CELL_HALVES, FILL_STRIP_ROWS, layoutCellColumns * (THREE_CELLS - 1), RUN_TEST_COLOR)
    ROW_CASE_DIAGONALS:
      display.drawLineOfColor(-DIAG_REACH, -DIAG_REACH, displayRows - 1 + DIAG_REACH, displayColumns - 1 + DIAG_REACH, RUN_TEST_COLOR)
      display.drawLineOfColor(displayRows - 1, 0, 0, displayColumns - 1, RUN_TEST_COLOR)
      display.drawLineOfColor(0, cellColumns - DIAG_STEEP_RUN, displayRows - 1, cellColumns + DIAG_STEEP_RUN, RUN_TEST_COLOR)
      display.drawLineOfColor(displayRows + DIAG_REACH, cellColumns + DIAG_STEEP_RUN, -DIAG_REACH, cellColumns - DIAG_STEEP_RUN, RUN_TEST_COLOR)
    ROW_CASE_CIRCLES:
      display.drawCircleOfColor(cellRows, cellColumns, cellRows / CELL_HALVES, RUN_TEST_COLOR)
      display.drawCircleOfColor(cellRows / CELL_HALVES, cellColumns / CELL_HALVES, CIRCLE_SMALL_RADIUS, RUN_TEST_COLOR)
      display.drawCircleOfColor(displayRows - CIRCLE_EDGE_INSET, displayColumns - CIRCLE_EDGE_INSET, CIRCLE_EDGE_RADIUS, RUN_TEST_COLOR)
    ROW_CASE_BMP:
      bmpHandler.placeBMP(chainIndex, @bmpFile, LONG[@testRotations][caseVariant // ROTATION_COUNT])
    other:
      repeat orientation from segment.SEG_LEFT_E to segment.SEG_BOTTOM
        segment.placeSegment(chainIndex, cellRows - SEGMENT_REACH, cellColumns - SEGMENT_REACH + ((orientation - segment.SEG_LEFT_E) * SEGMENT_SPACING), orientation, segment.STATE_ON, RUN_TEST_COLOR)
      segment.placeSegment(chainIndex, displayRows - SEGMENT_EDGE_ROWS, displayColumns - SEGMENT_EDGE_COLUMNS, segment.SEG_TOP, segment.STATE_ON, RUN_TEST_COLOR)

PRI edgePanelRow(displayColumns, cellColumns) : panelRow | panelIdx, rowOffset, columnOffset
' Return the display row of the top-left pixel of the first panel (in reading order) whose cell is
' in the rightmost cell column; every layout has one, since the display is its panels' bounding box.
'
' @param displayColumns - display width in pixels, as mounted
' @param cellColumns - pixel columns of one panel as the viewer sees it
' @returns panelRow - that panel's top row, as mounted

' Local Variables:
' @local panelIdx - panel position being looked at
' @local rowOffset - its top row
' @local columnOffset - its left column

  panelRow := FIRST_ROW
  repeat panelIdx from 0 to hub75Bffrs.maxPanels(chainIndex) - 1
    rowOffset, columnOffset := hub75Bffrs.offsetToPanel(chainIndex, panelIdx)
    if columnOffset + cellColumns == displayColumns
      panelRow := rowOffset
      quit

PRI finishRowRunCase(caseIdx)
' Finish a case after its comparison: a scrolling case is run to its end, so its scroller is free
' for the next (the inside-a-panel up scroll, which scrolls forever, was released as it was
' drawn). Other cases need nothing.
'
' @param caseIdx - ROW_CASE_* just compared

  if caseIdx >= ROW_CASE_SCROLL_LEFT and caseIdx <= ROW_CASE_SCROLL_CLEAR
    repeat SCROLL_FINISH_STEPS
      if display.isScrollingComplete() == TRUE
        quit
      display.animateScroll()

PRI rowCaseFont(caseIdx) : eFont
' Return the font a text or scrolling case draws in.
'
' @param caseIdx - ROW_CASE_* value
' @returns eFont - display.TEXT_FONT_* value

  case caseIdx
    ROW_CASE_TEXT_DITHERED, ROW_CASE_SCROLL_RIGHT, ROW_CASE_SCROLL_DOWN, ROW_CASE_SCROLL_IN_RIGHT, ROW_CASE_SCROLL_IN_DOWN:
      eFont := display.TEXT_FONT_5X7_DITH
    ROW_CASE_TEXT_8X8, ROW_CASE_SCROLL_IN_UP:
      eFont := display.TEXT_FONT_8X8A
    other:
      eFont := display.TEXT_FONT_5X7

PRI windowedNote(bWindowed) : pNote
' Return the note a case line ends with: whether the case was compared in windows.
'
' @param bWindowed - TRUE when the case was compared in windows
' @returns pNote - zero-terminated note

  pNote := @emptyNote
  if bWindowed == TRUE
    pNote := string(" (compared in windows)")

PRI lineBandStart(bandIdx, displaySize, cellSize) : bandStart
' Return the first row (column) of one band of the line (column) cases: the first cell, the
' second cell, and the last cell (the last two are the same on a display two cells across).
'
' @param bandIdx - LINE_BAND_* value
' @param displaySize - display height (width) in pixels, as mounted
' @param cellSize - pixel rows (columns) of one panel as the viewer sees it
' @returns bandStart - the band's first row (column)

  case bandIdx
    LINE_BAND_TOP:
      bandStart := FIRST_ROW
    LINE_BAND_SECOND:
      bandStart := cellSize
    other:
      bandStart := displaySize - cellSize

PRI fillBackground() | pScreen
' Fill the whole screen buffer with BACKGROUND_BYTE, so a write of any value, black included, shows.
'

' Local Variables:
' @local pScreen - hub address of the screen buffer

  pScreen := hub75Bffrs.displayBufferAddress(chainIndex)
  longfill(pScreen, BACKGROUND_LONG, hub75Bffrs.displaySizeInLongs(chainIndex))

PRI captureScreen() : nCaptured, bOverflow | pScreen, nLongs, longIdx, screenLong
' Record every long of the screen buffer that differs from the background, in order, up to
' CAPTURE_LONGS of them: their indices in the first half of captureArea, their values in the second.
'
' @returns nCaptured - longs that differ from the background (all of them, recorded or not)
' @returns bOverflow - TRUE when more than CAPTURE_LONGS differ (the case is then compared in windows)

' Local Variables:
' @local pScreen - hub address of the screen buffer
' @local nLongs - longs in the screen buffer
' @local longIdx - long being read
' @local screenLong - its value

  nCaptured := 0
  bOverflow := FALSE
  pScreen := hub75Bffrs.displayBufferAddress(chainIndex)
  nLongs := hub75Bffrs.displaySizeInLongs(chainIndex)
  repeat longIdx from 0 to nLongs - 1
    screenLong := LONG[pScreen][longIdx]
    if screenLong <> BACKGROUND_LONG
      if nCaptured < CAPTURE_LONGS
        LONG[@captureArea][nCaptured] := longIdx
        LONG[@captureArea][CAPTURE_LONGS + nCaptured] := screenLong
      else
        bOverflow := TRUE
      nCaptured++

PRI compareScreen(nRecorded) : nMismatches, firstOffset | pScreen, nLongs, longIdx, recordIdx, expectedLong
' Compare every byte of the screen buffer with the recorded drawing: a recorded long must hold its
' recorded value, every other long the background.
'
' @param nRecorded - longs recorded by captureScreen() (at most CAPTURE_LONGS)
' @returns nMismatches - bytes that differ
' @returns firstOffset - byte offset of the first that differs, or NO_OFFSET

' Local Variables:
' @local pScreen - hub address of the screen buffer
' @local nLongs - longs in the screen buffer
' @local longIdx - long being compared
' @local recordIdx - next recorded long
' @local expectedLong - the value the long must hold

  nMismatches := 0
  firstOffset := NO_OFFSET
  recordIdx := 0
  pScreen := hub75Bffrs.displayBufferAddress(chainIndex)
  nLongs := hub75Bffrs.displaySizeInLongs(chainIndex)
  repeat longIdx from 0 to nLongs - 1
    expectedLong := BACKGROUND_LONG
    if recordIdx < nRecorded
      if LONG[@captureArea][recordIdx] == longIdx
        expectedLong := LONG[@captureArea][CAPTURE_LONGS + recordIdx]
        recordIdx++
    nMismatches, firstOffset := countByteDiffs(longIdx, LONG[pScreen][longIdx], expectedLong, nMismatches, firstOffset)

PRI countByteDiffs(longIdx, screenLong, expectedLong, nMismatchesSoFar, firstOffsetSoFar) : nMismatches, firstOffset | byteIdx
' Add the bytes of one screen-buffer long that differ from the value it must hold to the counts.
'
' @param longIdx - index of the long in the screen buffer
' @param screenLong - the value it holds
' @param expectedLong - the value it must hold
' @param nMismatchesSoFar - bytes found different before this long
' @param firstOffsetSoFar - byte offset of the first found different before this long, or NO_OFFSET
' @returns nMismatches - bytes found different, this long included
' @returns firstOffset - byte offset of the first found different, or NO_OFFSET

' Local Variables:
' @local byteIdx - byte of the long being compared

  nMismatches := nMismatchesSoFar
  firstOffset := firstOffsetSoFar
  if screenLong <> expectedLong
    repeat byteIdx from 0 to hub75Bffrs.BYTES_PER_LONG - 1
      if (((screenLong ^ expectedLong) >> (byteIdx * matrix.BITS_PER_BYTE)) & BYTE_MASK) <> 0
        if firstOffset == NO_OFFSET
          firstOffset := (longIdx * hub75Bffrs.BYTES_PER_LONG) + byteIdx
        nMismatches++

PRI compareAddressRule() : nMismatches, nCompared | displayRows, displayColumns, cellRows, cellColumns, rowIdx, columnIdx, pRule, pOld
' Compare screenUtils.pixelAddressAtRC() with oldPixelAddress() on the layout in place, at one
' pixel beyond each display edge, at every cell edge and on a lattice inside. The first difference
' is printed; all are counted.
'
' @returns nMismatches - points whose addresses differ
' @returns nCompared - points compared

' Local Variables:
' @local displayRows - display height in pixels, as mounted
' @local displayColumns - display width in pixels, as mounted
' @local cellRows - pixel rows of one panel as the viewer sees it
' @local cellColumns - pixel columns of one panel as the viewer sees it
' @local rowIdx - display row being compared
' @local columnIdx - display column being compared
' @local pRule - the address pixelAddressAtRC() gives
' @local pOld - the address oldPixelAddress() gives

  nMismatches := nCompared := 0
  displayRows, displayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  cellRows, cellColumns := hub75Bffrs.cellSizeInPixels(chainIndex)
  repeat rowIdx from -ORACLE_EDGE_REACH to displayRows - 1 + ORACLE_EDGE_REACH
    if isRulePoint(rowIdx, displayRows, cellRows, ORACLE_ROW_STEP) == TRUE
      repeat columnIdx from -ORACLE_EDGE_REACH to displayColumns - 1 + ORACLE_EDGE_REACH
        if isRulePoint(columnIdx, displayColumns, cellColumns, ORACLE_COLUMN_STEP) == TRUE
          pRule := pixels.pixelAddressAtRC(chainIndex, rowIdx, columnIdx)
          pOld := oldPixelAddress(rowIdx, columnIdx)
          nCompared++
          if pRule <> pOld
            if nMismatches == 0
              debug("R", zstr_(@dbgRowRunAddressMismatchFirs), " ", sdec_(rowIdx), " column ", sdec_(columnIdx), ": rule ", uhex_long_(pRule), ", old ", uhex_long_(pOld))
            nMismatches++

PRI isRulePoint(coordIdx, displaySize, cellSize, latticeStep) : bPoint
' Return TRUE when a row (or column) is one the address-rule comparison visits: at or beyond a
' display edge, the first or last of a cell, or on the lattice.
'
' @param coordIdx - row or column
' @param displaySize - display height (or width) in pixels, as mounted
' @param cellSize - cell height (or width) in pixels, as mounted
' @param latticeStep - lattice spacing along this axis
' @returns bPoint - TRUE to compare at this row (or column)

  bPoint := coordIdx <= 0 or coordIdx >= displaySize - 1 or (coordIdx // latticeStep) == 0 or (coordIdx // cellSize) == 0 or (coordIdx // cellSize) == cellSize - 1

PRI oldPixelAddress(row, column) : pPixel | layoutRows, layoutColumns, eRotation, mountedRows, mountedColumns, mountedRow, mountedColumn, layoutRow, layoutColumn
' Reference copy of the per-pixel address rule as it stood before row runs (the address part of
' isp_hub75_screenUtils drawPixelAtRCwithRGB() at commit 11b4ab9): held to the mounted size,
' display rotation undone, then hub75Bffrs.displayPixelAddress(). It is frozen here so the
' self-test can show the extracted rule, pixelAddressAtRC(), is unchanged; the driver never calls it.
'
' @param row - pixel row on the display, as mounted
' @param column - pixel column on the display, as mounted
' @returns pPixel - hub address of the pixel's red byte, or hub75Bffrs.NO_PIXEL

' Local Variables:
' @local layoutRows - total display rows as the panels are laid out (rotation not applied)
' @local layoutColumns - total display columns as the panels are laid out
' @local eRotation - the display rotation: how the display is mounted
' @local mountedRows - total display rows, as mounted
' @local mountedColumns - total display columns, as mounted
' @local mountedRow - pixel row held to the mounted size
' @local mountedColumn - pixel column held to the mounted size
' @local layoutRow - pixel row on the display as its panels are laid out
' @local layoutColumn - pixel column on the display as its panels are laid out

  layoutRows, layoutColumns, eRotation := hub75Bffrs.layoutSizeAndRotation(chainIndex)
  mountedRows, mountedColumns := layoutRows, layoutColumns
  if (eRotation == hub75Bffrs.ROT_LEFT_90) or (eRotation == hub75Bffrs.ROT_RIGHT_90)
    mountedRows, mountedColumns := layoutColumns, layoutRows
  mountedRow := 0 #> row <# mountedRows - 1
  mountedColumn := 0 #> column <# mountedColumns - 1
  case eRotation
    hub75Bffrs.ROT_RIGHT_90:
      layoutRow := (layoutRows - 1) - mountedColumn
      layoutColumn := mountedRow
    hub75Bffrs.ROT_LEFT_90:
      layoutRow := mountedColumn
      layoutColumn := (layoutColumns - 1) - mountedRow
    hub75Bffrs.ROT_180:
      layoutRow := (layoutRows - 1) - mountedRow
      layoutColumn := (layoutColumns - 1) - mountedColumn
    other:
      layoutRow := mountedRow
      layoutColumn := mountedColumn
  pPixel := hub75Bffrs.displayPixelAddress(chainIndex, layoutRow, layoutColumn)

PRI layoutLabel(layoutIdx) : pLabel
' Return the printable name of a test layout.
'
' @param layoutIdx - LAYOUT_* under test
' @returns pLabel - zero-terminated name

  case layoutIdx
    LAYOUT_OWN:
      pLabel := string("own wiring")
    LAYOUT_WIDE_L:
      pLabel := string("wide L")
    other:
      pLabel := string("tall L")

PRI rotationLabel(rotationIdx) : pLabel
' Return the printable name of an entry of testRotations.
'
' @param rotationIdx - entry of testRotations
' @returns pLabel - zero-terminated name

  case LONG[@testRotations][rotationIdx]
    bmpHandler.ROT_NONE:
      pLabel := string("ROT_NONE")
    bmpHandler.ROT_RIGHT_90:
      pLabel := string("ROT_RIGHT_90")
    bmpHandler.ROT_180:
      pLabel := string("ROT_180")
    other:
      pLabel := string("ROT_LEFT_90")

PRI arrowLabel(arrowIdx) : pLabel
' Return the printable name of an entry of testArrows.
'
' @param arrowIdx - entry of testArrows
' @returns pLabel - zero-terminated name

  case LONG[@testArrows][arrowIdx]
    hwEnum.ARROW_UP:
      pLabel := string("up")
    hwEnum.ARROW_RIGHT:
      pLabel := string("right")
    hwEnum.ARROW_DOWN:
      pLabel := string("down")
    other:
      pLabel := string("left")

PRI rowCaseLabel(caseIdx) : pLabel
' Return the printable name of a row-run case.
'
' @param caseIdx - ROW_CASE_* value
' @returns pLabel - zero-terminated name

  case caseIdx
    ROW_CASE_LINES:
      pLabel := string("lines in 1, 2 and 3 cells")
    ROW_CASE_OFF_DISPLAY:
      pLabel := string("lines off the display")
    ROW_CASE_PANEL_CLIP:
      pLabel := string("panel-clipped lines")
    ROW_CASE_COLUMNS:
      pLabel := string("columns in 1, 2 and 3 cells")
    ROW_CASE_COLUMN_OFF:
      pLabel := string("columns off the display")
    ROW_CASE_COLUMN_CLIP:
      pLabel := string("panel-clipped columns")
    ROW_CASE_BOXES:
      pLabel := string("boxes")
    ROW_CASE_DIAGONALS:
      pLabel := string("sloped lines")
    ROW_CASE_CIRCLES:
      pLabel := string("circles")
    ROW_CASE_TEXT_5X7:
      pLabel := string("text 5x7")
    ROW_CASE_TEXT_DITHERED:
      pLabel := string("text dithered 5x7")
    ROW_CASE_TEXT_8X8:
      pLabel := string("text 8x8")
    ROW_CASE_SCROLL_LEFT:
      pLabel := string("scroll left 5x7")
    ROW_CASE_SCROLL_RIGHT:
      pLabel := string("scroll right dithered")
    ROW_CASE_SCROLL_UP:
      pLabel := string("scroll up 5x7")
    ROW_CASE_SCROLL_DOWN:
      pLabel := string("scroll down dithered")
    ROW_CASE_SCROLL_IN_LEFT:
      pLabel := string("scroll left 5x7 inside a panel")
    ROW_CASE_SCROLL_IN_RIGHT:
      pLabel := string("scroll right dithered inside a panel")
    ROW_CASE_SCROLL_IN_UP:
      pLabel := string("scroll up 8x8 inside a panel")
    ROW_CASE_SCROLL_IN_DOWN:
      pLabel := string("scroll down dithered inside a panel")
    ROW_CASE_SCROLL_OVERDRAW:
      pLabel := string("scroll left with a box drawn over it and the buffer cleared")
    ROW_CASE_SCROLL_CLEAR:
      pLabel := string("scroll left to clear, mode set after the start")
    ROW_CASE_FILL_PANEL:
      pLabel := string("fill one panel")
    ROW_CASE_FILL_AREA:
      pLabel := string("fill layout rectangles")
    ROW_CASE_BMP:
      pLabel := string("BMP")
    other:
      pLabel := string("7-segment segments")

PRI runWorkload() | phaseIdx
' Run each phase once: draw it, commit it, and measure the panel while it is shown.
'

' Local Variables:
' @local phaseIdx - phase being run

  repeat phaseIdx from 0 to PHASE_COUNT - 1
    drawPhase(phaseIdx)
    reportPhase(phaseIdx)

PRI runHandshakeTrace() | commitIdx, nCommitsBefore, nCommitsAfter, nWaited, nBad, pFirstShown, nProblems
' Commit TRACE_COMMITS times back to back, then print for each commit the frame set it converted
' into, the set on display when the conversion was done, and the set on display when the commit
' returned. A commit that converted into the set on display, or before the previous post was
' taken, prints a FAIL line; the verdict line says FAIL if any did. The first commit after start
' (display.start() clears the screen with one) is checked from the totals: nothing was on display.
'

' Local Variables:
' @local commitIdx - traced commit being run or printed
' @local nCommitsBefore - commits posted before the trace began
' @local nCommitsAfter - commits posted when the trace ended
' @local nWaited - posts that had to wait for the previous post to be taken
' @local nBad - commits the panel object counted as converting into the set on display
' @local pFirstShown - set on display when the first commit after start posted
' @local nProblems - FAIL lines printed

  nProblems := 0
  nCommitsBefore, nWaited, nBad, pFirstShown := display.commitTotals()
  if pFirstShown <> matrix.NO_FRAME_SET
    debug("R", zstr_(@dbgFailFirstCommitAfterStart), "(", uhex_long_(pFirstShown), ")", zstr_(@dbgBeforeAnySetWasTaken), "n")
    nProblems++
  else
    debug("R", zstr_(@dbgPassFirstCommitAfterStart), "(", uhex_long_(pFirstShown), ")", zstr_(@dbgConvertedWithoutWaiting), "g")

  repeat commitIdx from 0 to TRACE_COMMITS - 1
    display.commitScreenToPanelSet()
    traceConverted[commitIdx], traceShownAtPost[commitIdx], traceShownNow[commitIdx] := display.commitTrace()

  nCommitsAfter, nWaited, nBad, pFirstShown := display.commitTotals()
  repeat commitIdx from 0 to TRACE_COMMITS - 1
    debug("R", zstr_(@dbgTrace), " ", udec_(commitIdx), ":", zstr_(@dbgConverted), " ", uhex_long_(traceConverted[commitIdx]), " ", zstr_(@dbgShownAtPost), " ", uhex_long_(traceShownAtPost[commitIdx]), " ", zstr_(@dbgShownNow), " ", uhex_long_(traceShownNow[commitIdx]))
    if traceConverted[commitIdx] == traceShownAtPost[commitIdx]
      debug("R", zstr_(@dbgFailCommit), " ", udec_(commitIdx), " ", zstr_(@dbgConvertedIntoTheSetOn), " ", uhex_long_(traceConverted[commitIdx]))
      nProblems++
    if commitIdx > FIRST_TRACE_COMMIT and traceShownAtPost[commitIdx] <> traceConverted[commitIdx - 1]
      debug("R", zstr_(@dbgFailCommit), " ", udec_(commitIdx), " ", zstr_(@dbgConvertedBeforeTheSetPost), " ", udec_(commitIdx - 1), " (", uhex_long_(traceConverted[commitIdx - 1]), ")", zstr_(@dbgWasTakenOnDisplayWas), " ", uhex_long_(traceShownAtPost[commitIdx]))
      nProblems++

  if nCommitsAfter - nCommitsBefore <> TRACE_COMMITS
    debug("R", zstr_(@dbgFail), " ", udec_(nCommitsAfter - nCommitsBefore), " ", zstr_(@dbgCommitsCountedExpected), " ", udec_(TRACE_COMMITS))
    nProblems++
  if nBad <> 0
    debug("R", zstr_(@dbgFailThePanelObjectCounted), " ", udec_(nBad), " ", zstr_(@dbgCommitsThatConvertedIntoT), "y")
    nProblems++
  if nProblems == 0
    debug("R", zstr_(@dbgHandshakePass), " ", udec_(TRACE_COMMITS), " ", zstr_(@dbgCommitsNoneConvertedIntoT), " ", udec_(nWaited), " of ", udec_(nCommitsAfter), " ", zstr_(@dbgPostsWaitedForThePrevious), "n")
  else
    debug("R", zstr_(@dbgHandshakeFail), " ", udec_(nProblems), " ", zstr_(@dbgProblemSIn), " ", udec_(TRACE_COMMITS), " commits")

PRI runBrightnessSteps() | stepIdx, windowIdx, brightness, fullLitX100, relativePercent, bLabels
' Measure the lit share at each brightness step while the last committed image is shown, then
' restore full brightness. Brightness is /OE time, so the lit share follows it down to the
' chip-minimum floor, and 0 must read 0%. Each step is labelled on the panel: its number and
' brightness at once, and after window LABEL_WINDOW the lit share relative to the full step's.
' A display too narrow for a label line (LABEL_LINE_CHARS characters) gets no labels.
'

' Local Variables:
' @local stepIdx - brightness step being measured
' @local windowIdx - monitor window being taken
' @local brightness - brightness value of this step
' @local fullLitX100 - lit share of the full-brightness step's window LABEL_WINDOW, percent x100
' @local relativePercent - this step's lit share as a whole percent of the full step's
' @local bLabels - TRUE when a label line fits across the display

  fullLitX100 := 0
  display.setTextFont(display.TEXT_FONT_5x7)
  bLabels := display.numberTextColumns() >= LABEL_LINE_CHARS
  if bLabels == FALSE
    debug("R", zstr_(@dbgBrightnessLabelsOffTheDis), " ", udec_(display.numberTextColumns()), " ", zstr_(@dbgTextColumnsAndALabel), " ", udec_(LABEL_LINE_CHARS))
  repeat stepIdx from 0 to BRIGHTNESS_STEP_COUNT - 1
    brightness := LONG[@brightnessSteps][stepIdx]
    display.setBrightness(brightness)
    if bLabels == TRUE
      showStepLabel(stepIdx + 1, brightness)
    relativePercent := 0
    debug("R", zstr_(@dbgBrightness), " ", udec_(brightness), " ", zstr_(@dbgNowShowing), "g")
    repeat windowIdx from 1 to BRIGHTNESS_SAMPLE_SECONDS
      instrument.sampleSecond()
      if windowIdx == LABEL_WINDOW
        if stepIdx == 0
          fullLitX100 := instrument.litShareX100()
        if fullLitX100 > 0
          relativePercent := muldiv64(instrument.litShareX100(), colorUtils.PERCENT_SCALE, fullLitX100)
        if bLabels == TRUE
          showLitLabel(relativePercent)
    debug("R", zstr_(@dbgBrightness), " ", udec_(brightness), ":", zstr_(@dbgRefresh), " ", udec_(instrument.refreshRateX100() / matrix.FIXED_POINT_SCALE), ".", udec_((instrument.refreshRateX100() // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), " Hz, lit ", udec_(instrument.litShareX100() / matrix.FIXED_POINT_SCALE), ".", udec_((instrument.litShareX100() // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), "%, label ", udec_(relativePercent), "% of full")
  display.setBrightness(matrix.FULL_BRIGHTNESS)

PRI runTearingTest() | endMs, commitCount, pScreen, screenBytes
' Alternate a full white and a full black screen at the fastest commit rate for TEAR_TEST_SECONDS.
' The screen buffer is filled directly (a byte fill takes microseconds) so the commits run back
' to back. Without tearing every refresh shows one whole screen; a torn frame shows a band of each.
'

' Local Variables:
' @local endMs - millisecond count (getms()) when the test ends; the system counter would wrap
' @local commitCount - commits made
' @local pScreen - hub address of the screen buffer
' @local screenBytes - size of the screen buffer in bytes

  commitCount := 0
  pScreen := hub75Bffrs.displayBufferAddress(chainIndex)
  screenBytes := hub75Bffrs.displaySizeInLongs(chainIndex) * hub75Bffrs.BYTES_PER_LONG
  debug("R", zstr_(@dbgTearingTestWhiteAndBlack), " ", udec_(TEAR_TEST_SECONDS), " s")
  endMs := getms() + (TEAR_TEST_SECONDS * MS_PER_SECOND)
  repeat while getms() - endMs < 0
    bytefill(pScreen, SCREEN_BYTE_WHITE, screenBytes)
    display.commitScreenToPanelSet()
    bytefill(pScreen, SCREEN_BYTE_BLACK, screenBytes)
    display.commitScreenToPanelSet()
    commitCount += 2
  debug("R", zstr_(@dbgTearingTestDone), " ", udec_(commitCount), " ", zstr_(@dbgCommitsIn), " ", udec_(TEAR_TEST_SECONDS), " s")

PRI runPatterns() | patternIdx, displayRows, displayColumns
' Draw each plan section 1 test pattern over the whole display, commit it, name it in the log
' and hold it PATTERN_HOLD_SECONDS so it can be judged by eye.
'

' Local Variables:
' @local patternIdx - PATTERN_* being shown
' @local displayRows - display height in pixels
' @local displayColumns - display width in pixels

  displayRows, displayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  repeat patternIdx from 0 to PATTERN_COUNT - 1
    display.clearScreenBuffer()
    drawPattern(patternIdx, displayRows, displayColumns)
    display.commitScreenToPanelSet()
    debug("R", zstr_(@dbgPattern), " ", udec_(patternIdx + 1), " of ", udec_(PATTERN_COUNT), ": ", zstr_(patternLabel(patternIdx)))
    waitms(PATTERN_HOLD_SECONDS * MS_PER_SECOND)

PRI drawPattern(patternIdx, displayRows, displayColumns) | columnIdx, rowIdx, level, bandIdx, bandRows
' Draw one test pattern into the screen buffer, in display coordinates.
'
' @param patternIdx - PATTERN_* to draw
' @param displayRows - display height in pixels
' @param displayColumns - display width in pixels

' Local Variables:
' @local columnIdx - display column being drawn
' @local rowIdx - display row being drawn
' @local level - the ramp's level at this column
' @local bandIdx - BAND_* being drawn
' @local bandRows - rows in one band

  bandRows := displayRows / BAND_COUNT
  case patternIdx
    PATTERN_GREY_RAMP:
      repeat columnIdx from FIRST_COLUMN to displayColumns - 1
        level := columnIdx * LEVEL_COUNT / displayColumns
        display.drawBoxOfColor(FIRST_ROW, columnIdx, ONE_PIXEL, displayRows, TRUE, rgbOf(level, level, level))
    PATTERN_RGB_BANDS:
      repeat columnIdx from FIRST_COLUMN to displayColumns - 1
        level := columnIdx * LEVEL_COUNT / displayColumns
        repeat bandIdx from 0 to BAND_COUNT - 1
          display.drawBoxOfColor(bandIdx * bandRows, columnIdx, ONE_PIXEL, bandRows, TRUE, bandColor(bandIdx, level))
    PATTERN_SOLID_RED:
      display.fillScreen(rgbOf(colorUtils.MAX_COLOR_VALUE, 0, 0))
    PATTERN_SOLID_GREEN:
      display.fillScreen(rgbOf(0, colorUtils.MAX_COLOR_VALUE, 0))
    PATTERN_SOLID_BLUE:
      display.fillScreen(rgbOf(0, 0, colorUtils.MAX_COLOR_VALUE))
    PATTERN_SOLID_WHITE:
      display.fillScreen(rgbOf(colorUtils.MAX_COLOR_VALUE, colorUtils.MAX_COLOR_VALUE, colorUtils.MAX_COLOR_VALUE))
    other:
      repeat rowIdx from FIRST_ROW to displayRows - 1
        repeat columnIdx from FIRST_COLUMN to displayColumns - 1
          if (rowIdx + columnIdx) // CHECKER_PHASES == CHECKER_LIT_PHASE
            display.drawBoxOfColor(rowIdx, columnIdx, ONE_PIXEL, ONE_PIXEL, TRUE, color.cWhite)

PRI bandColor(bandIdx, level) : rgbColor
' Return the colour of a band pattern pixel: the band's channel (or all three) at level.
'
' @param bandIdx - BAND_* of the pixel
' @param level - ramp level 0..255
' @returns rgbColor - 24-bit $RRGGBB colour

  case bandIdx
    BAND_RED:
      rgbColor := rgbOf(level, 0, 0)
    BAND_GREEN:
      rgbColor := rgbOf(0, level, 0)
    BAND_BLUE:
      rgbColor := rgbOf(0, 0, level)
    other:
      rgbColor := rgbOf(level, level, level)

PRI rgbOf(redLevel, greenLevel, blueLevel) : rgbColor
' Compose a 24-bit $RRGGBB colour from three 8-bit levels.
'
' @param redLevel - red 0..255
' @param greenLevel - green 0..255
' @param blueLevel - blue 0..255
' @returns rgbColor - 24-bit $RRGGBB colour

  rgbColor := (redLevel << colorUtils.RED_SHIFT) | (greenLevel << colorUtils.GREEN_SHIFT) | blueLevel

PRI patternLabel(patternIdx) : pLabel
' Return what a viewer should see in a test pattern.
'
' @param patternIdx - PATTERN_* shown
' @returns pLabel - zero-terminated description

  case patternIdx
    PATTERN_GREY_RAMP:
      pLabel := string("grey ramp: dark to bright left to right, even steps, no missing or doubled bands")
    PATTERN_RGB_BANDS:
      pLabel := string("bands top to bottom: red, green, blue, white ramps")
    PATTERN_SOLID_RED:
      pLabel := string("solid red")
    PATTERN_SOLID_GREEN:
      pLabel := string("solid green")
    PATTERN_SOLID_BLUE:
      pLabel := string("solid blue")
    PATTERN_SOLID_WHITE:
      pLabel := string("solid white")
    other:
      pLabel := string("one-pixel checkerboard: dark pixels stay dark (no ghosting)")

PRI reportTakeCheck(nCommitsBefore) | nCommitsAfter, nTakes, nOnBoundary, nOffBoundary, lastOffRow, nProblems
' Print the frame-set take check: every take must have been made at a frame boundary, and the
' takes counted must equal the commits made since the check started (each commit posts the set
' not on display, so each is taken once), or the check missed some.
'
' @param nCommitsBefore - commits posted before the take check started

' Local Variables:
' @local nCommitsAfter - commits posted by now
' @local nTakes - takes the check saw
' @local nOnBoundary - takes made at a frame boundary
' @local nOffBoundary - takes made part way through a frame
' @local lastOffRow - row address of the latest take off the boundary
' @local nProblems - FAIL lines printed

  waitms(TAKE_SETTLE_MS)
  nCommitsAfter := commitsPosted()
  nTakes, nOnBoundary, nOffBoundary, lastOffRow := instrument.takeTotals()
  nProblems := 0
  if nOffBoundary <> 0
    debug("R", zstr_(@dbgFail), " ", udec_(nOffBoundary), " of ", udec_(nTakes), " ", zstr_(@dbgFrameSetTakesWerePart), " ", udec_(lastOffRow), ",", zstr_(@dbgExpected), " ", udec_(rowsPerRefresh() - 1), ")")
    nProblems++
  if nTakes <> nCommitsAfter - nCommitsBefore
    debug("R", zstr_(@dbgFailTheTakeCheckSaw), " ", udec_(nTakes), " ", zstr_(@dbgTakesFor), " ", udec_(nCommitsAfter - nCommitsBefore), " commits")
    nProblems++
  if nTakes == 0
    debug("R", zstr_(@dbgFailTheTakeCheckSaw2), "s")
    nProblems++
  if nProblems == 0
    debug("R", zstr_(@dbgTakeCheckPass), " ", udec_(nOnBoundary), " of ", udec_(nTakes), " ", zstr_(@dbgFrameSetTakesAtA), " ", udec_(rowsPerRefresh() - 1), " ", zstr_(@dbgOnThePinsOnePer), "t")
  else
    debug("R", zstr_(@dbgTakeCheckFail), " ", udec_(nProblems), " ", zstr_(@dbgProblemS), " ", udec_(nOnBoundary), " ", zstr_(@dbgOnTheBoundary), " ", udec_(nOffBoundary), " off it, ", udec_(nTakes), " takes, ", udec_(nCommitsAfter - nCommitsBefore), " commits")

PRI commitsPosted() : nCommits
' Return the commits posted since start (the first of display.commitTotals()).
'
' @returns nCommits - commits posted

  nCommits, _, _, _ := display.commitTotals()

PRI showStepLabel(stepNumber, brightness)
' Label a brightness step on the panel: "STEP n OF count  B nnn" with the lit line blank until the
' step's window LABEL_WINDOW is measured, then commit so the label shows.
'
' @param stepNumber - step being shown, from 1
' @param brightness - its brightness value

  labelStart()
  labelAppendText(string("STEP "))
  labelAppendDecimal(stepNumber)
  labelAppendText(string(" OF "))
  labelAppendDecimal(BRIGHTNESS_STEP_COUNT)
  labelAppendText(string("  B "))
  labelAppendDecimal(brightness)
  labelPlace(LABEL_STEP_LINE)
  labelStart()
  labelAppendText(string("LIT ..."))
  labelPlace(LABEL_LIT_LINE)
  display.commitScreenToPanelSet()

PRI showLitLabel(relativePercent)
' Show the step's measured lit share relative to full: "LIT nnn% OF FULL", and commit.
'
' @param relativePercent - lit share as a whole percent of the full step's

  labelStart()
  labelAppendText(string("LIT "))
  labelAppendDecimal(relativePercent)
  labelAppendText(string("% OF FULL"))
  labelPlace(LABEL_LIT_LINE)
  display.commitScreenToPanelSet()

PRI labelStart()
' Begin an empty label line.
'

  labelLength := 0
  BYTE[@labelLine][labelLength] := 0

PRI labelAppendText(pZString) | charIdx
' Append zero-terminated text to the label line, up to LABEL_LINE_CHARS characters.
'
' @param pZString - text to append

' Local Variables:
' @local charIdx - index into the text

  charIdx := 0
  repeat while BYTE[pZString][charIdx] <> 0 and labelLength < LABEL_LINE_CHARS
    BYTE[@labelLine][labelLength++] := BYTE[pZString][charIdx++]
  BYTE[@labelLine][labelLength] := 0

PRI labelAppendDecimal(labelNumber) | divisor
' Append a non-negative number in decimal to the label line, up to LABEL_LINE_CHARS characters.
'
' @param labelNumber - number to append (0 or more)

' Local Variables:
' @local divisor - place value of the digit being appended

  divisor := 1
  repeat while labelNumber / divisor >= DECIMAL_BASE
    divisor *= DECIMAL_BASE
  repeat while divisor > 0 and labelLength < LABEL_LINE_CHARS
    BYTE[@labelLine][labelLength++] := "0" + (labelNumber / divisor) // DECIMAL_BASE
    divisor /= DECIMAL_BASE
  BYTE[@labelLine][labelLength] := 0

PRI labelPlace(textLine)
' Draw the label line in white on the given text line, left-aligned and padded with spaces to
' LABEL_LINE_CHARS so it erases the longer label it replaces.
'
' @param textLine - text line to draw on

  display.setColoredTextAtLnWithAlignPad(textLine, @labelLine, color.cWhite, display.ALIGN_LEFT, LABEL_LINE_CHARS)

PRI refuseNullFrameSet() | showStatus
' Call display.showFrameSet(0): the call must print its refusal and post nothing.
'

' Local Variables:
' @local showStatus - what showFrameSet() answered

  showStatus := display.showFrameSet(matrix.NO_FRAME_SET)
  if showStatus == display.E_FRAMESET_NULL
    debug("R", zstr_(@dbgPassShowframeset0RefusedI), ")")
  else
    debug("R", zstr_(@dbgFailShowframeset0WasNot), " ", sdec_(showStatus))

PRI drawPhase(phaseIdx) | drawStart, commitStart
' Draw one phase into the screen buffer and commit it, timing each step.
'
' @param phaseIdx - PHASE_* to run

' Local Variables:
' @local drawStart - stopwatch tick when drawing began
' @local commitStart - stopwatch tick when the commit began

  display.clearScreenBuffer()
  drawStart := instrument.stopwatchStart()
  case phaseIdx
    PHASE_FILL:
      display.fillScreen(color.cWhite)
    PHASE_LINES:
      drawLines()
    PHASE_TEXT:
      drawText()
    other:
      bmpHandler.fillScreenFromBMP(chainIndex, @bmpFile)
  drawMicros := instrument.stopwatchMicros(drawStart)

  commitStart := instrument.stopwatchStart()
  display.commitScreenToPanelSet()
  commitMicros := instrument.stopwatchMicros(commitStart)

PRI drawLines() | lastRow, lastColumn, lineIdx, endColumn
' Draw LINE_COUNT lines from the top-left corner to evenly spaced points on the bottom edge.
'

' Local Variables:
' @local lastRow - bottom row of the display
' @local lastColumn - rightmost column of the display
' @local lineIdx - line being drawn
' @local endColumn - column where the line ends on the bottom row

  lastRow := hub75Bffrs.maxDisplayRows(chainIndex) - 1
  lastColumn := hub75Bffrs.maxDisplayColumns(chainIndex) - 1
  repeat lineIdx from 0 to LINE_COUNT - 1
    endColumn := (lastColumn * lineIdx) / (LINE_COUNT - 1)
    if (lineIdx // LINE_COLOR_PHASES) <> 0
      display.drawLineOfColor(FIRST_ROW, FIRST_COLUMN, lastRow, endColumn, color.cYellow)
    else
      display.drawLineOfColor(FIRST_ROW, FIRST_COLUMN, lastRow, endColumn, color.cCyan)

PRI drawText() | textLine
' Fill the display with lines of text.
'

' Local Variables:
' @local textLine - text line being drawn

  display.setTextFont(display.TEXT_FONT_5x7)
  repeat textLine from 0 to display.numberTextLines() - 1
    display.setColoredTextAtLnCol(textLine, FIRST_TEXT_COLUMN, @textMessage, color.cGreen)

PRI reportPhase(phaseIdx) | windowIdx, sampleStatus
' Sample the monitors while the phase is shown and print the phase's line from the last window.
'
' @param phaseIdx - PHASE_* just committed

' Local Variables:
' @local windowIdx - monitor window being taken
' @local sampleStatus - instrument.SUCCESS if the monitors were read

  sampleStatus := instrument.E_NOT_RUNNING
  repeat windowIdx from 1 to SAMPLE_SECONDS
    sampleStatus := instrument.sampleSecond()
    if sampleStatus <> instrument.SUCCESS
      quit
  if sampleStatus == instrument.SUCCESS
    debug("R", zstr_(@dbgDepth), " ", udec_(colorDepth), " ", zstr_(phaseLabel(phaseIdx)), ":", zstr_(@dbgRefresh), " ", udec_(instrument.refreshRateX100() / matrix.FIXED_POINT_SCALE), ".", udec_((instrument.refreshRateX100() // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), " Hz, lit ", udec_(instrument.litShareX100() / matrix.FIXED_POINT_SCALE), ".", udec_((instrument.litShareX100() // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), "%, clock ", udec_(instrument.clockRisesPerSecond()), " ", zstr_(@dbgRisesSClkHigh), " ", udec_(instrument.clockHighNsX100() / matrix.FIXED_POINT_SCALE), ".", udec_((instrument.clockHighNsX100() // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), " ", zstr_(@dbgNsDraw), " ", udec_(drawMicros), " ", zstr_(@dbgUsCommit), " ", udec_(commitMicros), " uS")
  else
    debug("R", zstr_(@dbgDepth), " ", udec_(colorDepth), " ", zstr_(phaseLabel(phaseIdx)), ":", zstr_(@dbgMonitorsUnavailableDraw), " ", udec_(drawMicros), " ", zstr_(@dbgUsCommit), " ", udec_(commitMicros), " uS")

PRI latchesPerRefresh() : latchCount
' Count the LATCH rises that make one refresh: one per row of every plane. The OE-weighted
' refresh core latches each plane once per row, so one refresh is rows x depth.
'
' @returns latchCount - LATCH rises in one full refresh

  latchCount := hub75Bffrs.colorDepth(chainIndex) * rowsPerRefresh()

PRI rowsPerRefresh() : rowsInFrame | driverConfig, eChipType, chainColumns, rowLongs
' Count the row addresses one refresh scans. This repeats the sizing of isp_hub75_rgb3bit.spin2
' start(): one row is what one row address shifts.
'
' @returns rowsInFrame - rows (row addresses) in one PWM frame

' Local Variables:
' @local driverConfig - flags and chip type from getDriverFlags()
' @local eChipType - hwEnum.CHIP_* of the panels
' @local chainColumns - column clocks one row address shifts
' @local rowLongs - longs in one row of the PWM frame

  driverConfig, eChipType := hub75Bffrs.getDriverFlags(chainIndex)
  chainColumns := hub75Bffrs.columnsPerPanel(chainIndex) * hub75Bffrs.maxPanels(chainIndex)
  if (driverConfig & matrix.DRIVER_FLAGS_MASK & hwEnum.SCAN_4) <> 0
    chainColumns *= hub75Bffrs.SCAN_4_COLUMN_FACTOR
  rowLongs := ((chainColumns * hub75Bffrs.BYTES_PER_COLUMN_CLOCK) + hub75Bffrs.BYTES_PER_LONG - 1) / hub75Bffrs.BYTES_PER_LONG
  rowsInFrame := hub75Bffrs.pwmFrameSizeInLongs(chainIndex) / rowLongs

PRI phaseLabel(phaseIdx) : pLabel
' Return the printable name of a phase.
'
' @param phaseIdx - PHASE_* value
' @returns pLabel - zero-terminated name

  case phaseIdx
    PHASE_FILL:
      pLabel := string("fill")
    PHASE_LINES:
      pLabel := string("lines")
    PHASE_TEXT:
      pLabel := string("text")
    other:
      pLabel := string("bmp")

