    dbgInstrumentNotStartedStatu BYTE    "ATES: instrument not started (status", 0
    dbgDrawAndCommitTimesOnly    BYTE    ": draw and commit times onl", 0
    dbgEndSession                BYTE    "ND_SESSIO", 0
