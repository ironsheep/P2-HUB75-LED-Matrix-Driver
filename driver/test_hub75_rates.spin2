    dbgHub75CorruptPixelAddressI BYTE    "ATES: HUB75_CORRUPT_PIXEL_ADDRESS is defined: pixelAddressAtRC() answers one pixel early, so every address-rule line must FAI", 0
    dbgRowRun                    BYTE    "ATES: row run", 0
