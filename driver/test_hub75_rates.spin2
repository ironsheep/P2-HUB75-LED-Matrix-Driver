    dbgScrollOraclePass          BYTE    "ATES: SCROLL ORACLE PASS:", 0
    dbgFramesIdenticalToTheStati BYTE    "frames identical to the static tex", 0
    dbgScrollOracleFail          BYTE    "ATES: SCROLL ORACLE FAIL:", 0
