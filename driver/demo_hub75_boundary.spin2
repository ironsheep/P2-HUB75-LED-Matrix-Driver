'' =================================================================================================
''
''   File....... demo_hub75_boundary.spin2
''   Purpose.... Top-level Demonstration - boundary test: draws across the panel seams of a multi-panel display
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2026
''   Updated.... 09 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ = 335_000_000                                        ' system freq as a constant
    _clkfreq = CLK_FREQ                                           ' set system clock

CON ' ---- Debug Settings ----

    DEBUG_COGS = %11111111
    DEBUG_BAUD = 2_000_000

CON ' ---- Boundary Test Geometry ----

    BOX_MARGIN_PIX = 4                                            ' gap between the spanning box and the display edge
    BOX_MARGIN_SIDES = 2                                          ' the margin is left on both sides of each span
    TEXT_LINE_DIVISOR = 8                                         ' text line = (number of text lines) / this
    PANEL_LINE_ROW_DIVISOR = 8                                    ' panel-line row = (rows per panel) / this
    TEST_PANEL = 0                                                ' panel position P0 (top-left)
    FIRST_ROW = 0                                                 ' top row of the display
    FIRST_COLUMN = 0                                              ' leftmost column of the display

OBJ ' ---- Objects ----

    color       : "isp_hub75_color"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    display     : "isp_hub75_display"

DAT ' ---- Boundary Text ----

    seamMessage     BYTE    "ACROSS THE SEAM",0

VAR ' ---- Per-instance State ----

    LONG    chainIndex

PUB main()
'' Start the display driver, draw the boundary test once, report the end of the session,
'' then hold the image on the panels.
''

  debug("Demo: HUB75 Boundary Test")

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(display.HUB75_ADAPTER_1)

  demoBoundary()
  debug("END_SESSION")

  repeat                                                        ' hold the image

PRI demoBoundary()
' Draw the boundary test, then show it.
'

  display.clearScreenBuffer()

  drawCrosshair()
  drawSpanningBox()
  drawCenterCircle()
  drawSeamText()
  drawPanelLineOverEdge()

  display.commitScreenToPanelSet()

PRI drawCrosshair() | centerRow, centerColumn, lastRow, lastColumn
' Draw a line along the centre row and one along the centre column of the display.
'

' Local Variables:
' @local centerRow - display row of the horizontal line
' @local centerColumn - display column of the vertical line
' @local lastRow - bottom row of the display
' @local lastColumn - rightmost column of the display

  lastRow := hub75Bffrs.maxDisplayRows(chainIndex) - 1
  lastColumn := hub75Bffrs.maxDisplayColumns(chainIndex) - 1
  centerRow := hub75Bffrs.maxDisplayRows(chainIndex) / display.CENTER_DIVISOR
  centerColumn := hub75Bffrs.maxDisplayColumns(chainIndex) / display.CENTER_DIVISOR

  display.drawLineOfColor(centerRow, FIRST_COLUMN, centerRow, lastColumn, color.cWhite)
  display.drawLineOfColor(FIRST_ROW, centerColumn, lastRow, centerColumn, color.cWhite)

PRI drawSpanningBox() | boxWidth, boxHeight
' Draw one box outline that spans all of the panels, inset from the display edge.
'

' Local Variables:
' @local boxWidth - box width in pixels
' @local boxHeight - box height in pixels

  boxWidth := hub75Bffrs.maxDisplayColumns(chainIndex) - (BOX_MARGIN_PIX * BOX_MARGIN_SIDES)
  boxHeight := hub75Bffrs.maxDisplayRows(chainIndex) - (BOX_MARGIN_PIX * BOX_MARGIN_SIDES)

  display.drawBoxOfColor(BOX_MARGIN_PIX, BOX_MARGIN_PIX, boxWidth, boxHeight, FALSE, color.cYellow)

PRI drawCenterCircle() | centerRow, centerColumn, radius
' Draw a circle centred on the display centre, as large as half a panel's height.
'

' Local Variables:
' @local centerRow - display row of the circle centre
' @local centerColumn - display column of the circle centre
' @local radius - circle radius in pixels

  centerRow := hub75Bffrs.maxDisplayRows(chainIndex) / display.CENTER_DIVISOR
  centerColumn := hub75Bffrs.maxDisplayColumns(chainIndex) / display.CENTER_DIVISOR
  radius := hub75Bffrs.rowsPerPanel(chainIndex) / display.CENTER_DIVISOR

  display.drawCircleOfColor(centerRow, centerColumn, radius, color.cCyan)

PRI drawSeamText() | textLine, textColumn
' Draw one text string centred on the display centre column, so it crosses the vertical seam.
'

' Local Variables:
' @local textLine - text line holding the string
' @local textColumn - text column of the first character

  display.setTextFont(display.TEXT_FONT_8x8A)
  display.setTextColor(color.cGreen)

  textLine := display.numberTextLines() / TEXT_LINE_DIVISOR
  textColumn := (display.numberTextColumns() - strsize(@seamMessage)) / display.CENTER_DIVISOR

  display.setCursor(textLine, textColumn)
  display.setTextAtCursor(@seamMessage)

PRI drawPanelLineOverEdge() | panelRows, panelColumns, lineRow, fromColumn, toColumn
' Draw a panel-centric line on panel P0 that runs on past the panel's right edge, so it must be clipped.
'

' Local Variables:
' @local panelRows - pixel rows in one panel, as the viewer sees it with the display as mounted
' @local panelColumns - pixel columns in one panel, as the viewer sees it with the display as mounted
' @local lineRow - panel row of the line
' @local fromColumn - panel column where the line starts
' @local toColumn - panel column where the line ends (beyond the right edge)

  panelRows, panelColumns := hub75Bffrs.cellSizeInPixels(chainIndex)
  lineRow := panelRows / PANEL_LINE_ROW_DIVISOR
  fromColumn := panelColumns / display.CENTER_DIVISOR
  toColumn := panelColumns + (panelColumns / display.CENTER_DIVISOR)

  display.drawPanelLineOfColor(TEST_PANEL, lineRow, fromColumn, lineRow, toColumn, color.cRed)

