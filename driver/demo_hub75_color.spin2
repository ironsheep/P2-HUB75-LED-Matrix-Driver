'' =================================================================================================
''
''   File....... demo_hub75_color.spin2
''   Purpose.... Top-level Demonstration - showing off colour, text, drawing and BMP display on the HUB75 matrix
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2020
''   Updated.... 09 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant 2.985 nSec
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

CON ' ---- Debug Settings ----

    DEBUG_COGS  = %11111111
    DEBUG_BAUD  = 2_000_000

CON ' ---- Demo Selection ----

    ' The demos run in this order, one per pass of the sequence in main():
    '  DEMO_TEXT         - driver info text
    '  DEMO_PARALLAX     - Parallax branding inside a coloured border
    '  DEMO_HUE_GROUPS   - hue spectrum in six 60-degree groups
    '  DEMO_HUE_LINES    - hue spectrum as continuous lines
    '  DEMO_PALETTE      - twelve mini panels of the 11x10x10 palette plus greys
    '  DEMO_SWEEP        - 256-step sweeps of seven colour channels
    '  DEMO_BRIGHTNESS   - 12x9 grid of brightness swatches
    '  DEMO_COLOR_BLAST  - computed colour gradients in a tile grid
    '  DEMO_TEXT_AGAIN   - driver info text again
    '  DEMO_SCREEN_BLAST - all eight 3-bit colours filling the screen (no pause after it)
    '  DEMO_BMP_FILE     - a .bmp image
    #1, DEMO_TEXT, DEMO_PARALLAX, DEMO_HUE_GROUPS, DEMO_HUE_LINES, DEMO_PALETTE, DEMO_SWEEP, DEMO_BRIGHTNESS, DEMO_COLOR_BLAST, DEMO_TEXT_AGAIN, DEMO_SCREEN_BLAST, DEMO_BMP_FILE

    DEMO_COUNT          = DEMO_BMP_FILE                             ' number of demos in the sequence
    DEMO_PASSES         = 2                                         ' times the whole sequence repeats
    DEMO_PAUSE_SECONDS  = 3                                         ' seconds between demos (time for current meas. to settle)
    MS_PER_SECOND       = 1000

CON ' ---- Display Geometry ----

    PANEL_ROWS_32       = 32                                        ' a panel this tall (or shorter) is a 64x32 or smaller
    PANEL_COLUMNS_64    = 64                                        ' a panel wider than this is a 128 wide panel
    LAST_ROW_32         = 31                                        ' last row of a 32 row panel
    LAST_COLUMN_64      = 63                                        ' last column of a 64 column panel
    HALF_COLUMN         = 32                                        ' first column of the right half of a 64 column panel

CON ' ---- Colour Arithmetic ----

    CHANNEL_MAX         = 255                                       ' full brightness of one colour channel
    CHANNEL_LEVELS      = 256                                       ' distinct levels of one colour channel
    DECIMAL_BASE        = 10
    ASCII_ZERO          = $30                                       ' the character '0'

    ' brightness levels used by the swatch grid (percent of CHANNEL_MAX)
    LEVEL_10_PCT        = 25
    LEVEL_20_PCT        = 51
    LEVEL_30_PCT        = 76
    LEVEL_40_PCT        = 102
    LEVEL_50_PCT        = 128
    LEVEL_60_PCT        = 153
    LEVEL_80_PCT        = 204
    LEVEL_FULL          = CHANNEL_MAX
    GRAY_STEP           = 32                                        ' step between the grey levels of the swatch grid
    GRAY_TOP_ROW        = 4                                         ' swatch row at which the grey levels stop rising

CON ' ---- Test Pattern Layout ----

    LINE_0              = 0                                         ' text line numbers, counted from the top
    LINE_1              = 1
    LINE_2              = 2
    FIRST_COLUMN        = 0                                         ' text lines start at the left edge

    SCAN_BAND_ROWS      = 4                                         ' height of a band in the 1/8 scan check
    SCAN_BOX_COLUMN     = 1                                         ' left column of the check bands
    SCAN_BOX_WIDTH      = 62                                        ' width of the check bands
    SCAN5_BAND_ROWS     = 3                                         ' height of a band in the fifth 1/8 scan check
    SCAN5_LAST_BAND_ROWS = 2                                        ' height of the last band of the fifth check
    SCAN_BANDS          = 8                                         ' bands in the 1/8 scan check
    SCAN5_BANDS         = 11                                        ' bands in the fifth 1/8 scan check
    ROW_ID_TENS_COLUMN  = 5                                         ' first column of the tens dots of a row number
    ROW_ID_ONES_COLUMN  = 10                                        ' first column of the ones dots of a row number

    SWATCH_ROWS         = 9                                         ' rows of swatches in the brightness grid

    ' the swatch columns of the brightness grid: which channels are at high (H), medium (M) or
    ' low brightness (r = red, g = green, b = blue); the last column is the grey ramp
    #0, SWATCH_RH, SWATCH_RH_GM, SWATCH_RH_GH, SWATCH_RM_GH, SWATCH_GH, SWATCH_GH_BM, SWATCH_GH_BH, SWATCH_GM_BH, SWATCH_BH, SWATCH_RM_BH, SWATCH_RH_BH, SWATCH_RH_BM, SWATCH_GRAY
    SWATCH_COLUMNS      = SWATCH_GRAY + 1                           ' columns of swatches in the brightness grid

    HUE_GROUP_DEGREES   = 60                                        ' width of one hue group
    HUE_GROUP_COUNT     = 6                                         ' hue groups around the colour circle
    HUE_LINE_STEP       = 6                                         ' degrees between neighbouring pixels of a hue line
    COL_START_OFFSET    = 2                                         ' left margin of the hue lines
    WIDE_MARGIN_FACTOR  = 2                                         ' the margin is this many times larger on a wider panel

    PALETTE_STEP        = 25                                        ' step of one palette channel
    PALETTE_LAST        = 230                                       ' last step of the green and blue palette channels
    PALETTE_PER_ROW     = 4                                         ' mini panels per row
    BW_PANEL_INDEX      = 11                                        ' mini panel holding the grey ramp
    BW_SKIP_ROWS        = 3                                         ' rows of the grey ramp left black
    BW_RAMP_STEP        = 2                                         ' grey level step along the ramp
    BW_ROW_WIDTH        = 10                                        ' pixels per row of the grey ramp
    MINI_ROW_HEIGHT     = 11                                        ' mini panel row spacing on a 32 row panel
    MINI_ROW_HEIGHT_TALL = 22                                       ' mini panel row spacing on a taller panel
    MINI_COL_WIDTH      = 16                                        ' mini panel column spacing on a 64 wide panel
    MINI_COL_WIDTH_WIDE = 32                                        ' mini panel column spacing on a wider panel

    SWEEP_FIRST_ROW     = 2                                         ' top row of the first colour sweep
    SWEEP_ROW_SLOTS     = 8                                         ' sweep bands the panel height is divided into

    BLAST_PASSES        = 1                                         ' times demoScreenBlast cycles the eight colours
    BLAST_HOLD_MS       = 2000                                      ' time each colour is held by demoScreenBlast
    BLAST_TILES_X       = 4                                         ' tiles across in colorBlast
    BLAST_TILES_Y       = 2                                         ' tiles down in colorBlast
    BLAST_TILE_COUNT    = BLAST_TILES_X * BLAST_TILES_Y

OBJ ' ---- Objects ----

    color           : "isp_hub75_color"
    colorUtils      : "isp_hub75_colorUtils"
    pixels          : "isp_hub75_screenUtils"
    hub75Bffrs      : "isp_hub75_hwBufferAccess"
    display         : "isp_hub75_display"
    bmpHandler      : "isp_hub75_display_bmp"

DAT ' ---- Demo Data ----

    bitMsg      BYTE    "-RGB "
    bitCt       BYTE    "nbit-",0

    bmpFile1    FILE    "TstBG-Up.bmp"

    ' brightness of the swatch grid, one entry per swatch row
    swatchMed   BYTE    LEVEL_10_PCT, LEVEL_20_PCT, LEVEL_30_PCT, LEVEL_40_PCT, LEVEL_50_PCT, LEVEL_50_PCT, LEVEL_20_PCT, LEVEL_40_PCT, LEVEL_60_PCT
    swatchHigh  BYTE    LEVEL_20_PCT, LEVEL_40_PCT, LEVEL_60_PCT, LEVEL_80_PCT, LEVEL_FULL, LEVEL_FULL, LEVEL_FULL, LEVEL_FULL, LEVEL_FULL
    swatchLow   BYTE    0, 0, 0, 0, 0, 0, LEVEL_20_PCT, LEVEL_40_PCT, LEVEL_60_PCT

    ' the bands of the 1/8 scan checks: their colours, and for the first check whether each is filled
    scanColors  LONG    color.cRed, color.cYellow, color.cWhite, color.cMagenta, color.cBlue, color.cRainbow, color.cLime, color.cOrange
    scanFilled  LONG    TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE
    scan5Colors LONG    color.cRed, color.cPurple, color.cWhite, color.cMagenta, color.cYellow, color.cGreen, color.cOrange, color.cLime, color.cBlue, color.cMaroon, color.cOlive

VAR ' ---- Per-instance State ----

    LONG    chainIndex

    LONG    pnlRowCount
    LONG    pnlColCount

PUB main() | demoIndex
'' Start underlying drivers and run demo.
''

' Local Variables:
' @local demoIndex - current demo sequence index

    chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

    ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
    display.start(display.HUB75_ADAPTER_1)

    ' NOTE: for focused bring-up testing of the 1/8 scan, call show18scanColorCheck() or
    '  show18scanColorCheck5() here followed by "repeat", in place of the demo sequence below.

    pnlRowCount, pnlColCount := hub75Bffrs.panelSizeInPixels(chainIndex)

    display.clearScreen()

    repeat DEMO_PASSES
        repeat demoIndex from 1 TO DEMO_COUNT
            display.clearScreen()
            case demoIndex
                DEMO_TEXT: demoText()
                DEMO_PARALLAX: demoParallax()
                DEMO_HUE_GROUPS: demoHueGroups()
                DEMO_HUE_LINES: demoHueLines()
                DEMO_PALETTE: demoColorPalette12Panels()
                DEMO_SWEEP: showFullColorSweep()
                DEMO_BRIGHTNESS: demoTest12x9ColorBrightness()
                DEMO_COLOR_BLAST: colorBlast()
                DEMO_TEXT_AGAIN: demoText()
                DEMO_SCREEN_BLAST: demoScreenBlast()
                DEMO_BMP_FILE: demoBmpFileLoad()

            if demoIndex <> DEMO_SCREEN_BLAST
                waitSec(DEMO_PAUSE_SECONDS)

    display.stop()

PRI waitSec(countSeconds)
' Wait for the specified number of seconds.
'
' @param countSeconds - number of seconds to wait

    repeat countSeconds
        waitms(MS_PER_SECOND)

' ==============================================================================
'  Below here, lots of small demo routines
' ------------------------------------------------------------------------------

PRI demoParallax() | rtCol, ltCol, topRow, botRow
' Display Parallax Propeller2 branding with colored border.
'

' Local Variables:
' @local rtCol - rightmost column index
' @local ltCol - leftmost column index
' @local topRow - top row index
' @local botRow - bottom row index

    display.setTextFont(display.TEXT_FONT_5x7)                                  ' font size
    display.setCursor(0, 0)                                                     ' start at top left, with one pixel of spacing

    ltCol := 0
    rtCol := pnlColCount - 1
    topRow := 0
    botRow :=  pnlRowCount > PANEL_ROWS_32 ? PANEL_ROWS_32 - 1 : pnlRowCount - 1
    display.drawLineOfColor(topRow, ltCol, topRow, rtCol, color.cYellow)        ' top line
    display.drawLineOfColor(topRow, ltCol, botRow, ltCol, color.cRed)           ' left line
    display.drawLineOfColor(topRow, rtCol, botRow, rtCol, color.cMagenta)       ' right line
    display.drawLineOfColor(botRow, ltCol, botRow, rtCol, color.cGreen)         ' bottom Line
    display.setColoredTextAtLnCol(LINE_1, FIRST_COLUMN, string(" Parallax"), color.cBlue)
    display.setColoredTextAtLnCol(LINE_2, FIRST_COLUMN, string("Propeller2"), color.cBlue)
    display.commitScreenToPanelSet()

PRI demoText()
' Draw demo text showing driver info on the LED matrix.
'

    display.setTextFont(display.TEXT_FONT_5x7)          ' font size
    display.setCursor(0, 0)                             ' start at top left, with one pixel of spacing
    display.setColoredTextAtLnCol(LINE_0, FIRST_COLUMN, string("iron sheep"), color.cMaroon)

    bitCt.BYTE[0] := hub75Bffrs.colorDepth(chainIndex) + ASCII_ZERO

    display.setColoredTextAtLnCol(LINE_1, FIRST_COLUMN, @bitMsg, color.cOrange)
    display.setColoredTextAtLnCol(LINE_2, FIRST_COLUMN, string("led matrix"), color.cWhite)
    display.commitScreenToPanelSet()

PRI show18scanColorCheck() | band
' Display test pattern for debugging 1/8 scan capability.
'

' Local Variables:
' @local band - index of the band being drawn

    repeat band from 0 TO SCAN_BANDS - 1
        display.drawBoxOfColor(SCAN_BAND_ROWS * band, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, scanFilled.LONG[band], scanColors.LONG[band])
    display.drawLineOfColor(0, LAST_COLUMN_64, LAST_ROW_32, LAST_COLUMN_64, color.cGreen)
    display.drawLineOfColor(0, 0, LAST_ROW_32, 0, color.cBlueViolet)
    display.drawLineOfColor(0, HALF_COLUMN, LAST_ROW_32, HALF_COLUMN, color.cWhite)
    display.drawLineOfColor(0, HALF_COLUMN - 1, LAST_ROW_32, HALF_COLUMN - 1, color.cYellow)
    display.commitScreenToPanelSet()

PRI show18scanColorCheck5() | band, bandRows
' Display fifth test pattern with numbered colored rows.
'

' Local Variables:
' @local band - index of the band being drawn
' @local bandRows - height of that band

    repeat band from 0 TO SCAN5_BANDS - 1
        bandRows := (band == SCAN5_BANDS - 1) ? SCAN5_LAST_BAND_ROWS : SCAN5_BAND_ROWS
        display.drawBoxOfColor(SCAN5_BAND_ROWS * band, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, bandRows, TRUE, scan5Colors.LONG[band])

    display.drawLineOfColor(0, LAST_COLUMN_64, LAST_ROW_32, LAST_COLUMN_64, color.cLime)
    display.drawLineOfColor(0, 0, LAST_ROW_32, 0, color.cYellow)

    numberTheRows()

    display.commitScreenToPanelSet()

PRI numberTheRows() | rowId, idCol, idOnes, idTens, tensColor, onesColor
' Draw row number indicators as pixel dots alongside each row.
'

' Local Variables:
' @local rowId - current row number being labeled
' @local idCol - column offset for drawing digit dots
' @local idOnes - ones digit of current row number
' @local idTens - tens digit of current row number
' @local tensColor - color for tens digit dots
' @local onesColor - color for ones digit dots

    tensColor := color.cCyan
    onesColor := color.cCyan
    repeat rowId from 1 TO pnlRowCount
        idOnes := rowId // DECIMAL_BASE
        idTens := rowId / DECIMAL_BASE
        if idTens > 0
            repeat idCol from 0 TO idTens - 1
                pixels.drawPixelAtRC(chainIndex, rowId - 1, idCol + ROW_ID_TENS_COLUMN, tensColor)
        if idOnes > 0
            repeat idCol from 0 TO idOnes - 1
                pixels.drawPixelAtRC(chainIndex, rowId - 1, idCol + ROW_ID_ONES_COLUMN, onesColor)

PRI demoTest12x9ColorBrightness() | red, green, blue, row, col, rowCtr, colCtr, clrLow, clrMed, clrHigh, clrBW, swatchWidth, swatchHt
' Display a 12x9 grid of color brightness swatches.
'

' Local Variables:
' @local red - red component value
' @local green - green component value
' @local blue - blue component value
' @local row - current swatch row position
' @local col - current swatch column position
' @local rowCtr - row counter for brightness levels
' @local colCtr - column counter for hue variations
' @local clrLow - low brightness gamma-corrected value
' @local clrMed - medium brightness gamma-corrected value
' @local clrHigh - high brightness gamma-corrected value
' @local clrBW - black/white gamma-corrected value
' @local swatchWidth - pixel width of each swatch
' @local swatchHt - pixel height of each swatch

    swatchWidth :=  (pnlColCount - SWATCH_COLUMNS) / SWATCH_COLUMNS
    swatchHt :=  (pnlRowCount - SWATCH_ROWS) / SWATCH_ROWS

    repeat rowCtr from 0 TO SWATCH_ROWS - 1
        clrLow := swatchLow.BYTE[rowCtr]
        clrMed := swatchMed.BYTE[rowCtr]
        clrHigh := swatchHigh.BYTE[rowCtr]
        clrBW := GRAY_STEP * (rowCtr <# GRAY_TOP_ROW)

        clrHigh := colorUtils.gammaPeek(clrHigh)
        clrMed := colorUtils.gammaPeek(clrMed)
        clrLow := colorUtils.gammaPeek(clrLow)
        clrBW := colorUtils.gammaPeek(clrBW)

        repeat colCtr from 0 TO SWATCH_COLUMNS - 1      ' last is the grey ramp
            red := green := blue := 0
            case colCtr
                SWATCH_RH:                              ' rH
                    red := clrHigh
                    green := blue := clrLow
                SWATCH_RH_GM:                           ' rH, gM
                    red := clrHigh
                    green := clrMed
                    blue := clrLow
                SWATCH_RH_GH:                           ' rH, gH
                    red := clrHigh
                    green := clrHigh
                    blue := clrLow
                SWATCH_RM_GH:                           ' rM, gH
                    red := clrMed
                    green := clrHigh
                    blue := clrLow
                SWATCH_GH:                              ' gH
                    green := clrHigh
                    red := blue := clrLow
                SWATCH_GH_BM:                           ' gH, bM
                    green := clrHigh
                    blue := clrMed
                    red := clrLow
                SWATCH_GH_BH:                           ' gH, bH
                    green := clrHigh
                    blue := clrHigh
                    red := clrLow
                SWATCH_GM_BH:                           ' gM, bH
                    green := clrMed
                    blue := clrHigh
                    red := clrLow
                SWATCH_BH:                              ' bH
                    blue := clrHigh
                    red := green := clrLow
                SWATCH_RM_BH:                           ' rM, bH
                    red := clrMed
                    blue := clrHigh
                    green := clrLow
                SWATCH_RH_BH:                           ' rH, bH
                    red := clrHigh
                    blue := clrHigh
                    green := clrLow
                SWATCH_RH_BM:                           ' rH, bM
                    red := clrHigh
                    blue := clrMed
                    green := clrLow
                SWATCH_GRAY:
                    red := blue := green := clrBW

            row := (rowCtr * swatchHt) + rowCtr
            col := (colCtr * swatchWidth) + colCtr
            drawSwatch(swatchWidth, swatchHt, row, col, colorUtils.cValueForRGB(red, green, blue))
    display.commitScreenToPanelSet()

PRI drawSwatch(width, height, row, col, rgbColor) | rowOffset, colOffset
' Draw a filled rectangular color swatch at the given position.
'
' @param width - pixel width of the swatch
' @param height - pixel height of the swatch
' @param row - starting row for the swatch
' @param col - starting column for the swatch
' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local rowOffset - vertical offset within swatch
' @local colOffset - horizontal offset within swatch

    repeat rowOffset from 0 TO height - 1
        repeat colOffset from 0 TO width - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col + colOffset, rgbColor)

PRI demoHueLines() | row, col, colorOffset, startOffset
' Draw hue spectrum as continuous lines across the panel.
'

' Local Variables:
' @local row - current pixel row
' @local col - current pixel column
' @local colorOffset - current hue degree offset (0-359)
' @local startOffset - column start offset based on panel width

    startOffset := (pnlColCount > PANEL_COLUMNS_64) ? COL_START_OFFSET * WIDE_MARGIN_FACTOR : COL_START_OFFSET
    col := startOffset
    repeat row from 0 TO pnlRowCount - 1
        repeat colorOffset from 0 TO colorUtils.DEGREES_PER_CIRCLE - 1 step HUE_LINE_STEP
            pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.rgbColorFromDegrees(colorOffset))
            col++
            if col > pnlColCount - startOffset          ' wrap back to the left margin once past the right margin
                col := startOffset
    display.commitScreenToPanelSet()

PRI demoHueGroups() | row, col, hueDegrees, groupStartHue, colorOffset
' Draw hue spectrum in six 60-degree color groups.
'

' Local Variables:
' @local row - current pixel row
' @local col - current pixel column
' @local hueDegrees - computed hue degree for current pixel
' @local groupStartHue - starting hue degree for current group
' @local colorOffset - row offset within current group

    row := 0
    repeat groupStartHue from 0 TO colorUtils.DEGREES_PER_CIRCLE - 1 step HUE_GROUP_DEGREES
        repeat colorOffset from 0 TO ((pnlRowCount - 1) / HUE_GROUP_COUNT) - 1
            repeat col from 0 TO pnlColCount - 1
                hueDegrees := groupStartHue + col
                pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.rgbColorFromDegrees(hueDegrees))
            row++
    display.commitScreenToPanelSet()

PRI demoColorPalette12Panels() | red, panelNumber
' Display twelve mini panels showing the 11x10x10 color palette plus grayscale.
'

' Local Variables:
' @local red - red component stepping value (0-255 step 25)
' @local panelNumber - index of the current mini panel (0-11)

    panelNumber := 0
    repeat red from 0 TO CHANNEL_MAX step PALETTE_STEP
        generateGreenBluePanelAgainst(panelNumber, red)
        panelNumber++
    generateBWPanel(BW_PANEL_INDEX)
    display.commitScreenToPanelSet()

PRI offsetForPanel() : rowHeight, colWidth
' Calculate row height and column width for mini panel layout.
'
' @returns rowHeight - pixel height per mini panel row
' @returns colWidth - pixel width per mini panel column

    rowHeight := MINI_ROW_HEIGHT
    if pnlRowCount > PANEL_ROWS_32
        rowHeight := MINI_ROW_HEIGHT_TALL
    colWidth := MINI_COL_WIDTH
    if pnlColCount > PANEL_COLUMNS_64
        colWidth := MINI_COL_WIDTH_WIDE

PRI generateGreenBluePanelAgainst(panelNumber, red) | panelRow, panelCol, row, col, green, blue, startCol, rowHt, colWdth
' Generate a green-blue color grid for a given red level in a mini panel.
'
' @param panelNumber - index of the mini panel (0-10)
' @param red - fixed red component value for this panel

' Local Variables:
' @local panelRow - panel grid row position
' @local panelCol - panel grid column position
' @local row - current pixel row
' @local col - current pixel column
' @local green - green component stepping value
' @local blue - blue component stepping value
' @local startCol - starting column for this panel
' @local rowHt - row height per mini panel
' @local colWdth - column width per mini panel

    rowHt, colWdth := offsetForPanel()
    panelRow := panelNumber / PALETTE_PER_ROW
    panelCol := panelNumber // PALETTE_PER_ROW
    row := panelRow * rowHt
    startCol := col := panelCol * colWdth
    repeat green from 0 TO PALETTE_LAST step PALETTE_STEP
        repeat blue from 0 TO PALETTE_LAST step PALETTE_STEP
            pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
            col++
        row++
        col := startCol

PRI generateBWPanel(panelNumber) | panelRow, panelCol, row, col, red, green, blue, startCol, colCtr, startRow, rowHt, colWdth
' Generate a grayscale gradient in a mini panel position.
'
' @param panelNumber - index of the mini panel (0-11)

' Local Variables:
' @local panelRow - panel grid row position
' @local panelCol - panel grid column position
' @local row - current pixel row
' @local col - current pixel column
' @local red - red component value
' @local green - green component stepping value (0-255)
' @local blue - blue component value
' @local startCol - starting column for this panel
' @local colCtr - column counter within current row
' @local startRow - first row of the panel area
' @local rowHt - row height per mini panel
' @local colWdth - column width per mini panel

    rowHt, colWdth := offsetForPanel()
    panelRow := panelNumber / PALETTE_PER_ROW
    panelCol := panelNumber // PALETTE_PER_ROW
    startRow := (panelRow * rowHt)
    row := startRow - BW_SKIP_ROWS                      ' skip black rows
    startCol := col := panelCol * colWdth
    colCtr := 0
    repeat green from 0 TO CHANNEL_MAX step BW_RAMP_STEP
        red := blue := green
        if row >= startRow
            pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        colCtr++
        if colCtr >= BW_ROW_WIDTH
            colCtr := 0
            row++
            col := startCol

PRI showFullColorSweep() | row, col, red, green, blue, rowsPerSweep, rowsPerSweepRow, rowOffset
' Display full 256-step color sweeps for seven color channels.
'

' Local Variables:
' @local row - current pixel row
' @local col - current pixel column
' @local red - red component value
' @local green - green component value
' @local blue - blue component value
' @local rowsPerSweep - number of pixel rows per sweep pass
' @local rowsPerSweepRow - number of pixel rows per sweep row
' @local rowOffset - vertical offset within current sweep row

    rowsPerSweep := CHANNEL_LEVELS / pnlColCount
    rowsPerSweepRow := pnlRowCount / (rowsPerSweep * SWEEP_ROW_SLOTS)

    red := green := blue := 0
    row := SWEEP_FIRST_ROW
    col := 0
    repeat red from 0 TO CHANNEL_MAX                    ' RED
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    red := green := blue := 0
    repeat green from 0 TO CHANNEL_MAX                  ' GREEN
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    red := green := blue := 0
    repeat blue from 0 TO CHANNEL_MAX                   ' BLUE
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    red := green := blue := 0
    repeat red from 0 TO CHANNEL_MAX                    ' YELLOW
        green := red
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    red := green := blue := 0
    repeat green from 0 TO CHANNEL_MAX                  ' CYAN
        blue := green
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    red := green := blue := 0
    repeat blue from 0 TO CHANNEL_MAX                   ' MAGENTA
        red := blue
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    red := green := blue := 0
    repeat blue from 0 TO CHANNEL_MAX                   ' WHITE
        green := red := blue
        repeat rowOffset from 0 TO rowsPerSweepRow - 1
            pixels.drawPixelAtRC(chainIndex, row + rowOffset, col, colorUtils.cValueForRGB(red, green, blue))
        col++
        if (col > pnlColCount - 1)
            row += rowsPerSweepRow
            col := 0

    display.commitScreenToPanelSet()

PRI demoScreenBlast() | color3bit
' Cycle through all eight 3-bit colors filling the screen without PWM.
'

' Local Variables:
' @local color3bit - current 3-bit color value (0-7)

    repeat BLAST_PASSES
        repeat color3bit from color.BASE_BLACK TO color.BASE_WHITE
            display.fillScreenNoPWM(color3bit)
            waitms(BLAST_HOLD_MS)

PRI colorBlast() | row, col, red, green, blue, blockX, blockY, subrow, subcol, tileWidth, tileHeight
' Fill the panel with computed color gradients in a 4x2 tile grid.
'

' Local Variables:
' @local row - current pixel row
' @local col - current pixel column
' @local red - red component value
' @local green - green component value
' @local blue - blue component value
' @local blockX - horizontal tile index (0-3)
' @local blockY - vertical tile index (0-1)
' @local subrow - row offset within current tile
' @local subcol - column offset within current tile
' @local tileWidth - pixel width of each tile
' @local tileHeight - pixel height of each tile

    tileWidth := pnlColCount / BLAST_TILES_X
    tileHeight := pnlRowCount / BLAST_TILES_Y
    repeat blockX from 0 TO BLAST_TILES_X - 1
        repeat blockY from 0 TO BLAST_TILES_Y - 1
            repeat subrow from 0 TO tileHeight - 1
                repeat subcol from 0 TO tileWidth - 1
                    row := (blockY * tileHeight) + subrow
                    col := (blockX * tileWidth) + subcol
                    red := subrow * (CHANNEL_MAX / tileHeight)
                    green := subcol * (CHANNEL_MAX / tileWidth)
                    blue := ((blockY * BLAST_TILES_X) + blockX) * (CHANNEL_MAX / BLAST_TILE_COUNT)
                    pixels.drawPixelAtRCwithRGB(chainIndex, row, col, red, green, blue)

    display.commitScreenToPanelSet()

PRI demoBmpFileLoad()
' Load and display a BMP image file on the LED matrix.
'

    bmpHandler.fillScreenFromBMP(chainIndex, @bmpFile1)
    display.commitScreenToPanelSet()

