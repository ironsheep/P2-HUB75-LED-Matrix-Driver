OBJ

    hwEnum      : "isp_hub75_hwEnums"                               ' hub75 attachment, set up constants

CON ' ---- User Panel Connection and Configuration ----
    {Spin2_Doc_CON}

' Reference: addr width for known chips:
'
'       DP5125D                 ABC
'       MBI5124GP               ABC
'
'       FM6124                  ABCD
'       FM6126A                 ABCD
'       GS6238S                 ABCD
'
'       ICN2037                 ABCDE
'       ICN2038S                ABCDE

'  User customized section describing the memory allocated to our matrix panel displays
'
' Wiring: one sentence per cable position, DISPn_C0 .. DISPn_C15
'
'  Cable position C0 is the panel the adapter plugs into, C1 is the next panel
'  along the ribbon cable, and so on. The sentence DISPn_Ck describes the panel at
'  cable position k: where it sits next to a panel already described, and the
'  direction its identify arrow points (its panel rotation).
'
'  The words (all from isp_hub75_hwEnums, so each is written hwEnum.WORD):
'    direction - hwEnum.ABOVE, hwEnum.BELOW, hwEnum.LEFT_OF, hwEnum.RIGHT_OF
'    neighbour - hwEnum.C0 through hwEnum.C15, the neighbour's cable position
'    arrow     - hwEnum.ARROW_UP, hwEnum.ARROW_DOWN, hwEnum.ARROW_LEFT, hwEnum.ARROW_RIGHT
'  Example: hwEnum.RIGHT_OF | hwEnum.C0 | hwEnum.ARROW_DOWN means "this panel sits to
'  the right of C0, and its arrow points down".
'
'  Three forms:
'    hwEnum.FIRST_PANEL | arrow     - for C0 only
'    direction | neighbour | arrow  - for every other panel in use
'    hwEnum.NO_PANEL                - for unused cable positions
'
'  Five rules:
'    1. Join the words with | only, never +, in any order. Each word is a single
'       bit, so + carries into the next word: C2 + C2 silently becomes C3.
'    2. The neighbour shares a full edge with this panel. It may come earlier or
'       later in the cable.
'    3. Every panel connects back to C0 through its neighbours.
'    4. No two panels share a cell.
'    5. Panels in use are numbered C0, C1, C2 and so on with no gaps, and NO_PANEL
'       comes only after the last one.
'
'  An adapter whose DISPn_C0 is hwEnum.NO_PANEL has no panels: its buffers are zero
'  length and cost no memory.

' panel set on 1st HUB75 adapter board - DISP0_* constants

    ' User configure

    ' (1) describe the panel connections, addressing and chips
    DISP0_ADAPTER_BASE_PIN         = hwEnum.PIN_GROUP_P16_P31
    DISP0_PANEL_DRIVER_CHIP        = hwEnum.CHIP_ICN2037
    DISP0_PANEL_ADDR_LINES         = hwEnum.ADDR_ABCDE

    ' (2) describe the single panel physical size
    DISP0_MAX_PANEL_COLUMNS        = 128
    DISP0_MAX_PANEL_ROWS           = 64

    ' (3) describe the color depth you want to support [3-8] bits per LED
    '    NOTE full 24bit color is hwEnum.DEPTH_8BIT
    '    NOTE: Screen buffer always uses 3 bytes per pixel (one byte per R/G/B channel)
    DISP0_COLOR_DEPTH              = hwEnum.DEPTH_5BIT

    ' (4) Say how the whole display is mounted (the rotation is physical)
    '    ROT_RIGHT_90 = hung turned 90 degrees clockwise, ROT_LEFT_90 = counter-clockwise,
    '    ROT_180 = upside-down. Content then reads upright as mounted.
    ' NOTE: Use ROT_NONE first to verify panel orientation, then adjust if needed
    DISP0_ROTATION                 = hwEnum.ROT_NONE
    'DISP0_ROTATION = hwEnum.ROT_180  ' uncomment if display is upside-down

    ' (5) Describe the wiring: one sentence per cable position (rules above)
    '
    '  Looking at the display front, every arrow points down:
    '     [C2][C3]
    '     [C0][C1]   the adapter plugs into C0
    '
    DISP0_C0                       = hwEnum.FIRST_PANEL | hwEnum.ARROW_DOWN
    DISP0_C1                       = hwEnum.RIGHT_OF | hwEnum.C0 | hwEnum.ARROW_DOWN
    DISP0_C2                       = hwEnum.ABOVE | hwEnum.C0 | hwEnum.ARROW_DOWN
    DISP0_C3                       = hwEnum.RIGHT_OF | hwEnum.C2 | hwEnum.ARROW_DOWN
    DISP0_C4                       = hwEnum.NO_PANEL
    DISP0_C5                       = hwEnum.NO_PANEL
    DISP0_C6                       = hwEnum.NO_PANEL
    DISP0_C7                       = hwEnum.NO_PANEL
    DISP0_C8                       = hwEnum.NO_PANEL
    DISP0_C9                       = hwEnum.NO_PANEL
    DISP0_C10                      = hwEnum.NO_PANEL
    DISP0_C11                      = hwEnum.NO_PANEL
    DISP0_C12                      = hwEnum.NO_PANEL
    DISP0_C13                      = hwEnum.NO_PANEL
    DISP0_C14                      = hwEnum.NO_PANEL
    DISP0_C15                      = hwEnum.NO_PANEL

    ' (6) Describe the display shape: hwEnum.SHAPE_FLAT or hwEnum.SHAPE_CUBE
    '  For a cube, DISP0_CUBE_TOP and DISP0_CUBE_FRONT are the cable positions
    '  (hwEnum.C0 through hwEnum.C15) of the top face and the front face.
    '  They are not used by a flat display.
    DISP0_SHAPE                    = hwEnum.SHAPE_FLAT
    DISP0_CUBE_TOP                 = hwEnum.NO_PANEL
    DISP0_CUBE_FRONT               = hwEnum.NO_PANEL

    ' End User configure

    ' The display's size, its grid of panels and each panel's place and rotation are
    ' derived from the wiring sentences at startup, not set here.

    ' Screen buffer always uses 3 bytes per pixel (one byte per R/G/B channel)
    ' Color depth only affects which bits are significant in BCM conversion
    DISP0_BITS_PER_COLOR           = DISP0_COLOR_DEPTH * 3
    DISP0_BYTES_PER_COLOR          = 3

    ' how many panels are in use: each cable position that is not NO_PANEL
    DISP0_PANEL_COUNT              = (DISP0_C0 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C1 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C2 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C3 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C4 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C5 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C6 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C7 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C8 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C9 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C10 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C11 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C12 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C13 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP0_C14 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP0_C15 <> hwEnum.NO_PANEL ? 1 : 0)

    ' buffers hold only the panels in use (panel count x panel pixels), not the bounding box
    DISP0_SCRN_SIZE_IN_BYTES       = (((DISP0_PANEL_COUNT * DISP0_MAX_PANEL_COLUMNS * DISP0_MAX_PANEL_ROWS * DISP0_BYTES_PER_COLOR) + 3) / 4) * 4
    DISP0_SCRN_SIZE_IN_LONGS       = (DISP0_SCRN_SIZE_IN_BYTES / 4)

    ' what is our PWM frame size
    ' PWM Frames are 4 bits per pixel for every pixel of the panels in use
    DISP0_PWM_FRAME_SIZE_IN_BYTES  = (DISP0_PANEL_COUNT * DISP0_MAX_PANEL_COLUMNS * DISP0_MAX_PANEL_ROWS) / 2
    DISP0_PWM_FRAME_SIZE_IN_LONGS  = (DISP0_PWM_FRAME_SIZE_IN_BYTES + 3) / 4

    DISP0_FRAMESET_SIZE_IN_LONGS   = DISP0_COLOR_DEPTH * DISP0_PWM_FRAME_SIZE_IN_LONGS

' panel set on 2nd HUB75 adapter board - DISP1_* constants

    ' User configure

    ' (1) describe the panel connections, addressing and chips
    DISP1_ADAPTER_BASE_PIN         = hwEnum.PIN_GROUP_P16_P31
    DISP1_PANEL_DRIVER_CHIP        = hwEnum.CHIP_ICN2037
    DISP1_PANEL_ADDR_LINES         = hwEnum.ADDR_ABCDE

    ' (2) describe the single panel physical size
    DISP1_MAX_PANEL_COLUMNS        = 64
    DISP1_MAX_PANEL_ROWS           = 64

    ' (3) describe the color depth you want to support [3-8] bits per LED
    '    NOTE full 24bit color is hwEnum.DEPTH_8BIT
    '    NOTE: Screen buffer always uses 3 bytes per pixel (one byte per R/G/B channel)
    DISP1_COLOR_DEPTH              = hwEnum.DEPTH_6BIT

    ' (4) Say how the whole display is mounted (rules above DISP0)
    DISP1_ROTATION                 = hwEnum.ROT_NONE

    ' (5) Describe the wiring: one sentence per cable position (rules above DISP0)
    '  This adapter has no panels: every cable position is NO_PANEL.
    DISP1_C0                       = hwEnum.NO_PANEL
    DISP1_C1                       = hwEnum.NO_PANEL
    DISP1_C2                       = hwEnum.NO_PANEL
    DISP1_C3                       = hwEnum.NO_PANEL
    DISP1_C4                       = hwEnum.NO_PANEL
    DISP1_C5                       = hwEnum.NO_PANEL
    DISP1_C6                       = hwEnum.NO_PANEL
    DISP1_C7                       = hwEnum.NO_PANEL
    DISP1_C8                       = hwEnum.NO_PANEL
    DISP1_C9                       = hwEnum.NO_PANEL
    DISP1_C10                      = hwEnum.NO_PANEL
    DISP1_C11                      = hwEnum.NO_PANEL
    DISP1_C12                      = hwEnum.NO_PANEL
    DISP1_C13                      = hwEnum.NO_PANEL
    DISP1_C14                      = hwEnum.NO_PANEL
    DISP1_C15                      = hwEnum.NO_PANEL

    ' (6) Describe the display shape: hwEnum.SHAPE_FLAT or hwEnum.SHAPE_CUBE
    '  For a cube, DISP1_CUBE_TOP and DISP1_CUBE_FRONT are the cable positions
    '  (hwEnum.C0 through hwEnum.C15) of the top face and the front face.
    '  They are not used by a flat display.
    DISP1_SHAPE                    = hwEnum.SHAPE_FLAT
    DISP1_CUBE_TOP                 = hwEnum.NO_PANEL
    DISP1_CUBE_FRONT               = hwEnum.NO_PANEL

    ' End User configure

    ' Screen buffer always uses 3 bytes per pixel (one byte per R/G/B channel)
    DISP1_BITS_PER_COLOR           = DISP1_COLOR_DEPTH * 3
    DISP1_BYTES_PER_COLOR          = 3

    ' how many panels are in use: each cable position that is not NO_PANEL
    DISP1_PANEL_COUNT              = (DISP1_C0 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C1 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C2 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C3 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C4 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C5 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C6 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C7 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C8 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C9 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C10 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C11 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C12 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C13 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP1_C14 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP1_C15 <> hwEnum.NO_PANEL ? 1 : 0)

    ' buffers hold only the panels in use (panel count x panel pixels), not the bounding box
    DISP1_SCRN_SIZE_IN_BYTES       = (((DISP1_PANEL_COUNT * DISP1_MAX_PANEL_COLUMNS * DISP1_MAX_PANEL_ROWS * DISP1_BYTES_PER_COLOR) + 3) / 4) * 4
    DISP1_SCRN_SIZE_IN_LONGS       = (DISP1_SCRN_SIZE_IN_BYTES / 4)

    ' what is our PWM frame size
    ' PWM Frames are 4 bits per pixel for every pixel of the panels in use
    DISP1_PWM_FRAME_SIZE_IN_BYTES  = (DISP1_PANEL_COUNT * DISP1_MAX_PANEL_COLUMNS * DISP1_MAX_PANEL_ROWS) / 2
    DISP1_PWM_FRAME_SIZE_IN_LONGS  = (DISP1_PWM_FRAME_SIZE_IN_BYTES + 3) / 4

    DISP1_FRAMESET_SIZE_IN_LONGS   = DISP1_COLOR_DEPTH * DISP1_PWM_FRAME_SIZE_IN_LONGS

' panel set on 3rd HUB75 adapter board - DISP2_* constants

    ' User configure

    ' (1) describe the panel connections, addressing and chips
    DISP2_ADAPTER_BASE_PIN         = hwEnum.PIN_GROUP_P16_P31
    DISP2_PANEL_DRIVER_CHIP        = hwEnum.CHIP_ICN2037
    DISP2_PANEL_ADDR_LINES         = hwEnum.ADDR_ABCDE

    ' (2) describe the single panel physical size
    DISP2_MAX_PANEL_COLUMNS        = 64
    DISP2_MAX_PANEL_ROWS           = 64

    ' (3) describe the color depth you want to support [3-8] bits per LED
    '    NOTE full 24bit color is hwEnum.DEPTH_8BIT
    '    NOTE: Screen buffer always uses 3 bytes per pixel (one byte per R/G/B channel)
    DISP2_COLOR_DEPTH              = hwEnum.DEPTH_4BIT

    ' (4) Say how the whole display is mounted (rules above DISP0)
    DISP2_ROTATION                 = hwEnum.ROT_NONE

    ' (5) Describe the wiring: one sentence per cable position (rules above DISP0)
    '  This adapter has no panels: every cable position is NO_PANEL.
    DISP2_C0                       = hwEnum.NO_PANEL
    DISP2_C1                       = hwEnum.NO_PANEL
    DISP2_C2                       = hwEnum.NO_PANEL
    DISP2_C3                       = hwEnum.NO_PANEL
    DISP2_C4                       = hwEnum.NO_PANEL
    DISP2_C5                       = hwEnum.NO_PANEL
    DISP2_C6                       = hwEnum.NO_PANEL
    DISP2_C7                       = hwEnum.NO_PANEL
    DISP2_C8                       = hwEnum.NO_PANEL
    DISP2_C9                       = hwEnum.NO_PANEL
    DISP2_C10                      = hwEnum.NO_PANEL
    DISP2_C11                      = hwEnum.NO_PANEL
    DISP2_C12                      = hwEnum.NO_PANEL
    DISP2_C13                      = hwEnum.NO_PANEL
    DISP2_C14                      = hwEnum.NO_PANEL
    DISP2_C15                      = hwEnum.NO_PANEL

    ' (6) Describe the display shape: hwEnum.SHAPE_FLAT or hwEnum.SHAPE_CUBE
    '  For a cube, DISP2_CUBE_TOP and DISP2_CUBE_FRONT are the cable positions
    '  (hwEnum.C0 through hwEnum.C15) of the top face and the front face.
    '  They are not used by a flat display.
    DISP2_SHAPE                    = hwEnum.SHAPE_FLAT
    DISP2_CUBE_TOP                 = hwEnum.NO_PANEL
    DISP2_CUBE_FRONT               = hwEnum.NO_PANEL

    ' End User configure

    ' Screen buffer always uses 3 bytes per pixel (one byte per R/G/B channel)
    DISP2_BITS_PER_COLOR           = DISP2_COLOR_DEPTH * 3
    DISP2_BYTES_PER_COLOR          = 3

    ' how many panels are in use: each cable position that is not NO_PANEL
    DISP2_PANEL_COUNT              = (DISP2_C0 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C1 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C2 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C3 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C4 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C5 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C6 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C7 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C8 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C9 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C10 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C11 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C12 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C13 <> hwEnum.NO_PANEL ? 1 : 0) + ...
                                     (DISP2_C14 <> hwEnum.NO_PANEL ? 1 : 0) + (DISP2_C15 <> hwEnum.NO_PANEL ? 1 : 0)

    ' buffers hold only the panels in use (panel count x panel pixels), not the bounding box
    DISP2_SCRN_SIZE_IN_BYTES       = (((DISP2_PANEL_COUNT * DISP2_MAX_PANEL_COLUMNS * DISP2_MAX_PANEL_ROWS * DISP2_BYTES_PER_COLOR) + 3) / 4) * 4
    DISP2_SCRN_SIZE_IN_LONGS       = (DISP2_SCRN_SIZE_IN_BYTES / 4)

    ' what is our PWM frame size
    ' PWM Frames are 4 bits per pixel for every pixel of the panels in use
    DISP2_PWM_FRAME_SIZE_IN_BYTES  = (DISP2_PANEL_COUNT * DISP2_MAX_PANEL_COLUMNS * DISP2_MAX_PANEL_ROWS) / 2
    DISP2_PWM_FRAME_SIZE_IN_LONGS  = (DISP2_PWM_FRAME_SIZE_IN_BYTES + 3) / 4

    DISP2_FRAMESET_SIZE_IN_LONGS   = DISP2_COLOR_DEPTH * DISP2_PWM_FRAME_SIZE_IN_LONGS

PUB null()
'' Placeholder to prevent this object from being used as a top-level file.
''

CON ' More Hardware Setup Notes

{
' -------------------------------------------------------------------------------------------------
' AUTHORs  1st configuration
' -------------------------------------------------------------------------------------------------
' PANEL: ---  P3-6432-121-16s-D1.0  --- (pink labels)
'   panel theory  3 bits per pixel
'   64 columns x 32 rows = 2048 pixels
'   16 lines [0-15]: 64 pixels / line
'   2 halves: 1024 pixels / half (top and bottom)
'     EA half: 1024 pixels
'     top half (lines 0-15) driven by R1,G1,B1 pins
'     bottom half (lines 16-31) driven by R2,G2,B2 pins
'  Author's panel uses FM6126A chips
'    max clock rate of 30MHz - [16.5ns hi/16.5ns lo]   TESTED NEW
' ----------------------------------------------------------

    ADAPTER_BASE_PIN = hwEnum.PIN_GROUP_P16_P31

    ' (1) determine what form of signalling the driver should use
    PANEL_DRIVER_CHIP = hwEnum.CHIP_FM6126A
    PANEL_ADDR_LINES = hwEnum.ADDR_ABCD

' -------------------------------------------------------------------------------------------------
' AUTHORs  2nd configuration
' -------------------------------------------------------------------------------------------------
' PANEL: ---  P3-6432-121-16s-D1.0  --- (pink labels)
'   panel theory  3 bits per pixel
'   64 columns x 32 rows = 2048 pixels
'   16 lines [0-15]: 64 pixels / line
'   2 halves: 1024 pixels / half (top and bottom)
'     EA half: 1024 pixels
'     top half (lines 0-15) driven by R1,G1,B1 pins
'     bottom half (lines 16-31) driven by R2,G2,B2 pins
' ----------------------------------------------------------

    ADAPTER_BASE_PIN = hwEnum.PIN_GROUP_P16_P31

    ' (1) determine what form of signalling the driver should use
    PANEL_DRIVER_CHIP = hwEnum.CHIP_FM6126A
    PANEL_ADDR_LINES = hwEnum.ADDR_ABCD

' -------------------------------------------------------------------------------------------------
' AUTHORs  3rd configuration
' -------------------------------------------------------------------------------------------------
' PANEL: ---  P3-6432-121-16s-D1.0  --- (pink labels)
'   panel theory  3 bits per pixel
'   64 columns x 32 rows = 2048 pixels
'   16 lines [0-15]: 64 pixels / line
'   2 halves: 1024 pixels / half (top and bottom)
'     EA half: 1024 pixels
'     top half (lines 0-15) driven by R1,G1,B1 pins
'     bottom half (lines 16-31) driven by R2,G2,B2 pins
' ----------------------------------------------------------

    ADAPTER_BASE_PIN = hwEnum.PIN_GROUP_P16_P31

    ' (1) determine what form of signalling the driver should use
    PANEL_DRIVER_CHIP = hwEnum.CHIP_FM6126A
    PANEL_ADDR_LINES = hwEnum.ADDR_ABCD

' -------------------------------------------------------------------------------------------------
' AUTHORs  4th configuration
' -------------------------------------------------------------------------------------------------
' PANEL: ---  P3-6432-121-16s-D1.0  --- (orange labels)
'   panel theory  3 bits per pixel
'   64 columns x 32 rows = 2048 pixels
'   16 lines [0-15]: 64 pixels / line
'   2 halves: 1024 pixels / half (top and bottom)
'     EA half: 1024 pixels
'     top half (lines 0-15) driven by R1,G1,B1 pins
'     bottom half (lines 16-31) driven by R2,G2,B2 pins
'  Author's panel uses FM6124 chips (came in Hackerbox)
'    max clock rate of 30MHz - [16.5ns hi/16.5ns lo]   TESTED NEW
' ----------------------------------------------------------

    ADAPTER_BASE_PIN = hwEnum.PIN_GROUP_P16_P31

    ' (1) determine what form of signalling the driver should use
    PANEL_DRIVER_CHIP = hwEnum.CHIP_FM6124
    PANEL_ADDR_LINES = hwEnum.ADDR_ABCD

' -------------------------------------------------------------------------------------------------
' AUTHORs  5th configuration (red/blue swapped!)
' -------------------------------------------------------------------------------------------------
' PANEL: ---  P2-2020210240-200  ---
'   panel theory  3 bits per pixel
'   64 columns x 64 rows = 4096 pixels
'   32 lines [0-31]: 64 pixels / line
'   2 halves: 2048 pixels / half (top and bottom)
'     EA half: 2048 pixels
'     top half (lines 0-31) driven by R1,G1,B1 pins
'     bottom half (lines 32-63) driven by R2,G2,B2 pins
'  Author's panel uses ICN2037 chips
'    max clock rate of 20MHz - [25ns hi/25ns lo]
' ----------------------------------------------------------

    ADAPTER_BASE_PIN = hwEnum.PIN_GROUP_P16_P31

   ' (1) determine what form of signalling the driver should use
    PANEL_DRIVER_CHIP = hwEnum.CHIP_ICN2037
