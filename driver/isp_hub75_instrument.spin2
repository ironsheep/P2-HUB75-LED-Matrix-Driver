#IFNDEF HUB75_INSTRUMENT
#ERROR isp_hub75_instrument needs HUB75_INSTRUMENT: define it, and #PRAGMA EXPORTDEF it, in the test top file
#ENDIF

{ What this object is:

   The measuring half of the HUB75_INSTRUMENT build (DOCs/plans/FRAME-RATE-SPRINT-PLAN.md section 2).
   With the symbol defined, the refresh cog of isp_hub75_rgb3bit.spin2 marks its progress on P8-P11
   and this object starts one input-only smart pin beside each signal it watches. A monitor sits
   up to three pins from the signal and reads it through the smart pin's A (and B) input routing,
   so it never drives a pin. Single adapter only: the strobes belong to one refresh cog.

   Monitor map for an adapter at P16 (every pin is derived, none is typed in):

     signal                 pin   monitor   measures
     P8   posted set taken   P8    P5       rises per 1 s window
     P9   frame start        P9    P6       rises per 1 s window
     P10  row start          P10   P7       rises per 1 s window
     P11  plane latch        P11   P12      rises per 1 s window
     CLK                     P16   P13      high clocks and periods over period-aligned windows
     /OE                     P17   P14      clocks LOW (lit) per 1 s window
     LATCH                   P18   P15      rises per 1 s window

   Each signal tries the pins around it nearest-below first (three below, two below, one below,
   then one, two, three above) and takes the first that is free: not the adapter's own, not a
   strobe, not another monitor's. A signal with no free neighbour is reported as "not monitored:
   jumper needed". An adapter at P0 owns P0-P13, which holds the strobe pins themselves, so
   there the strobes are not driven and no monitor starts.

   CLK is one smart pin, so it alternates between two period-aligned windows: P_COUNTER_HIGHS
   (clocks CLK was high) and P_COUNTER_PERIODS (CLK periods). Each window is X = clkfreq clocks,
   stretched only to finish the CLK period in progress, so each count is a per-second figure
   and the mean high time per pulse is their ratio. The window restarts by itself, so a late
   read still gets one whole window. The refresh core drives CLK low at the end of every shift, so
   CLK idles low between shifts and highs / periods is the mean high time of one pulse; the
   low half is the column period (RG3 TIMING line) minus it.

   The frame-set take check (startTakeCheck()) answers "does a new image ever start part way
   through a frame?" from the pins. A cog of its own waits for each rise of P8 (posted set
   taken) as a pin event, which latches even the two-clock pulse, and reads the adapter's
   row-address pins A-E at that moment. The refresh core takes a set before it drives row 0's
   address, so a take at a frame boundary finds the last row address of the frame still on the
   pins; any other address is a take part way through a frame. The takes counted must also
   equal the commits made, or the check missed some.
}

CON ' ---- Signals and Monitors ----

    ' Signals the instrument watches, in report order (MON_COUNT is how many):
    '  MON_CMD   - P8, the refresh cog took a newly posted PWM frame set (posted set taken)
    '  MON_FRAME - P9, frame start
    '  MON_ROW   - P10, row start
    '  MON_PLANE - P11, plane latch
    '  MON_CLK   - the adapter's CLK
    '  MON_OE    - the adapter's /OE
    '  MON_LATCH - the adapter's LATCH
    #0, MON_CMD, MON_FRAME, MON_ROW, MON_PLANE, MON_CLK, MON_OE, MON_LATCH, MON_COUNT

    ' Marks a signal that has no monitor pin
    NO_PIN                  = -1

    ' Smart-pin A and B inputs can reach this far from the monitor's own pin
    MONITOR_REACH           = 3
    ' Monitors are searched for in this many positions around a signal
    NEIGHBOUR_CHOICES       = MONITOR_REACH * 2

    ' Pins 48-63 overlap the P2's predefined pins, so a monitor is never placed there
    LAST_USABLE_PIN         = 47

    ' Y = 0: count the A input only; for the CLK windows, A rise to B rise
    MON_COUNT_A_ONLY        = 0
    CLK_PERIOD_TRIGGER      = %00

    ' Which of its two windows the CLK monitor is running:
    '  CLK_WINDOW_HIGHS   (0) - P_COUNTER_HIGHS, clocks CLK was high
    '  CLK_WINDOW_PERIODS (1) - P_COUNTER_PERIODS, CLK periods
    #0, CLK_WINDOW_HIGHS, CLK_WINDOW_PERIODS

    ' A window that has not completed after this many window lengths is given up
    WINDOW_TIMEOUT_LENGTHS  = 2

CON ' ---- Frame-Set Take Check ----

    ' SETSE1 D[8:6] = %001: selectable event 1 fires when the pin in D[5:0] rises (p2kbPasm2Setse1)
    EVENT_PIN_RISES         = %001 << 6

    ' A pin number's bit 5 selects the port it is read through (0 = INA, 1 = INB); the low five
    ' bits are its place in that port
    PORT_SELECT_BIT         = 5
    PIN_IN_PORT_MASK        = %1_1111

    ' The row address on the five pins A-E
    ROW_ADDRESS_MASK        = %1_1111

    ' Marks the take check's cog as not running
    NO_COG                  = -1

    ' Stack of the take check's cog: it runs one method that never calls another
    TAKE_STACK_LONGS        = 32

    ' Take tallies the take check's cog keeps (TALLY_COUNT longs in takeTallies):
    '  TALLY_TAKES        - P8 rises seen
    '  TALLY_ON_BOUNDARY  - of those, taken with the frame's last row address on A-E
    '  TALLY_OFF_BOUNDARY - of those, taken with any other row address
    '  TALLY_LAST_OFF_ROW - the row address of the latest take off the boundary
    #0, TALLY_TAKES, TALLY_ON_BOUNDARY, TALLY_OFF_BOUNDARY, TALLY_LAST_OFF_ROW, TALLY_COUNT

CON ' ---- Report Arithmetic ----

    ' Fixed-point reports: x100 values print with one decimal (matrix.FIXED_POINT_SCALE,
    ' matrix.FRACTION_DIVISOR, matrix.PERCENT_X100_SCALE and matrix.NS_PER_SECOND)
    MICROS_PER_SECOND       = 1_000_000

CON ' ---- Status Codes ----
    {Spin2_Doc_CON}

    ' Status codes of start(), sampleSecond() and startTakeCheck():
    '  SUCCESS             - the call did what it was asked (forwarded from hwEnum, which defines it)
    '  E_STROBE_PINS_OWNED - start(): the adapter at P0 owns P8-P11, the strobe pins; nothing was started
    '  E_NO_MONITOR_PIN    - start(): no signal has a free neighbour pin, so no monitor was started
    '  E_NOT_RUNNING       - sampleSecond(), startTakeCheck(): no monitor is running
    '  E_NO_FREE_COG       - startTakeCheck(): no cog is free for the take check
    SUCCESS                 = hwEnum.SUCCESS
    E_STROBE_PINS_OWNED     = -1
    E_NO_MONITOR_PIN        = -2
    E_NOT_RUNNING           = -3
    E_NO_FREE_COG           = -4

OBJ ' ---- Objects Needed ----

    hwEnum      : "isp_hub75_hwEnums"                               ' hwEnum.SUCCESS
    matrix      : "isp_hub75_rgb3bit"                               ' constants only: adapter pin layout and the strobe pins

DAT ' ---- Singleton State ----

    ' Per signal: the pin watched, the pin that monitors it, the neighbour choice that routes it
    watchedPins             LONG    NO_PIN[MON_COUNT]
    monitorPins             LONG    NO_PIN[MON_COUNT]
    monitorRoutes           LONG    0[MON_COUNT]
    ' Per signal: the count the last window gave
    windowCounts            LONG    0[MON_COUNT]

    ' Neighbour choices, nearest-below first: the monitor's offset from the watched pin, and the
    ' routing that makes the monitor's A (and B) input read the watched pin
    neighbourOffsets        LONG    -3, -2, -1, 1, 2, 3
    routeInputA             LONG    P_PLUS3_A, P_PLUS2_A, P_PLUS1_A, P_MINUS1_A, P_MINUS2_A, P_MINUS3_A
    routeInputB             LONG    P_PLUS3_B, P_PLUS2_B, P_PLUS1_B, P_MINUS1_B, P_MINUS2_B, P_MINUS3_B

    ' The adapter's own pins, base to B2
    adapterFirstPin         LONG    0
    adapterLastPin          LONG    0

    monitorsRunning         LONG    FALSE                           ' TRUE once any monitor has started
    latchesPerRefresh       LONG    0                               ' LATCH rises that make one refresh (0 = unknown)

    clkWindowKind           LONG    CLK_WINDOW_HIGHS                ' the window the CLK monitor is running
    clkHighClocksPerSec     LONG    0                               ' clocks CLK was high, per second
    clkPeriodsPerSec        LONG    0                               ' CLK periods, per second

    lastRefreshX100         LONG    0                               ' refresh implied by LATCH, Hz x100
    lastLitX100             LONG    0                               ' share of the window the panel was lit, percent x100
    lastClkRisesPerSec      LONG    0                               ' mean CLK rises per second
    lastClkHighClocksX100   LONG    0                               ' mean CLK high time per pulse, clocks x100
    lastClkHighNsX100       LONG    0                               ' mean CLK high time per pulse, ns x100

    takeCheckCog            LONG    NO_COG                          ' cog running watchTakes(), or NO_COG
    takeTallies             LONG    0[TALLY_COUNT]                  ' written only by that cog
    takeCheckStack          LONG    0[TAKE_STACK_LONGS]

PUB start(adapterBasePin, latchesPerRefreshCount) : status | sigIdx, monitorPin
'' Start a monitor beside each signal that has a free neighbour pin, for the adapter whose
'' pins begin at adapterBasePin. An adapter at P0 has the strobe pins among its own: nothing
'' is started and the reason is printed.
''
'' @param adapterBasePin - pin number of the adapter's CLK (0, 16 or 32)
'' @param latchesPerRefreshCount - LATCH rises that make one full refresh, for the refresh figure (0 = not reported)
'' @returns status - SUCCESS if at least one monitor started, E_NO_MONITOR_PIN if none could be placed,
''                   E_STROBE_PINS_OWNED if the adapter owns the strobe pins

' Local Variables:
' @local sigIdx - the MON_* signal being set up
' @local monitorPin - the pin that monitors that signal

  status := E_NO_MONITOR_PIN
  monitorsRunning := FALSE
  latchesPerRefresh := latchesPerRefreshCount
  clkWindowKind := CLK_WINDOW_HIGHS
  adapterFirstPin := adapterBasePin
  adapterLastPin := adapterBasePin + matrix.PIN_OFST_R1 + matrix.COLOR_PINS_SPAN

  if adapterBasePin > matrix.MTX_LA_XT_P11
    LONG[@watchedPins][MON_CMD] := matrix.MTX_LA_XT_P08
    LONG[@watchedPins][MON_FRAME] := matrix.MTX_LA_XT_P09
    LONG[@watchedPins][MON_ROW] := matrix.MTX_LA_XT_P10
    LONG[@watchedPins][MON_PLANE] := matrix.MTX_LA_XT_P11
    LONG[@watchedPins][MON_CLK] := adapterBasePin + matrix.PIN_OFST_CLK
    LONG[@watchedPins][MON_OE] := adapterBasePin + matrix.PIN_OFST_OE
    LONG[@watchedPins][MON_LATCH] := adapterBasePin + matrix.PIN_OFST_LATCH
    repeat sigIdx from 0 to MON_COUNT - 1
      LONG[@monitorPins][sigIdx] := NO_PIN
      LONG[@windowCounts][sigIdx] := 0
    repeat sigIdx from 0 to MON_COUNT - 1
      monitorPin := chooseMonitorPin(sigIdx)
      if monitorPin == NO_PIN
        debug("INSTR: ", zstr_(signalLabel(sigIdx)), " P", udec_(LONG[@watchedPins][sigIdx]), " not monitored: jumper needed")
      else
        startMonitor(sigIdx)
        status := hwEnum.SUCCESS
        debug("INSTR: ", zstr_(signalLabel(sigIdx)), " P", udec_(LONG[@watchedPins][sigIdx]), " watched by P", udec_(monitorPin))
    monitorsRunning := (status == hwEnum.SUCCESS)
  else
    status := E_STROBE_PINS_OWNED
    debug("INSTR: monitors unavailable: the adapter at P", udec_(adapterFirstPin), " owns P", udec_(adapterFirstPin), "-P", udec_(adapterLastPin), ", which holds strobes P", udec_(matrix.MTX_LA_XT_P08), "-P", udec_(matrix.MTX_LA_XT_P11), " and the monitor pins; none driven, none started")

PUB stop() | sigIdx
'' Stop the take check and release every monitor pin.
''

' Local Variables:
' @local sigIdx - the MON_* signal whose monitor is released

  stopTakeCheck()
  repeat sigIdx from 0 to MON_COUNT - 1
    if LONG[@monitorPins][sigIdx] <> NO_PIN
      pinclear(LONG[@monitorPins][sigIdx])
      LONG[@monitorPins][sigIdx] := NO_PIN
  monitorsRunning := FALSE

PUB isRunning() : bRunning
'' Report whether any monitor is running.
''
'' @returns bRunning - TRUE if at least one monitor was started and not stopped

  bRunning := (monitorsRunning == TRUE)

PUB sampleSecond() : status | sigIdx
'' Wait for the monitors' next one-second window, read them, and print one INSTR line. The
'' CLK monitor is read first because its window length is timed at the moment it completes.
''
'' @returns status - SUCCESS if the monitors were read, E_NOT_RUNNING if none is running

' Local Variables:
' @local sigIdx - the MON_* signal being read

  status := E_NOT_RUNNING
  if monitorsRunning == TRUE
    readClockMonitor()
    repeat sigIdx from 0 to MON_COUNT - 1
      if sigIdx <> MON_CLK and LONG[@monitorPins][sigIdx] <> NO_PIN
        LONG[@windowCounts][sigIdx] := readWindow(LONG[@monitorPins][sigIdx])
    deriveFigures()
    reportSecond()
    status := hwEnum.SUCCESS

PUB refreshRateX100() : refreshX100
'' Return the refresh the last window implied from LATCH rises.
''
'' @returns refreshX100 - refreshes per second x 100

  refreshX100 := lastRefreshX100

PUB litShareX100() : litX100
'' Return the share of the last window that /OE was low (the panel lit).
''
'' @returns litX100 - percent x 100

  litX100 := lastLitX100

PUB clockRisesPerSecond() : risesPerSec
'' Return the mean CLK rise rate over the last two CLK windows.
''
'' @returns risesPerSec - CLK rises per second, averaged over shifting and gaps

  risesPerSec := lastClkRisesPerSec

PUB clockHighNsX100() : highNsX100
'' Return the mean time CLK stays high in each pulse, high clocks / periods (CLK idles low
'' between shifts, so no gap time is counted). The monitor reads it long by up to one clock.
''
'' @returns highNsX100 - nanoseconds x 100

  highNsX100 := lastClkHighNsX100

PUB startTakeCheck(lastRowAddress) : status
'' Start a cog that checks every frame-set take: at each rise of P8 it reads the row-address
'' pins and counts the take as at a frame boundary when they hold lastRowAddress. Needs the
'' monitors running (P8 is driven only then). Read the counts with takeTotals().
''
'' @param lastRowAddress - the row address of a frame's last row (row addresses in a frame - 1)
'' @returns status - SUCCESS if the check's cog started, E_NOT_RUNNING if the monitors are not running,
''                   E_NO_FREE_COG if no cog is free

  status := E_NOT_RUNNING
  stopTakeCheck()
  if monitorsRunning == TRUE
    longfill(@takeTallies, 0, TALLY_COUNT)
    takeCheckCog := cogspin(NEWCOG, watchTakes(matrix.MTX_LA_XT_P08, adapterFirstPin + matrix.PIN_OFST_A, lastRowAddress), @takeCheckStack)
    if takeCheckCog >= 0
      status := hwEnum.SUCCESS
    else
      status := E_NO_FREE_COG
      takeCheckCog := NO_COG
      debug("INSTR: take check not started: no free cog")

PUB stopTakeCheck()
'' Stop the take check's cog, if running. Its counts stay readable.
''

  if takeCheckCog <> NO_COG
    cogstop(takeCheckCog)
    takeCheckCog := NO_COG

PUB takeTotals() : nTakes, nOnBoundary, nOffBoundary, lastOffRow
'' Return the take check's counts since startTakeCheck().
''
'' @returns nTakes - frame-set takes seen (P8 rises)
'' @returns nOnBoundary - takes made with the frame's last row address on the pins
'' @returns nOffBoundary - takes made with any other row address: part way through a frame
'' @returns lastOffRow - row address of the latest take off the boundary (meaningful only when nOffBoundary > 0)

  nTakes := LONG[@takeTallies][TALLY_TAKES]
  nOnBoundary := LONG[@takeTallies][TALLY_ON_BOUNDARY]
  nOffBoundary := LONG[@takeTallies][TALLY_OFF_BOUNDARY]
  lastOffRow := LONG[@takeTallies][TALLY_LAST_OFF_ROW]

PUB stopwatchStart() : startTick
'' Take the start of an interval, for commit time or draw time.
''
'' @returns startTick - the system counter now

  startTick := getct()

PUB stopwatchMicros(startTick) : elapsedMicros
'' Return the microseconds since a stopwatchStart().
''
'' @param startTick - value stopwatchStart() returned
'' @returns elapsedMicros - elapsed time in microseconds

  elapsedMicros := muldiv64(getct() - startTick, MICROS_PER_SECOND, clkfreq)

PRI chooseMonitorPin(sigIdx) : monitorPin | choiceIdx, candidatePin
' Pick the first free neighbour of a signal, nearest-below first, and record its routing.
'
' @param sigIdx - the MON_* signal to find a monitor for
' @returns monitorPin - the pin that monitors the signal, or NO_PIN if no neighbour is free

' Local Variables:
' @local choiceIdx - neighbour choice being tried
' @local candidatePin - the pin that choice would use

  monitorPin := NO_PIN
  repeat choiceIdx from 0 to NEIGHBOUR_CHOICES - 1
    candidatePin := LONG[@watchedPins][sigIdx] + LONG[@neighbourOffsets][choiceIdx]
    if isPinFree(candidatePin) == TRUE
      monitorPin := candidatePin
      LONG[@monitorPins][sigIdx] := candidatePin
      LONG[@monitorRoutes][sigIdx] := choiceIdx
      quit

PRI isPinFree(candidatePin) : bFree | otherIdx
' Say whether a pin may hold a monitor: usable, not the adapter's, not a strobe, not already a monitor.
'
' @param candidatePin - pin being considered
' @returns bFree - TRUE if the pin is free

' Local Variables:
' @local otherIdx - signal whose monitor pin is compared

  bFree := (candidatePin >= 0) and (candidatePin <= LAST_USABLE_PIN)
  if candidatePin >= adapterFirstPin and candidatePin <= adapterLastPin
    bFree := FALSE
  if candidatePin >= matrix.MTX_LA_XT_P08 and candidatePin <= matrix.MTX_LA_XT_P11
    bFree := FALSE
  repeat otherIdx from 0 to MON_COUNT - 1
    if LONG[@monitorPins][otherIdx] == candidatePin
      bFree := FALSE

PRI startMonitor(sigIdx) | monitorPin, routeIdx
' Configure and start one monitor smart pin. Y is written before DIR rises, which is safe for
' these counting modes because their Y is 0, the reset value.
'
' @param sigIdx - the MON_* signal whose monitor starts

' Local Variables:
' @local monitorPin - the pin that monitors the signal
' @local routeIdx - the neighbour choice that routes it

  monitorPin := LONG[@monitorPins][sigIdx]
  routeIdx := LONG[@monitorRoutes][sigIdx]
  case sigIdx
    MON_CLK:
      startClockWindow()
    MON_OE:
      ' count the clocks A is LOW in each window: the lit time (p2kbArchSmartPin01111CountHighsOptionalDec)
      pinstart(monitorPin, P_COUNT_HIGHS | P_INVERT_A | LONG[@routeInputA][routeIdx], clkfreq, MON_COUNT_A_ONLY)
    other:
      ' count A rises in each window (p2kbArchSmartPin01110CountAEdgesOptionalBDec)
      pinstart(monitorPin, P_COUNT_RISES | LONG[@routeInputA][routeIdx], clkfreq, MON_COUNT_A_ONLY)

PRI startClockWindow() | monitorPin, routeIdx, windowMode
' Start the CLK monitor's next period-aligned window (p2kbArchSmartPin10110CountHighsInXClocks).
' Both inputs are routed to CLK: the window closes on the next rise of B.
'

' Local Variables:
' @local monitorPin - the pin that monitors CLK
' @local routeIdx - the neighbour choice that routes it
' @local windowMode - smart-pin mode of this window

  monitorPin := LONG[@monitorPins][MON_CLK]
  routeIdx := LONG[@monitorRoutes][MON_CLK]
  if clkWindowKind == CLK_WINDOW_HIGHS
    windowMode := P_COUNTER_HIGHS
  else
    windowMode := P_COUNTER_PERIODS
  pinstart(monitorPin, windowMode | LONG[@routeInputA][routeIdx] | LONG[@routeInputB][routeIdx], clkfreq, CLK_PERIOD_TRIGGER)

PRI readClockMonitor() | monitorPin, windowValue, bDone
' Finish the CLK window, keep its count as a per-second figure, and start the other window.
' The window is X = clkfreq clocks plus at most the CLK period in progress, so its count is
' per second without timing it here (p2kbArchSmartPin10110CountHighsInXClocks).
'

' Local Variables:
' @local monitorPin - the pin that monitors CLK
' @local windowValue - the window's count
' @local bDone - TRUE if the window completed

  monitorPin := LONG[@monitorPins][MON_CLK]
  if monitorPin <> NO_PIN
    bDone := waitForWindow(monitorPin)
    windowValue := 0
    if bDone == TRUE
      windowValue := rdpin(monitorPin)
    if clkWindowKind == CLK_WINDOW_HIGHS
      clkHighClocksPerSec := windowValue
      clkWindowKind := CLK_WINDOW_PERIODS
    else
      clkPeriodsPerSec := windowValue
      clkWindowKind := CLK_WINDOW_HIGHS
    startClockWindow()

PRI readWindow(monitorPin) : windowCount | bDone
' Wait for a monitor's window to end and return its count; 0 if it never ends.
'
' @param monitorPin - the pin that monitors the signal to read
' @returns windowCount - the window's count

' Local Variables:
' @local bDone - TRUE if the window completed

  windowCount := 0
  bDone := waitForWindow(monitorPin)
  if bDone == TRUE
    windowCount := rdpin(monitorPin)

PRI waitForWindow(monitorPin) : bDone | giveUpTick
' Wait until a monitor raises IN (the end of its window), for at most WINDOW_TIMEOUT_LENGTHS
' windows. A CLK monitor on a silent panel never completes, so the wait must end.
'
' @param monitorPin - the pin that monitors the signal to wait on
' @returns bDone - TRUE if IN rose, FALSE if the wait timed out

' Local Variables:
' @local giveUpTick - system counter at which the wait ends

  bDone := FALSE
  giveUpTick := getct() + (clkfreq * WINDOW_TIMEOUT_LENGTHS)
  repeat
    if pinread(monitorPin) <> 0
      bDone := TRUE
      quit
    if getct() - giveUpTick > 0
      quit

PRI deriveFigures() | latchRises, litClocks, highPulseX100
' Turn the last window counts into the figures the report and the getters give. CLK idles low
' in the gaps between shifts, so high clocks / periods is the mean high time of one pulse. The
' monitor sees the pin through its own input threshold and reads the high half long by about
' 0.5 to 1 clock (DOCs/bench/RUN-NOTES.md, "Clock low half", and task #93).
'

' Local Variables:
' @local latchRises - LATCH rises in the last window
' @local litClocks - clocks /OE was low in the last window
' @local highPulseX100 - mean clocks CLK is high per pulse, x100

  latchRises := LONG[@windowCounts][MON_LATCH]
  litClocks := LONG[@windowCounts][MON_OE]
  lastRefreshX100 := 0
  if latchesPerRefresh > 0
    lastRefreshX100 := muldiv64(latchRises, matrix.FIXED_POINT_SCALE, latchesPerRefresh)
  lastLitX100 := muldiv64(litClocks, matrix.PERCENT_X100_SCALE, clkfreq)
  lastClkRisesPerSec := clkPeriodsPerSec
  lastClkHighClocksX100 := 0
  lastClkHighNsX100 := 0
  if clkPeriodsPerSec > 0
    highPulseX100 := muldiv64(clkHighClocksPerSec, matrix.FIXED_POINT_SCALE, clkPeriodsPerSec)
    lastClkHighClocksX100 := highPulseX100
    lastClkHighNsX100 := muldiv64(highPulseX100, matrix.NS_PER_SECOND, clkfreq)

PRI reportSecond()
' Print one INSTR line: the figures first, then the raw counts of each strobe and of LATCH.
'

  debug("INSTR: refresh ", udec_(lastRefreshX100 / matrix.FIXED_POINT_SCALE), ".", udec_((lastRefreshX100 // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), " Hz, lit ", udec_(lastLitX100 / matrix.FIXED_POINT_SCALE), ".", udec_((lastLitX100 // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), "%, clk ", udec_(lastClkRisesPerSec / matrix.HZ_PER_MHZ), ".", udec_((lastClkRisesPerSec // matrix.HZ_PER_MHZ) / (matrix.HZ_PER_MHZ / matrix.FRACTION_DIVISOR)), " MHz mean, high ", udec_(lastClkHighClocksX100 / matrix.FIXED_POINT_SCALE), ".", udec_((lastClkHighClocksX100 // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), " clk ", udec_(lastClkHighNsX100 / matrix.FIXED_POINT_SCALE), ".", udec_((lastClkHighNsX100 // matrix.FIXED_POINT_SCALE) / matrix.FRACTION_DIVISOR), " ns | /s: cmd ", udec_(LONG[@windowCounts][MON_CMD]), " frame ", udec_(LONG[@windowCounts][MON_FRAME]), " row ", udec_(LONG[@windowCounts][MON_ROW]), " plane ", udec_(LONG[@windowCounts][MON_PLANE]), " latch ", udec_(LONG[@windowCounts][MON_LATCH]))

PRI watchTakes(takePin, firstAddressPin, lastRowAddress) | eventConfig, addressShift, rowAddress, tally, pTakes, pOnBoundary, pOffBoundary, pLastOffRow
' Run in the take check's own cog, forever (stopTakeCheck() stops the cog). Selectable event 1
' latches each rise of takePin (p2kbPasm2Setse1), so the two-clock P8 pulse is never missed, and
' WAITSE1 returns on it and clears it (p2kbPasm2Waitse1). The row address is read from the port
' at once: the refresh core drives row 0's address only after shifting row 0's first plane.
'
' @param takePin - the posted-set-taken strobe pin (P8)
' @param firstAddressPin - the adapter's address pin A; A-E are five consecutive pins
' @param lastRowAddress - the row address a take at a frame boundary finds on A-E

' Local Variables:
' @local eventConfig - SETSE1 value: takePin rises
' @local addressShift - place of pin A in its port
' @local rowAddress - row address read at a take
' @local tally - a count being stepped
' @local pTakes - hub address of TALLY_TAKES
' @local pOnBoundary - hub address of TALLY_ON_BOUNDARY
' @local pOffBoundary - hub address of TALLY_OFF_BOUNDARY
' @local pLastOffRow - hub address of TALLY_LAST_OFF_ROW

  eventConfig := EVENT_PIN_RISES | takePin
  addressShift := firstAddressPin & PIN_IN_PORT_MASK
  pTakes := @LONG[@takeTallies][TALLY_TAKES]
  pOnBoundary := @LONG[@takeTallies][TALLY_ON_BOUNDARY]
  pOffBoundary := @LONG[@takeTallies][TALLY_OFF_BOUNDARY]
  pLastOffRow := @LONG[@takeTallies][TALLY_LAST_OFF_ROW]
  org
                setse1  eventConfig                     ' also clears the event flag
.waitTake       waitse1
                testb   firstAddressPin, #PORT_SELECT_BIT  wc
    if_nc       mov     rowAddress, ina
    if_c        mov     rowAddress, inb
                shr     rowAddress, addressShift
                and     rowAddress, #ROW_ADDRESS_MASK
                rdlong  tally, pTakes
                add     tally, #1
                wrlong  tally, pTakes
                cmp     rowAddress, lastRowAddress  wz
    if_z        rdlong  tally, pOnBoundary
    if_z        add     tally, #1
    if_z        wrlong  tally, pOnBoundary
    if_nz       rdlong  tally, pOffBoundary
    if_nz       add     tally, #1
    if_nz       wrlong  tally, pOffBoundary
    if_nz       wrlong  rowAddress, pLastOffRow
                jmp     #.waitTake
  end

PRI signalLabel(sigIdx) : pLabel
' Return the printable name of a signal.
'
' @param sigIdx - the MON_* signal to name
' @returns pLabel - zero-terminated name

  case sigIdx
    MON_CMD:
      pLabel := string("posted set taken")
    MON_FRAME:
      pLabel := string("frame start")
    MON_ROW:
      pLabel := string("row start")
    MON_PLANE:
      pLabel := string("plane latch")
    MON_CLK:
      pLabel := string("CLK")
    MON_OE:
      pLabel := string("/OE")
    other:
      pLabel := string("LATCH")

