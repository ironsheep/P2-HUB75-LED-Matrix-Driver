''
''   File....... isp_hub75_panel.spin2
''   Purpose.... Manage the HUB75 panel content
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2022 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2020
''   Updated.... 04 Oct 2026
''
''  This object provides 24bit screen buffer to PWM buffers support
'' =================================================================================================

CON ' I/O PINs

' None

CON ' Magic-number vocabulary (per SPIN2-AUTHORING-GUIDE.md 5.7)

' RGB1/RGB2 plane bit values (panel BGR byte layout)
    RGB1_RED_BIT            = $01
    RGB1_GREEN_BIT          = $02
    RGB1_BLUE_BIT           = $04
    RGB2_RED_BIT            = $08
    RGB2_GREEN_BIT          = $10
    RGB2_BLUE_BIT           = $20

' RGB plane masks
    MASK_RGB1               = $07
    MASK_RGB2               = $38
    MASK_RGB12              = $3F

' Scan-geometry split divisors
    HALF_DIVISOR            = 2
    QUARTER_DIVISOR         = 4

' Byte/long geometry
    MSBIT_OF_BYTE           = 7
    BITS_PER_BYTE           = 8
    BYTES_PER_LONG          = 4

' ASCII digit/letter build
    ASCII_SPACE             = $20
    ASCII_DIGIT_ZERO        = $30
    ASCII_UPPER_A           = $41
    MAX_DECIMAL_DIGIT       = 9
    DECIMAL_BASE            = 10

' Color byte indices within a 24-bit RGB long
    RED_BYTE_IDX            = 0
    GREEN_BYTE_IDX          = 1
    BLUE_BYTE_IDX           = 2

' Debug-dump head byte count
    DUMP_HEAD_BYTES         = 48

' RGB2 empty-check scan span (first 32 bytes)
    RGB2_CHECK_BYTE_COUNT   = 32

' Test sentinel
    ALL_ONES                = $ffffffff

' "Pwm0 " dump-label byte positions (frame index char, RGB2-present flag)
    MSG_PWM_INDEX_POS       = 3
    MSG_PWM_FLAG_POS        = 4

CON ' ---- MERGEB converter (convertRowPairs) ----

' MOVBYTS byte orders that put a pixel's channel bytes where the panel's R, G and B pins take
' them (bytes 0, 1, 2); byte 3 stays in place. Each base-4 digit names the source byte of one
' result byte, result byte 3 first:
'  CHANNELS_AS_IS           - R, G, B unchanged
'  CHANNELS_SWAP_RB         - R pin shows blue, B pin shows red
'  CHANNELS_SWAP_GB         - G pin shows blue, B pin shows green
'  CHANNELS_SWAP_RB_THEN_GB - both swaps, red/blue first: R pin blue, G pin red, B pin green
    CHANNELS_AS_IS              = %%3210
    CHANNELS_SWAP_RB            = %%3012
    CHANNELS_SWAP_GB            = %%3120
    CHANNELS_SWAP_RB_THEN_GB    = %%3102

' byte of the top pixel's long that carries the bottom pixel's R-pin byte into the MERGEB
' (it held the next pixel's red)
    TOP_SPARE_BYTE_IDX          = 3

' highest bit of the bottom pixel's G-pin and B-pin bytes once they sit in bytes 0-1
    BOTTOM_GB_MSBIT             = 15

' frame walk of the half-scan: its slots' lines follow one another with no gap, and its first
' top-half row (screen offset 0) has frame line 0
    NO_SLOT_GAP_BYTES           = 0
    FIRST_SCAN_ROW_BYTES        = 0

' instructions in one unrolled plane step (SUB, GETNIB, ROLNIB, WRBYTE)
    PLANE_STEP_LONGS            = 4

' colour bit n of a channel byte: after MERGEB it is nibble n of the merged long
'  COLOR_BIT_0 (least significant) .. COLOR_BIT_7 (most significant, plane 0)
    #0, COLOR_BIT_0, COLOR_BIT_1, COLOR_BIT_2, COLOR_BIT_3, COLOR_BIT_4, COLOR_BIT_5, COLOR_BIT_6, COLOR_BIT_7

OBJ ' Objects Needed

    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    matrix      : "isp_hub75_rgb3bit"

VAR ' driver instance variables
    LONG    instanceID
    LONG    cog
    LONG    chainIndex
    LONG    maxChainRows
    LONG    maxChainColumns
    LONG    nPanelRows
    LONG    nPanelColumns
    LONG    nPanelCount
    LONG    nPanelsPerRow
    LONG    nPanelsPerColumn
    LONG    nDisplayRows
    LONG    nDisplayColumns
    LONG    nColorDepth
    LONG    nBytesPerColor
    LONG    nPwmFrameSizeInBytes
    LONG    nPwmFrameSizeInLongs
#ifdef DBG_PWM
    BYTE    bDumpOnce
    BYTE    nPassCt
#endif

    LONG    pPwmFrame1
    LONG    pPwmFrame2
    LONG    pLastPosted                                 ' the frame set posted last (matrix.NO_FRAME_SET before the first post)
#IFDEF HUB75_INSTRUMENT
    LONG    pTraceConverted                             ' the set the latest commit converted into
    LONG    pTraceShownAtPost                           ' the set on display when that conversion was done
    LONG    pTraceFirstShown                            ' the set on display when the first commit posted
    LONG    nTraceCommits                               ' commits posted
    LONG    nTraceWaited                                ' posts that had to wait for the previous one to be taken
    LONG    nTraceBad                                   ' commits that converted into the set on display
#ENDIF

' ----------------------------------------------------------

PUB null()
'' Placeholder to prevent this object from being used as a top-level file.
''

PUB start(nID, nChainIdx) : startedCog
'' Start the backend PASM2 driver for the matrix.
''
'' @param nID - panel instance identifier
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns startedCog - cog ID on success or -1 on failure

  chainIndex := nChainIdx
  instanceID := nID
  nBytesPerColor := hub75Bffrs.bytesPerColor(chainIndex)
  nColorDepth := hub75Bffrs.colorDepth(chainIndex)
  nPwmFrameSizeInBytes := hub75Bffrs.pwmFrameSizeInBytes(chainIndex)
  pPwmFrame1 := hub75Bffrs.pwmFrame1BufferAddress(chainIndex)
  pPwmFrame2 := hub75Bffrs.pwmFrame2BufferAddress(chainIndex)
  nPanelCount := hub75Bffrs.maxPanels(chainIndex)
  nPanelRows, nPanelColumns := hub75Bffrs.panelSizeInPixels(chainIndex)
  nPanelsPerColumn, nPanelsPerRow := hub75Bffrs.displaySizeInPanels(chainIndex)
  nDisplayRows, nDisplayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  maxChainRows := nPanelRows
  maxChainColumns := nPanelCount * nPanelColumns

  DEBUG("- PNL: #", udec_(instanceID), " Start clk=", udec_long(clkfreq))
  DEBUG("- PNL: Grid ", udec_(nPanelsPerRow), "x", udec_(nPanelsPerColumn), " cells, ", udec_(nPanelCount), " panels, Display ", udec_(nDisplayColumns), "x", udec_(nDisplayRows))

#ifdef DBG_PWM
  bDumpOnce := FALSE
  nPassCt := 0
#endif

  nPwmFrameSizeInLongs := hub75Bffrs.pwmFrameSizeInLongs(chainIndex)
  DEBUG("- PNL: PHYScols=", udec_long_(maxChainColumns), " PHYSrows=", udec_long_(maxChainRows))
  DEBUG("- PNL: maxPwmBuffers=", udec_long_(nColorDepth), " PwmBufferSizeInLongs=", udec_long_(nPwmFrameSizeInLongs))
  DEBUG("- PNL: BFFR pwm[1][", udec_long_(nPwmFrameSizeInLongs), "] ", uhex_long_(pPwmFrame1))
  DEBUG("- PNL: BFFR pwm[2][", udec_long_(nPwmFrameSizeInLongs), "] ", uhex_long_(pPwmFrame2))

  pLastPosted := matrix.NO_FRAME_SET                    ' nothing posted yet: the first commit has no earlier post to wait for
#IFDEF HUB75_INSTRUMENT
  nTraceCommits := 0
  nTraceWaited := 0
  nTraceBad := 0
#ENDIF

  longfill(pPwmFrame1, 0, nPwmFrameSizeInLongs * nColorDepth)   ' clear both PWM frame sets
  longfill(pPwmFrame2, 0, nPwmFrameSizeInLongs * nColorDepth)

  startedCog := cog := matrix.start(instanceID, chainIndex)     ' send buffer to driver
  if startedCog == -1
    DEBUG("- PNL: underlying drivers failed!")
    abort

  waitms(1)                                             ' allow cog-start debug messages to finish...

PUB stop()
'' Stop the PASM2 backend driver and release the cog.
''

  if cog
    matrix.stop()
    cog := 0

PUB fillScreenNoPWM(threeBitColor) | pFrameSet
'' Fill screen with a solid 3-bit color without PWM (for testing the underlying driver). Every
'' bit plane of the frame set that is not on display is filled with the color at full level,
'' and that set is posted the way a commit posts it, so the fill never writes the set on
'' display. The screen buffer is not touched.
''
'' @param threeBitColor - 3-bit RGB color value to fill

' Local Variables:
' @local pFrameSet - the frame set that is not on display, which the fill writes

  pFrameSet := frameSetToConvertInto()                  ' waits for the previous post to be taken
  bytefill(pFrameSet, matrix.fillByteForColor(threeBitColor), nPwmFrameSizeInBytes * nColorDepth)
  postFrameSet(pFrameSet)

PUB setBrightness(newBrightness)
'' Set the brightness scale every refresh driver applies to its /OE time
'' (see isp_hub75_rgb3bit.spin2 setBrightness()).
''
'' @param newBrightness - the desired brightness value [0-256]

  matrix.setBrightness(newBrightness)

PUB getBrightness() : nBrightness
'' Return the brightness scale the refresh drivers apply to their /OE time.
''
'' @returns nBrightness - the brightness value [0-256]

  nBrightness := matrix.getBrightness()

PUB showFrameSet(pFrameSet) : accepted
'' Post a PWM frame set to the refresh driver, the way a commit does. Only one of this adapter's
'' two frame sets is accepted, so the set a converter writes stays the one that is not on
'' display. If the previous post has not been taken yet, this waits for it first, so no post is
'' overwritten before the driver has seen it. A refused address prints a message and posts nothing.
''
'' @param pFrameSet - hub address of one of the adapter's two PWM frame sets
'' @returns accepted - TRUE if the set was posted, FALSE if the address was refused

  accepted := FALSE
  if pFrameSet == matrix.NO_FRAME_SET
    debug("HUB75: DISP", udec_(chainIndex), ": showFrameSet(NULL) refused: no frame set given; give one of this adapter's two PWM frame sets, ", uhex_long_(pPwmFrame1), " or ", uhex_long_(pPwmFrame2))
  elseif pFrameSet <> pPwmFrame1 and pFrameSet <> pPwmFrame2
    debug("HUB75: DISP", udec_(chainIndex), ": showFrameSet(", uhex_long_(pFrameSet), ") refused: not one of this adapter's two PWM frame sets, ", uhex_long_(pPwmFrame1), " or ", uhex_long_(pPwmFrame2))
  else
    waitPostedSetTaken()
    postFrameSet(pFrameSet)
    accepted := TRUE

#IFDEF HUB75_INSTRUMENT
PUB commitTrace() : pConverted, pShownAtPost, pShownNow
'' Instrument build only: what the latest commit did, for the frame-set handshake trace.
''
'' @returns pConverted - the frame set the latest commit converted into
'' @returns pShownAtPost - the frame set on display when that conversion was done (never equal to pConverted)
'' @returns pShownNow - the frame set on display at this call

  pConverted := pTraceConverted
  pShownAtPost := pTraceShownAtPost
  pShownNow := matrix.showingFrameSet()

PUB commitTotals() : nCommits, nWaited, nBad, pFirstShown
'' Instrument build only: totals since start for the frame-set handshake trace.
''
'' @returns nCommits - commits posted
'' @returns nWaited - posts that waited for the previous post to be taken
'' @returns nBad - commits that converted into the frame set on display (must be 0)
'' @returns pFirstShown - the frame set on display when the first commit posted (matrix.NO_FRAME_SET at the first commit after start)

  nCommits := nTraceCommits
  nWaited := nTraceWaited
  nBad := nTraceBad
  pFirstShown := pTraceFirstShown
#ENDIF

PUB convertScreen2PWM_14(p24bitScreen, bSwapRB, bSwapGB) | pPwmFrameSet
'' Load a 24-bit-color image into PWM frame buffers for 1/8 scan panels (4 scan-lines at a time):
'' convert it into the PWM frame set that is not on display (see convertQuarterScan()), then post
'' that set.
''
'' @param p24bitScreen - pointer to 24-bit screen buffer
'' @param bSwapRB - TRUE to swap red and blue channels
'' @param bSwapGB - TRUE to swap green and blue channels

' Local Variables:
' @local pPwmFrameSet - pointer to the PWM frame set that is not on display (converted into, then posted)

  pPwmFrameSet := frameSetToConvertInto()
  convertQuarterScan(p24bitScreen, pPwmFrameSet, nPanelCount, nPanelColumns, nPanelRows, nColorDepth, nBytesPerColor, bSwapRB, bSwapGB)
  postConvertedSet(pPwmFrameSet)

PUB convertQuarterScan(p24bitScreen, pFrameSet, panelCnt, panelCols, panelRows, planeCnt, pixelBytes, bSwapRB, bSwapGB) | lineBytes
'' Convert a 24-bit screen buffer into a PWM frame set for panels that light four rows at once
'' (1/8 scan on a 64x32 panel, chip flag SCAN_4), using inline PASM (convertRowPairs()). It
'' writes only the buffers it is given and posts nothing: the commit (convertScreen2PWM_14())
'' calls it, and so does the converter test (test_hub75_converter.spin2).
''
'' Row m of the top half and row m + half a panel share a plane byte (RGB1 and RGB2), as in
'' convertHalfScan(). Each row address shifts two lines of every panel along the cable, slot 0
'' first: the line of the first quarter's row m is the second line of address m, and the line
'' of the second quarter's row q + m (q = a quarter of the panel rows) is the first line of
'' address m. The plane bytes are as convertHalfScan() describes.
''
'' @param p24bitScreen - pointer to 24-bit screen buffer
'' @param pFrameSet - hub address of the PWM frame set to write
'' @param panelCnt - panels on the adapter (buffer slots)
'' @param panelCols - pixel columns per panel
'' @param panelRows - pixel rows per panel
'' @param planeCnt - bit planes in the frame set: the colour depth (hwEnum.DEPTH_3BIT .. DEPTH_8BIT)
'' @param pixelBytes - bytes per pixel in the screen buffer (red, green, blue at +0, +1, +2)
'' @param bSwapRB - TRUE to swap red and blue channels
'' @param bSwapGB - TRUE to swap green and blue channels

' Local Variables:
' @local lineBytes - frame bytes in one line of one panel (the other line of a slot's pair is the gap)

  lineBytes := panelCols * hub75Bffrs.BYTES_PER_COLUMN_CLOCK
  convertRowPairs(p24bitScreen, pFrameSet, panelCnt, panelCols, panelRows, planeCnt, pixelBytes, channelOrder(bSwapRB, bSwapGB), ...
                  lineBytes, hub75Bffrs.SCAN_4_COLUMN_FACTOR * panelCnt * lineBytes, (panelRows / QUARTER_DIVISOR) * panelCols * pixelBytes)

' -----------------------------------------------------------------------------

PUB convertScreen2PWM(p24bitScreen, bSwapRB, bSwapGB) | pPwmFrameSet
'' Load a 24-bit image into PWM frame buffers at 16s, 32s (2 scan-lines at a time): convert it
'' into the PWM frame set that is not on display (see convertHalfScan()), then post that set.
''
'' @param p24bitScreen - pointer to 24-bit screen buffer
'' @param bSwapRB - TRUE to swap red and blue channels
'' @param bSwapGB - TRUE to swap green and blue channels

' Local Variables:
' @local pPwmFrameSet - pointer to the PWM frame set that is not on display (converted into, then posted)

  pPwmFrameSet := frameSetToConvertInto()
  convertHalfScan(p24bitScreen, pPwmFrameSet, nPanelCount, nPanelColumns, nPanelRows, nColorDepth, nBytesPerColor, bSwapRB, bSwapGB)

#ifdef DBG_PWM
  ' Debug code for Frame 0 MSB issue investigation (enable with -D DBG_PWM)
  nPassCt++
  if not bDumpOnce && nPassCt == 2
    bDumpOnce := TRUE
    debug("--- DEBUG: Frame 0 vs Frame 1 data ---")
    dumpBufferHeads(p24bitScreen, pPwmFrameSet)
    hub75Bffrs.dbgMemDump(@frame0Msg, pPwmFrameSet, 32)
    hub75Bffrs.dbgMemDump(@frame1Msg, pPwmFrameSet + nPwmFrameSizeInBytes, 32)
#endif

  postConvertedSet(pPwmFrameSet)

PUB convertHalfScan(p24bitScreen, pFrameSet, panelCnt, panelCols, panelRows, planeCnt, pixelBytes, bSwapRB, bSwapGB)
'' Convert a 24-bit screen buffer into a PWM frame set for panels that light two rows at once
'' (1/16 and 1/32 scan), using inline PASM (convertRowPairs()). It writes only the buffers it
'' is given and posts nothing: the commit (convertScreen2PWM()) calls it, and so does the
'' converter test (test_hub75_converter.spin2), which runs it on buffers of its own with no
'' panels attached.
''
'' The screen buffer holds the panels one after another, in buffer-slot order (row-major within
'' each panel). One row along the cable is the same scan row of every slot, slot 0 first, and
'' the scan rows follow one another in the frame. The frame set is planeCnt frames of one byte
'' per column clock, plane 0 first (the most significant colour bit); each byte carries the
'' top-half pixel (RGB1) in bits 0-2 and the pixel half a panel below it (RGB2) in bits 3-5.
''
'' @param p24bitScreen - pointer to 24-bit screen buffer
'' @param pFrameSet - hub address of the PWM frame set to write
'' @param panelCnt - panels on the adapter (buffer slots)
'' @param panelCols - pixel columns per panel
'' @param panelRows - pixel rows per panel
'' @param planeCnt - bit planes in the frame set: the colour depth (hwEnum.DEPTH_3BIT .. DEPTH_8BIT)
'' @param pixelBytes - bytes per pixel in the screen buffer (red, green, blue at +0, +1, +2)
'' @param bSwapRB - TRUE to swap red and blue channels
'' @param bSwapGB - TRUE to swap green and blue channels

  convertRowPairs(p24bitScreen, pFrameSet, panelCnt, panelCols, panelRows, planeCnt, pixelBytes, channelOrder(bSwapRB, bSwapGB), ...
                  NO_SLOT_GAP_BYTES, panelCnt * panelCols * hub75Bffrs.BYTES_PER_COLUMN_CLOCK, FIRST_SCAN_ROW_BYTES)

' -----------------------------------------------------------------------------

CON ' ------------- PRIVATE (Utility) Methods -------------

#ifdef DBG_PWM
' --- PWM/frame dump diagnostics toolkit (compiled only with -D DBG_PWM) ---
PRI dumpBufferHeads(pSCreenBuffer,pPwmBuffer)
' Dump the first 48 bytes of the screen and PWM buffers for debug inspection.
'
' @param pSCreenBuffer - pointer to screen buffer
' @param pPwmBuffer - pointer to PWM buffer

  hub75Bffrs.dbgMemDump(@bufferMsg, pSCreenBuffer, DUMP_HEAD_BYTES)
  hub75Bffrs.dbgMemDump(@frameMsg, pPwmBuffer, DUMP_HEAD_BYTES)

PRI dumpFrameAddrs(pPwmFrameSet) | pFrameBuffer, frameIndex
' Display the hub address of each PWM frame in the frame set.
'
' @param pPwmFrameSet - pointer to the PWM frame set

' Local Variables:
' @local pFrameBuffer - computed address of current PWM frame
' @local frameIndex - loop index over PWM frames

  repeat frameIndex from 0 to nColorDepth - 1
    pFrameBuffer := @LONG[pPwmFrameSet][frameIndex * nPwmFrameSizeInLongs]
    debug("PNL: PWM", udec_(frameIndex), ": ", uhex_long_(pFrameBuffer))

PRI dumpFrameSet(pPwmFrameSet) | pFrameBuffer, frameIndex
' Dump memory contents of all PWM frames in the frame set.
'
' @param pPwmFrameSet - pointer to the PWM frame set

' Local Variables:
' @local pFrameBuffer - computed address of current PWM frame
' @local frameIndex - loop index over PWM frames

  repeat frameIndex from 0 to nColorDepth - 1
    pFrameBuffer := @LONG[pPwmFrameSet][frameIndex * nPwmFrameSizeInLongs]
    dumpFrame(frameIndex, pFrameBuffer)

PRI dumpFrame(frameIdx, pFrameBuffer) | frameASCII
' Dump one PWM frame with an ASCII label indicating its index.
'
' @param frameIdx - zero-based PWM frame index
' @param pFrameBuffer - pointer to the PWM frame buffer

' Local Variables:
' @local frameASCII - ASCII character representing the frame index

  frameASCII := frameIdx | ASCII_DIGIT_ZERO
  if frameIdx > MAX_DECIMAL_DIGIT
    frameASCII := frameIdx - DECIMAL_BASE + ASCII_UPPER_A
  BYTE[@msgPwm][MSG_PWM_INDEX_POS] := frameASCII

  if emptyRgb2(pFrameBuffer)
    BYTE[@msgPwm][MSG_PWM_FLAG_POS] := "*"
  else
    BYTE[@msgPwm][MSG_PWM_FLAG_POS] := ASCII_SPACE     ' space

  hub75Bffrs.dbgMemDump(@msgPwm, pFrameBuffer, 32)

PRI emptyRgb2(pFrameBuffer) : isEmpty | byteIdx
' Check whether all RGB2 bits are zero in the first 32 bytes of a PWM frame.
'
' @param pFrameBuffer - pointer to the PWM frame buffer
' @returns isEmpty - TRUE if no RGB2 bits are set, FALSE otherwise

' Local Variables:
' @local byteIdx - loop index over frame bytes

  isEmpty := TRUE
  repeat byteIdx from 0 TO RGB2_CHECK_BYTE_COUNT - 1
    if BYTE[pFrameBuffer][byteIdx] & MASK_RGB2 > 0
      isEmpty := FALSE
      quit
#endif

PRI convertRowPairs(p24bitScreen, pFrameSet, panelCnt, panelCols, panelRows, planeCnt, pixelBytes, swapOrder, slotGapBytes, rowStepBytes, lineZeroRowBytes) | rowBytes, halfPanelBytes, panelSkipBytes, frameBytes, columnStep
' The MERGEB converter both scans share (convertHalfScan(), convertQuarterScan()). It pairs each
' top-half row m of every panel with row m + half a panel (RGB1 with RGB2), reads the screen
' buffer slot by slot, and writes one plane byte per column clock into each plane of the frame
' set. Only where each row's line lands in the frame differs between the scans, and the three
' frame-walk parameters give it:
'   a row's line starts slotGapBytes past where the row before it started (rowStepBytes), the
'   row at lineZeroRowBytes starts frame line 0, and the rows before it start slotGapBytes in;
'   along a row, each slot's line follows the last one after a gap of slotGapBytes.
'
' @param p24bitScreen - pointer to 24-bit screen buffer
' @param pFrameSet - hub address of the PWM frame set to write
' @param panelCnt - panels on the adapter (buffer slots)
' @param panelCols - pixel columns per panel
' @param panelRows - pixel rows per panel
' @param planeCnt - bit planes in the frame set: the colour depth (hwEnum.DEPTH_3BIT .. DEPTH_8BIT)
' @param pixelBytes - bytes per pixel in the screen buffer (red, green, blue at +0, +1, +2)
' @param swapOrder - MOVBYTS byte order that applies the channel swaps (channelOrder())
' @param slotGapBytes - frame bytes between one slot's line and the next slot's line in a row
' @param rowStepBytes - frame bytes from one top-half row's line to the next row's line
' @param lineZeroRowBytes - screen offset of the top-half row whose line is frame line 0 (slot 0)

' Local Variables:
' @local rowBytes - bytes in one row of one panel in the screen buffer
' @local halfPanelBytes - bytes from a top-half (RGB1) row to its bottom-half (RGB2) row
' @local panelSkipBytes - bytes from the end of a row in one slot to the same row in the next slot
' @local frameBytes - bytes in one PWM frame (one bit plane)
' @local columnStep - frame-set step from the plane 0 byte of a column to the last plane's byte of the next column

' NOTE: 16 longs total avail to inline pasm: params + return + local
'  --> 16/16 used

  rowBytes        := panelCols * pixelBytes
  halfPanelBytes  := (panelRows / HALF_DIVISOR) * rowBytes
  panelSkipBytes  := (panelRows - 1) * rowBytes
  frameBytes      := (panelRows / HALF_DIVISOR) * panelCnt * panelCols * hub75Bffrs.BYTES_PER_COLUMN_CLOCK
  columnStep      := planeCnt * frameBytes + hub75Bffrs.BYTES_PER_COLUMN_CLOCK

  { Per pixel pair (P2KB p2kbPasm2Rdlong, p2kbPasm2Movbyts, p2kbPasm2Setbyte, p2kbPasm2Mergeb,
    p2kbPasm2Getnib, p2kbPasm2Rolnib):
      top    long, bytes 0..3:  R-pin  G-pin  B-pin  bottom R-pin   (after MOVBYTS and SETBYTE)
      bottom long, bytes 0..3:  bottom G-pin  bottom B-pin  0  0    (after SHR and ZEROX)
    MERGEB makes nibble n of each long hold bit n of its four bytes, byte 3 in the nibble's
    top bit, so for colour bit n:
      top nibble    = {Rb, Bt, Gt, Rt}      bottom nibble = {0, 0, Bb, Gb}
    GETNIB the bottom nibble, ROLNIB the top nibble in below it, and the low byte is the plane
    byte: Rt, Gt, Bt, Rb, Gb, Bb in bits 0..5 (RGB1_RED_BIT .. RGB2_BLUE_BIT).
    The plane steps are unrolled from colour bit 0 up to bit 7 (plane 0). Each step first steps
    the frame pointer back one frame, so the pointer starts a column just past the last plane
    and ends it on plane 0; the column starts at the step of the least significant bit kept.
    Frame pointers below (pPlanesEnd, pLineStart, pPlaneByte) are all "just past the last
    plane" pointers: the plane steps take them back to the planes.
  }
    ORG
                    jmp     #startRowPairs

' registers (copied into the cog with the code)
topPixel            LONG    0                               ' top-half pixel, then its merged colour bits
bottomPixel         LONG    0                               ' bottom-half pixel, then its merged colour bits
pTopPixel           LONG    0                               ' screen address of the top-half pixel
pBottomPixel        LONG    0                               ' screen address of the bottom-half pixel
pRowStart           LONG    0                               ' screen address of this top-half row in slot 0
pRowsEnd            LONG    0                               ' screen address of the first bottom-half row in slot 0
pLineZeroRow        LONG    0                               ' screen address of the row whose line is frame line 0
pPlanesEnd          LONG    0                               ' frame-set address just past the last plane
pLineStart          LONG    0                               ' frame byte of this row's slot-0 line, past the last plane
pPlaneByte          LONG    0                               ' frame-set address of the plane byte being written
planeBits           LONG    0                               ' one plane byte: RGB1 in bits 0-2, RGB2 in bits 3-5
planeEntry          LONG    0                               ' cog address of the plane step of the least significant bit kept
panelCtr            LONG    0                               ' slots left in this row
columnCtr           LONG    0                               ' columns left in this slot

startRowPairs
                    ' skip the plane steps of the colour bits below the colour depth
                    mov     planeEntry, #BITS_PER_BYTE
                    sub     planeEntry, planeCnt
                    mul     planeEntry, #PLANE_STEP_LONGS
                    add     planeEntry, #planeOfBit0
                    mov     pPlanesEnd, pFrameSet
                    add     pPlanesEnd, columnStep
                    sub     pPlanesEnd, #hub75Bffrs.BYTES_PER_COLUMN_CLOCK
                    mov     pLineStart, pPlanesEnd                  ' rows before the line-zero row start one gap in
                    add     pLineStart, slotGapBytes
                    mov     pRowStart, p24bitScreen
                    mov     pLineZeroRow, p24bitScreen
                    add     pLineZeroRow, lineZeroRowBytes
                    mov     pRowsEnd, p24bitScreen
                    add     pRowsEnd, halfPanelBytes
nextPairRow
                    cmp     pRowStart, pLineZeroRow         wz
        if_z        mov     pLineStart, pPlanesEnd                  ' this row's line is frame line 0
                    mov     pPlaneByte, pLineStart
                    mov     pTopPixel, pRowStart
                    mov     pBottomPixel, pRowStart
                    add     pBottomPixel, halfPanelBytes
                    mov     panelCtr, panelCnt
nextPairPanel
                    mov     columnCtr, panelCols
nextPairColumn
                    rdlong  topPixel, pTopPixel                     ' bytes 0-2: R, G, B (byte 3: the next pixel's R)
                    rdlong  bottomPixel, pBottomPixel
                    movbyts topPixel, swapOrder                     ' bytes 0-2: what the R, G, B pins show
                    movbyts bottomPixel, swapOrder
                    setbyte topPixel, bottomPixel, #TOP_SPARE_BYTE_IDX  ' byte 3: the bottom pixel's R-pin byte
                    shr     bottomPixel, #BITS_PER_BYTE             ' bytes 0-1: the bottom G-pin and B-pin bytes
                    zerox   bottomPixel, #BOTTOM_GB_MSBIT           ' bytes 2-3: zero
                    mergeb  topPixel                                ' nibble n: bit n of {Rb, Bt, Gt, Rt}
                    mergeb  bottomPixel                             ' nibble n: bit n of {0, 0, Bb, Gb}
                    jmp     planeEntry
planeOfBit0
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_0
                    rolnib  planeBits, topPixel, #COLOR_BIT_0
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_1
                    rolnib  planeBits, topPixel, #COLOR_BIT_1
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_2
                    rolnib  planeBits, topPixel, #COLOR_BIT_2
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_3
                    rolnib  planeBits, topPixel, #COLOR_BIT_3
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_4
                    rolnib  planeBits, topPixel, #COLOR_BIT_4
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_5
                    rolnib  planeBits, topPixel, #COLOR_BIT_5
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes
                    getnib  planeBits, bottomPixel, #COLOR_BIT_6
                    rolnib  planeBits, topPixel, #COLOR_BIT_6
                    wrbyte  planeBits, pPlaneByte
                    sub     pPlaneByte, frameBytes                  ' plane 0: the most significant bit
                    getnib  planeBits, bottomPixel, #COLOR_BIT_7
                    rolnib  planeBits, topPixel, #COLOR_BIT_7
                    wrbyte  planeBits, pPlaneByte
                    ' next column: next pixel of this slot, next byte along the line
                    add     pPlaneByte, columnStep
                    add     pTopPixel, pixelBytes
                    add     pBottomPixel, pixelBytes
                    djnz    columnCtr, #nextPairColumn
                    ' the same row of the next slot, and that slot's line
                    add     pPlaneByte, slotGapBytes
                    add     pTopPixel, panelSkipBytes
                    add     pBottomPixel, panelSkipBytes
                    djnz    panelCtr, #nextPairPanel
                    ' the next top-half row, until the top half is done
                    add     pLineStart, rowStepBytes
                    add     pRowStart, rowBytes
                    cmp     pRowStart, pRowsEnd             wc
        if_c        jmp     #nextPairRow
    END

#IFDEF HUB75_CORRUPT_CONVERTER
  ' converter-test FAIL limb only (test_hub75_converter.spin2): one wrong bit, in the last byte
  ' of the last plane, for both scans
  BYTE[pFrameSet + planeCnt * frameBytes - hub75Bffrs.BYTES_PER_COLUMN_CLOCK] ^= RGB2_BLUE_BIT
#ENDIF

PRI channelOrder(bSwapRB, bSwapGB) : swapOrder
' Return the MOVBYTS byte order that puts a pixel's channel bytes where the panel's R, G and B
' pins take them (bytes 0, 1, 2), leaving byte 3 in place. With both swaps set, the red/blue
' swap is applied first and the green/blue swap to its result.
'
' @param bSwapRB - TRUE to swap red and blue channels
' @param bSwapGB - TRUE to swap green and blue channels
' @returns swapOrder - one of CHANNELS_AS_IS, CHANNELS_SWAP_RB, CHANNELS_SWAP_GB, CHANNELS_SWAP_RB_THEN_GB

  swapOrder := CHANNELS_AS_IS
  if bSwapRB <> FALSE and bSwapGB <> FALSE
    swapOrder := CHANNELS_SWAP_RB_THEN_GB
  elseif bSwapRB <> FALSE
    swapOrder := CHANNELS_SWAP_RB
  elseif bSwapGB <> FALSE
    swapOrder := CHANNELS_SWAP_GB

PRI waitPostedSetTaken()
' Wait until the refresh driver has taken the frame set posted last, that is, until the set it
' shows (dvrShowing) is that set. Nothing is waited for before the first post, or after the
' driver cog has been stopped.
'

  if pLastPosted <> matrix.NO_FRAME_SET and cog <> 0
#IFDEF HUB75_INSTRUMENT
    if matrix.showingFrameSet() <> pLastPosted
      nTraceWaited++
#ENDIF
    repeat while matrix.showingFrameSet() <> pLastPosted

PRI frameSetToConvertInto() : pFrameSet
' Return the frame set a commit converts into: the one that is not on display. It first waits
' for the previous post to be taken, so the set on display is the set posted last and the other
' set is free; before anything has been taken, neither set is on display and set 1 is free.
'
' @returns pFrameSet - hub address of the frame set that is not on display

  waitPostedSetTaken()
  pFrameSet := (matrix.showingFrameSet() == pPwmFrame1) ? pPwmFrame2 : pPwmFrame1

PRI postConvertedSet(pFrameSet)
' Post the frame set a commit has just converted into. In the instrument build the commit is
' recorded first: a set that is on display when its conversion is done is counted as bad.
'
' @param pFrameSet - hub address of the frame set the commit converted into

#IFDEF HUB75_INSTRUMENT
  pTraceConverted := pFrameSet
  pTraceShownAtPost := matrix.showingFrameSet()
  if nTraceCommits == 0
    pTraceFirstShown := pTraceShownAtPost
  if pFrameSet == pTraceShownAtPost
    nTraceBad++
  nTraceCommits++
#ENDIF
  postFrameSet(pFrameSet)

PRI postFrameSet(pFrameSet)
' Post a frame set to the refresh driver and remember it as the set posted last.
'
' @param pFrameSet - hub address of the frame set to show

  pLastPosted := pFrameSet
  matrix.cmdWritePwmBuffer(pFrameSet)

#ifdef DBG_PWM
DAT  ' PWM/frame dump diagnostic message strings (compiled only with -D DBG_PWM)

    msgPwm          BYTE    "Pwm0 ", 0

    bufferMsg       BYTE    "SCREEN",0
    frameMsg        BYTE    "PWM[0]",0
    frame0Msg       BYTE    "Frame0",0
    frame1Msg       BYTE    "Frame1",0
#endif

