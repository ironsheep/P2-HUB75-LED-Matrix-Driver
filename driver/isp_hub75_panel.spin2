'' =================================================================================================
''
''   File....... isp_hub75_panel.spin2
''   Purpose.... Manage the HUB75 panel content
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2022 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2020
''   Updated.... 5 Nov 2022
''
''  This object provides 24bit screen buffer to PWM buffers support
'' =================================================================================================

CON ' I/O PINs

' None

CON ' Magic-number vocabulary (per SPIN2-AUTHORING-GUIDE.md 5.7)

' RGB1/RGB2 plane bit values (panel BGR byte layout)
    RGB1_RED_BIT            = $01
    RGB1_GREEN_BIT          = $02
    RGB1_BLUE_BIT           = $04
    RGB2_RED_BIT            = $08
    RGB2_GREEN_BIT          = $10
    RGB2_BLUE_BIT           = $20

' RGB plane masks
    MASK_RGB1               = $07
    MASK_RGB2               = $38
    MASK_RGB12              = $3F

' Scan-geometry split divisors
    HALF_DIVISOR            = 2
    QUARTER_DIVISOR         = 4

' Byte/long geometry
    MSBIT_OF_BYTE           = 7
    BITS_PER_BYTE           = 8
    BYTES_PER_LONG          = 4

' ASCII digit/letter build
    ASCII_SPACE             = $20
    ASCII_DIGIT_ZERO        = $30
    ASCII_UPPER_A           = $41
    MAX_DECIMAL_DIGIT       = 9
    DECIMAL_BASE            = 10

' Color byte indices within a 24-bit RGB long
    RED_BYTE_IDX            = 0
    GREEN_BYTE_IDX          = 1
    BLUE_BYTE_IDX           = 2

' Debug-dump head byte count
    DUMP_HEAD_BYTES         = 48

' RGB2 empty-check scan span (first 32 bytes)
    RGB2_CHECK_BYTE_COUNT   = 32

' Test sentinel
    ALL_ONES                = $ffffffff

' "Pwm0 " dump-label byte positions (frame index char, RGB2-present flag)
    MSG_PWM_INDEX_POS       = 3
    MSG_PWM_FLAG_POS        = 4

OBJ ' Objects Needed

    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    matrix      : "isp_hub75_rgb3bit"

VAR ' driver instance variables
    LONG    instanceID
    LONG    cog
    LONG    chainIndex
    LONG    maxChainRows
    LONG    maxChainColumns
    LONG    nPanelRows
    LONG    nPanelColumns
    LONG    nPanelCount
    LONG    nPanelsPerRow
    LONG    nPanelsPerColumn
    LONG    nDisplayRows
    LONG    nDisplayColumns
    LONG    nColorDepth
    LONG    nBytesPerColor
    LONG    nPwmFrameSizeInBytes
    LONG    nPwmFrameSizeInLongs
#ifdef DBG_PWM
    BYTE    bDumpOnce
    BYTE    nPassCt
#endif

    LONG    pPwmFrame1
    LONG    pPwmFrame2
    LONG    pLastPosted                                 ' the frame set posted last (matrix.NO_FRAME_SET before the first post)
#IFDEF HUB75_INSTRUMENT
    LONG    pTraceConverted                             ' the set the latest commit converted into
    LONG    pTraceShownAtPost                           ' the set on display when that conversion was done
    LONG    pTraceFirstShown                            ' the set on display when the first commit posted
    LONG    nTraceCommits                               ' commits posted
    LONG    nTraceWaited                                ' posts that had to wait for the previous one to be taken
    LONG    nTraceBad                                   ' commits that converted into the set on display
#ENDIF

' ----------------------------------------------------------

PUB null()
'' Placeholder to prevent this object from being used as a top-level file.
''

PUB start(nID, nChainIdx) : startedCog
'' Start the backend PASM2 driver for the matrix.
''
'' @param nID - panel instance identifier
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns startedCog - cog ID on success or -1 on failure

  chainIndex := nChainIdx
  instanceID := nID
  nBytesPerColor := hub75Bffrs.bytesPerColor(chainIndex)
  nColorDepth := hub75Bffrs.colorDepth(chainIndex)
  nPwmFrameSizeInBytes := hub75Bffrs.pwmFrameSizeInBytes(chainIndex)
  pPwmFrame1 := hub75Bffrs.pwmFrame1BufferAddress(chainIndex)
  pPwmFrame2 := hub75Bffrs.pwmFrame2BufferAddress(chainIndex)
  nPanelCount := hub75Bffrs.maxPanels(chainIndex)
  nPanelRows, nPanelColumns := hub75Bffrs.panelSizeInPixels(chainIndex)
  nPanelsPerColumn, nPanelsPerRow := hub75Bffrs.displaySizeInPanels(chainIndex)
  nDisplayRows, nDisplayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  maxChainRows := nPanelRows
  maxChainColumns := nPanelCount * nPanelColumns

  DEBUG("- PNL: #", udec_(instanceID), " Start clk=", udec_long(clkfreq))
  DEBUG("- PNL: Grid ", udec_(nPanelsPerRow), "x", udec_(nPanelsPerColumn), " cells, ", udec_(nPanelCount), " panels, Display ", udec_(nDisplayColumns), "x", udec_(nDisplayRows))

#ifdef DBG_PWM
  bDumpOnce := FALSE
  nPassCt := 0
#endif

  nPwmFrameSizeInLongs := hub75Bffrs.pwmFrameSizeInLongs(chainIndex)
  DEBUG("- PNL: PHYScols=", udec_long_(maxChainColumns), " PHYSrows=", udec_long_(maxChainRows))
  DEBUG("- PNL: maxPwmBuffers=", udec_long_(nColorDepth), " PwmBufferSizeInLongs=", udec_long_(nPwmFrameSizeInLongs))
  DEBUG("- PNL: BFFR pwm[1][", udec_long_(nPwmFrameSizeInLongs), "] ", uhex_long_(pPwmFrame1))
  DEBUG("- PNL: BFFR pwm[2][", udec_long_(nPwmFrameSizeInLongs), "] ", uhex_long_(pPwmFrame2))

  pLastPosted := matrix.NO_FRAME_SET                    ' nothing posted yet: the first commit has no earlier post to wait for
#IFDEF HUB75_INSTRUMENT
  nTraceCommits := 0
  nTraceWaited := 0
  nTraceBad := 0
#ENDIF

  longfill(pPwmFrame1, 0, nPwmFrameSizeInLongs * nColorDepth)   ' clear both PWM frame sets
  longfill(pPwmFrame2, 0, nPwmFrameSizeInLongs * nColorDepth)

  startedCog := cog := matrix.start(instanceID, chainIndex)     ' send buffer to driver
  if startedCog == -1
    DEBUG("- PNL: underlying drivers failed!")
    abort

  waitms(1)                                             ' allow cog-start debug messages to finish...

PUB stop()
'' Stop the PASM2 backend driver and release the cog.
''

  if cog
    matrix.stop()
    cog := 0

PUB fillScreenNoPWM(threeBitColor) | pFrameSet
'' Fill screen with a solid 3-bit color without PWM (for testing the underlying driver). Every
'' bit plane of the frame set that is not on display is filled with the color at full level,
'' and that set is posted the way a commit posts it, so the fill never writes the set on
'' display. The screen buffer is not touched.
''
'' @param threeBitColor - 3-bit RGB color value to fill

' Local Variables:
' @local pFrameSet - the frame set that is not on display, which the fill writes

  pFrameSet := frameSetToConvertInto()                  ' waits for the previous post to be taken
  bytefill(pFrameSet, matrix.fillByteForColor(threeBitColor), nPwmFrameSizeInBytes * nColorDepth)
  postFrameSet(pFrameSet)

PUB setBrightness(newBrightness)
'' Set the brightness scale every refresh driver applies to its /OE time
'' (see isp_hub75_rgb3bit.spin2 setBrightness()).
''
'' @param newBrightness - the desired brightness value [0-256]

  matrix.setBrightness(newBrightness)

PUB getBrightness() : nBrightness
'' Return the brightness scale the refresh drivers apply to their /OE time.
''
'' @returns nBrightness - the brightness value [0-256]

  nBrightness := matrix.getBrightness()

PUB showFrameSet(pFrameSet) : accepted
'' Post a PWM frame set to the refresh driver, the way a commit does. Only one of this adapter's
'' two frame sets is accepted, so the set a converter writes stays the one that is not on
'' display. If the previous post has not been taken yet, this waits for it first, so no post is
'' overwritten before the driver has seen it. A refused address prints a message and posts nothing.
''
'' @param pFrameSet - hub address of one of the adapter's two PWM frame sets
'' @returns accepted - TRUE if the set was posted, FALSE if the address was refused

  accepted := FALSE
  if pFrameSet == matrix.NO_FRAME_SET
    debug("HUB75: DISP", udec_(chainIndex), ": showFrameSet(NULL) refused: no frame set given; give one of this adapter's two PWM frame sets, ", uhex_long_(pPwmFrame1), " or ", uhex_long_(pPwmFrame2))
  elseif pFrameSet <> pPwmFrame1 and pFrameSet <> pPwmFrame2
    debug("HUB75: DISP", udec_(chainIndex), ": showFrameSet(", uhex_long_(pFrameSet), ") refused: not one of this adapter's two PWM frame sets, ", uhex_long_(pPwmFrame1), " or ", uhex_long_(pPwmFrame2))
  else
    waitPostedSetTaken()
    postFrameSet(pFrameSet)
    accepted := TRUE

#IFDEF HUB75_INSTRUMENT
PUB commitTrace() : pConverted, pShownAtPost, pShownNow
'' Instrument build only: what the latest commit did, for the frame-set handshake trace.
''
'' @returns pConverted - the frame set the latest commit converted into
'' @returns pShownAtPost - the frame set on display when that conversion was done (never equal to pConverted)
'' @returns pShownNow - the frame set on display at this call

  pConverted := pTraceConverted
  pShownAtPost := pTraceShownAtPost
  pShownNow := matrix.showingFrameSet()

PUB commitTotals() : nCommits, nWaited, nBad, pFirstShown
'' Instrument build only: totals since start for the frame-set handshake trace.
''
'' @returns nCommits - commits posted
'' @returns nWaited - posts that waited for the previous post to be taken
'' @returns nBad - commits that converted into the frame set on display (must be 0)
'' @returns pFirstShown - the frame set on display when the first commit posted (matrix.NO_FRAME_SET at the first commit after start)

  nCommits := nTraceCommits
  nWaited := nTraceWaited
  nBad := nTraceBad
  pFirstShown := pTraceFirstShown
#ENDIF

PUB convertScreen2PWM_14(p24bitScreen, bSwapRB, bSwapGB) | pPwmFrameSet, pPwmFrame, lOne4thLineCt, lOneHalfLineCt, lThree4thsLineCt, lPhyRows, lPanelCols, lPanelCount, lPanelSkipBytes, lPwmAddrRowBytes, lDisplayBytesPerColor, lMaxPwmBuffers, lPwmFrameSizeInBytes
'' Load a 24-bit-color image into PWM frame buffers for 1/8 scan panels (4 scan-lines at a time) using inline PASM.
'' The screen buffer holds the panels one after another, in buffer-slot order (row-major within
'' each panel). Each row address shifts two panel lines from every panel along the cable, slot 0
'' first, so the converter reads one panel row at a time, slot by slot, like the 1/2-scan converter.
''
'' @param p24bitScreen - pointer to 24-bit screen buffer
'' @param bSwapRB - TRUE to swap red and blue channels
'' @param bSwapGB - TRUE to swap green and blue channels

' Local Variables:
' @local pPwmFrameSet - pointer to the PWM frame set that is not on display (converted into, then posted)
' @local pPwmFrame - pointer to current PWM frame
' @local lOne4thLineCt - one quarter of the panel row count
' @local lOneHalfLineCt - one half of the panel row count
' @local lThree4thsLineCt - three quarters of the panel row count
' @local lPhyRows - pixel rows per panel
' @local lPanelCols - pixel columns per panel
' @local lPanelCount - panels on this adapter (buffer slots)
' @local lPanelSkipBytes - bytes from the end of a row in one slot to the same row in the next slot
' @local lPwmAddrRowBytes - PWM bytes the refresh core shifts per row address (two lines of every panel)
' @local lDisplayBytesPerColor - bytes per color in the display buffer
' @local lMaxPwmBuffers - number of PWM buffers (color depth)
' @local lPwmFrameSizeInBytes - size of one PWM frame in bytes

' NOTE: 16 longs total avail to inline pasm: params + return + local
'  --> 16/16 used
  ' scan memory, write PWM bytes twice, sigh...
  'debug("- PNL:cs2pwm(): scn ", uhex_long(p24bitScreen), uhex_long(bSwapRB), uhex_long(bSwapGB))

  ' -------------------------------------------------------------------------
  ' NOTES for panel P4-1921-8S-V2.0 - 1/8 scan
  '  two full 64px lines are emmitted for wach row, or 128px per each of 8 rows
  '  the top 16 rows are fed by RGB1, while the bottom 16 rows are fed by RGB2
  '
  '  64px lines do NOT span multiple rows! This means we can do a simple row-
  '  number translation when mapping our PWM buffers to how the panel will display
  '  the pixel values.
  '
  '  The mapping is as follows:
  '    ----- TOP ------                    ----- BOTTOM -----
  '  Row 0 is placed in PWM bffr Row 1    Row 16 into pwm Row 17
  '     ------------                          ------------
  '      0   ->   1                           16   ->   17
  '      1   ->   3                           17   ->   19
  '      2   ->   5                           18   ->   21
  '      3   ->   7                           19   ->   23
  '      4   ->   9                           20   ->   25
  '      5   ->  11                           21   ->   27
  '      6   ->  13                           22   ->   29
  '      7   ->  15                           23   ->   31
  '     ------------                          ------------
  '      8   ->   0                           24   ->   16
  '      9   ->   2                           25   ->   18
  '     10   ->   4                           26   ->   20
  '     11   ->   6                           27   ->   22
  '     12   ->   8                           28   ->   24
  '     13   ->  10                           29   ->   26
  '     14   ->  12                           30   ->   28
  '     15   ->  14                           31   ->   30
  ' -------------------------------------------------------------------------
  ' this routine does not prestore all the transformed bytes
  '  instead it scans each pixel at RC of the screen size
  '  it then places either RGB1 into the each pwm frames' buffer
  '   or if we are addressing the BOTTOM then it reads RGB1 value
  '   from the pwm frames' buffer and or's in the RGB2 values
  '
  '  THIS means that each screen buffer BYTE is read once while each
  '    PWM buffer BYTE is written twice.
  '  Anyway, the math to calculate the target pixel BYTE in the pwm buffer
  '   is:
  ' -------------------------------------------------------------------------
  '  The targetRow math of:
  '    rows  0 -  7: targetRow = (row * 2) + 1
  '    rows  8 - 15: targetRow = (row - 8) * 2
  '    rows 16 - 24: targetRow = ((row - 16) * 2) + 17
  '    rows 24 - 31: targetRow = (row - 24) * 2) + 16
  ' -------------------------------------------------------------------------

  ' init ptrs/variables
  pPwmFrameSet            := frameSetToConvertInto()
  lPhyRows                := nPanelRows
  lPanelCols              := nPanelColumns
  lPanelCount             := nPanelCount
  lOne4thLineCt           := lPhyRows / QUARTER_DIVISOR
  lOneHalfLineCt          := lPhyRows / HALF_DIVISOR
  lThree4thsLineCt        := (lPhyRows / QUARTER_DIVISOR) * 3
  lPanelSkipBytes         := (nPanelRows - 1) * nPanelColumns * nBytesPerColor
  lPwmAddrRowBytes        := hub75Bffrs.SCAN_4_COLUMN_FACTOR * nPanelCount * nPanelColumns * hub75Bffrs.BYTES_PER_COLUMN_CLOCK ' as the refresh core sizes one row address
  lDisplayBytesPerColor   := nBytesPerColor
  lMaxPwmBuffers          := nColorDepth
  lPwmFrameSizeInBytes    := nPwmFrameSizeInBytes

    ORG
                JMP         #startS8

' the following initialized values are simply copied into PASM area before routine is run
nPhysLineIdx        LONG    0
nPhysLineCtr        LONG    0
nPanelCtr           LONG    0
nColumnCtr          LONG    0
nTargLineIdx        LONG    0
nPwmRGB12ByteIdx    LONG    0
bIsBottomHalf       LONG    0
nRGBColorOfst       LONG    0
maskQtrRowsModulus  LONG    0
pRGBPixAddr         LONG    0
redBitRGB1Value     LONG    RGB1_RED_BIT
greenBitRGB1Value   LONG    RGB1_GREEN_BIT
blueBitRGB1Value    LONG    RGB1_BLUE_BIT
redBitRGB2Value     LONG    RGB2_RED_BIT
greenBitRGB2Value   LONG    RGB2_GREEN_BIT
blueBitRGB2Value    LONG    RGB2_BLUE_BIT
maskOnlyRGB1bits    LONG    MASK_RGB1
maskOnlyRGB2bits    LONG    MASK_RGB2
maskRGB1nRGB2bits   LONG    MASK_RGB12
redPwmBits          LONG    0
greenPwmBits        LONG    0
bluePwmBits         LONG    0
colorValue24bit     LONG    0
pwmBitCtr           LONG    0
currPwmBffrIdx      LONG    0
currMaskBitIdx      LONG    0
bitsBGR             LONG    0
pPwmFrameByte       LONG    0
currPwmBits         LONG    0
allOnes             LONG    ALL_ONES

startS8
                ' init variables
                MOV         redBitRGB1Value, #RGB1_RED_BIT
                MOV         greenBitRGB1Value, #RGB1_GREEN_BIT
                MOV         blueBitRGB1Value, #RGB1_BLUE_BIT
                MOV         redBitRGB2Value, #RGB2_RED_BIT
                MOV         greenBitRGB2Value, #RGB2_GREEN_BIT
                MOV         blueBitRGB2Value, #RGB2_BLUE_BIT
                ' setup for red/blue flip if needed
                OR          bSwapRB, bSwapRB                wz      ' T/F where: T=nz, F=z
    ' T/nz = is Swapped
    if_nz       MOV         redBitRGB1Value, #RGB1_BLUE_BIT         ' red1 gets blue
    if_nz       MOV         blueBitRGB1Value, #RGB1_RED_BIT         ' blue1 gets red
    if_nz       MOV         redBitRGB2Value, #RGB2_BLUE_BIT         ' red2 gets blue
    if_nz       MOV         blueBitRGB2Value, #RGB2_RED_BIT         ' blue2 gets red
                ' setup for blue/green flip if needed
                OR          bSwapGB, bSwapGB                wz      ' T/F where: T=nz, F=z
    ' T/nz = is Swapped
    if_nz       MOV         greenBitRGB1Value, #RGB1_BLUE_BIT       ' green1 gets blue
    if_nz       MOV         blueBitRGB1Value, #RGB1_GREEN_BIT       ' blue1 gets green
    if_nz       MOV         greenBitRGB2Value, #RGB2_BLUE_BIT       ' green2 gets blue
    if_nz       MOV         blueBitRGB2Value, #RGB2_GREEN_BIT       ' blue2 gets green
for8SScreen
                ' for all pixels of the screen buffer
                'repeat nPhysLineIdx from 0 to screen.MAX_PHYSICAL_ROWS - 1             ' [0-31]
                XOR         nPhysLineIdx, nPhysLineIdx
                MOV         nPhysLineCtr, lPhyRows
next8SLine
                ' calc nPwmRGB12ByteIdx: offset into PWM buffer
                MOV         nTargLineIdx, nPhysLineIdx              ' start with phys row number
                '  if low-half rows of panelSet...
                CMP         nPhysLineIdx, lOneHalfLineCt    wc
    if_nc       JMP         #bottom8SRows
top8SRows                                                           ' determine calcs to use for top half of panel - Rows [0-15]
                ' if nPhysLineIdx < lOne4thLineCt...
                CMP         nPhysLineIdx, lOne4thLineCt     wc
    ' CY=1: nTargLineIdx := (nPhysLineIdx * 2) + 1 - rows  [0-7]
    if_c        SHL         nTargLineIdx, #1                        ' mult by 2
    if_c        ADD         nTargLineIdx, #1                        ' add 1
    ' CY=0: nTargLineIdx := (nPhysLineIdx - lOne4thLineCt) * 2 - Rows [8-15]
    if_nc       SUB         nTargLineIdx, lOne4thLineCt             ' subtract 8
    if_nc       SHL         nTargLineIdx, #1                        ' mult by 2
                JMP         #targ8SCalcsDone
bottom8SRows                                                        ' determine calcs to use for bottom half of panel - Rows [16-31]
                ' if nPhysLineIdx < lThree4thsLineCt
                CMP         nPhysLineIdx, lThree4thsLineCt  wc
    ' CY=1: nTargLineIdx := ((nPhysLineIdx - lOneHalfLineCt) * 2) + lOneHalfLineCt + 1 - Rows [16-23]
    if_c        SUB         nTargLineIdx, lOneHalfLineCt            ' minus lOneHalfLineCt
    if_c        SHL         nTargLineIdx, #1                        ' mult by 2
    if_c        ADD         nTargLineIdx, lOneHalfLineCt            ' add lOneHalfLineCt
    if_c        ADD         nTargLineIdx, #1                        ' add 1
    ' CY=0: nTargLineIdx := ((nPhysLineIdx - lThree4thsLineCt) + lOneHalfLineCt) * 2 - Rows  [24-31]
    if_nc       SUB         nTargLineIdx, lThree4thsLineCt          ' minus lThree4thsLineCt
    if_nc       SHL         nTargLineIdx, #1                        ' mult by 2
    if_nc       ADD         nTargLineIdx, lOneHalfLineCt            ' add lOneHalfLineCt
targ8SCalcsDone
                ' bIsBottomHalf := (nTargLineIdx > lOneHalfLineCt - 1) ? TRUE : FALSE
                CMP         nTargLineIdx, lOneHalfLineCt    wc
    if_nc       MOV         bIsBottomHalf, allOnes                  ' TRUE if row 16-31
    if_c        XOR         bIsBottomHalf, bIsBottomHalf            ' FALSE if row 0-15
                ' a bottom (RGB2) line shares its bytes with the top (RGB1) line half a panel above
    if_nc       SUB         nTargLineIdx, lOneHalfLineCt            ' target line within its half
                ' nPwmRGB12ByteIdx := (nTargLineIdx / 2) * lPwmAddrRowBytes + (nTargLineIdx odd ? lPanelCols : 0)
                '  (slot 0's bytes for this line; each row address holds two lines of every slot, slot 0 first)
                MOV         nPwmRGB12ByteIdx, nTargLineIdx
                SHR         nPwmRGB12ByteIdx, #1                    ' row address of this line
                MUL         nPwmRGB12ByteIdx, lPwmAddrRowBytes
                TESTB       nTargLineIdx, #0                wc      ' odd line: 2nd line of the pair
    if_c        ADD         nPwmRGB12ByteIdx, lPanelCols
                ' calc nRGBColorOfst: offset of this row in slot 0 of the screen buffer
                'nRGBColorOfst := (nPhysLineIdx * lPanelCols) * screen.DISPLAY_BYTES_PER_COLOR
                MOV         nRGBColorOfst, nPhysLineIdx
                MUL         nRGBColorOfst, lPanelCols
                MUL         nRGBColorOfst, lDisplayBytesPerColor
                ' pRGBPixAddr := @BYTE[p24bitScreen][nRGBColorOfst]    ' add in offset to 24-bit color
                MOV         pRGBPixAddr, p24bitScreen
                ADD         pRGBPixAddr, nRGBColorOfst
                ' repeat for each slot (panel along the cable), slot 0 first
                MOV         nPanelCtr, lPanelCount
next8SPanel
                ' repeat nColumnIdx from 0 to lPanelCols - 1
                MOV         nColumnCtr, lPanelCols
next8SColumn
                ' locate and load color for scanline
                RDLONG      colorValue24bit, pRGBPixAddr
                ' red := BYTE[pRGBPixAddr][0]
                GETBYTE     redPwmBits, colorValue24bit, #RED_BYTE_IDX
                ' green := BYTE[pRGBPixAddr][1]
                GETBYTE     greenPwmBits, colorValue24bit, #GREEN_BYTE_IDX
                ' blue := BYTE[pRGBPixAddr][2]
                GETBYTE     bluePwmBits, colorValue24bit, #BLUE_BYTE_IDX

                ' write color information to our PWM buffers
                ' expand PWM-Bit-width bits into N pwm frames of 3-bit pixels two pixels/BYTE

                ' for ea. bit do...
                ' repeat currPwmBffrIdx from 0 to screen.MAX_PWM_BUFFERS - 1 (there's PWM_BUFFER for ea. bit in color depth)
                XOR         currPwmBffrIdx, currPwmBffrIdx          ' start with buffer[0] of [0-MAX_PWM_BUFFERS - 1]
                ' NOTE: PWM def'n bits are org'd at MSBit and are COLOR_DEPTH in width (3-8 bits depth)
                MOV         currMaskBitIdx, #MSBIT_OF_BYTE         ' start bitmask is always msBit of BYTE
                MOV         pwmBitCtr, lMaxPwmBuffers               ' MAX PWM FRAME bits to scan in LONG

next8SPwmFrame
                ' calculate pointer to frame for this bit #
                '   nFrameOffset := frameIdx * nPwmFrameSizeInLongs ' 256 longs in each frame
                '   pPwmFrame := @LONG[pPwmFrameSet][nFrameOffset]
                MOV         pPwmFrame, currPwmBffrIdx
                MUL         pPwmFrame, lPwmFrameSizeInBytes
                ADD         pPwmFrame, pPwmFrameSet
                ' calc address of BYTE in pwm frame for this nPwmRGB12ByteIdx
                MOV         pPwmFrameByte, nPwmRGB12ByteIdx         ' get base addr
                ADD         pPwmFrameByte, pPwmFrame                ' add offset
                ' build top RGB1 or bottom RGB2 bits to be stored in pwm BYTE
                ' if not bIsBottomHalf
                OR          bIsBottomHalf, bIsBottomHalf    wz      ' T/F where: T=nz, F=z
    if_nz       JMP         #bottom8SHalf
top8SHalf
                ' bitsBGR := 0
                XOR         bitsBGR, bitsBGR                        ' clear all bits
                ' set our RGB1 bits
                '     bitsBGR |= (rPwm & currBitMask) > 0 ? 1 : 0
                '     bitsBGR |= (gPwm & currBitMask) > 0 ? 2 : 0
                '     bitsBGR |= (bPwm & currBitMask) > 0 ? 4 : 0
                TESTB       redPwmBits, currMaskBitIdx      wc
    if_c        OR          bitsBGR, redBitRGB1Value
                TESTB       greenPwmBits, currMaskBitIdx    wc
    if_c        OR          bitsBGR, greenBitRGB1Value
                TESTB       bluePwmBits, currMaskBitIdx     wc
    if_c        OR          bitsBGR, blueBitRGB1Value
                JMP         #write8SPwmByte
bottom8SHalf
                '    bitsBGR := BYTE[pPwmFrame][nPwmRGB12ByteIdx]
                RDBYTE      bitsBGR, pPwmFrameByte                  ' load current value
                ' NOTE: see if there's a write w/mask so we don't have to read...
                ' not needed        and     bitsBGR, maskOnlyRGB1bits   ' clear all bits except RGB1 value
                ' set our RGB2 bits
                '    bitsBGR |= (rPwm & currBitMask) > 0 ? 8 : 0
                '    bitsBGR |= (gPwm & currBitMask) > 0 ? $10 : 0
                '    bitsBGR |= (bPwm & currBitMask) > 0 ? $20 : 0
                TESTB       redPwmBits, currMaskBitIdx      wc
    if_c        OR          bitsBGR, redBitRGB2Value
                TESTB       greenPwmBits, currMaskBitIdx    wc
    if_c        OR          bitsBGR, greenBitRGB2Value
                TESTB       bluePwmBits, currMaskBitIdx     wc
    if_c        OR          bitsBGR, blueBitRGB2Value
write8SPwmByte
                ' write RGB1, RGB2 value to BYTE
                'BYTE[pPwmFrame][nPwmRGB12ByteIdx] := bitsBGR
                'or      bitsBGR, #$3F
                WRBYTE      bitsBGR, pPwmFrameByte                  ' load current value
                ' this one done, if not all 8 bits done, go do next
                ADD         currPwmBffrIdx, #1
                SUB         currMaskBitIdx, #1
                DJNZ        pwmBitCtr, #next8SPwmFrame

                ' count this column, go do next column if not yet done
                ADD         pRGBPixAddr, lDisplayBytesPerColor
                ADD         nPwmRGB12ByteIdx, #1
                DJNZ        nColumnCtr, #next8SColumn
                ' same row of the next slot; skip the other line of this slot's pair
                ADD         pRGBPixAddr, lPanelSkipBytes
                ADD         nPwmRGB12ByteIdx, lPanelCols
                DJNZ        nPanelCtr, #next8SPanel
                ' count this row, go do next row if not yet done
                ADD         nPhysLineIdx, #1
                DJNZ        nPhysLineCtr, #next8SLine
doneS8
    END

  postConvertedSet(pPwmFrameSet)

' -----------------------------------------------------------------------------

PUB convertScreen2PWM(p24bitScreen, bSwapRB, bSwapGB) | pPwmFrameSet, lPanelCount, lPanelCols, lHalfPanelRows, lPanelRowBytes, lHalfPanelBytes, lPanelSkipBytes, lDisplayBytesPerColor, lPwmFrameSizeInBytes, lMaxPwmBuffers
'' Load a 24-bit image into PWM frame buffers at 16s, 32s (2 scan-lines at a time) using inline PASM.
'' The screen buffer holds the panels one after another, in buffer-slot order (row-major within
'' each panel). One row along the cable is the same scan row of every slot, slot 0 first, so the
'' converter walks the slots in that order and every panel up to the driver limit is converted.
''
'' @param p24bitScreen - pointer to 24-bit screen buffer
'' @param bSwapRB - TRUE to swap red and blue channels
'' @param bSwapGB - TRUE to swap green and blue channels

' Local Variables:
' @local pPwmFrameSet - pointer to the PWM frame set that is not on display (converted into, then posted)
' @local lPanelCount - panels on this adapter (buffer slots)
' @local lPanelCols - columns per panel
' @local lHalfPanelRows - half panel height for RGB1/RGB2 split
' @local lPanelRowBytes - bytes in one row of one panel in the screen buffer
' @local lHalfPanelBytes - bytes from a top-half (RGB1) row to its bottom-half (RGB2) row
' @local lPanelSkipBytes - bytes from the end of a row in one slot to the same row in the next slot
' @local lDisplayBytesPerColor - bytes per color in the display buffer
' @local lPwmFrameSizeInBytes - size of one PWM frame in bytes
' @local lMaxPwmBuffers - number of PWM buffers (color depth)

' NOTE: 16 longs total avail to inline pasm: params + return + local
'  --> 13/16 used


  ' Get PWM buffer and setup parameters
  pPwmFrameSet            := frameSetToConvertInto()
  lPanelCount             := nPanelCount              ' Panels on this adapter (e.g., 4)
  lPanelCols              := nPanelColumns            ' Columns per panel (e.g., 128)
  lHalfPanelRows          := nPanelRows / HALF_DIVISOR    ' Half panel height for RGB1/RGB2 split (e.g., 32)
  lPanelRowBytes          := nPanelColumns * nBytesPerColor
  lHalfPanelBytes         := lHalfPanelRows * lPanelRowBytes
  lPanelSkipBytes         := (nPanelRows - 1) * lPanelRowBytes
  lPwmFrameSizeInBytes    := nPwmFrameSizeInBytes
  lMaxPwmBuffers          := nColorDepth
  lDisplayBytesPerColor   := nBytesPerColor

  ' Fill PWM_FRAMES from 24-bit-screen
  ' Screen buffer is in buffer-slot order:
  '   slot 0: bytes 0 to (nPanelRows * lPanelRowBytes - 1)
  '   slot 1: bytes (nPanelRows * lPanelRowBytes) to (2 * nPanelRows * lPanelRowBytes - 1)
  '   etc.
  ' Each scan row is read slot by slot, so no column needs dividing to find its panel.
    ORG
                JMP         #start16s

' Initialized values copied into PASM area
redBitTopValue      LONG    RGB1_RED_BIT
greenBitTopValue    LONG    RGB1_GREEN_BIT
blueBitTopValue     LONG    RGB1_BLUE_BIT
redBitBotValue      LONG    RGB2_RED_BIT
greenBitBotValue    LONG    RGB2_GREEN_BIT
blueBitBotValue     LONG    RGB2_BLUE_BIT
redPwmBitsTop       LONG    0
greenPwmBitsTop     LONG    0
bluePwmBitsTop      LONG    0
redPwmBitsBot       LONG    0
greenPwmBitsBot     LONG    0
bluePwmBitsBot      LONG    0
pPwmFrameByt        LONG    0
pTopPixelAddr       LONG    0
pBotPixelAddr       LONG    0
colorValue24bit     LONG    0
bitCount            LONG    0
currMaskBitIdx      LONG    0
currPwmBffrIdx      LONG    0
panelBGR            LONG    0
pwmByteIndex        LONG    0
' Loop control
scanRowCtr          LONG    0
scanRow             LONG    0
panelCtr            LONG    0
localColCtr         LONG    0

start16s
                    ' Initialize color bit values
                    mov     redBitTopValue, #RGB1_RED_BIT
                    mov     greenBitTopValue, #RGB1_GREEN_BIT
                    mov     blueBitTopValue, #RGB1_BLUE_BIT
                    mov     redBitBotValue, #RGB2_RED_BIT
                    mov     greenBitBotValue, #RGB2_GREEN_BIT
                    mov     blueBitBotValue, #RGB2_BLUE_BIT
                    ' Setup for red/blue swap if needed
                    or      bSwapRB, bSwapRB   wz
    if_nz           mov     redBitTopValue, #RGB1_BLUE_BIT
    if_nz           mov     blueBitTopValue, #RGB1_RED_BIT
    if_nz           mov     redBitBotValue, #RGB2_BLUE_BIT
    if_nz           mov     blueBitBotValue, #RGB2_RED_BIT
                    ' Setup for green/blue swap if needed
                    or      bSwapGB, bSwapGB   wz
    if_nz           mov     greenBitTopValue, #RGB1_BLUE_BIT
    if_nz           mov     blueBitTopValue, #RGB1_GREEN_BIT
    if_nz           mov     greenBitBotValue, #RGB2_BLUE_BIT
    if_nz           mov     blueBitBotValue, #RGB2_GREEN_BIT

                    ' Initialize PWM byte index
                    xor     pwmByteIndex, pwmByteIndex
                    ' Outer loop: scan rows 0 to halfPanelRows-1 (e.g., 0-31)
                    xor     scanRow, scanRow
                    mov     scanRowCtr, lHalfPanelRows
nextScanRow
                    ' this scan row in slot 0: top pixel (RGB1) and bottom pixel (RGB2)
                    ' pTopPixelAddr = p24bitScreen + scanRow * panelRowBytes
                    ' pBotPixelAddr = pTopPixelAddr + halfPanelRows * panelRowBytes
                    mov     pTopPixelAddr, scanRow
                    mul     pTopPixelAddr, lPanelRowBytes
                    add     pTopPixelAddr, p24bitScreen
                    mov     pBotPixelAddr, pTopPixelAddr
                    add     pBotPixelAddr, lHalfPanelBytes
                    ' Middle loop: slots 0 to panelCount-1, in cable order (slot 0 first)
                    mov     panelCtr, lPanelCount
nextPanel
                    ' Inner loop: columns 0 to panelCols-1 of this slot (e.g., 0-127)
                    mov     localColCtr, lPanelCols
nextLocalCol
                    ' Load top pixel color (RGB1)
                    rdlong  colorValue24bit, pTopPixelAddr
                    getbyte redPwmBitsTop, colorValue24bit, #RED_BYTE_IDX
                    getbyte greenPwmBitsTop, colorValue24bit, #GREEN_BYTE_IDX
                    getbyte bluePwmBitsTop, colorValue24bit, #BLUE_BYTE_IDX

                    ' Load bottom pixel color (RGB2)
                    rdlong  colorValue24bit, pBotPixelAddr
                    getbyte redPwmBitsBot, colorValue24bit, #RED_BYTE_IDX
                    getbyte greenPwmBitsBot, colorValue24bit, #GREEN_BYTE_IDX
                    getbyte bluePwmBitsBot, colorValue24bit, #BLUE_BYTE_IDX

                    ' Write to PWM buffers for each bit plane
                    xor     currPwmBffrIdx, currPwmBffrIdx
                    mov     bitCount, lMaxPwmBuffers
                    mov     currMaskBitIdx, #MSBIT_OF_BYTE
nextBit
                    ' Calculate PWM frame byte address
                    mov     pPwmFrameByt, currPwmBffrIdx
                    mul     pPwmFrameByt, lPwmFrameSizeInBytes
                    add     pPwmFrameByt, pPwmFrameSet
                    add     pPwmFrameByt, pwmByteIndex

                    ' Build RGB1 and RGB2 bits
                    xor     panelBGR, panelBGR
                    testb   redPwmBitsTop, currMaskBitIdx     wc
        if_c        or      panelBGR, redBitTopValue
                    testb   greenPwmBitsTop, currMaskBitIdx   wc
        if_c        or      panelBGR, greenBitTopValue
                    testb   bluePwmBitsTop, currMaskBitIdx    wc
        if_c        or      panelBGR, blueBitTopValue
                    testb   redPwmBitsBot, currMaskBitIdx     wc
        if_c        or      panelBGR, redBitBotValue
                    testb   greenPwmBitsBot, currMaskBitIdx   wc
        if_c        or      panelBGR, greenBitBotValue
                    testb   bluePwmBitsBot, currMaskBitIdx    wc
        if_c        or      panelBGR, blueBitBotValue

                    ' Write PWM byte
                    wrbyte  panelBGR, pPwmFrameByt
                    ' Next bit plane
                    add     currPwmBffrIdx, #1
                    sub     currMaskBitIdx, #1
                    djnz    bitCount, #nextBit

                    ' Advance to next column: next pixel of this slot, next PWM byte along the cable
                    add     pTopPixelAddr, lDisplayBytesPerColor
                    add     pBotPixelAddr, lDisplayBytesPerColor
                    add     pwmByteIndex, #1
                    djnz    localColCtr, #nextLocalCol

                    ' Advance to the same scan row of the next slot
                    add     pTopPixelAddr, lPanelSkipBytes
                    add     pBotPixelAddr, lPanelSkipBytes
                    djnz    panelCtr, #nextPanel

                    ' Advance to next scan row
                    add     scanRow, #1
                    djnz    scanRowCtr, #nextScanRow
done16s
    END

#ifdef DBG_PWM
  ' Debug code for Frame 0 MSB issue investigation (enable with -D DBG_PWM)
  nPassCt++
  if not bDumpOnce && nPassCt == 2
    bDumpOnce := TRUE
    debug("--- DEBUG: Frame 0 vs Frame 1 data ---")
    dumpBufferHeads(p24bitScreen, pPwmFrameSet)
    hub75Bffrs.dbgMemDump(@frame0Msg, pPwmFrameSet, 32)
    hub75Bffrs.dbgMemDump(@frame1Msg, pPwmFrameSet + nPwmFrameSizeInBytes, 32)
#endif

  postConvertedSet(pPwmFrameSet)

' -----------------------------------------------------------------------------

CON ' ------------- PRIVATE (Utility) Methods -------------

#ifdef DBG_PWM
' --- PWM/frame dump diagnostics toolkit (compiled only with -D DBG_PWM) ---
PRI dumpBufferHeads(pSCreenBuffer,pPwmBuffer)
' Dump the first 48 bytes of the screen and PWM buffers for debug inspection.
'
' @param pSCreenBuffer - pointer to screen buffer
' @param pPwmBuffer - pointer to PWM buffer

  hub75Bffrs.dbgMemDump(@bufferMsg, pSCreenBuffer, DUMP_HEAD_BYTES)
  hub75Bffrs.dbgMemDump(@frameMsg, pPwmBuffer, DUMP_HEAD_BYTES)

PRI dumpFrameAddrs(pPwmFrameSet) | pFrameBuffer, frameIndex
' Display the hub address of each PWM frame in the frame set.
'
' @param pPwmFrameSet - pointer to the PWM frame set

' Local Variables:
' @local pFrameBuffer - computed address of current PWM frame
' @local frameIndex - loop index over PWM frames

  repeat frameIndex from 0 to nColorDepth - 1
    pFrameBuffer := @LONG[pPwmFrameSet][frameIndex * nPwmFrameSizeInLongs]
    debug("PNL: PWM", udec_(frameIndex), ": ", uhex_long_(pFrameBuffer))

PRI dumpFrameSet(pPwmFrameSet) | pFrameBuffer, frameIndex
' Dump memory contents of all PWM frames in the frame set.
'
' @param pPwmFrameSet - pointer to the PWM frame set

' Local Variables:
' @local pFrameBuffer - computed address of current PWM frame
' @local frameIndex - loop index over PWM frames

  repeat frameIndex from 0 to nColorDepth - 1
    pFrameBuffer := @LONG[pPwmFrameSet][frameIndex * nPwmFrameSizeInLongs]
    dumpFrame(frameIndex, pFrameBuffer)

PRI dumpFrame(frameIdx, pFrameBuffer) | frameASCII
' Dump one PWM frame with an ASCII label indicating its index.
'
' @param frameIdx - zero-based PWM frame index
' @param pFrameBuffer - pointer to the PWM frame buffer

' Local Variables:
' @local frameASCII - ASCII character representing the frame index

  frameASCII := frameIdx | ASCII_DIGIT_ZERO
  if frameIdx > MAX_DECIMAL_DIGIT
    frameASCII := frameIdx - DECIMAL_BASE + ASCII_UPPER_A
  BYTE[@msgPwm][MSG_PWM_INDEX_POS] := frameASCII

  if emptyRgb2(pFrameBuffer)
    BYTE[@msgPwm][MSG_PWM_FLAG_POS] := "*"
  else
    BYTE[@msgPwm][MSG_PWM_FLAG_POS] := ASCII_SPACE     ' space

  hub75Bffrs.dbgMemDump(@msgPwm, pFrameBuffer, 32)

PRI emptyRgb2(pFrameBuffer) : isEmpty | byteIdx
' Check whether all RGB2 bits are zero in the first 32 bytes of a PWM frame.
'
' @param pFrameBuffer - pointer to the PWM frame buffer
' @returns isEmpty - TRUE if no RGB2 bits are set, FALSE otherwise

' Local Variables:
' @local byteIdx - loop index over frame bytes

  isEmpty := TRUE
  repeat byteIdx from 0 TO RGB2_CHECK_BYTE_COUNT - 1
    if BYTE[pFrameBuffer][byteIdx] & MASK_RGB2 > 0
      isEmpty := FALSE
      quit
#endif

PRI waitPostedSetTaken()
' Wait until the refresh driver has taken the frame set posted last, that is, until the set it
' shows (dvrShowing) is that set. Nothing is waited for before the first post, or after the
' driver cog has been stopped.
'

  if pLastPosted <> matrix.NO_FRAME_SET and cog <> 0
#IFDEF HUB75_INSTRUMENT
    if matrix.showingFrameSet() <> pLastPosted
      nTraceWaited++
#ENDIF
    repeat while matrix.showingFrameSet() <> pLastPosted

PRI frameSetToConvertInto() : pFrameSet
' Return the frame set a commit converts into: the one that is not on display. It first waits
' for the previous post to be taken, so the set on display is the set posted last and the other
' set is free; before anything has been taken, neither set is on display and set 1 is free.
'
' @returns pFrameSet - hub address of the frame set that is not on display

  waitPostedSetTaken()
  pFrameSet := (matrix.showingFrameSet() == pPwmFrame1) ? pPwmFrame2 : pPwmFrame1

PRI postConvertedSet(pFrameSet)
' Post the frame set a commit has just converted into. In the instrument build the commit is
' recorded first: a set that is on display when its conversion is done is counted as bad.
'
' @param pFrameSet - hub address of the frame set the commit converted into

#IFDEF HUB75_INSTRUMENT
  pTraceConverted := pFrameSet
  pTraceShownAtPost := matrix.showingFrameSet()
  if nTraceCommits == 0
    pTraceFirstShown := pTraceShownAtPost
  if pFrameSet == pTraceShownAtPost
    nTraceBad++
  nTraceCommits++
#ENDIF
  postFrameSet(pFrameSet)

PRI postFrameSet(pFrameSet)
' Post a frame set to the refresh driver and remember it as the set posted last.
'
' @param pFrameSet - hub address of the frame set to show

  pLastPosted := pFrameSet
  matrix.cmdWritePwmBuffer(pFrameSet)

#ifdef DBG_PWM
DAT  ' PWM/frame dump diagnostic message strings (compiled only with -D DBG_PWM)

    msgPwm          BYTE    "Pwm0 ", 0

    bufferMsg       BYTE    "SCREEN",0
    frameMsg        BYTE    "PWM[0]",0
    frame0Msg       BYTE    "Frame0",0
    frame1Msg       BYTE    "Frame1",0
#endif

