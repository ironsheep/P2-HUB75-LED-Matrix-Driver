'' =================================================================================================
''
''   File....... isp_hub75_display_bmp.spin2
''   Purpose.... Display contents of .bmp file on HUB75 RGB Matrix
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Dec 2020
''   Updated.... 07 Oct 2026
''
''  This object adds .bmp file loading support: an image of any size is placed on the display,
''  centred, optionally turned by a content rotation (see placeBMP).
'' =================================================================================================

CON ' ---- .bmp File-Format Constants ----

    ' BMP file-type signature bytes ("BM")
    BMP_SIG_B               = $42         ' 'B'
    BMP_SIG_M               = $4d         ' 'M'

    ' BMP header sizes (bytes)
    BMP_HEADER_SIZE         = 54          ' BITMAPFILEHEADER + BITMAPINFOHEADER
    BMP_DIB_HEADER_SIZE     = 40          ' BITMAPINFOHEADER (DIB header)

    ' Header field-span byte counts used while parsing (bytemove lengths)
    BMP_TYPE_BYTES          = 2           ' bfType field span
    BMP_RESERVED_BYTES      = 4           ' bfReserved1 field span
    BMP_LONG_FIELD_BYTES    = 4           ' single LONG header field span
    BMP_OFFBITS_BLOCK_BYTES = 16          ' bfSize..bfOffBits block span
    BMP_DIB_TAIL_BYTES      = 24          ' biCompression..biClrImportant block span

    ' BMP DIB header expected values
    BMP_BIT_COUNT_24        = 24          ' 24-bit (BGR) pixel depth
    BMP_PLANES              = 1           ' color planes (always 1)
    BMP_COMPRESSION_NONE    = 0           ' BI_RGB (uncompressed)

    ' In-memory BMP pixel BYTE order is BGR
    BMP_BLUE_OFST           = 0           ' blue channel byte offset
    BMP_GREEN_OFST          = 1           ' green channel byte offset
    BMP_RED_OFST            = 2           ' red channel byte offset

    ' 24-bit pixel geometry in the file: three bytes per pixel, each row padded to a 4-byte multiple
    BMP_BYTES_PER_PIXEL     = 3           ' bytes per 24-bit pixel
    BMP_ROW_ALIGN_BYTES     = 4           ' each pixel row of the file is padded to this multiple


    ' placement arithmetic: positions are kept in half-pixel units from the centre
    BMP_HALF_PIXEL_SCALE    = 2           ' half-pixel units per pixel
    BMP_HALF_PIXEL_SHIFT    = 1           ' the same factor as a shift: halves a half-pixel position
    BMP_LAST_INDEX_OFFSET   = 1           ' a count less this is the index of its last member

    ' smallest valid image width in pixels
    BMP_MIN_IMAGE_WIDTH     = 1

OBJ ' ---- Objects Used ----

    hub75Bffrs  :   "isp_hub75_hwBufferAccess"
    pixels      :   "isp_hub75_screenUtils"
    colorUtils  :   "isp_hub75_colorUtils"                          ' the color table, for rows written in PASM

VAR ' ---- Buffer Addresses ----

    LONG    pBitmapFileInMemory
    LONG    chainIndex
    LONG    maxRowPixels
    LONG    maxColPixels

PUB null()
'' This is NOT a top level object.
''

PUB fillScreenFromBMP(nChainIdx, pBmpFile) : bPlaced
'' Load a 24-bit .bmp file image onto the display, centred and not turned. This is placeBMP()
'' at ROT_NONE: a display-sized image lands exactly on the display, any other size is centred.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param pBmpFile - pointer to the in-memory .bmp file data
'' @returns bPlaced - TRUE if the image was placed, FALSE if the file was rejected

  bPlaced := placeBMP(nChainIdx, pBmpFile, hub75Bffrs.ROT_NONE)

PUB placeBMP(nChainIdx, pBmpFile, eContentRotation) : bPlaced
'' Place a 24-bit uncompressed .bmp image of any size on the display, centred, turned by a content
'' rotation. The image is turned as it is placed, from the file as it sits in memory; the file
'' and the screen buffer are never turned in place, so placing again at another rotation starts
'' from the original. The turn is about the display centre. Every display pixel (as mounted) takes
'' the image pixel the inverse rotation gives it, when that lies inside the image; a display pixel
'' the image does not cover is left as it is, and a part of the image that falls off the display
'' is not painted: nothing is cropped and relocated. Pixels are drawn as row runs through
'' pixels.copyRowRun(), so display mounting and the buffer mapping apply. Drawing is
'' not committed: call commitScreenToPanelSet() afterwards.
'' An invalid rotation value, or a file that is not an uncompressed 24-bit .bmp, draws nothing,
'' returns FALSE and reports a debug message (in DEBUG builds).
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param pBmpFile - pointer to the in-memory .bmp file data
'' @param eContentRotation - how the image is turned: hub75Bffrs.ROT_NONE, ROT_RIGHT_90 (clockwise), ROT_LEFT_90 or ROT_180
'' @returns bPlaced - TRUE if the image was placed, FALSE if the rotation or the file was rejected

  chainIndex := nChainIdx
  maxRowPixels, maxColPixels := hub75Bffrs.displaySizeInPixels(chainIndex)
  bPlaced := FALSE
  if isValidContentRotation(eContentRotation) == TRUE
    bPlaced := loadBitmap(pBmpFile, eContentRotation)
  else
    debug("- ERROR placeBMP() invalid content rotation value [", udec_(eContentRotation), "], nothing drawn")

PRI isValidContentRotation(eContentRotation) : bIsValid
' Return TRUE if eContentRotation is one of the four content rotations.
'
' @param eContentRotation - the value to check
' @returns bIsValid - TRUE if the value is ROT_NONE, ROT_RIGHT_90, ROT_LEFT_90 or ROT_180

  case eContentRotation
    hub75Bffrs.ROT_NONE, hub75Bffrs.ROT_RIGHT_90, hub75Bffrs.ROT_LEFT_90, hub75Bffrs.ROT_180:
      bIsValid := TRUE
    other:
      bIsValid := FALSE

PRI loadBitmap(pBitmapFile, eContentRotation) : bLoaded | nImageWidth, nImageHeight, bTopDown, nRowStride, nDisplayRow, nDisplayColumn, nRowOffset2, nColumnOffset2, nImageColumn, nImageRow, pPixel, bRun
' Place a validated 24-bit .bmp image on the display, turned by eContentRotation. Each display
' pixel the image covers takes its source pixel's color; on a display row those pixels are one
' span of the image, written cell by cell in PASM from one address lookup per cell
' (placeRowSpan()), each pixel corrected through the color table. While the
' instrument build's self-test draws its reference, each pixel goes through drawPixelAtRCwithRGB().
' Positions are held in half-pixel units measured from the display centre (and from the image
' centre), so the image is centred whatever the parity of its size and the display's.
'
' @param pBitmapFile - pointer to the in-memory .bmp file data
' @param eContentRotation - a valid content rotation
' @returns bLoaded - TRUE if the file was valid and the image was placed

' Local Variables:
' @local nImageWidth - image width in pixels, from the file header
' @local nImageHeight - image height in pixels, from the file header
' @local bTopDown - TRUE if the file stores its rows top first (negative biHeight)
' @local nRowStride - bytes from the start of one file row to the next (rows pad to 4 bytes)
' @local nDisplayRow - display row being painted, as mounted
' @local nDisplayColumn - display column being painted, as mounted
' @local nRowOffset2 - twice the row distance of the display pixel from the display centre
' @local nColumnOffset2 - twice the column distance of the display pixel from the display centre
' @local nImageColumn - column of the source pixel in the image (0 at its left)
' @local nImageRow - row of the source pixel in the image (0 at its top)
' @local pPixel - address of the source pixel's bytes within the file image
' @local bRun - TRUE to write each row as spans in PASM, FALSE pixel by pixel

  ' save address of 24bit file image for use by called routines
  pBitmapFileInMemory := pBitmapFile

  bLoaded := validateBmpFile(pBitmapFile)
  if bLoaded == TRUE
    nImageWidth := biWidth
    nImageHeight := abs(biHeight)
    bTopDown := (biHeight < 0)
    nRowStride := (((nImageWidth * BMP_BYTES_PER_PIXEL) + (BMP_ROW_ALIGN_BYTES - 1)) / BMP_ROW_ALIGN_BYTES) * BMP_ROW_ALIGN_BYTES
    bRun := TRUE
#IFDEF HUB75_INSTRUMENT
    bRun := pixels.isPerPixelReference() == FALSE
#ENDIF

    if bRun == TRUE
      ' each display row is one span of the image: written cell by cell in PASM (placeRowSpan())
      repeat maxRowPixels with nDisplayRow
        placeRowSpan(nDisplayRow, eContentRotation, nImageWidth, nImageHeight, bTopDown, nRowStride)
    else
      ' pixel by pixel: the instrument build's self-test reference
      repeat maxRowPixels with nDisplayRow
        nRowOffset2 := (BMP_HALF_PIXEL_SCALE * nDisplayRow) - (maxRowPixels - BMP_LAST_INDEX_OFFSET)
        repeat maxColPixels with nDisplayColumn
          nColumnOffset2 := (BMP_HALF_PIXEL_SCALE * nDisplayColumn) - (maxColPixels - BMP_LAST_INDEX_OFFSET)
          nImageColumn, nImageRow := sourcePixelOf(eContentRotation, nRowOffset2, nColumnOffset2, nImageWidth, nImageHeight)
          ' unsigned compare: a negative index is out of range as well
          if nImageColumn +< nImageWidth and nImageRow +< nImageHeight
            pPixel := sourceAddressOf(nImageColumn, nImageRow, nImageHeight, bTopDown, nRowStride)
            ' our internal .bmp file BYTE order is BGR!
            pixels.drawPixelAtRCwithRGB(chainIndex, nDisplayRow, nDisplayColumn, BYTE[pPixel][BMP_RED_OFST], BYTE[pPixel][BMP_GREEN_OFST], BYTE[pPixel][BMP_BLUE_OFST])

PRI sourcePixelOf(eContentRotation, nRowOffset2, nColumnOffset2, nImageWidth, nImageHeight) : nImageColumn, nImageRow | nSourceX2, nSourceY2
' Return the image pixel a display pixel shows: the inverse of the content rotation, about the
' centres of the display and the image (y grows downward; a clockwise turn sends image-top to
' display-right). The result may lie outside the image.
'
' @param eContentRotation - ROT_NONE, ROT_RIGHT_90, ROT_LEFT_90 or ROT_180
' @param nRowOffset2 - twice the row distance of the display pixel from the display centre
' @param nColumnOffset2 - twice the column distance of the display pixel from the display centre
' @param nImageWidth - image width in pixels
' @param nImageHeight - image height in pixels
' @returns nImageColumn - column of the source pixel in the image (0 at its left)
' @returns nImageRow - row of the source pixel in the image (0 at its top)

' Local Variables:
' @local nSourceX2 - twice the column distance of the source pixel from the image centre
' @local nSourceY2 - twice the row distance of the source pixel from the image centre

  case eContentRotation
    hub75Bffrs.ROT_RIGHT_90:
      nSourceX2 := nRowOffset2
      nSourceY2 := -nColumnOffset2
    hub75Bffrs.ROT_LEFT_90:
      nSourceX2 := -nRowOffset2
      nSourceY2 := nColumnOffset2
    hub75Bffrs.ROT_180:
      nSourceX2 := -nColumnOffset2
      nSourceY2 := -nRowOffset2
    other:
      nSourceX2 := nColumnOffset2
      nSourceY2 := nRowOffset2
  nImageColumn := (nSourceX2 + nImageWidth - BMP_LAST_INDEX_OFFSET) sar BMP_HALF_PIXEL_SHIFT
  nImageRow := (nSourceY2 + nImageHeight - BMP_LAST_INDEX_OFFSET) sar BMP_HALF_PIXEL_SHIFT

PRI sourceAddressOf(nImageColumn, nImageRow, nImageHeight, bTopDown, nRowStride) : pPixel | nFileRow
' Return the address of an image pixel's bytes in the file image.
'
' @param nImageColumn - column of the pixel in the image (0 at its left)
' @param nImageRow - row of the pixel in the image (0 at its top)
' @param nImageHeight - image height in pixels
' @param bTopDown - TRUE when the file stores the top row first
' @param nRowStride - bytes per stored row (padded)
' @returns pPixel - address of the pixel's B, G, R bytes

' Local Variables:
' @local nFileRow - row of the pixel as the file stores it

  if bTopDown == TRUE
    nFileRow := nImageRow
  else
    nFileRow := (nImageHeight - 1) - nImageRow                 ' bottom-up file: first stored row is the image bottom
  pPixel := @BYTE[pBitmapFileInMemory][bfOffBits] + (nFileRow * nRowStride) + (nImageColumn * BMP_BYTES_PER_PIXEL)

PRI placeRowSpan(nDisplayRow, eContentRotation, nImageWidth, nImageHeight, bTopDown, nRowStride) | nRowOffset2, nImageColumn, nImageRow, bVaryRow, nVaryStep, nFixed, nFixedSize, nVary0, nVarySize, firstColumn, lastColumn, pSource, sourceStep, column, cellColumns, nPixels, pPixel, rightStep, pTable
' Write one display row of the image: the display pixels it covers are one span, and along it
' exactly one image coordinate changes, by one per display column (the column for ROT_NONE and
' ROT_180, the row for the quarter turns), so the source bytes step by a constant amount. The
' span is written cell by cell, each part from one address lookup (hub75Bffrs.mountedPixelRun())
' in PASM (copyBgrSpan()). It writes the bytes drawPixelAtRCwithRGB() writes pixel by pixel; a
' cell that holds no panel is not drawn.
'
' @param nDisplayRow - display row being painted, as mounted
' @param eContentRotation - ROT_NONE, ROT_RIGHT_90, ROT_LEFT_90 or ROT_180
' @param nImageWidth - image width in pixels
' @param nImageHeight - image height in pixels
' @param bTopDown - TRUE when the file stores the top row first
' @param nRowStride - bytes per stored row (padded)

' Local Variables:
' @local nRowOffset2 - twice the row distance of the display row from the display centre
' @local nImageColumn - image column at the span's first display column
' @local nImageRow - image row at the span's first display column
' @local bVaryRow - TRUE when the image row changes along the display row (quarter turns)
' @local nVaryStep - +1 or -1: how the changing image coordinate moves per display column
' @local nFixed - the image coordinate that is the same along the display row
' @local nFixedSize - the image's size along that coordinate
' @local nVary0 - the changing image coordinate at display column 0
' @local nVarySize - the image's size along the changing coordinate
' @local firstColumn - first display column the image covers on this row
' @local lastColumn - last display column the image covers on this row
' @local pSource - address of the source bytes of the pixel being written
' @local sourceStep - signed bytes from one source pixel to the next along the span
' @local column - display column of the span part being written
' @local cellColumns - pixel columns of one mounted cell
' @local nPixels - pixels of the span in the current cell
' @local pPixel - hub address of the part's first pixel, or NO_PIXEL for a cell with no panel
' @local rightStep - signed bytes to the pixel at the right, within the cell

  nRowOffset2 := (BMP_HALF_PIXEL_SCALE * nDisplayRow) - (maxRowPixels - BMP_LAST_INDEX_OFFSET)
  ' the image pixel at display column 0; along the row one coordinate moves by nVaryStep per column
  nImageColumn, nImageRow := sourcePixelOf(eContentRotation, nRowOffset2, -(maxColPixels - BMP_LAST_INDEX_OFFSET), nImageWidth, nImageHeight)
  case eContentRotation
    hub75Bffrs.ROT_RIGHT_90:
      bVaryRow, nVaryStep := TRUE, -1
    hub75Bffrs.ROT_LEFT_90:
      bVaryRow, nVaryStep := TRUE, 1
    hub75Bffrs.ROT_180:
      bVaryRow, nVaryStep := FALSE, -1
    other:
      bVaryRow, nVaryStep := FALSE, 1
  if bVaryRow == TRUE
    nFixed, nFixedSize, nVary0, nVarySize := nImageColumn, nImageWidth, nImageRow, nImageHeight
  else
    nFixed, nFixedSize, nVary0, nVarySize := nImageRow, nImageHeight, nImageColumn, nImageWidth
  ' the display columns whose changing coordinate lies inside the image
  if nVaryStep > 0
    firstColumn := 0 #> -nVary0
    lastColumn := (maxColPixels - 1) <# (nVarySize - 1 - nVary0)
  else
    firstColumn := 0 #> (nVary0 - (nVarySize - 1))
    lastColumn := (maxColPixels - 1) <# nVary0
  if nFixed +< nFixedSize and firstColumn <= lastColumn
    if bVaryRow == TRUE
      nImageRow := nVary0 + (nVaryStep * firstColumn)
      sourceStep := nVaryStep * nRowStride
      if bTopDown == FALSE
        sourceStep := -sourceStep                               ' bottom-up file: a lower image row is an earlier stored row
    else
      nImageColumn := nVary0 + (nVaryStep * firstColumn)
      sourceStep := nVaryStep * BMP_BYTES_PER_PIXEL
    pSource := sourceAddressOf(nImageColumn, nImageRow, nImageHeight, bTopDown, nRowStride)
    pTable := colorUtils.colorTableAddress(chainIndex)
    _, cellColumns := hub75Bffrs.cellSizeInPixels(chainIndex)
    column := firstColumn
    repeat while column <= lastColumn
      ' the pixels from column to the end of its cell, or of the span when sooner
      nPixels := ((((column / cellColumns) + 1) * cellColumns) <# (lastColumn + 1)) - column
      pPixel, rightStep, _ := hub75Bffrs.mountedPixelRun(chainIndex, nDisplayRow, column)
      if pPixel <> hub75Bffrs.NO_PIXEL
        copyBgrSpan(pSource, sourceStep, pPixel, rightStep, nPixels, pTable)
      pSource += nPixels * sourceStep
      column += nPixels

PRI copyBgrSpan(pSource, sourceStep, pPixel, rightStep, nPixels, pTable)
' Write a span of image pixels, in PASM: nPixels pixels from pSource (B, G, R bytes), sourceStep
' bytes apart, each channel corrected through the adapter's color table, to the screen buffer
' from pPixel, rightStep bytes apart. PR0-PR1 are scratch.
'
' @param pSource - address of the first source pixel's bytes
' @param sourceStep - signed bytes from one source pixel to the next
' @param pPixel - hub address of the first screen pixel's red byte
' @param rightStep - signed bytes from one screen pixel to the next
' @param nPixels - pixels to write (at least one)
' @param pTable - the adapter's color table (colorUtils colorTableAddress())

    org
.nextPixel
                mov     pr1, pSource
                add     pr1, #BMP_RED_OFST
                rdbyte  pr0, pr1
                add     pr0, pTable
                rdbyte  pr0, pr0
                mov     pr1, pPixel
                add     pr1, #pixels.RED_BYTE_OFST
                wrbyte  pr0, pr1
                mov     pr1, pSource
                add     pr1, #BMP_GREEN_OFST
                rdbyte  pr0, pr1
                add     pr0, pTable
                rdbyte  pr0, pr0
                mov     pr1, pPixel
                add     pr1, #pixels.GREEN_BYTE_OFST
                wrbyte  pr0, pr1
                mov     pr1, pSource
                add     pr1, #BMP_BLUE_OFST
                rdbyte  pr0, pr1
                add     pr0, pTable
                rdbyte  pr0, pr0
                mov     pr1, pPixel
                add     pr1, #pixels.BLUE_BYTE_OFST
                wrbyte  pr0, pr1
                add     pSource, sourceStep
                add     pPixel, rightStep
                djnz    nPixels, #.nextPixel
    end

PRI validateBmpFile(pBmpFileImage) : bValidStatus | pFileHeader
' Parse and validate the .BMP file header, returning TRUE if the file is a supported format. The
' image may be any size; its width and height are left in biWidth and biHeight.
'
' @param pBmpFileImage - pointer to the in-memory .bmp file data
' @returns bValidStatus - TRUE if the file is an uncompressed 24-bit BMP with a non-empty image

' Local Variables:
' @local pFileHeader - moving pointer through header fields during parsing

  bValidStatus := TRUE
  'analyze bitmap image
  pFileHeader := pBmpFileImage
  bytemove(@bfType, pFileHeader, BMP_TYPE_BYTES) 'read bmp header
  pFileHeader += BMP_TYPE_BYTES
  bytemove(@bfSize, pFileHeader, BMP_LONG_FIELD_BYTES) 'read bmp header
  pFileHeader += BMP_LONG_FIELD_BYTES
  bytemove(@bfReserved1, pFileHeader, BMP_RESERVED_BYTES) 'read bmp header
  pFileHeader += BMP_RESERVED_BYTES
  bytemove(@bfOffBits, pFileHeader, BMP_OFFBITS_BLOCK_BYTES) 'read bmp header
  pFileHeader += BMP_OFFBITS_BLOCK_BYTES
  bytemove(@biPlanes, pFileHeader, BMP_LONG_FIELD_BYTES)
  pFileHeader += BMP_LONG_FIELD_BYTES
  bytemove(@biCompression, pFileHeader, BMP_DIB_TAIL_BYTES)

  if biWidth < BMP_MIN_IMAGE_WIDTH or biHeight == 0
    bValidStatus := FALSE

  if biBitCount <> BMP_BIT_COUNT_24
    bValidStatus := FALSE

  if BYTE[@bfType][0] <> BMP_SIG_B || BYTE[@bfType][1] <> BMP_SIG_M ' B, M
    bValidStatus := FALSE

  if biCompression <> BMP_COMPRESSION_NONE
    bValidStatus := FALSE

  if bValidStatus == FALSE
    debug("- ERROR placeBMP() file is not an uncompressed 24-bit .bmp image, nothing drawn")

DAT ' ---- .bmp file work area ----

                    ALIGNL
                    BYTE 0  ' fill aligning header to avoid gaps
                    BYTE 0
BMPHeader     'Mostly using info from here:  http://www.fortunecity.com/skyscraper/windows/364/bmpffrmt.html
bfType              BYTE "B","M"
bfSize              LONG 0
bfReserved1         WORD 0
bfReserved2         WORD 0
bfOffBits           LONG BMP_HEADER_SIZE
biSize              LONG BMP_DIB_HEADER_SIZE
biWidth             LONG 0
biHeight            LONG 10
biPlanes            WORD BMP_PLANES
biBitCount          WORD BMP_BIT_COUNT_24
biCompression       LONG BMP_COMPRESSION_NONE
biSizeImage         LONG 0

biXPelsPerMeter     LONG 0
biYPelsPerMeter     LONG 0

biClrUsed           LONG 0
biClrImportant      LONG 0

CON ' license

