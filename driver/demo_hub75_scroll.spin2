''
''   File....... demo_hub75_scroll.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 matrix scrolling capability
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2022
''   Updated.... 07 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

    DEBUG_BAUD  = 2_000_000

CON ' ---- Demo Constants ----

    SCROLL_PERIOD       = 3                                         ' hundredths of a second between scroll steps (about 33 pixels a second)
    MS_PER_100TH_SEC    = 10

OBJ ' ---- Objects ----

    color           : "isp_hub75_color"
    hub75Bffrs      : "isp_hub75_hwBufferAccess"
    display         : "isp_hub75_display"

VAR ' ---- Per-instance State ----

    LONG    chainIndex
    LONG    scrollPeriod

PUB main()
'' Run the scrolling text demo on the HUB75 LED matrix.
''

    chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

    ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
    display.start(hub75Bffrs.HUB75_ADAPTER_1)

    demoScrollingText()

    repeat

PRI demoScrollingText() | scrollerID, textSize
' Set up and animate multiple scrolling text lines in different directions.
'

' Local Variables:
' @local scrollerID - identifier for the active text scroller
' @local textSize - selected font size for the display text

    scrollPeriod := SCROLL_PERIOD                       ' SCROLL_PERIOD hundredths of a second per step

    textSize := display.TEXT_FONT_5x7

    display.clearScreen()
    display.setTextFont(textSize)                       ' font size
    display.setCursor(0, 0)                             ' start at top left, with one pixel of spacing
    ' show some static text on 64x32 display
    if textSize == display.TEXT_FONT_5x7
        display.setColoredTextAtLnCol(0,0, string("Iron Sheep"), color.cMaroon)
        display.setColoredTextAtLnCol(1,0, string("ScrollDemo"), color.cOrange)
    else
        display.setColoredTextAtLnCol(0,0, string("SHEEP"), color.cMaroon)
        display.setColoredTextAtLnCol(1,0, string("scroll"), color.cOrange)
    ' show a region of scrolling text
    scrollerID := display.scrollColoredTextOnLn(2, string("First long text-123          "), display.DIR_TO_RIGHT, color.cBlue)
    ' configure it for one time scroll then stop when last bit arrives on screen
    display.configureScrollLoopMode(scrollerID, display.SCROLL_ONCE_TO_CLEAR)

    scrollerID := display.scrollColoredTextOnLn(3, string("2nd shorter - "), display.DIR_TO_LEFT, color.cLime)
    ' configure it for one time scroll then stop when last bit arrives on screen
    display.configureScrollLoopMode(scrollerID, display.SCROLL_FOREVER)

    scrollerID := display.scrollColoredTextOnLn(4, string("3rd  UP  -"), display.DIR_UP, color.cCyan)
    ' configure it for one time scroll then stop when last bit arrives on screen
    display.configureScrollLoopMode(scrollerID, display.SCROLL_FOREVER)

    scrollerID := display.scrollColoredTextOnLn(6, string("4th Down -"), display.DIR_DOWN, color.cYellow)
    ' configure it for one time scroll then stop when last bit arrives on screen
    display.configureScrollLoopMode(scrollerID, display.SCROLL_FOREVER)

    ' update our screen
    display.commitScreenToPanelSet()

    ' now loop while scrolling finishes
    wait100thSecs(scrollPeriod)

    ' while scrolling not done...
    repeat while display.isScrollingComplete() == FALSE
        ' move the text
        display.animateScroll()
        ' commit to screen
        display.commitScreenToPanelSet()

        ' delay while we stare wide-eyed at the new...
        wait100thSecs(scrollPeriod)

PRI wait100thSecs(count)
' Wait for N hundredths of a second.
'
' @param count - number of hundredths of a second to wait

    repeat count
        waitms(MS_PER_100TH_SEC)

