''   Updated.... 08 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant 2.985 nSec
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

CON ' ---- Debug Settings ----

    DEBUG_COGS  = %11111111
    DEBUG_BAUD  = 2_000_000

CON ' ---- Demo Timing ----

    DEMO_PAUSE_SECONDS  = 3                                         ' seconds (time for current meas. to settle)
    PARALLAX_TRIM       = 1                                         ' seconds the Parallax screen is held for less than a pause
    PAD_HOLD_PAUSES     = 20                                        ' the RGB pads are held for this many pauses
    MS_PER_SECOND       = 1000

CON ' ---- Text Layout ----

    LINE_0              = 0                                         ' text line numbers, counted from the top
    LINE_1              = 1
    LINE_2              = 2
    LINE_3              = 3
    FIRST_COLUMN        = 0                                         ' text lines start at the left edge

CON ' ---- RGB Pads Layout ----

    PAD_ROW             = 2                                         ' top row of the three pads
    PAD_SIZE            = 16                                        ' width and height of one pad
    PAD_COLUMN_RED      = 0
    PAD_COLUMN_GREEN    = 24
    PAD_COLUMN_BLUE     = 48
    PAD_LABEL_LINE      = 3                                         ' text line of the pad labels
    PAD_LABEL_COL_RED   = 0                                         ' text columns of the pad labels
    PAD_LABEL_COL_GREEN = 4
    PAD_LABEL_COL_BLUE  = 8

CON ' ---- Display Geometry ----

    PANEL_ROWS_32       = 32                                        ' a panel this tall (or shorter) is a 64x32 or smaller
    LAST_ROW_32         = 31                                        ' last row of a 32 row panel
    LAST_COLUMN_64      = 63                                        ' last column of a 64 column panel
    HALF_COLUMN         = 32                                        ' first column of the right half of a 64 column panel

CON ' ---- Colour Arithmetic ----

    CHANNEL_MAX         = 255                                       ' full brightness of one colour channel
    DECIMAL_BASE        = 10
    HUNDREDS_PLACE      = 100                                       ' place value of the hundreds digit of a frame count
    ASCII_SPACE         = $20
    ASCII_ZERO          = $30                                       ' the character '0'

CON ' ---- Test Pattern Layout ----

    SCAN_BAND_ROWS      = 4                                         ' height of a band in the 1/8 scan check
    SCAN_BOX_COLUMN     = 1                                         ' left column of the check bands
    SCAN_BOX_WIDTH      = 62                                        ' width of the check bands
    SCAN5_BAND_ROWS     = 3                                         ' height of a band in the fifth 1/8 scan check
    SCAN5_LAST_BAND_ROWS = 2                                        ' height of the last band of the fifth check
    ROW_ID_TENS_COLUMN  = 5                                         ' first column of the tens dots of a row number
    ROW_ID_ONES_COLUMN  = 10                                        ' first column of the ones dots of a row number

    PALETTE_STEP        = 25                                        ' step of one palette channel
    PALETTE_LAST        = 230                                       ' last step of the green and blue palette channels
    PALETTE_PER_ROW     = 4                                         ' mini panels per row
    BW_PANEL_INDEX      = 11                                        ' mini panel holding the grey ramp
    BW_SKIP_ROWS        = 3                                         ' rows of the grey ramp left black
    BW_RAMP_STEP        = 2                                         ' grey level step along the ramp
    BW_ROW_WIDTH        = 10                                        ' pixels per row of the grey ramp
    MINI_ROW_HEIGHT     = 11                                        ' mini panel row spacing
    MINI_COL_WIDTH      = 16                                        ' mini panel column spacing

    SWEEP_FIRST_ROW     = 2                                         ' top row of the first colour sweep

OBJ ' ---- Objects ----

    color           : "isp_hub75_color"
    colorUtils      : "isp_hub75_colorUtils"
    pixels          : "isp_hub75_screenUtils"
    hub75Bffrs      : "isp_hub75_hwBufferAccess"
    display         : "isp_hub75_display"

DAT ' ---- Demo Data ----

    pwmMsg      BYTE    "XXXfrm pwm",0
    bitMsg      BYTE    "-RGB "
    bitCt       BYTE    "nbit-",0

VAR ' ---- Per-instance State ----

    LONG    chainIndex

PUB main()
'' Start underlying drivers and run demo.
''

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(display.HUB75_ADAPTER_1)

  ' NOTE: for focused testing of some aspect of the driver/panel, call any of these in place of
  '  the demo below, followed by "repeat": demoColorPalette12Panels(), demoText(),
  '  showFullColorSweep(), show18scanColorCheck5() or show18scanColorCheck().

  demoParallax()
  waitSec(DEMO_PAUSE_SECONDS - PARALLAX_TRIM)

  ' put up the RGB pads
  display.clearScreen()
  display.drawBoxOfColor(PAD_ROW, PAD_COLUMN_RED, PAD_SIZE, PAD_SIZE, TRUE, color.cFullRed)
  display.drawBoxOfColor(PAD_ROW, PAD_COLUMN_GREEN, PAD_SIZE, PAD_SIZE, TRUE, color.cFullGreen)
  display.drawBoxOfColor(PAD_ROW, PAD_COLUMN_BLUE, PAD_SIZE, PAD_SIZE, TRUE, color.cFullBlue)

  display.setTextFont(display.TEXT_FONT_5x7)            ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing
  display.setColoredTextAtLnCol(PAD_LABEL_LINE, PAD_LABEL_COL_RED, string("Rd"), color.cFullRed)
  display.setColoredTextAtLnCol(PAD_LABEL_LINE, PAD_LABEL_COL_GREEN, string("Gr"), color.cFullGreen)
  display.setColoredTextAtLnCol(PAD_LABEL_LINE, PAD_LABEL_COL_BLUE, string("Bl"), color.cFullBlue)

  display.commitScreenToPanelSet()

  waitSec(DEMO_PAUSE_SECONDS * PAD_HOLD_PAUSES)

  display.stop()

PRI waitSec(countSeconds)
' Wait for the specified number of seconds.
'
' @param countSeconds - number of seconds to wait

  repeat countSeconds
    waitms(MS_PER_SECOND)

' ==============================================================================
'  Below here, lots of small demo routines
' ------------------------------------------------------------------------------

PRI demoParallax() | rtCol, ltCol, topRow, botRow, panelRows, panelColumns
' Draw the Parallax Propeller2 branded demo screen.
'

' Local Variables:
' @local rtCol - rightmost column index
' @local ltCol - leftmost column index
' @local topRow - top row index
' @local botRow - bottom row index
' @local panelRows - pixel rows of one panel, as the viewer sees it
' @local panelColumns - pixel columns of one panel, as the viewer sees it

  display.setTextFont(display.TEXT_FONT_5x7)                                    ' font size
  display.setCursor(0, 0)                                                       ' start at top left, with one pixel of spacing

  panelRows, panelColumns := hub75Bffrs.cellSizeInPixels(chainIndex)        ' one panel as the viewer sees it
  ltCol := 0
  rtCol := panelColumns - 1
  topRow := 0
  botRow :=  panelRows > PANEL_ROWS_32 ? PANEL_ROWS_32 - 1 : panelRows - 1
  display.drawLineOfColor(topRow, ltCol, topRow, rtCol, color.cYellow)          ' top line
  display.drawLineOfColor(topRow, ltCol, botRow, ltCol, color.cRed)             ' left line
  display.drawLineOfColor(topRow, rtCol, botRow, rtCol, color.cMagenta)         ' right line
  display.drawLineOfColor(botRow, ltCol, botRow, rtCol, color.cGreen)           ' bottom Line
  display.setColoredTextAtLnCol(LINE_1, FIRST_COLUMN, string(" Parallax"), color.cBlue)
  display.setColoredTextAtLnCol(LINE_2, FIRST_COLUMN, string("Propeller2"), color.cBlue)
  display.commitScreenToPanelSet()

PRI demoText() | frameCount
' Draw demo text showing driver info and color depth.
'

' Local Variables:
' @local frameCount - number of PWM frames for current color depth

  ' draw some text!

  display.setTextFont(display.TEXT_FONT_5x7)            ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing
  display.setColoredTextAtLnCol(LINE_0, FIRST_COLUMN, string("iron sheep"), color.cMaroon)

  frameCount := hub75Bffrs.pwmFrameCount(chainIndex)
  case hub75Bffrs.colorDepth(chainIndex)
    hub75Bffrs.DEPTH_3BIT:
      pwmMsg.BYTE[0] := ASCII_SPACE
      pwmMsg.BYTE[1] := ASCII_SPACE
      pwmMsg.BYTE[2] := ASCII_ZERO + frameCount
    hub75Bffrs.DEPTH_7BIT,hub75Bffrs.DEPTH_8BIT:
      pwmMsg.BYTE[0] := ASCII_ZERO + (frameCount / HUNDREDS_PLACE)
      pwmMsg.BYTE[1] := ASCII_ZERO + ((frameCount // HUNDREDS_PLACE) / DECIMAL_BASE)
      pwmMsg.BYTE[2] := ASCII_ZERO + ((frameCount // HUNDREDS_PLACE) // DECIMAL_BASE)
    other:
      pwmMsg.BYTE[0] := ASCII_SPACE
      pwmMsg.BYTE[1] := ASCII_ZERO + (frameCount / DECIMAL_BASE)
      pwmMsg.BYTE[2] := ASCII_ZERO + (frameCount // DECIMAL_BASE)
  bitCt.BYTE[0] := hub75Bffrs.colorDepth(chainIndex) + ASCII_ZERO

  display.setColoredTextAtLnCol(LINE_1, FIRST_COLUMN, @bitMsg, color.cOrange)
  display.setColoredTextAtLnCol(LINE_2, FIRST_COLUMN, @pwmMsg, color.cRainbow)
  display.setColoredTextAtLnCol(LINE_3, FIRST_COLUMN, string("led matrix"), color.cWhite)
  display.commitScreenToPanelSet()

PRI show18scanColorCheck()
' Draw color check test pattern for 1/8 scan debugging.
'

  ' test pattern used while debugging 1/8 scan capability

  display.drawBoxOfColor(0, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, TRUE, color.cRed)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 1, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, FALSE, color.cYellow)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 2, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, TRUE, color.cWhite)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 3, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, FALSE, color.cMagenta)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 4, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, TRUE, color.cBlue)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 5, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, FALSE, color.cRainbow)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 6, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, TRUE, color.cLime)
  display.drawBoxOfColor(SCAN_BAND_ROWS * 7, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN_BAND_ROWS, FALSE, color.cOrange)
  display.drawLineOfColor(0, LAST_COLUMN_64, LAST_ROW_32, LAST_COLUMN_64, color.cGreen)
  display.drawLineOfColor(0, 0, LAST_ROW_32, 0, color.cBlueViolet)
  display.drawLineOfColor(0, HALF_COLUMN, LAST_ROW_32, HALF_COLUMN, color.cWhite)
  display.drawLineOfColor(0, HALF_COLUMN - 1, LAST_ROW_32, HALF_COLUMN - 1, color.cYellow)
  display.commitScreenToPanelSet()

PRI show18scanColorCheck5()
' Draw multi-color stripe pattern with row numbers for 1/8 scan debugging.
'

  display.drawBoxOfColor(0, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cRed)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 1, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cPurple)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 2, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cWhite)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 3, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cMagenta)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 4, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cYellow)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 5, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cGreen)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 6, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cOrange)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 7, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cLime)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 8, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cBlue)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 9, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_BAND_ROWS, TRUE, color.cMaroon)
  display.drawBoxOfColor(SCAN5_BAND_ROWS * 10, SCAN_BOX_COLUMN, SCAN_BOX_WIDTH, SCAN5_LAST_BAND_ROWS, TRUE, color.cOlive)

  display.drawLineOfColor(0, LAST_COLUMN_64, LAST_ROW_32, LAST_COLUMN_64, color.cLime)
  display.drawLineOfColor(0, 0, LAST_ROW_32, 0, color.cYellow)

  numberTheRows()

  display.commitScreenToPanelSet()

PRI numberTheRows() | rowId, idCol, idOnes, idTens, tensColor, onesColor, panelRows
' Draw row number indicators using pixel dots for each row.
'

' Local Variables:
' @local rowId - current row being numbered
' @local idCol - column offset for drawing digit dots
' @local idOnes - ones digit of current row number
' @local idTens - tens digit of current row number
' @local panelRows - pixel rows of one panel, as the viewer sees it
' @local tensColor - color used for tens digit dots
' @local onesColor - color used for ones digit dots

  tensColor := color.cCyan
  onesColor := color.cCyan
  panelRows, _ := hub75Bffrs.cellSizeInPixels(chainIndex)
  repeat rowId from 1 TO panelRows
    idOnes := rowId // DECIMAL_BASE
    idTens := rowId / DECIMAL_BASE
    if idTens > 0
      repeat idCol from 0 TO idTens - 1
        pixels.drawPixelAtRC(chainIndex, rowId - 1, idCol + ROW_ID_TENS_COLUMN, tensColor)
    if idOnes > 0
      repeat idCol from 0 TO idOnes - 1
        pixels.drawPixelAtRC(chainIndex, rowId - 1, idCol + ROW_ID_ONES_COLUMN, onesColor)

PRI demoColorPalette12Panels() | red, panelNumber
' Draw twelve mini panels showing color palette and grayscale.
'

' Local Variables:
' @local red - current red channel level
' @local panelNumber - index of current mini panel

  ' 11x10x10 COLOR PANELs + BW panel

  panelNumber := 0
  repeat red from 0 TO CHANNEL_MAX step PALETTE_STEP
    generateGreenBluePanelAgainst(panelNumber, red)
    panelNumber++
  generateBWPanel(BW_PANEL_INDEX)
  display.commitScreenToPanelSet()

PRI generateGreenBluePanelAgainst(panelNumber, red) | panelRow, panelCol, row, col, green, blue, startCol
' Generate a green-blue gradient mini panel at the given red level.
'
' @param panelNumber - index of the mini panel (0-10)
' @param red - fixed red channel value for this panel

' Local Variables:
' @local panelRow - row position of mini panel in grid
' @local panelCol - column position of mini panel in grid
' @local row - current pixel row
' @local col - current pixel column
' @local green - current green channel value
' @local blue - current blue channel value
' @local startCol - starting column for this panel

  panelRow := panelNumber / PALETTE_PER_ROW
  panelCol := panelNumber // PALETTE_PER_ROW
  row := panelRow * MINI_ROW_HEIGHT
  startCol := col := panelCol * MINI_COL_WIDTH
  repeat green from 0 TO PALETTE_LAST step PALETTE_STEP
    repeat blue from 0 TO PALETTE_LAST step PALETTE_STEP
      pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
      col++
    row++
    col := startCol

PRI generateBWPanel(panelNumber) | panelRow, panelCol, row, col, red, green, blue, startCol, colCtr, startRow
' Generate a grayscale gradient mini panel at the given position.
'
' @param panelNumber - index of the mini panel (0-11)

' Local Variables:
' @local panelRow - row position of mini panel in grid
' @local panelCol - column position of mini panel in grid
' @local row - current pixel row
' @local col - current pixel column
' @local red - red channel value
' @local green - green channel value (drives grayscale sweep)
' @local blue - blue channel value
' @local startCol - starting column for this panel
' @local colCtr - column counter within current row
' @local startRow - first valid row for this panel

  panelRow := panelNumber / PALETTE_PER_ROW
  panelCol := panelNumber // PALETTE_PER_ROW
  startRow := (panelRow * MINI_ROW_HEIGHT)
  row := startRow - BW_SKIP_ROWS                        ' skip black rows
  startCol := col := panelCol * MINI_COL_WIDTH
  colCtr := 0
  repeat green from 0 TO CHANNEL_MAX step BW_RAMP_STEP
    red := blue := green
    if row >= startRow
      pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    colCtr++
    if colCtr >= BW_ROW_WIDTH
      colCtr := 0
      row++
      col := startCol

PRI showFullColorSweep() | row, col, red, green, blue, panelColumns
' Draw full 0-255 brightness sweeps for seven color channels.
'

' Local Variables:
' @local row - current row position
' @local col - current column position
' @local red - red channel value
' @local green - green channel value
' @local blue - blue channel value
' @local panelColumns - pixel columns of one panel, as the viewer sees it

  ' basic bands - full color sweep

  _, panelColumns := hub75Bffrs.cellSizeInPixels(chainIndex)    ' one panel as the viewer sees it
  red := green := blue := 0
  row := SWEEP_FIRST_ROW
  col := 0
  repeat red from 0 TO CHANNEL_MAX                      ' RED
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  red := green := blue := 0
  repeat green from 0 TO CHANNEL_MAX                    ' GREEN
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  red := green := blue := 0
  repeat blue from 0 TO CHANNEL_MAX                     ' BLUE
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  red := green := blue := 0
  repeat red from 0 TO CHANNEL_MAX                      ' YELLOW
    green := red
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  red := green := blue := 0
  repeat green from 0 TO CHANNEL_MAX                    ' CYAN
    blue := green
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  red := green := blue := 0
  repeat blue from 0 TO CHANNEL_MAX                     ' MAGENTA
    red := blue
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  red := green := blue := 0
  repeat blue from 0 TO CHANNEL_MAX                     ' WHITE
    green := red := blue
    pixels.drawPixelAtRC(chainIndex, row, col, colorUtils.cValueForRGB(red, green, blue))
    col++
    if (col > panelColumns - 1)
      row++
      col := 0
  display.commitScreenToPanelSet()

