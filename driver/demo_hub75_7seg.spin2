CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

    DEBUG_BAUD  = 2_000_000

CON ' ---- Display Constants ----

    MAX_DIGITS          = 8

    ' digit placement (row, then the left column of each digit; the second panel adds PANEL_WIDTH)
    DIGIT_ROW           = 8
    DIGIT_COLUMN_A      = 2
    DIGIT_COLUMN_B      = 17
    DIGIT_COLUMN_C      = 35
    DIGIT_COLUMN_D      = 50
    PANEL_WIDTH         = 64

    ' display width, in pixel columns, above which the next digits are shown
    WIDTH_FOR_4_DIGITS  = 32
    WIDTH_FOR_6_DIGITS  = 64
    WIDTH_FOR_8_DIGITS  = 96

    ' digit shown when each digit is first placed
    DIGIT_ZERO          = 0
    DIGIT_ONE           = 1
    DIGIT_TWO           = 2

    ' timing, in hundredths of a second
    SEGMENT_PERIOD      = 8                                         ' between segment animation steps
    DIGIT_PERIOD        = 12                                        ' pause on a finished digit
    MS_PER_100TH_SEC    = 10

    ' clock arithmetic
    DECIMAL_BASE        = 10
    LAST_HOUR           = 12
    LAST_MINUTE         = 59
    SECOND_CLOCK_OFFSET = 12                                        ' hours between the two clocks shown
    HOURS_PER_DAY       = 24
    SECONDS_DOT_PERIOD  = 2                                         ' the dots alternate every minute step

    ' colon dots between the hour and minute digits
    DOT_ROW_UPPER       = 15
    DOT_ROW_LOWER       = 23
    DOT_COLUMN          = 31
    DOT_DIM_COLOR       = $00006F
    DOT_BRIGHT_COLOR    = $0080FF

OBJ ' ---- Objects ----

    color                       : "isp_hub75_color"
    display                     : "isp_hub75_display"
    pixels                      : "isp_hub75_screenUtils"
    digit[MAX_DIGITS]           : "isp_hub75_7seg"
    hub75Bffrs                  : "isp_hub75_hwBufferAccess"

VAR ' ---- Per-instance State ----

    LONG    chainIndex
    LONG    segmentPeriod
    LONG    digitPeriod
    LONG    digitIndex
    LONG    hours
    LONG    minutes

PUB start() | hours24, displayColumns
'' Start underlying drivers and run the seven-segment clock demo.
''

' Local Variables:
' @local hours24 - hours value in 24-hour format
' @local displayColumns - width of the display in pixel columns

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)
  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(hub75Bffrs.HUB75_ADAPTER_1)

  displayColumns := hub75Bffrs.maxDisplayColumns(chainIndex)

  '  SEVEN SEGMENT DEMO

  segmentPeriod := SEGMENT_PERIOD
  digitPeriod := DIGIT_PERIOD

  ' draw some text!
  display.setTextFont(display.TEXT_FONT_5x7)            ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing

  display.setColoredTextAtLnCol(0,0, string("iron sheep"), color.cMaroon)
  display.commitScreenToPanelSet()

  ' High Speed CLOCK demo
  hours := minutes := 0

  digit[0].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_A, DIGIT_ZERO, color.cOrange)
  digit[1].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_B, DIGIT_ZERO, color.cOrange)
  if displayColumns > WIDTH_FOR_4_DIGITS
    digit[2].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_C, DIGIT_ZERO, color.cOrange)
    digit[3].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_D, DIGIT_ZERO, color.cOrange)
  if displayColumns > WIDTH_FOR_6_DIGITS
    digit[4].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_A + PANEL_WIDTH, DIGIT_ONE, color.cOrange)
    digit[5].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_B + PANEL_WIDTH, DIGIT_TWO, color.cOrange)
  if displayColumns > WIDTH_FOR_8_DIGITS
    digit[6].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_C + PANEL_WIDTH, DIGIT_ZERO, color.cOrange)
    digit[7].placeDigit(chainIndex, DIGIT_ROW, DIGIT_COLUMN_D + PANEL_WIDTH, DIGIT_ZERO, color.cOrange)

  display.commitScreenToPanelSet()
  wait100thSecs(segmentPeriod)

  loopUntilSegmentsFinish()

  ' PAUSE to see digit before next morph
  wait100thSecs(digitPeriod)

  repeat hours from 0 TO LAST_HOUR
    hours24 := hours + SECOND_CLOCK_OFFSET
    if hours24 >= HOURS_PER_DAY
      hours24 -= HOURS_PER_DAY

    repeat minutes from 0 TO LAST_MINUTE

      digit[0].setValue(hours / DECIMAL_BASE)
      digit[1].setValue(hours // DECIMAL_BASE)
      digit[2].setValue(minutes / DECIMAL_BASE)
      digit[3].setValue(minutes // DECIMAL_BASE)
      if displayColumns > WIDTH_FOR_6_DIGITS
        digit[4].setValue(hours24 / DECIMAL_BASE)
        digit[5].setValue(hours24 // DECIMAL_BASE)
      if displayColumns > WIDTH_FOR_8_DIGITS
        digit[6].setValue(minutes / DECIMAL_BASE)
        digit[7].setValue(minutes // DECIMAL_BASE)

      display.commitScreenToPanelSet()
      wait100thSecs(segmentPeriod)

      showSecondsDots( minutes // SECONDS_DOT_PERIOD )

      loopUntilSegmentsFinish()

      wait100thSecs(digitPeriod)

  DEBUG("DEMO: done")
  repeat

PUB wait100thSecs(count)
'' Wait for the specified number of hundredths of a second.
''
'' @param count - number of hundredths of a second to wait

  repeat count
    waitms(MS_PER_100TH_SEC)

CON ' ---- Private Methods ----

PRI showSecondsDots(lightDark) | targetColor
' Draw the colon dots between hour and minute digits.
'
' @param lightDark - 0 for dim color, 1 for bright color

' Local Variables:
' @local targetColor - computed 24-bit RGB color for dots

  if lightDark == 0
    targetColor := DOT_DIM_COLOR
  else
    targetColor := DOT_BRIGHT_COLOR

  drawSecondsDot(DOT_ROW_UPPER, DOT_COLUMN, targetColor)
  drawSecondsDot(DOT_ROW_LOWER, DOT_COLUMN, targetColor)
  if hub75Bffrs.maxDisplayColumns(chainIndex) > WIDTH_FOR_8_DIGITS
    drawSecondsDot(DOT_ROW_UPPER, DOT_COLUMN + PANEL_WIDTH, targetColor)
    drawSecondsDot(DOT_ROW_LOWER, DOT_COLUMN + PANEL_WIDTH, targetColor)

PRI drawSecondsDot(row, column, rgbColor)
' Draw a 2x2 pixel dot at the given row and column.
'
' @param row - top-left row of the dot
' @param column - top-left column of the dot
' @param rgbColor - 24-bit RGB color for the dot

  pixels.drawPixelAtRC(chainIndex, row, column, rgbColor)
  pixels.drawPixelAtRC(chainIndex, row, column+1, rgbColor)
  pixels.drawPixelAtRC(chainIndex, row+1, column, rgbColor)
  pixels.drawPixelAtRC(chainIndex, row+1, column+1, rgbColor)

PRI allDigitAnimationsComplete() : bAllComplete
' Return TRUE if all digit animations have finished.
'
' @returns bAllComplete - TRUE if all complete, FALSE otherwise

  bAllComplete := TRUE
  repeat digitIndex from 0 TO MAX_DIGITS - 1
    if digit[digitIndex].isAnimationComplete() == FALSE
      bAllComplete := FALSE
      quit

PRI loopUntilSegmentsFinish() | didAnimate
' Animate all digit segments until all animations are complete.
'

' Local Variables:
' @local didAnimate - TRUE if any digit animated this iteration

  repeat
    didAnimate := FALSE
    if allDigitAnimationsComplete() == FALSE
      repeat digitIndex from 0 TO MAX_DIGITS - 1
        if digit[digitIndex].isAnimationComplete() == FALSE
          didAnimate := TRUE
          digit[digitIndex].animateStep()
      if didAnimate == TRUE
        display.commitScreenToPanelSet()
        wait100thSecs(segmentPeriod)

    if allDigitAnimationsComplete() == TRUE
      quit

