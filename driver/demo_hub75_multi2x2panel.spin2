'' =================================================================================================
''
''   File....... demo_hub75_multi2x2panel.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 matrix access to individual panels
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Apr 2021
''   Updated.... 08 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ = 335_000_000                                        ' system freq as a constant 2.985 nSec
    _clkfreq = CLK_FREQ                                           ' set system clock

    DEBUG_COGS = %11111111
    DEBUG_BAUD = 2_000_000

CON ' ---- Orientation Test Layout ----

    ' Panel positions for the 2x2 grid: reading order from the top-left panel, as the
    ' display is mounted (panel position P0 is the top-left panel):
    '  PNL_TOP_LT - top-left panel     (P0)
    '  PNL_TOP_RT - top-right panel    (P1)
    '  PNL_BOT_LT - bottom-left panel  (P2)
    '  PNL_BOT_RT - bottom-right panel (P3)
    #0, PNL_TOP_LT, PNL_TOP_RT, PNL_BOT_LT, PNL_BOT_RT

    DISPLAY_BRIGHTNESS = 128
    ARROW_LINE = 3                                                ' panel-local text line of the arrow
    LABEL_LINE = 4                                                ' panel-local text line of the panel number
    PANEL_TEXT_COLUMN = 7                                         ' panel-local text column of both
    MARK_ROW = 2                                                  ' panel-local row of the small yellow box
    MARK_COLUMN = 2                                               ' panel-local column of the small yellow box
    MARK_SIZE = 10                                                ' width and height of the small yellow box
    CENTER_ROW = 64                                               ' display row where all 4 panels meet
    CENTER_COLUMN = 128                                           ' display column where all 4 panels meet
    CIRCLE_RADIUS = 32
    LAST_ROW = 127                                                ' last display row
    LAST_COLUMN = 255                                             ' last display column
    CORNER_SIZE = 8                                               ' width and height of the navy corner markers
    CORNER_ROW = LAST_ROW + 1 - CORNER_SIZE                       ' top row of the bottom corner markers
    CORNER_COLUMN = LAST_COLUMN + 1 - CORNER_SIZE                 ' left column of the right corner markers
    HOLD_SECONDS = 120                                            ' how long the image is held before the cog is stopped
    MS_PER_SECOND = 1000

OBJ ' ---- Objects ----

    color       : "isp_hub75_color"
    display     : "isp_hub75_display"

DAT ' ---- Panel Orientation Labels ----

    lbl0          BYTE    "0", 0
    lbl1          BYTE    "1", 0
    lbl2          BYTE    "2", 0
    lbl3          BYTE    "3", 0
    lblArrow      BYTE    "^", 0

PUB main()
'' Start underlying drivers and run the panel orientation test on a 2x2 grid of panels.
''

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(display.HUB75_ADAPTER_1)

  ' ============================================
  ' PANEL ORIENTATION TEST
  ' 2x2 grid of 128x64 panels = 256x128 total
  ' Center at (128, 64) where all 4 panels meet
  ' ============================================
  testPanelOrientation()

  display.stop()

PRI testPanelOrientation()
' Test pattern using BOTH coordinate systems:
'
' PANEL-SPECIFIC drawing (panel-local coordinates + panelIndex):
'   - fillPanel() - fills entire panel with color
'   - setCursorOnPanel() - text at panel-local line/column
'   - drawPanelBox() - box at panel-local row/column
'
' DISPLAY-WIDE drawing (absolute display coordinates):
'   - drawCircleOfColor() - circle at display row/column
'   - drawLineOfColor() - line at display coordinates
'   - setCursor() / setColoredTextAtLnCol() - text at display line/column
'
' For 2x2 grid of 128x64 panels:
'   Display size: 256 columns x 128 rows
'   Panel layout: [0=Blue][1=Green]   (top row, rows 0-63)
'                 [2=Red][3=Magenta]  (bottom row, rows 64-127)

  display.clearScreenBuffer()
  display.setBrightness(DISPLAY_BRIGHTNESS)

  ' Set up text
  display.setTextFont(display.TEXT_FONT_8x8A)

  ' ========================================
  ' PANEL-SPECIFIC DRAWING (panel-local coordinates)
  ' ========================================

  ' Panel 0 (display top-left): Blue background
  display.fillPanel(PNL_TOP_LT, color.cBlue)
  display.setTextColor(color.cWhite)
  display.setCursorOnPanel(ARROW_LINE, PANEL_TEXT_COLUMN, PNL_TOP_LT)
  display.setTextAtCursor(@lblArrow)
  display.setCursorOnPanel(LABEL_LINE, PANEL_TEXT_COLUMN, PNL_TOP_LT)
  display.setTextAtCursor(@lbl0)
  ' Small yellow box in top-left corner of panel 0 (panel-local coords)
  display.drawPanelBoxOfColor(PNL_TOP_LT, MARK_ROW, MARK_COLUMN, MARK_SIZE, MARK_SIZE, TRUE, color.cYellow)

  ' Panel 1 (display top-right): Green background
  display.fillPanel(PNL_TOP_RT, color.cGreen)
  display.setTextColor(color.cWhite)
  display.setCursorOnPanel(ARROW_LINE, PANEL_TEXT_COLUMN, PNL_TOP_RT)
  display.setTextAtCursor(@lblArrow)
  display.setCursorOnPanel(LABEL_LINE, PANEL_TEXT_COLUMN, PNL_TOP_RT)
  display.setTextAtCursor(@lbl1)
  ' Small yellow box in top-left corner of panel 1
  display.drawPanelBoxOfColor(PNL_TOP_RT, MARK_ROW, MARK_COLUMN, MARK_SIZE, MARK_SIZE, TRUE, color.cYellow)

  ' Panel 2 (display bottom-left): Red background
  display.fillPanel(PNL_BOT_LT, color.cRed)
  display.setTextColor(color.cWhite)
  display.setCursorOnPanel(ARROW_LINE, PANEL_TEXT_COLUMN, PNL_BOT_LT)
  display.setTextAtCursor(@lblArrow)
  display.setCursorOnPanel(LABEL_LINE, PANEL_TEXT_COLUMN, PNL_BOT_LT)
  display.setTextAtCursor(@lbl2)
  ' Small yellow box in top-left corner of panel 2
  display.drawPanelBoxOfColor(PNL_BOT_LT, MARK_ROW, MARK_COLUMN, MARK_SIZE, MARK_SIZE, TRUE, color.cYellow)

  ' Panel 3 (display bottom-right): Magenta background
  display.fillPanel(PNL_BOT_RT, color.cMagenta)
  display.setTextColor(color.cWhite)
  display.setCursorOnPanel(ARROW_LINE, PANEL_TEXT_COLUMN, PNL_BOT_RT)
  display.setTextAtCursor(@lblArrow)
  display.setCursorOnPanel(LABEL_LINE, PANEL_TEXT_COLUMN, PNL_BOT_RT)
  display.setTextAtCursor(@lbl3)
  ' Small yellow box in top-left corner of panel 3
  display.drawPanelBoxOfColor(PNL_BOT_RT, MARK_ROW, MARK_COLUMN, MARK_SIZE, MARK_SIZE, TRUE, color.cYellow)

  ' ========================================
  ' DISPLAY-WIDE DRAWING (absolute coordinates)
  ' ========================================

  ' Cyan circle at display center (where all 4 panels meet)
  display.drawCircleOfColor(CENTER_ROW, CENTER_COLUMN, CIRCLE_RADIUS, color.cCyan)

  ' White crosshairs through the display center (display coordinates)
  ' Horizontal line: the center row, across the full width
  display.drawLineOfColor(CENTER_ROW, 0, CENTER_ROW, LAST_COLUMN, color.cWhite)
  ' Vertical line: the center column, down the full height
  display.drawLineOfColor(0, CENTER_COLUMN, LAST_ROW, CENTER_COLUMN, color.cWhite)

  ' Navy corner markers using display coordinates (dark, contrasts with yellow panel boxes)
  ' Top-left corner of display
  display.drawBoxOfColor(0, 0, CORNER_SIZE, CORNER_SIZE, TRUE, color.cNavy)
  ' Top-right corner of display
  display.drawBoxOfColor(0, CORNER_COLUMN, CORNER_SIZE, CORNER_SIZE, TRUE, color.cNavy)
  ' Bottom-left corner of display
  display.drawBoxOfColor(CORNER_ROW, 0, CORNER_SIZE, CORNER_SIZE, TRUE, color.cNavy)
  ' Bottom-right corner of display
  display.drawBoxOfColor(CORNER_ROW, CORNER_COLUMN, CORNER_SIZE, CORNER_SIZE, TRUE, color.cNavy)

  display.commitScreenToPanelSet()
  debug("=== PANEL-SPECIFIC DRAWING ===")
  debug("  Colored backgrounds: 0=Blue(TL), 1=Green(TR), 2=Red(BL), 3=Magenta(BR)")
  debug("  Yellow boxes: panel-local (2,2) on each panel")
  debug("  White text ^/0-3: panel-local lines 3-4, col 7")
  debug("=== DISPLAY-WIDE DRAWING ===")
  debug("  Cyan circle: display center (64,128) r=32")
  debug("  White crosshairs: row 64, col 128")
  debug("  Navy corners: display (0,0), (0,248), (120,0), (120,248)")
  waitSec(HOLD_SECONDS)

PRI waitSec(countSeconds)
' Wait for the specified number of seconds.
'
' @param countSeconds - number of seconds to wait

  repeat countSeconds
    waitms(MS_PER_SECOND)

