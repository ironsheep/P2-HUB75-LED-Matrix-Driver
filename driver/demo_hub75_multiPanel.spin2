'' =================================================================================================
''
''   File....... demo_hub75_multiPanel.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 matrix access to individual panels
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Apr 2021
''   Updated.... 09 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant 2.985 nSec
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

    DEBUG_COGS  = %11111111
    DEBUG_BAUD  = 2_000_000

CON ' ---- Demo Info ----

    ' the demos main() runs, in order, numbered from 1
    #1, DEMO_PANEL_COLORS, DEMO_TOP_BOTTOM_SCROLL, DEMO_RANDOM_COLORS, DEMO_FILL_COLORS

    ' DEMO_COUNT is how many of those demos run, in order from the first
    ' (set DEMO_COUNT to DEMO_FILL_COLORS to include the fill demo)
    DEMO_COUNT  = DEMO_RANDOM_COLORS

    ' The labelled-panels demo names panels P0 .. P5, in reading order from the top-left panel
    ' as the display is mounted, after the faces of an unfolded cube: Top, Front, Right, Back,
    ' Left, Bot. The names are labels only: they do not follow DISPn_CUBE_TOP / DISPn_CUBE_FRONT.
    ' To draw on the faces of a real cube, use the face-centric calls (drawFace...). A display
    ' with fewer panels labels the panels it has; one with more labels the first LABELLED_PANELS.
    LABELLED_PANELS     = 6

    ' demo timing and counts
    DEMO_PAUSE_SECONDS  = 3                                         ' pause between demos
    DEMO_PASSES         = 20                                        ' times the whole demo sequence repeats
    RANDOM_PASSES       = 20                                        ' random-colour screens per demoRandomPanelColors
    FILL_PASSES         = 4                                         ' times demoPanelFillColors cycles its colours
    FILL_SHORT_SECONDS  = 2
    FILL_LONG_SECONDS   = 4
    MS_PER_SECOND       = 1000

    ' hue arithmetic (a hue is an angle, 0 to colorUtils.DEGREES_PER_CIRCLE - 1, around the colour circle)
    BOX_HUE_OFFSET      = 3                                         ' the box hue is this many panels past the panel's own
    PANEL_HUE_OFFSET    = 1                                         ' the panel hue is this many panels past its index
    ASCII_ZERO          = $30                                       ' the character '0' (panel numbers are one digit: up to 10 panels)

    ' the coloured box drawn inside each panel
    BOX_TOP_ROW         = 17
    BOX_LEFT_COLUMN     = 10
    BOX_WIDTH           = 40
    BOX_HEIGHT          = 34

    ' text positions (panel-local line and column), for the 8x8 font
    ID_LINE             = 1                                         ' panel number
    ID_COLUMN           = 1
    LABEL_LINE          = 0                                         ' the panel's name
    LABEL_COLUMN        = 1

    ' the scrolling text crosses the top row of panels, on the middle text line of a panel
    ' (the panel's text lines / SCROLL_LINE_DIVISOR), and repeats SCROLL_REPEATS times
    SCROLL_LINE_DIVISOR = 2
    PANEL_P0            = 0                                         ' the top-left panel, where the text starts
    TOP_ROW             = 0                                         ' display row of the top row of panels
    SCROLL_REPEATS      = 2

OBJ ' ---- Objects ----

    color           : "isp_hub75_color"
    colorUtils      : "isp_hub75_colorUtils"
    hub75Bffrs      : "isp_hub75_hwBufferAccess"
    display         : "isp_hub75_display"

DAT ' ---- Panel Messages ----

    panelIdMessage  BYTE    "Pn",0

    lblTop      BYTE    "Top", 0
    lblBot      BYTE    "Bot", 0
    lblFrnt     BYTE    "Front", 0
    lblRight    BYTE    "Right", 0
    lblBack     BYTE    "Back", 0
    lblLeft     BYTE    "Left", 0

VAR ' ---- Per-instance State ----

    LONG    chainIndex

PUB main() | demoIndex
'' Start underlying drivers and run the multi-panel demo sequence.
''

' Local Variables:
' @local demoIndex - index of the current demo being run

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(display.HUB75_ADAPTER_1)

  repeat DEMO_PASSES
    repeat demoIndex from 1 TO DEMO_COUNT
      case demoIndex
        DEMO_PANEL_COLORS: demoPanelColors()
        DEMO_TOP_BOTTOM_SCROLL: demoTopBottomScroll()
        DEMO_RANDOM_COLORS: demoRandomPanelColors()
        DEMO_FILL_COLORS: demoPanelFillColors()

      waitSec(DEMO_PAUSE_SECONDS)

  display.stop()

PRI waitSec(countSeconds)
' Wait for the specified number of seconds.
'
' @param countSeconds - number of seconds to wait

  repeat countSeconds
    waitms(MS_PER_SECOND)

PRI demoPanelFillColors()
' Fill the screen with solid red, green, blue, and white colors in sequence.
'

  display.clearScreenBuffer()
  repeat FILL_PASSES
    display.fillScreenNoPWM(color.BASE_RED)             ' full single color panel NO pwm
    waitSec(FILL_SHORT_SECONDS)
    display.fillScreenNoPWM(color.BASE_GREEN)           ' full single color panel NO pwm
    waitSec(FILL_SHORT_SECONDS)
    display.fillScreenNoPWM(color.BASE_BLUE)            ' full single color panel NO pwm
    waitSec(FILL_SHORT_SECONDS)
    display.fillScreenNoPWM(color.BASE_WHITE)           ' full single color panel NO pwm
    waitSec(FILL_LONG_SECONDS)

PRI demoRandomPanelColors() | panelIndex, panelHue, panelColor
' Fill each panel with a random hue color.
'

' Local Variables:
' @local panelIndex - index of the panel being colored
' @local panelHue - random hue value for the panel
' @local panelColor - RGB color derived from the hue

  display.clearScreenBuffer()
  repeat RANDOM_PASSES
    repeat panelIndex from 0 TO hub75Bffrs.maxPanels(chainIndex) - 1
      panelHue := GETRND() +// colorUtils.DEGREES_PER_CIRCLE
      panelColor := colorUtils.rgbColorFromDegrees(panelHue)
      display.fillPanel(panelIndex, panelColor)
    ' update our screen
    display.commitScreenToPanelSet()

PRI demoTopBottomScroll() | scrollerID, panelIdx, nLabelled, nTopRowPanels, panelRow
' Label each panel with a face name of an unfolded cube, and scroll text across the top row of
' panels. Both follow the display's own layout: only the panels it has are labelled, and the
' text crosses every panel in the top row.
'

' Local Variables:
' @local scrollerID - identifier for the active text scroller
' @local panelIdx - panel position being labelled or counted
' @local nLabelled - panels labelled: the display's panels, at most LABELLED_PANELS
' @local nTopRowPanels - panels in the display's top row, which the text crosses
' @local panelRow - display row of a panel's top-left pixel (the top row is 0)

  display.setTextFont(display.TEXT_FONT_8x8A)           ' font size
  display.setTextColor(color.cBlueViolet)

  ' start with blank screen on which to draw
  display.clearScreenBuffer()

  nLabelled := hub75Bffrs.maxPanels(chainIndex) <# LABELLED_PANELS
  repeat panelIdx from 0 to nLabelled - 1
    display.fillPanel(panelIdx, lookupz(panelIdx : color.cGreen, color.cYellow, color.cCyan, color.cOrange, color.cLime, color.cRed))
    display.setCursorOnPanel(LABEL_LINE, LABEL_COLUMN, panelIdx)
    display.setTextAtCursor(lookupz(panelIdx : @lblTop, @lblFrnt, @lblRight, @lblBack, @lblLeft, @lblBot))

  ' the panels in the top row are the first in reading order, so count from P0 while the row is 0
  nTopRowPanels := 0
  repeat panelIdx from 0 to hub75Bffrs.maxPanels(chainIndex) - 1
    panelRow, _ := hub75Bffrs.offsetToPanel(chainIndex, panelIdx)
    if panelRow <> TOP_ROW
      quit
    nTopRowPanels++

  ' get scroller initialized with text to scroll and direction
  scrollerID := display.scrollColoredTextOnLnOfNPanels(display.textLinesPerPanel() / SCROLL_LINE_DIVISOR, PANEL_P0, nTopRowPanels, string("Multi-panel long test scroll   "), display.DIR_TO_LEFT, color.cBlue)
  ' configure scroll repeat count
  display.configureScrollLoopCount(scrollerID, display.SCROLL_N_TIMES, SCROLL_REPEATS)

  ' update our screen
  display.commitScreenToPanelSet()

  ' loop while scrolling finishes
  repeat while display.isScrollingComplete() == FALSE
    ' move the text
    display.animateScroll()
    ' commit to screen
    display.commitScreenToPanelSet()

PRI demoPanelColors() | panelIndex, panelHueWidth, panelColor, boxColor, hueIndex
' Color each panel with a unique hue, label it, and draw a colored box inside.
'

' Local Variables:
' @local panelIndex - index of the panel being drawn
' @local panelHueWidth - hue step size per panel
' @local panelColor - RGB color for the panel background
' @local boxColor - RGB color for the box drawn inside the panel
' @local hueIndex - computed hue index for color selection

  panelHueWidth := colorUtils.DEGREES_PER_CIRCLE / hub75Bffrs.maxPanels(chainIndex)

  ' set up text subsystem
  display.setTextFont(display.TEXT_FONT_8x8A)           ' font size
  display.setTextColor(color.cBlueViolet)
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing

  ' start with blank screen on which to draw
  display.clearScreenBuffer()

  repeat panelIndex from 0 TO hub75Bffrs.maxPanels(chainIndex) - 1
    ' color the panel
    hueIndex := panelIndex + PANEL_HUE_OFFSET
    if hueIndex > hub75Bffrs.maxPanels(chainIndex) - 1
      hueIndex -= hub75Bffrs.maxPanels(chainIndex)
    panelColor := colorUtils.rgbColorFromDegrees(panelHueWidth * hueIndex)
    display.fillPanel(panelIndex, panelColor)
    ' number the panel
    display.setCursorOnPanel(ID_LINE, ID_COLUMN, panelIndex)
    BYTE [@panelIdMessage][1] := panelIndex + ASCII_ZERO
    display.setTextAtCursor(@panelIdMessage)
    ' draw a colored box in panel (don't use panel color)
    hueIndex := panelIndex + BOX_HUE_OFFSET
    if hueIndex > hub75Bffrs.maxPanels(chainIndex) - 1
      hueIndex -= hub75Bffrs.maxPanels(chainIndex)
    boxColor := colorUtils.rgbColorFromDegrees(panelHueWidth * hueIndex)
    display.drawPanelBoxOfColor(panelIndex, BOX_TOP_ROW, BOX_LEFT_COLUMN, BOX_WIDTH, BOX_HEIGHT, TRUE, boxColor)
  display.commitScreenToPanelSet()

CON ' ---- License ----

