CON ' ---- Color Constants ----
    {Spin2_Doc_CON}

    ' Named 24-bit $RRGGBB colors (HTML/X11 basic color set, plus two of our own)
    CBLACK        = $000000     ' all channels off
    CWHITE        = $FFFFFF     ' all channels full
    CRED          = $FF0000     ' red
    CLIME         = $00FF00     ' bright green ("lime")
    CBLUE         = $0000FF     ' blue
    CYELLOW       = $FFFF00     ' red + green
    CCYAN         = $00FFFF     ' green + blue
    CMAGENTA      = $FF00FF     ' red + blue
    CSILVER       = $C0C0C0     ' light gray
    CGRAY         = $808080     ' mid gray
    CMAROON       = $800000     ' dark red
    COLIVE        = $808000     ' dark yellow
    CGREEN        = $008000     ' dark green
    CPURPLE       = $800080     ' dark magenta
    CTEAL         = $008080     ' dark cyan
    CNAVY         = $000080     ' dark blue
    CDARKGREEN    = $006400     ' very dark green
    CORANGE       = $FFA500     ' orange
    CBLUEVIOLET   = $8A2BE2     ' blue-violet

    ' Full-intensity single-channel colors (the same values as CRED, CLIME and CBLUE)
    CFULLRED      = $FF0000     ' red channel at full
    CFULLGREEN    = $00FF00     ' green channel at full
    CFULLBLUE     = $0000FF     ' blue channel at full

    ' SPECIAL non-colors - invoke algorithm to generate actual color used
    CREDWHTBLU    = $DEADF0     ' marker for a red-white-blue pattern (no driver code interprets it yet)
    CRAINBOW      = $DEADF1     ' marker for a hue that follows the display column (screenUtils expands it)

    ' our 3-bit colors (one bit per RGB channel):
    '  BASE_BLACK   - $00 all channels off
    '  BASE_RED     - $01 red only
    '  BASE_GREEN   - $02 green only
    '  BASE_YELLOW  - $03 red + green
    '  BASE_BLUE    - $04 blue only
    '  BASE_MAGENTA - $05 red + blue
    '  BASE_CYAN    - $06 green + blue
    '  BASE_WHITE   - $07 all channels on
    BASE_BLACK    = $00
    BASE_RED      = $01
    BASE_GREEN    = $02
    BASE_YELLOW   = $03
    BASE_BLUE     = $04
    BASE_MAGENTA  = $05
    BASE_CYAN     = $06
    BASE_WHITE    = $07

PUB null()
'' This is not a top level object
''

