''
''   File....... demo_hub75_text.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 matrix text and scrolling features
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2024 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2020
''   Updated.... 08 Oct 2026
''
'' =================================================================================================

CON ' ---- Timing ----

    CLK_FREQ  = 335_000_000                                         ' system freq as a constant
    _CLKFREQ  = CLK_FREQ                                            ' set system clock

    DEBUG_BAUD  = 2_000_000

CON ' ---- Demo Constants ----

    ASCII_SPACE         = $20
    ASCII_ZERO          = $30                                       ' the character '0'
    DECIMAL_BASE        = 10
    HUNDRED             = 100                                       ' divisor for the hundreds digit of a frame count
    DELAY_SECONDS       = 4                                         ' pause between the static text and the scrolling text
    MS_PER_SECOND       = 1000
    MS_PER_100TH_SEC    = 10
    SCROLL_PERIOD       = 0                                         ' hundredths of a second between scroll steps (0 = no delay)
    FIRST_COLUMN        = 0                                         ' text lines start at the left edge
    LINE_0              = 0                                         ' text line numbers, counted from the top
    LINE_1              = 1
    LINE_2              = 2
    LINE_3              = 3

OBJ ' ---- Objects ----

    color           : "isp_hub75_color"
    hub75Bffrs      : "isp_hub75_hwBufferAccess"
    display         : "isp_hub75_display"

DAT ' ---- String Data ----

    pwmMsg      BYTE    "XXXfrm pwm",0
    bitMsg      BYTE    "-RGB "
    bitCt       BYTE    "nbit-",0

VAR ' ---- Per-instance State ----

    LONG    chainIndex

PUB main()
'' Run demo displaying text and graphics in various ways.
''

  chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)

  ' startup our backend COG(s): one call per adapter (aborts if no cog is free)
  display.start(display.HUB75_ADAPTER_1)

  demoText()

  waitSec(DELAY_SECONDS)

  demoScrollingText()

  repeat

PRI demoScrollingText() | scrollerID
' Display scrolling text demonstration on the LED matrix.
'

' Local Variables:
' @local scrollerID - ID of the active scroll region

  display.clearScreen()
  display.setTextFont(display.TEXT_FONT_5x7)            ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing
  ' show some static text on 64x32 display
  display.setColoredTextAtLnCol(LINE_0, FIRST_COLUMN, string("Iron Sheep"), color.cMaroon)
  display.setColoredTextAtLnCol(LINE_1, FIRST_COLUMN, string("ScrollDemo"), color.cOrange)
  ' show a region of scrolling text
  scrollerID := display.scrollColoredTextOnLn(LINE_2, string("First long text-123          "), display.DIR_TO_LEFT, color.cBlue)
  ' configure it for one time scroll then stop when last bit arrives on screen
  display.configureScrollLoopMode(scrollerID, display.SCROLL_ONCE_TO_CLEAR)

  scrollerID := display.scrollColoredTextOnLn(LINE_3, string("2nd shorter - "), display.DIR_TO_LEFT, color.cLime)
  ' configure it to scroll forever
  display.configureScrollLoopMode(scrollerID, display.SCROLL_FOREVER)

  ' update our screen
  display.commitScreenToPanelSet()

  ' now loop while scrolling finishes
  wait100thSecs(SCROLL_PERIOD)

  ' while scrolling not done...
  repeat while display.isScrollingComplete() == FALSE
    ' move the text
    display.animateScroll()
    ' commit to screen
    display.commitScreenToPanelSet()

    ' delay while we stare wide-eyed at the new...
    wait100thSecs(SCROLL_PERIOD)

PRI demoText() | frameCount
' Display static text and panel info on the LED matrix.
'

' Local Variables:
' @local frameCount - number of PWM frames for current color depth

  display.clearScreen()
  display.setTextFont(display.TEXT_FONT_5x7)            ' font size
  display.setCursor(0, 0)                               ' start at top left, with one pixel of spacing
  display.setColoredTextAtLnCol(LINE_0, FIRST_COLUMN, string("iron sheep"), color.cMaroon)

  frameCount := hub75Bffrs.pwmFrameCount(chainIndex)
  case hub75Bffrs.colorDepth(chainIndex)
    hub75Bffrs.DEPTH_3BIT:
      pwmMsg.BYTE[0] := ASCII_SPACE
      pwmMsg.BYTE[1] := ASCII_SPACE
      pwmMsg.BYTE[2] := ASCII_ZERO + frameCount
    hub75Bffrs.DEPTH_7BIT,hub75Bffrs.DEPTH_8BIT:
      pwmMsg.BYTE[0] := ASCII_ZERO + (frameCount / HUNDRED)
      pwmMsg.BYTE[1] := ASCII_ZERO + ((frameCount // HUNDRED) / DECIMAL_BASE)
      pwmMsg.BYTE[2] := ASCII_ZERO + ((frameCount // HUNDRED) // DECIMAL_BASE)
    other:
      pwmMsg.BYTE[0] := ASCII_SPACE
      pwmMsg.BYTE[1] := ASCII_ZERO + (frameCount / DECIMAL_BASE)
      pwmMsg.BYTE[2] := ASCII_ZERO + (frameCount // DECIMAL_BASE)
  bitCt.BYTE[0] := hub75Bffrs.colorDepth(chainIndex) + ASCII_ZERO

  display.setColoredTextAtLnCol(LINE_1, FIRST_COLUMN, @bitMsg, color.cOrange)
  display.setColoredTextAtLnCol(LINE_2, FIRST_COLUMN, @pwmMsg, color.cMagenta)
  display.setColoredTextAtLnCol(LINE_3, FIRST_COLUMN, string("led matrix"), color.cWhite)
  display.commitScreenToPanelSet()

PRI waitSec(countSeconds)
' Wait for the specified number of seconds.
'
' @param countSeconds - number of seconds to wait

  repeat countSeconds
    waitms(MS_PER_SECOND)

PRI wait100thSecs(hundredths)
' Wait for N hundredths of a second.
'
' @param hundredths - number of 1/100th second intervals to wait

  repeat hundredths
    waitms(MS_PER_100TH_SEC)

