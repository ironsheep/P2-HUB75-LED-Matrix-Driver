CON ' ---- Object Interface: PUBLIC ENUMs ----
    {Spin2_Doc_CON}

    ' scroller region index "not found":
    '  NOT_FOUND - no scroller region was placed (the scrollFace* calls return it when the
    '              display is not a cube)
    NOT_FOUND                 = -1

    ' supported Text Fonts (forwarded from fonts object for external consumers)
    TEXT_FONT_DEFAULT         = fonts.TEXT_FONT_DEFAULT
    TEXT_FONT_5X7             = fonts.TEXT_FONT_5X7
    TEXT_FONT_5X7_DITH        = fonts.TEXT_FONT_5X7_DITH
    TEXT_FONT_5X7_DITH_DCNDR  = fonts.TEXT_FONT_5X7_DITH_DCNDR
    TEXT_FONT_8X8A            = fonts.TEXT_FONT_8X8A
    TEXT_FONT_8X8B            = fonts.TEXT_FONT_8X8B

    ' scrolling direction (forwarded from scroller object; these start from 10 decimal):
    '  DIR_UNKNOWN  - direction not yet set
    '  DIR_TO_LEFT  - scroll text toward the left
    '  DIR_TO_RIGHT - scroll text toward the right
    '  DIR_DOWN     - scroll text downward
    '  DIR_UP       - scroll text upward
    DIR_UNKNOWN               = scroller.DIR_UNKNOWN
    DIR_TO_LEFT               = scroller.DIR_TO_LEFT
    DIR_TO_RIGHT              = scroller.DIR_TO_RIGHT
    DIR_DOWN                  = scroller.DIR_DOWN
    DIR_UP                    = scroller.DIR_UP

    ' scrolling duration (forwarded from scroller object):
    '  SCROLL_UNKNOWN       - duration mode not yet set
    '  SCROLL_FOREVER       - scroll continuously
    '  SCROLL_ONCE          - scroll one pass then stop
    '  SCROLL_ONCE_TO_CLEAR - scroll one pass to clear the region
    '  SCROLL_N_TIMES       - scroll a specified number of passes
    SCROLL_UNKNOWN            = scroller.SCROLL_UNKNOWN
    SCROLL_FOREVER            = scroller.SCROLL_FOREVER
    SCROLL_ONCE               = scroller.SCROLL_ONCE
    SCROLL_ONCE_TO_CLEAR      = scroller.SCROLL_ONCE_TO_CLEAR
    SCROLL_N_TIMES            = scroller.SCROLL_N_TIMES

    ' text alignment (these start from 0 decimal):
    '  ALIGN_UNKNOWN - alignment not specified
    '  ALIGN_RIGHT   - align text to the right edge
    '  ALIGN_CENTER  - center text within the field
    '  ALIGN_LEFT    - align text to the left edge
    #0, ALIGN_UNKNOWN, ALIGN_RIGHT, ALIGN_CENTER, ALIGN_LEFT

    ' cube faces, for face-centric drawing on a display with DISPn_SHAPE = SHAPE_CUBE
    ' (forwarded from hwEnum; face coordinates and each face's up are described there):
    '  FACE_TOP    - the face at DISPn_CUBE_TOP
    '  FACE_BOTTOM - the face opposite the top
    '  FACE_FRONT  - the face at DISPn_CUBE_FRONT
    '  FACE_BACK   - the face opposite the front
    '  FACE_LEFT   - the face on the viewer's left, standing at the front
    '  FACE_RIGHT  - the face on the viewer's right, standing at the front
    FACE_TOP                  = hwEnum.FACE_TOP
    FACE_BOTTOM               = hwEnum.FACE_BOTTOM
    FACE_FRONT                = hwEnum.FACE_FRONT
    FACE_BACK                 = hwEnum.FACE_BACK
    FACE_LEFT                 = hwEnum.FACE_LEFT
    FACE_RIGHT                = hwEnum.FACE_RIGHT

CON ' ---- Object Interface: PRIVATE ENUMs ----

    ' scroller regions that can be in use at once (a compile-time limit of this object)
    MAX_SCROLLING_REGIONS     = 4

OBJ ' ---- Objects Used by this Object ----

    hub75Bffrs                              : "isp_hub75_hwBufferAccess"
    cube                                    : "isp_hub75_cube"      ' the cube's faces, for face-centric drawing
    pixels                                  : "isp_hub75_screenUtils"
    panelSet                                : "isp_hub75_panel"
    fonts                                   : "isp_hub75_fonts"
    hwEnum                                  : "isp_hub75_hwEnums"   ' hub75 attachment, set up constants
    color                                   : "isp_hub75_color"
    colorUtils                              : "isp_hub75_colorUtils"
    scroller[MAX_SCROLLING_REGIONS]         : "isp_hub75_scrollingText"

VAR ' ---- Object Instance Variables ----
    LONG    instanceID
    LONG    chainIndex
    LONG    currTextColor
    LONG    cursorLine
    LONG    cursorColumn
    LONG    maxTextLines
    LONG    maxTextColumns
    LONG    maxDisplayRows
    LONG    maxDisplayColumns
    LONG    maxPanels
    LONG    cog

    ' the home transform of the face-centric object being drawn (see faceHomeOf())
    LONG    faceHomeTurn
    LONG    faceHomeAddRow
    LONG    faceHomeAddColumn

    WORD columnsPerPanel
    WORD rowsPerPanel

    BYTE    selectedTextFont
    BYTE    topOffsetInPix
    BYTE    leftOffsetInPix
    BYTE    charHeightInPix
    BYTE    charWidthInPix
    BYTE    horizontalGapInPix
    BYTE    verticalGapInPix
    BYTE    hBitmapOffsetInPix
    BYTE    maxPanelTextLines
    BYTE    maxPanelTextColumns
    BYTE    panelFixupOffetInPix

    ' booleans are LONGs: a BYTE would hold 255 for TRUE, which does not compare equal to TRUE (-1)
    LONG    bFontIsDithered
    LONG    bScan_1_4
    LONG    bSwapRB
    LONG    bSwapGB

    BYTE    padBuffer[MAX_PAD_BUFFER_BYTES]

CON ' ---- PRIVATE Constants ----

    ' the pad buffer holds a padded field and its terminating zero, so a field is at most
    ' MAX_PAD_FIELD_CHARS (29) characters
    MAX_PAD_BUFFER_BYTES  = 30
    MAX_PAD_FIELD_CHARS   = MAX_PAD_BUFFER_BYTES - 1

    DEFAULT_TEXT_COLOR    = $AAAAAA           ' light-grey default text color
    PAD_CHAR_SPACE        = $20               ' ASCII space used for field padding

    FONT_CELL_PADDING     = 1                 ' extra pix added to char cell (height/bitmap correction)

    HOME_LINE             = 0                 ' top-left cursor home line
    HOME_COLUMN           = 0                 ' top-left cursor home column

    CENTER_DIVISOR        = 2                 ' halve free space when centering text
    ROUND_HALF_BIAS       = 1                 ' +1 before the halving shift for round-to-nearest
    HALVE_SHIFT           = 1                 ' right-shift that halves the unused pixels

    MARGIN_SIDE_COUNT     = 2                 ' left+right (or top+bottom) margins

    MIN_PANEL_COUNT       = 1                 ' fewest panels a span may cover

    ' drawing-core mode: what the coordinates are, and what happens at an edge
    '  DRAW_WHOLE_DISPLAY - display coordinates (display-centric); end points held to the display
    '  DRAW_CLIP_TO_PANEL - display coordinates; only the target panel position's pixels are drawn (panel-centric: clip)
    '  DRAW_FOLD_ON_FACE  - face coordinates; the target is the object's home face (faceHomeOf()), and each pixel is carried into the home frame, then folds across the cube's edges (face-centric: fold)
    #0, DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL, DRAW_FOLD_ON_FACE
    DRAW_NO_TARGET        = 0                 ' the target of DRAW_WHOLE_DISPLAY, which has none

    FACE_TEXT_GAP_PIX     = 1                 ' blank pixels between characters of face-centric text

    ' the dithered-font pixel codec and its brightness are scroller.DITH_* and
    ' scroller.DITHER_BRIGHTNESS_PCT: the one definition lives in isp_hub75_scrollingText

    ' Bresenham line/circle integer coefficients (algorithm-inherent; named per FULL-STRICT)
    BRESENHAM_TWO         = 2                 ' 2*dy / 2*dx slope-error doubling
    CIRCLE_DECISION_INIT  = 3                 ' initial decision: 3 - 2*radius
    CIRCLE_DECISION_RADIUS_MUL = 2           ' radius multiplier in initial decision
    CIRCLE_DELTA_MUL      = 4                 ' 4*(column-row) / 4*column decision delta
    CIRCLE_DELTA_DIAG_ADD = 10               ' decision add when stepping diagonally
    CIRCLE_DELTA_AXIS_ADD = 6                ' decision add when stepping along axis

PUB null()
'' This is not a top level object.
''

PUB start(eHub75Adapter) : workerCog
'' Start one HUB75 adapter's display, in one call. This reads the adapter's settings and
'' buffers, checks its wiring sentences, and starts the underlying driver(s). Each adapter in
'' use gets its own display object instance. An adapter whose display has no panels
'' (every DISPn_C0 .. DISPn_C15 is NO_PANEL) stops startup with a message. Aborts (and so never
'' returns) when the adapter's settings or wiring sentences are refused, or when no cog is free
'' for the underlying driver.
''
'' @param eHub75Adapter - the adapter to start (HUB75_ADAPTER_1, HUB75_ADAPTER_2 or HUB75_ADAPTER_3; adapter k drives display DISPn with n = k-1)
'' @returns workerCog - cog ID + 1 (never 0) of the driver cog; aborts when no cog is free

  workerCog := startWithId(0, eHub75Adapter)

PUB startWithId(nId, eHub75Adapter) : workerCog | scrollerIndex, dvrConfig
'' Start one HUB75 adapter's display with a debug instance ID for multi-hub75 card configurations.
'' Same as start(), plus the debug instance identifier. Aborts (and so never returns) when the
'' adapter's settings or wiring sentences are refused, or when no cog is free for the
'' underlying driver.
''
'' @param nId - debug instance identifier
'' @param eHub75Adapter - the adapter to start (HUB75_ADAPTER_1, HUB75_ADAPTER_2 or HUB75_ADAPTER_3)
'' @returns workerCog - cog ID + 1 (never 0) of the driver cog; aborts when no cog is free

' Local Variables:
' @local scrollerIndex - loop index for scroller initialization
' @local dvrConfig - driver configuration flags

  chainIndex := hub75Bffrs.configureAdapter(eHub75Adapter)   ' settings, wiring check, buffer pointers
  colorUtils.buildColorTable(chainIndex)                 ' this adapter's color table, from its depth and the gamma setting
  instanceID := nId
  bytefill(@padBuffer, 0, MAX_PAD_BUFFER_BYTES)

  DEBUG("DSP: start() #", udec_(instanceID))
  ' panelSet.start() aborts when no cog is free, so a return here is always a started cog
  workerCog := cog := panelSet.start(instanceID, chainIndex)   ' send buffer to driver

  ' now that we know our chainIndex for this instance, we can record geometry info
  maxDisplayRows, maxDisplayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  maxPanels := hub75Bffrs.maxPanels(chainIndex)
  ' panel coordinates run over a panel as the viewer sees it (one cell of the display's grid)
  rowsPerPanel, columnsPerPanel := hub75Bffrs.cellSizeInPixels(chainIndex)

  debug("DSP: BFFR screen[", udec_long_(hub75Bffrs.displaySizeInLongs(chainIndex)), "] ", uhex_long_(hub75Bffrs.displayBufferAddress(chainIndex)))

  dvrConfig, _ := hub75Bffrs.getDriverFlags(chainIndex)          ' the chip type is not needed here
  bScan_1_4 := (dvrConfig & hwEnum.SCAN_4) <> 0
  bSwapRB := (dvrConfig & hwEnum.RB_SWAP) <> 0
  bSwapGB := (dvrConfig & hwEnum.GB_SWAP) <> 0

  ' configure our scrollers for first use
  repeat scrollerIndex from 0 TO MAX_SCROLLING_REGIONS - 1
    scroller[scrollerIndex].initialize(chainIndex)
  ' now set text font - which also tell scrollers!
  setTextFont(TEXT_FONT_DEFAULT)
  debug("DSP: display as mounted ", udec_(maxDisplayColumns), " x ", udec_(maxDisplayRows), " pixels (columns x rows), text grid ", udec_(maxTextColumns), " columns x ", udec_(maxTextLines), " lines")

  homeCursor()
  setTextColor(DEFAULT_TEXT_COLOR)
  clearScreen()

PUB stop()
'' Stop the underlying driver(s).
''

  if cog
    panelSet.stop()
    cog := 0

PUB clearScreen()
'' Clear the display to BLACK.
''

  hub75Bffrs.zeroFillBuffer(chainIndex)
  commitScreenToPanelSet()

PUB clearScreenBuffer()
'' Clear the screen buffer to BLACK without committing it to the display.
''

  hub75Bffrs.zeroFillBuffer(chainIndex)

PUB setBrightness(newBrightness)
'' Set the global brightness value (every adapter)
''  - where 256 is NO brightness adjustment
''  - where 0 is OFF, 205 = 80%, etc.
''  - brightness scales how long each row is lit (the /OE time), not the colour values
''  - the lit time never goes below the panel chip's shortest /OE pulse: low values give that
''    floor brightness rather than less (0 is still OFF)
''
'' @param newBrightness - the desired brightness value [0-255,256]

  panelSet.setBrightness(newBrightness)

PUB getBrightness() : brightness
'' Return the global brightness value
''
'' @returns brightness - the current brightness value [0-255,256]
''  - where 256 is NO brightness adjustment
''  - where 0 is OFF, 205 = 80%, etc.

  brightness := panelSet.getBrightness()

PUB fillScreen(rgbColor) | panelIndex
'' Fill the display with 24-bit color value. The display is filled panel by panel, so a
'' cell of the display's grid that holds no panel costs no time.
''
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local panelIndex - panel position being filled

  repeat maxPanels with panelIndex
    fillPanelPixels(panelIndex, rgbColor)

PUB fillPanel(panelIndex, rgbColor) | offsetPixelRows, offsetPixelColumns
'' Fill the specified panel with 24-bit color value. Panels are named by panel position as the
'' display is mounted: reading order from the top-left panel as the viewer sees it, over the
'' cells of the display's grid that hold a panel. At ROT_NONE this is the layout's order.
''   2x2 grid: [0][1]    3x3 grid: [0][1][2]
''             [2][3]              [3][4][5]
''                                 [6][7][8]
''
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local offsetPixelRows - display row of the panel's top-left pixel, as mounted
' @local offsetPixelColumns - display column of the panel's top-left pixel, as mounted

  offsetPixelRows, offsetPixelColumns := fillPanelPixels(panelIndex, rgbColor)
  debug("fillPanel(", udec_(panelIndex), ") ", udec_(columnsPerPanel), "x", udec_(rowsPerPanel), " @ row=", udec_(offsetPixelRows), " col=", udec_(offsetPixelColumns))

PUB fillScreenNoPWM(threeBitColor)
'' Fill screen without PWM conversion for testing the underlying driver.
''
'' @param threeBitColor - 3-bit color value (one bit per R, G, B)

  panelSet.fillScreenNoPWM(threeBitColor)

PUB commitScreenToPanelSet()
'' Write this display's screen buffer (its own adapter's buffer) to its panel driver PWM frames.
'' The commit converts into the PWM frame set that is not on display and posts it, so the image
'' on the panel never shows a half-converted screen. If the previous commit has not yet been
'' taken by the refresh driver (within one refresh), this waits for it first.
''

  if bScan_1_4 == TRUE
    panelSet.convertScreen2PWM_14(hub75Bffrs.displayBufferAddress(chainIndex), bSwapRB, bSwapGB)
  else
    panelSet.convertScreen2PWM(hub75Bffrs.displayBufferAddress(chainIndex), bSwapRB, bSwapGB)

PUB showFrameSet(pFrameSet) : accepted
'' Show a PWM frame set the caller has built, in place of a commit of the screen buffer. The
'' address must be one of this adapter's two PWM frame sets (hub75Bffrs.pwmFrame1BufferAddress()
'' or pwmFrame2BufferAddress() of this adapter), and the one to build into is the one that is
'' not on display; any other address, or NULL (0), prints a message naming this call and posts
'' nothing. If the previous post has not yet been taken by the refresh driver, this waits.
''
'' The frame set is exactly one PWM frame per colour bit, stored plane-major: plane 0 is the
'' most significant colour bit, then plane 1, and so on to plane DISPn_COLOR_DEPTH - 1. Within
'' a plane the bytes are row-major, one byte per column clock, in the order the panel is
'' shifted (each byte holds RGB1 in bits 0-2 and RGB2 in bits 3-5, %00BGRBGR). Its size in
'' bytes is hub75Bffrs.pwmFrameSizeInBytes() x hub75Bffrs.colorDepth() of this adapter, which
'' is also the size of each of the two sets.
''
'' @param pFrameSet - hub address of one of this adapter's two PWM frame sets, built by the caller
'' @returns accepted - TRUE if the set was posted, FALSE if the address was refused

  accepted := panelSet.showFrameSet(pFrameSet)

#IFDEF HUB75_INSTRUMENT
PUB commitTrace() : pConverted, pShownAtPost, pShownNow
'' Instrument build only: what the latest commit did, for the frame-set handshake trace.
''
'' @returns pConverted - the frame set the latest commit converted into
'' @returns pShownAtPost - the frame set on display when that conversion was done
'' @returns pShownNow - the frame set on display at this call

  pConverted, pShownAtPost, pShownNow := panelSet.commitTrace()

PUB commitTotals() : nCommits, nWaited, nBad, pFirstShown
'' Instrument build only: totals since start for the frame-set handshake trace.
''
'' @returns nCommits - commits posted
'' @returns nWaited - posts that waited for the previous post to be taken
'' @returns nBad - commits that converted into the frame set on display (must be 0)
'' @returns pFirstShown - the frame set on display when the first commit posted (0 at the first commit after start)

  nCommits, nWaited, nBad, pFirstShown := panelSet.commitTotals()

PUB refreshGeometry() | scrollerIndex
'' Instrument build only: read the display's size, panel count and panel size again, here and in
'' every scroller, after a self-test has replaced the adapter's layout (hub75Bffrs testRelayout())
'' or put it back (testRestoreLayout()). The text grid follows at the next setTextFont().
''

' Local Variables:
' @local scrollerIndex - scroller being told the display's width

  maxDisplayRows, maxDisplayColumns := hub75Bffrs.displaySizeInPixels(chainIndex)
  maxPanels := hub75Bffrs.maxPanels(chainIndex)
  rowsPerPanel, columnsPerPanel := hub75Bffrs.cellSizeInPixels(chainIndex)
  repeat scrollerIndex from 0 to MAX_SCROLLING_REGIONS - 1
    scroller[scrollerIndex].refreshGeometry()
#ENDIF

CON ' --------------     Text Handling     --------------

PUB setCursor(line, column)
'' Position the text cursor to row, column on the display. A line or column outside the
'' display is held to its nearest edge, without a message.
''
'' @param line - zero-based text line number
'' @param column - zero-based text column number

  cursorLine := 0 #> line <# maxTextLines - 1
  cursorColumn := 0 #> column <# maxTextColumns - 1
    ' debug("crsr: ln=", udec_(cursorLine), ", col=", udec_(cursorColumn))

PUB homeCursor()
'' Return the cursor to the top left corner of the display.
''

  setCursor(HOME_LINE, HOME_COLUMN)

PUB setCursorOnPanel(line, column, panelIndex) | boundedPanelIndex, boundedLine, boundedColumn, panelGridRow, panelGridCol, offsetPixelRows, offsetPixelColumns
'' Position the text cursor to line, column within the selected panel
'' Translates panel-local text coordinates to display-wide coordinates
'' Panels are named by panel position as the display is mounted: reading order from the
'' top-left panel as the viewer sees it. Lines and columns count as the viewer reads them.
''   2x2 grid: [0][1]    3x3 grid: [0][1][2]
''             [2][3]              [3][4][5]
''                                 [6][7][8]
''
'' @param line - zero-based text line number within the panel
'' @param column - zero-based text column number within the panel
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)

' Local Variables:
' @local boundedPanelIndex - panel position clamped to the panels in use
' @local boundedLine - line clamped to the panel's text lines
' @local boundedColumn - column clamped to the panel's text columns
' @local panelGridRow - grid row of the panel's cell
' @local panelGridCol - grid column of the panel's cell
' @local offsetPixelRows - display row of the panel's top-left pixel
' @local offsetPixelColumns - display column of the panel's top-left pixel

  boundedPanelIndex := 0 #> panelIndex <# maxPanels - 1
  boundedLine := 0 #> line <# maxPanelTextLines - 1
  boundedColumn := 0 #> column <# maxPanelTextColumns - 1

  ' the panel's cell in the display's grid, derived from the wiring sentences
  offsetPixelRows, offsetPixelColumns := hub75Bffrs.offsetToPanel(chainIndex, boundedPanelIndex)
  panelGridRow := offsetPixelRows / rowsPerPanel
  panelGridCol := offsetPixelColumns / columnsPerPanel

  ' Translate panel-local coordinates to display-wide text coordinates
  cursorLine := boundedLine + (panelGridRow * maxPanelTextLines)
  cursorColumn := boundedColumn + (panelGridCol * maxPanelTextColumns)

  ' Reset pixel fixup (no longer needed with proper 2D calculation)
  panelFixupOffetInPix := 0

PUB homeCursorOnPanel(panelIndex)
'' Return the cursor to the top left corner of the selected panel.
''
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)

  setCursorOnPanel(HOME_LINE, HOME_COLUMN, panelIndex)

PUB setTextFont(newFont) | scrollerIndex, hUnusedPix, vUnusedPix, heightCorrection, widthCorrection
'' Select the text font and recalculate the text grid size. Aborts (after a DEBUG message) when
'' newFont is not one of the supported fonts.
''
'' @param newFont - font identifier constant (TEXT_FONT_*)

' Local Variables:
' @local scrollerIndex - loop index for scroller configuration
' @local hUnusedPix - horizontal unused pixels after text grid layout
' @local vUnusedPix - vertical unused pixels after text grid layout
' @local heightCorrection - pixels added to the character cell height when counting text lines
' @local widthCorrection - pixels added to the character cell width when counting text columns

  ' currently we only support our 8x8 and 5x7 fonts
  panelFixupOffetInPix := 0
  heightCorrection := 0
  widthCorrection := 0
  hBitmapOffsetInPix := 0
  case newFont
    TEXT_FONT_DEFAULT..TEXT_FONT_5x7:
      heightCorrection := FONT_CELL_PADDING
      widthCorrection := FONT_CELL_PADDING
    TEXT_FONT_5x7_DITH:
      heightCorrection := FONT_CELL_PADDING
      widthCorrection := FONT_CELL_PADDING
    TEXT_FONT_5x7_DITH_DCNDR:
      heightCorrection := FONT_CELL_PADDING
      widthCorrection := FONT_CELL_PADDING
    TEXT_FONT_8x8A:
      hBitmapOffsetInPix := FONT_CELL_PADDING
    TEXT_FONT_8x8B:
    OTHER:
      debug("*ERROR* unknown text font*")
      abort

  selectedTextFont := newFont
  charWidthInPix, charHeightInPix := fonts.getGeometryOfFont(newFont)
  maxTextLines := (maxDisplayRows / (charHeightInPix + heightCorrection))
  maxTextColumns := (maxDisplayColumns / (charWidthInPix + widthCorrection))

  bFontIsDithered := fonts.isDitheredFont(newFont)

  vUnusedPix := maxDisplayRows - (maxTextLines * charHeightInPix)
  hUnusedPix := maxDisplayColumns - (maxTextColumns * charWidthInPix)
  verticalGapInPix := vUnusedPix / maxTextLines
  horizontalGapInPix := hUnusedPix / maxTextColumns
  vUnusedPix := maxDisplayRows - (maxTextLines * (charHeightInPix + verticalGapInPix))
  hUnusedPix := maxDisplayColumns - (maxTextColumns * (charWidthInPix + horizontalGapInPix))
  topOffsetInPix := (vUnusedPix + ROUND_HALF_BIAS) >> HALVE_SHIFT
  leftOffsetInPix := (hUnusedPix + ROUND_HALF_BIAS) >> HALVE_SHIFT

  maxPanelTextLines := ((rowsPerPanel - topOffsetInPix) / (charHeightInPix + verticalGapInPix))
  maxPanelTextColumns := ((columnsPerPanel - leftOffsetInPix) / (charWidthInPix + horizontalGapInPix))

  'debug("DSP: TEXT: ", udec(maxTextColumns), udec(maxTextLines))

  'debug("DSP: font ", udec(charHeightInPix), udec(charWidthInPix), udec(maxTextLines), udec(maxTextColumns), udec(verticalGapInPix), udec(horizontalGapInPix), udec(topOffsetInPix), udec(leftOffsetInPix))

  ' configure our scrollers for font choice
  repeat scrollerIndex from 0 to MAX_SCROLLING_REGIONS - 1
    scroller[scrollerIndex].setFontInfo(maxTextColumns, charWidthInPix, charHeightInPix, leftOffsetInPix, horizontalGapInPix, hBitmapOffsetInPix, selectedTextFont)

PUB numberTextLines() : nbrTextLines
'' Return the number of text rows for the currently selected font.
''
'' @returns nbrTextLines - number of text rows that fit on the display

  nbrTextLines := maxTextLines

PUB numberTextColumns() : nbrTextColumns
'' Return the number of text columns for the currently selected font.
''
'' @returns nbrTextColumns - number of text columns that fit on the display

  nbrTextColumns := maxTextColumns

PUB textLinesPerPanel() : nbrPanelTextLines
'' Return the number of text lines on one panel for the currently selected font, as the viewer
'' sees the panel with the display mounted. It is the line count setCursorOnPanel() counts over,
'' so it follows the font and, at 90 and 270 degrees, the panel's turned shape.
''
'' @returns nbrPanelTextLines - number of text lines that fit on one panel, as mounted

  nbrPanelTextLines := maxPanelTextLines

PUB textColumnsPerPanel() : nbrPanelTextColumns
'' Return the number of text columns on one panel for the currently selected font, as the viewer
'' sees the panel with the display mounted. It is the column count setCursorOnPanel() counts over.
''
'' @returns nbrPanelTextColumns - number of text columns that fit on one panel, as mounted

  nbrPanelTextColumns := maxPanelTextColumns

PUB setTextColor(rgbColor)
'' Set the 24-bit color for subsequent text display.
''
'' @param rgbColor - 24-bit RGB color value

  currTextColor := rgbColor

PUB setTextAtCursor(pZString)
'' Place zero-terminated text at the current cursor position using the current text color.
''
'' @param pZString - pointer to zero-terminated string

  setColoredTextAtLnCol(cursorLine, cursorColumn, pZString, currTextColor)

PUB setColoredTextAtLnCol(line, column, pZString, rgbColor) | charIndex
'' Place zero-terminated text at the specified line and column using the given color.
''
'' @param line - zero-based text line number
'' @param column - zero-based text column number
'' @param pZString - pointer to zero-terminated string
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local charIndex - index into the string being placed

  setCursor(line, column)
  charIndex := 0
  repeat
    if BYTE[pZString][charIndex] <> 0
      setColorCharAtCursor(BYTE[pZString][charIndex++], rgbColor)
  while BYTE[pZString][charIndex] <> 0

PUB centerColoredTextAtLn(line, pZString, rgbColor) | textLen, desiredCol
'' Center text on the specified line using the given color.
''
'' @param line - zero-based text line number
'' @param pZString - pointer to zero-terminated string
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local textLen - length of the string in characters
' @local desiredCol - calculated column for centering

  textLen := strsize(pZString)
  desiredCol := (numberTextColumns() - textLen) / CENTER_DIVISOR     ' half the free columns go on the left
  ' debug("DSP: cctal() ", udec(desiredCol), udec(textLen), zstr(pZString))
  setColoredTextAtLnCol(line, desiredCol, pZString, rgbColor)

PUB setColoredTextAtLnWithAlignPad(line, pZString, rgbColor, alignment, padLen) | offset, valLen, lineWidth, paddedStr, padOffset, fieldLen
'' Align and pad text on the specified line using the given color. The padded field is built in
'' a buffer of MAX_PAD_BUFFER_BYTES, so a field is at most 29 characters (MAX_PAD_FIELD_CHARS):
'' a larger padLen is held to 29, and a string longer than that is placed unpadded.
''
'' @param line - zero-based text line number
'' @param pZString - pointer to zero-terminated string
'' @param rgbColor - 24-bit RGB color value
'' @param alignment - text alignment (ALIGN_LEFT, ALIGN_CENTER, or ALIGN_RIGHT)
'' @param padLen - total padded field width in characters (held to MAX_PAD_FIELD_CHARS)

' Local Variables:
' @local offset - calculated column offset for alignment
' @local valLen - length of the input string
' @local lineWidth - total number of text columns on the display
' @local paddedStr - pointer to the padded output string
' @local padOffset - offset within pad buffer for string placement
' @local fieldLen - padLen held to the pad buffer's capacity

  fieldLen := padLen <# MAX_PAD_FIELD_CHARS
  paddedStr := pZString
  valLen := strsize(pZString)

  ' debug("sctalwap: ln=", udec_(line), " [", zstr_(pZString), "](", udec_(valLen), ") ", udec(alignment), udec(padLen))
  lineWidth := numberTextColumns()
  ' calc padded string offset
  case alignment
    ALIGN_RIGHT:
      ' pad on left
      offset := lineWidth - valLen
    ALIGN_CENTER:
      ' 1/2 of the free columns on left
      offset := (lineWidth - valLen) / CENTER_DIVISOR
    other:
      ' ALIGN_LEFT - pad on right
      offset := 0

  ' if we need to pad...
  if valLen < fieldLen
    bytefill(@padBuffer, 0, MAX_PAD_BUFFER_BYTES)
    case alignment
      ALIGN_RIGHT:
        ' pad on left
        padOffset := fieldLen - valLen
        bytefill(@padBuffer, PAD_CHAR_SPACE, padOffset)
      ALIGN_CENTER:
        ' 1/2 of the field's free space on left
        padOffset := (fieldLen - valLen) / CENTER_DIVISOR
        bytefill(@padBuffer, PAD_CHAR_SPACE, padOffset)
      other:
        ' ALIGN_LEFT - pad on right
        bytefill(@padBuffer, PAD_CHAR_SPACE, fieldLen)
        padOffset := 0
    bytemove(@BYTE[@padBuffer][padOffset], pZString, valLen)
    paddedStr := @padBuffer

  ' debug("               [", zstr_(paddedStr), "](", udec_(strsize(paddedStr)), ") col=", udec_(offset))
  if strsize(paddedStr) + offset > lineWidth
    DEBUG("DSP: ERROR2: off Edge! ", udec(offset), udec(fieldLen), udec(valLen), zstr(pZString))
  setColoredTextAtLnCol(line, offset, paddedStr, rgbColor)

PUB setCharAtCursor(cChar)
'' Write a character at the current cursor position using the current text color and advance the cursor with line wrap.
''
'' @param cChar - character to display

  setColorCharAtCursor(cChar, currTextColor)

PUB setColorCharAtCursor(cChar, rgbColor)
'' Write a character at the current cursor position with the given color and advance the cursor with line wrap.
''
'' @param cChar - character to display
'' @param rgbColor - 24-bit RGB color value

  setColoredCharAtLnCol(cursorLine, cursorColumn, cChar, rgbColor)
  incrCursorWithWrap()

PUB setCharAtLnCol(line, column, cChar)
'' Write a character to the display at the specified line and column using the current text color.
''
'' @param line - zero-based text line number
'' @param column - zero-based text column number
'' @param cChar - character to display

  setColoredCharAtLnCol(line, column, cChar, currTextColor)

PUB setColoredCharAtLnCol(line, column, cChar, rgbColor) | cLineIdx, cColumnIdx, sRowPixIdx, sColumnPixIdx
'' Write a character to the display at the specified line and column using the given color.
''
'' @param line - zero-based text line number
'' @param column - zero-based text column number
'' @param cChar - character to display
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local cLineIdx - bounded line index
' @local cColumnIdx - bounded column index
' @local sRowPixIdx - screen row in pixels
' @local sColumnPixIdx - screen column in pixels

' debug("DSP: setCharAtCursor @LnCol(", udec_(line), ",", udec_(column), "), char=", uhex_(cChar), ", RGB=", uhex_long_(rgbColor), udec(topOffsetInPix), udec(leftOffsetInPix))

  cLineIdx := 0 #> line <# maxTextLines - 1
  cColumnIdx :=  0 #> column <# maxTextColumns - 1
  ' NOTE: cursor is 0-relative so add in our top/left offset to get row/col and mult by char size in pix
  sRowPixIdx := topOffsetInPix + (cLineIdx * (charHeightInPix + verticalGapInPix))
  ' NOTE: panelFixupOffetInPix is only non-zero when we are placing text on specific panel!
  sColumnPixIdx := leftOffsetInPix + panelFixupOffetInPix + (cColumnIdx * (charWidthInPix + horizontalGapInPix))

  placeCharAtRC(cChar, sRowPixIdx, sColumnPixIdx, rgbColor, DRAW_WHOLE_DISPLAY, DRAW_NO_TARGET)

PUB drawFaceTextAtRC(eFace, row, column, pZString)
'' Draw text on a face of the cube using the current text color and font.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - pixel row of the top of the text on the face (may run past the face's edges)
'' @param column - pixel column of the left of the text on the face (may run past the face's edges)
'' @param pZString - pointer to zero-terminated string

  drawFaceTextAtRCOfColor(eFace, row, column, pZString, currTextColor)

PUB drawFaceTextAtRCOfColor(eFace, row, column, pZString, rgbColor) | textLen, charPitch, textWidth, eHomeFace, charIndex
'' Draw text on a face of the cube using rgbColor and the current font.
'' Uses face coordinates: every face is seen from outside the cube, row 0 at the face's up edge
'' and column 0 at its left edge, and the text reads left to right along the face's columns.
'' Characters are placed one character width plus FACE_TEXT_GAP_PIX apart. Each pixel of each
'' character is folded across the cube's edges like any face-centric pixel, so text that runs
'' past a face's edge continues on the neighbouring face. The text is drawn in the frame of the
'' face that holds its centre, so the seam at a corner it straddles falls on that corner's edge
'' farthest from the centre; any part in a corner gap is not drawn. On a display that is not a
'' cube, nothing is drawn.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - pixel row of the top of the text on the face
'' @param column - pixel column of the left of the text on the face
'' @param pZString - pointer to zero-terminated string
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local textLen - number of characters in the string
' @local charPitch - pixel columns from one character to the next
' @local textWidth - pixel columns the text spans
' @local eHomeFace - the face that holds the text's centre
' @local charIndex - index of the character being drawn

  textLen := strsize(pZString)
  if textLen > 0
    charPitch := charWidthInPix + FACE_TEXT_GAP_PIX
    textWidth := (textLen * charPitch) - FACE_TEXT_GAP_PIX
    eHomeFace := faceHomeOf(eFace, row, column, row + charHeightInPix - 1, column + textWidth - 1)
    if eHomeFace <> cube.NO_FACE
      repeat charIndex from 0 to textLen - 1
        placeCharAtRC(BYTE[pZString][charIndex], row, column + (charIndex * charPitch), rgbColor, DRAW_FOLD_ON_FACE, eHomeFace)

CON ' --------------     Scrolling Text     --------------
' EXAMPLES
'    configureScrollLoopMode(scrollerID, display.SCROLL_ONCE)
'    configureScrollLoopCount(scrollerID, display.SCROLL_N_TIMES, 2)

PUB configureScrollLoopMode(indexAllocated, loopMode)
'' Specify the scrolling text loop duration mode.
''
'' @param indexAllocated - scroller region index returned by a scroll method
'' @param loopMode - scrolling duration (SCROLL_FOREVER, SCROLL_ONCE, etc.)

' debug("DSP: configureScrollLoopMode() ", udec(indexAllocated))

  if indexAllocated >= 0 && indexAllocated < MAX_SCROLLING_REGIONS
    ' debug("DSP: idx=(", udec_(indexAllocated), ") ", udec(loopMode))
    scroller[indexAllocated].configureScrollLoopMode(loopMode)
  else
    DEBUG("DSP: ERROR no such scroller idx=(", udec_(indexAllocated), ")")

PUB configureScrollLoopCount(indexAllocated, loopMode, loopCount)
'' Specify the scrolling text loop duration mode with a repeat count.
''
'' @param indexAllocated - scroller region index returned by a scroll method
'' @param loopMode - scrolling duration (SCROLL_N_TIMES, etc.)
'' @param loopCount - number of times to repeat the scroll

' debug("DSP: configureScrollLoopCount() ", udec(indexAllocated))

  if indexAllocated >= 0 && indexAllocated < MAX_SCROLLING_REGIONS
    scroller[indexAllocated].configureScrollLoopCount(loopMode, loopCount)

PUB scrollTextOnLine(line, pZString, direction) : indexAllocated
'' Place scrolling text on the specified line using the current text color.
''
'' @param line - zero-based text line number
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @returns indexAllocated - scroller region index; aborts when every scroller region is in use

  indexAllocated := scrollColoredTextOnLn(line, pZString, direction, currTextColor)

PUB scrollColoredTextOnLn(line, pZString, direction, rgbColor) : indexAllocated  | cLineIdx, cColumnIdx, widthInChars, sRowPixIdx, sColumnPixIdx
'' Place scrolling text on the specified line using the given color.
''
'' @param line - zero-based text line number
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @param rgbColor - 24-bit RGB color value
'' @returns indexAllocated - scroller region index; aborts when every scroller region is in use

' Local Variables:
' @local cLineIdx - bounded line index
' @local cColumnIdx - starting column index
' @local widthInChars - width of scrolling region in characters
' @local sRowPixIdx - screen row in pixels
' @local sColumnPixIdx - screen column in pixels

'debug("DSP: scrollColoredTextOnLn()")
' ensure we are asked to use a good location

  cLineIdx := 0 #> line <# maxTextLines - 1
  cColumnIdx :=  0
  ' convert line info to row,col
  ' NOTE: cursor is 0-relative so add in our top/left offset to get row/col and mult by char size in pix
  widthInChars := maxTextColumns
  sRowPixIdx := topOffsetInPix + (cLineIdx * (charHeightInPix + verticalGapInPix))
  sColumnPixIdx := leftOffsetInPix + (cColumnIdx * (charWidthInPix + horizontalGapInPix))

  indexAllocated := scrollTextAtRCOfColor(sRowPixIdx, sColumnPixIdx, widthInChars, pZString, direction, rgbColor)
  DEBUG("DSP: new scroller ", udec(indexAllocated))

PUB scrollTextOnLnOfNPanels(line, panelIndex, panelCount, pZString, direction) : indexAllocated
'' Place scrolling text across multiple panels on the specified line using the current text color.
''
'' @param line - zero-based text line number
'' @param panelIndex - panel position of the starting panel (P0 is the top-left panel as mounted)
'' @param panelCount - number of panels to scroll across
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @returns indexAllocated - scroller region index; aborts when every scroller region is in use

  indexAllocated := scrollColoredTextOnLnOfNPanels(line, panelIndex, panelCount, pZString, direction, currTextColor)

PUB scrollColoredTextOnLnOfNPanels(line, panelIndex, panelCount, pZString, direction, rgbColor) : indexAllocated | cLineIdx, cColumnIdx, widthInChars, sRowPixIdx, sColumnPixIdx, boundedPanelIdx, cPanelCt, offsetPixelRows, offsetPixelColumns
'' Place scrolling text across multiple panels on the specified line using the given color.
''
'' @param line - zero-based text line number
'' @param panelIndex - panel position of the starting panel (P0 is the top-left panel as mounted)
'' @param panelCount - number of panels to scroll across
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @param rgbColor - 24-bit RGB color value
'' @returns indexAllocated - scroller region index; aborts when every scroller region is in use

' Local Variables:
' @local cLineIdx - bounded line index
' @local cColumnIdx - starting column index
' @local widthInChars - width of scrolling region in characters
' @local sRowPixIdx - screen row in pixels
' @local sColumnPixIdx - screen column in pixels
' @local boundedPanelIdx - panel index clamped to valid range
' @local cPanelCt - panel count clamped to valid range
' @local offsetPixelRows - pixel row offset to the target panel
' @local offsetPixelColumns - pixel column offset to the target panel

  'debug("DSP: scrollColoredTextOnLnOfNPanels()")
  boundedPanelIdx := 0 #> panelIndex <# maxPanels - 1
  cPanelCt := MIN_PANEL_COUNT #> panelCount <# maxPanels
  cLineIdx := 0 #> line <# maxTextLines - 1
  cColumnIdx :=  0
  widthInChars := ((cPanelCt * columnsPerPanel) - (MARGIN_SIDE_COUNT * leftOffsetInPix)) / (charWidthInPix + horizontalGapInPix)
  offsetPixelRows, offsetPixelColumns := hub75Bffrs.offsetToPanel(chainIndex, boundedPanelIdx)
  ' ensure we are asked to use a good location
  ' convert line info to row,col
  ' NOTE: cursor is 0-relative so add in our top/left offset to get row/col and mult by char size in pix
  sRowPixIdx := topOffsetInPix + (cLineIdx * (charHeightInPix + verticalGapInPix))
  sColumnPixIdx := offsetPixelColumns + leftOffsetInPix
  indexAllocated := scrollTextAtRCOfColor(sRowPixIdx, sColumnPixIdx, widthInChars, pZString, direction, rgbColor)

PUB scrollTextAtRC(row, column, widthInChars, pZString, direction) : indexAllocated
'' Place scrolling text at the specified pixel row and column using the current text color.
''
'' @param row - pixel row position
'' @param column - pixel column position
'' @param widthInChars - width of scrolling region in characters
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @returns indexAllocated - scroller region index; aborts when every scroller region is in use

  indexAllocated := scrollTextAtRCOfColor(row, column, widthInChars, pZString, direction, currTextColor)

PUB scrollTextAtRCOfColor(row, column, widthInChars, pZString, direction, rgbColor) : indexAllocated
'' Place scrolling text at the specified pixel row and column using the given color.
''
'' @param row - pixel row position
'' @param column - pixel column position
'' @param widthInChars - width of scrolling region in characters
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @param rgbColor - 24-bit RGB color value
'' @returns indexAllocated - scroller region index; aborts when every scroller region is in use

  indexAllocated := nextFreeScroller()
  ' debug("DSP: scrollTextAtRCOfColor() ", udec(indexAllocated))
  scroller[indexAllocated].scrollTextAtRCOfColor(row, column, widthInChars, pZString, direction, rgbColor)

PUB scrollFaceTextAtRC(eFace, row, column, widthInChars, pZString, direction) : indexAllocated
'' Place scrolling text on a face of the cube at the specified pixel row and column using the current text color.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - pixel row of the top of the scrolling region on the face
'' @param column - pixel column of the left of the scrolling region on the face
'' @param widthInChars - width of scrolling region in characters
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @returns indexAllocated - scroller region index or NOT_FOUND when the display is not a cube; aborts when every scroller region is in use

  indexAllocated := scrollFaceTextAtRCOfColor(eFace, row, column, widthInChars, pZString, direction, currTextColor)

PUB scrollFaceTextAtRCOfColor(eFace, row, column, widthInChars, pZString, direction, rgbColor) : indexAllocated | visibleChars, windowWidth, eHomeFace
'' Place scrolling text on a face of the cube at the specified pixel row and column using the given color.
'' Uses face coordinates, as drawFaceTextAtRCOfColor() does. The region stays where it is placed
'' on the face; each pixel of the scrolling text is folded across the cube's edges, so a region
'' that runs past a face's edge continues on the neighbouring face. The region is drawn in the
'' frame of the face that holds its centre, so the seam at a corner it straddles falls on that
'' corner's edge farthest from the centre. Animate it with animateScroll() like any scroller.
'' On a display that is not a cube, nothing is placed.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - pixel row of the top of the scrolling region on the face
'' @param column - pixel column of the left of the scrolling region on the face
'' @param widthInChars - width of scrolling region in characters
'' @param pZString - pointer to zero-terminated string
'' @param direction - scroll direction (DIR_TO_LEFT, DIR_TO_RIGHT, etc.)
'' @param rgbColor - 24-bit RGB color value
'' @returns indexAllocated - scroller region index or NOT_FOUND when the display is not a cube; aborts when every scroller region is in use

' Local Variables:
' @local visibleChars - characters the region shows at once, as the scroller limits them
' @local windowWidth - pixel columns the region spans
' @local eHomeFace - the face that holds the region's centre

  indexAllocated := NOT_FOUND
  visibleChars := 1 #> widthInChars <# maxTextColumns
  windowWidth := (visibleChars * (charWidthInPix + horizontalGapInPix)) - horizontalGapInPix
  eHomeFace := faceHomeOf(eFace, row, column, row + charHeightInPix - 1, column + windowWidth - 1)
  if eHomeFace <> cube.NO_FACE
    indexAllocated := nextFreeScroller()
    scroller[indexAllocated].scrollFaceTextAtRCOfColor(eHomeFace, faceHomeTurn, faceHomeAddRow, faceHomeAddColumn, row, column, widthInChars, pZString, direction, rgbColor)

PUB isScrollingComplete() : bComplete | scrollerIndex
'' Return TRUE if all scrolling text region movements are complete.
''
'' @returns bComplete - TRUE when all scrollers are idle or finished

' Local Variables:
' @local scrollerIndex - loop index for checking each scroller

  bComplete := TRUE
  ' if one or more scrollers are still moving we are not done!
  repeat scrollerIndex from 0 TO MAX_SCROLLING_REGIONS - 1
    ' is this scroller active?
    if scroller[scrollerIndex].isIdle() == FALSE
      ' is its scrolling complete?
      if scroller[scrollerIndex].isScrollingComplete() == FALSE
        bComplete := FALSE
        quit                                            ' outta here we have our answer

PUB animateScroll() | scrollerIndex
'' Perform one scroll animation step for all active scrolling regions.
''

' Local Variables:
' @local scrollerIndex - loop index for each scroller

  repeat scrollerIndex from 0 TO MAX_SCROLLING_REGIONS - 1
    if scroller[scrollerIndex].isIdle() == FALSE
      if scroller[scrollerIndex].isScrollingComplete() == FALSE
        scroller[scrollerIndex].animateScroll()

PUB releaseScroller(indexAllocated)
'' Mark the specified scroller region as no longer in use.
''
'' @param indexAllocated - scroller region index returned by a scroll method

  if indexAllocated >= 0 AND indexAllocated < MAX_SCROLLING_REGIONS
    ' make this once again available for reuse
    scroller[indexAllocated].release()

CON ' --------------     Basic Graphics     --------------

PUB drawBox(topRow, leftColumn, width, height, filled)
'' Draw box within the display outline/filled of width x height at R,C (using current text color)
''   - use preceding setTextColor() to set the outline color
''
'' @param topRow - row number of top left corner
'' @param leftColumn - column number of top left corner
'' @param width - width of box in pixels (including outline)
'' @param height - height of box in pixels
'' @param filled - T/F where T = filled with current text color

  drawBoxOfColor(topRow, leftColumn, width, height, filled, currTextColor)

PUB drawBoxOfColor(topRow, leftColumn, width, height, filled, rgbColor)
'' Draw box within the display outline/filled of width x height at R,C using rgbColor.
''
'' @param topRow - row number of top left corner
'' @param leftColumn - column number of top left corner
'' @param width - width of box in pixels (including outline)
'' @param height - height of box in pixels
'' @param filled - T/F where T = filled with rgbColor
'' @param rgbColor - the 24-bit color value to use for the box & fill

  drawBoxInternal(topRow, leftColumn, width, height, filled, rgbColor, DRAW_WHOLE_DISPLAY, DRAW_NO_TARGET)

PUB drawPanelBox(panelIndex, topRow, leftColumn, width, height, filled)
'' Draw a box in desired panel outline/filled of width x height at R,C (using current text color)
''   - use preceding setTextColor() to set the outline color
''
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)
'' @param topRow - row number of top left corner
'' @param leftColumn - column number of top left corner
'' @param width - width of box in pixels (including outline)
'' @param height - height of box in pixels
'' @param filled - T/F where T = filled with current text color

  drawPanelBoxOfColor(panelIndex, topRow, leftColumn, width, height, filled, currTextColor)

PUB drawPanelBoxOfColor(panelIndex, topRow, leftColumn, width, height, filled, rgbColor) | offsetPixelRows, offsetPixelColumns, panelPosn
'' Draw a box outline/filled in desired panel of width x height at R,C using rgbColor.
'' R,C are panel coordinates as the viewer sees the panel with the display mounted; the parts of the box that fall outside the panel are clipped,
'' never drawn on a neighbouring panel.
''
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)
'' @param topRow - row number of top left corner
'' @param leftColumn - column number of top left corner
'' @param width - width of box in pixels (including outline)
'' @param height - height of box in pixels
'' @param filled - T/F where T = filled with rgbColor
'' @param rgbColor - the 24-bit color value to use for the box & fill

' Local Variables:
' @local offsetPixelRows - pixel row offset to the target panel
' @local offsetPixelColumns - pixel column offset to the target panel
' @local panelPosn - panel position clamped to the panels in use

  panelPosn := 0 #> panelIndex <# maxPanels - 1
  offsetPixelRows, offsetPixelColumns := hub75Bffrs.offsetToPanel(chainIndex, panelPosn)
  ' panel coordinates + the panel's display offset = display coordinates, clipped to the panel
  drawBoxInternal(topRow + offsetPixelRows, leftColumn + offsetPixelColumns, width, height, filled, rgbColor, DRAW_CLIP_TO_PANEL, panelPosn)

PUB drawFaceBox(eFace, topRow, leftColumn, width, height, filled)
'' Draw a box on a face of the cube outline/filled of width x height at R,C (using current text color)
''   - use preceding setTextColor() to set the outline color
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param topRow - row number of top left corner on the face (may run past the face's edges)
'' @param leftColumn - column number of top left corner on the face (may run past the face's edges)
'' @param width - width of box in pixels (including outline)
'' @param height - height of box in pixels
'' @param filled - T/F where T = filled with current text color

  drawFaceBoxOfColor(eFace, topRow, leftColumn, width, height, filled, currTextColor)

PUB drawFaceBoxOfColor(eFace, topRow, leftColumn, width, height, filled, rgbColor) | eHomeFace
'' Draw a box on a face of the cube outline/filled of width x height at R,C using rgbColor.
'' Uses face coordinates: every face is seen from outside the cube, row 0 at the face's up edge
'' and column 0 at its left edge. The part of the box past the face's edges is not clipped: it
'' folds onto the neighbouring faces, across as many edges as it crosses. The box is drawn in the
'' frame of the face that holds its centre, so the seam at a corner it straddles falls on that
'' corner's edge farthest from the centre; any part in a corner gap (where a cube corner has no
'' surface) is not drawn. On a display that is not a cube, nothing is drawn.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param topRow - row number of top left corner on the face
'' @param leftColumn - column number of top left corner on the face
'' @param width - width of box in pixels (including outline)
'' @param height - height of box in pixels
'' @param filled - T/F where T = filled with rgbColor
'' @param rgbColor - the 24-bit color value to use for the box & fill

' Local Variables:
' @local eHomeFace - the face that holds the box's centre

  eHomeFace := faceHomeOf(eFace, topRow, leftColumn, topRow + height - 1, leftColumn + width - 1)
  if eHomeFace <> cube.NO_FACE
    drawBoxInternal(topRow, leftColumn, width, height, filled, rgbColor, DRAW_FOLD_ON_FACE, eHomeFace)

PUB drawLine(fmRow, fmColumn, toRow, toColumn)
'' Draw a line from one position to another using the current text color.
''
'' @param fmRow - starting pixel row
'' @param fmColumn - starting pixel column
'' @param toRow - ending pixel row
'' @param toColumn - ending pixel column

  drawLineOfColor(fmRow, fmColumn, toRow, toColumn, currTextColor)

PUB drawLineOfColor(fmRow, fmColumn, toRow, toColumn, rgbColor)
'' Draw line fromRC -> toRC using rgbColor
'' Uses display coordinates
''
'' @param fmRow - starting pixel row
'' @param fmColumn - starting pixel column
'' @param toRow - ending pixel row
'' @param toColumn - ending pixel column
'' @param rgbColor - 24-bit RGB color value

  drawLineInternal(fmRow, fmColumn, toRow, toColumn, rgbColor, DRAW_WHOLE_DISPLAY, DRAW_NO_TARGET)

PUB drawPanelLine(panelIndex, fmRow, fmColumn, toRow, toColumn)
'' Draw a line on the specified panel from one position to another using the current text color.
''
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)
'' @param fmRow - starting pixel row relative to the panel
'' @param fmColumn - starting pixel column relative to the panel
'' @param toRow - ending pixel row relative to the panel
'' @param toColumn - ending pixel column relative to the panel

  drawPanelLineOfColor(panelIndex, fmRow, fmColumn, toRow, toColumn, currTextColor)

PUB drawPanelLineOfColor(panelIndex, fmRow, fmColumn, toRow, toColumn, rgbColor) | desiredPanelIndex, offsetPixelRows, offsetPixelColumns
'' Draw line fromRC -> toRC using rgbColor within a specific panel
'' Uses panel coordinates as the viewer sees the panel with the display mounted: row 0 is the
'' panel's top, column 0 its left. The part of the line that falls outside the panel is clipped,
'' never drawn on a neighbouring panel.
''
'' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)
'' @param fmRow - starting pixel row relative to the panel
'' @param fmColumn - starting pixel column relative to the panel
'' @param toRow - ending pixel row relative to the panel
'' @param toColumn - ending pixel column relative to the panel
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local desiredPanelIndex - panel position clamped to the panels in use
' @local offsetPixelRows - pixel row offset to the target panel
' @local offsetPixelColumns - pixel column offset to the target panel

  desiredPanelIndex :=  0 #> panelIndex <# maxPanels - 1
  offsetPixelRows, offsetPixelColumns := hub75Bffrs.offsetToPanel(chainIndex, desiredPanelIndex)
  ' panel coordinates + the panel's display offset = display coordinates, clipped to the panel
  drawLineInternal(fmRow + offsetPixelRows, fmColumn + offsetPixelColumns, toRow + offsetPixelRows, toColumn + offsetPixelColumns, rgbColor, DRAW_CLIP_TO_PANEL, desiredPanelIndex)

PUB drawFaceLine(eFace, fmRow, fmColumn, toRow, toColumn)
'' Draw a line on a face of the cube from one position to another using the current text color.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param fmRow - starting pixel row on the face (may run past the face's edges)
'' @param fmColumn - starting pixel column on the face (may run past the face's edges)
'' @param toRow - ending pixel row on the face (may run past the face's edges)
'' @param toColumn - ending pixel column on the face (may run past the face's edges)

  drawFaceLineOfColor(eFace, fmRow, fmColumn, toRow, toColumn, currTextColor)

PUB drawFaceLineOfColor(eFace, fmRow, fmColumn, toRow, toColumn, rgbColor) | eHomeFace
'' Draw line fromRC -> toRC using rgbColor on a face of the cube (DISPn_SHAPE = SHAPE_CUBE).
'' Uses face coordinates: every face is seen from outside the cube, row 0 at the face's up edge
'' and column 0 at its left edge. The part of the line past the face's edges is not clipped: it
'' folds onto the neighbouring faces, across as many edges as it crosses. The line is drawn in
'' the frame of the face that holds its midpoint, so the seam at a corner it straddles falls on
'' that corner's edge farthest from the midpoint; any part in a corner gap (where a cube corner
'' has no surface) is not drawn. On a display that is not a cube, nothing is drawn.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param fmRow - starting pixel row on the face
'' @param fmColumn - starting pixel column on the face
'' @param toRow - ending pixel row on the face
'' @param toColumn - ending pixel column on the face
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local eHomeFace - the face that holds the line's midpoint

  eHomeFace := faceHomeOf(eFace, fmRow, fmColumn, toRow, toColumn)
  if eHomeFace <> cube.NO_FACE
    drawLineInternal(fmRow, fmColumn, toRow, toColumn, rgbColor, DRAW_FOLD_ON_FACE, eHomeFace)

PUB drawFacePixel(eFace, row, column)
'' Draw one pixel on a face of the cube using the current text color.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - pixel row on the face (may run past the face's edges)
'' @param column - pixel column on the face (may run past the face's edges)

  drawFacePixelOfColor(eFace, row, column, currTextColor)

PUB drawFacePixelOfColor(eFace, row, column, rgbColor) | eHomeFace
'' Draw one pixel on a face of the cube using rgbColor.
'' Uses face coordinates: every face is seen from outside the cube, row 0 at the face's up edge
'' and column 0 at its left edge. A pixel past the face's edges is not clipped: it folds onto the
'' neighbouring face, across as many edges as it crosses; a pixel in a corner gap (where a cube
'' corner has no surface) is not drawn. On a display that is not a cube, nothing is drawn.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - pixel row on the face
'' @param column - pixel column on the face
'' @param rgbColor - 24-bit RGB color value

' Local Variables:
' @local eHomeFace - the face the pixel is drawn from (the given face: one pixel has no seam to place)

  eHomeFace := faceFrameOf(eFace)
  if eHomeFace <> cube.NO_FACE
    drawPixelInternal(row, column, rgbColor, DRAW_FOLD_ON_FACE, eHomeFace)

PUB drawCircle(row, column, radius)
'' Draw circle centered at R,C of radius using current text color
''   - use preceding setTextColor() to set the outline color
''
'' @param row - row number of center-point
'' @param column - column number of center-point
'' @param radius - radius of circle

  drawCircleOfColor(row, column, radius, currTextColor)


PUB drawCircleOfColor(ctrRow, ctrColumn, radius, rgbColor)
'' Draw circle centered at R,C of radius using rgbColor
''
'' @param ctrRow - row number of center-point
'' @param ctrColumn - column number of center-point
'' @param radius - radius of circle
'' @param rgbColor - draw outline using this 24-bit color value

  drawCircleInternal(ctrRow, ctrColumn, radius, rgbColor, DRAW_WHOLE_DISPLAY, DRAW_NO_TARGET)

PUB drawFaceCircle(eFace, row, column, radius)
'' Draw circle on a face of the cube centered at R,C of radius using current text color
''   - use preceding setTextColor() to set the outline color
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param row - row number of center-point on the face (may run past the face's edges)
'' @param column - column number of center-point on the face (may run past the face's edges)
'' @param radius - radius of circle

  drawFaceCircleOfColor(eFace, row, column, radius, currTextColor)

PUB drawFaceCircleOfColor(eFace, ctrRow, ctrColumn, radius, rgbColor) | eHomeFace
'' Draw circle on a face of the cube centered at R,C of radius using rgbColor.
'' Uses face coordinates: every face is seen from outside the cube, row 0 at the face's up edge
'' and column 0 at its left edge. The part of the circle past the face's edges is not clipped: it
'' folds onto the neighbouring faces, across as many edges as it crosses. The circle is drawn in
'' the frame of the face that holds its centre, so the seam at a corner it straddles falls on
'' that corner's edge farthest from the centre; any part in a corner gap (where a cube corner has
'' no surface) is not drawn. On a display that is not a cube, nothing is drawn.
''
'' @param eFace - the face the coordinates are on (FACE_TOP, FACE_BOTTOM, FACE_FRONT, FACE_BACK, FACE_LEFT or FACE_RIGHT)
'' @param ctrRow - row number of center-point on the face
'' @param ctrColumn - column number of center-point on the face
'' @param radius - radius of circle
'' @param rgbColor - draw outline using this 24-bit color value

' Local Variables:
' @local eHomeFace - the face that holds the circle's centre

  eHomeFace := faceHomeOf(eFace, ctrRow, ctrColumn, ctrRow, ctrColumn)
  if eHomeFace <> cube.NO_FACE
    drawCircleInternal(ctrRow, ctrColumn, radius, rgbColor, DRAW_FOLD_ON_FACE, eHomeFace)


CON ' --------------     Private Methods     --------------

PRI placeCharAtRC(cChar, sRowPixIdx, sColumnPixIdx, rgbColor, eDrawMode, drawTarget) | pCharBitMap
' Render one character of the selected font to the screen buffer: display-centric text and
' face-centric text place their characters here, told whether the pixels clip or fold.
'
' @param cChar - character to display
' @param sRowPixIdx - row in pixels for top of character
' @param sColumnPixIdx - column in pixels for left of character
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, or the face (FACE_*) the coordinates are on

' Local Variables:
' @local pCharBitMap - pointer to the character bitmap data

  pCharBitMap := fonts.getCharAddrForFont(selectedTextFont, cChar)
  if bFontIsDithered == TRUE
    placeDitheredCharBitmap(pCharBitMap, sRowPixIdx, sColumnPixIdx, rgbColor, eDrawMode, drawTarget)
  else
    placeCharBitmap(pCharBitMap, sRowPixIdx, sColumnPixIdx, rgbColor, eDrawMode, drawTarget)

PRI placeCharBitmap(pCharBitMap, sRowPixIdx, sColumnPixIdx, rgbColor, eDrawMode, drawTarget) | cRowOffset, cRowBits, cColOffset, pixColor, cBitOffset, bRunRows, packedFg, packedBlack, runColors[pixels.GLYPH_RUN_PIXELS], bDrawnAsBlock
' Render a non-dithered character bitmap to the screen buffer. A display-centric glyph wholly inside
' one panel is one block (screenUtils copyGlyphBlock()); otherwise each glyph row is one run
' (screenUtils copyRowRun()), each pixel foreground or black; with cRainbow, or while the
' instrument build's self-test draws its reference, each pixel goes straight to the screen buffer.
' A face-centric pixel goes through the one drawing core, drawPixelInternal().
'
' @param pCharBitMap - pointer to the character bitmap data
' @param sRowPixIdx - screen row in pixels for top of character
' @param sColumnPixIdx - screen column in pixels for left of character
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, or the face (FACE_*) the coordinates are on

' Local Variables:
' @local cRowOffset - row offset within character bitmap
' @local cRowBits - bit pattern for current row of character
' @local cColOffset - column offset within character bitmap
' @local pixColor - resolved pixel color (foreground or black)
' @local cBitOffset - bit position within the row byte
' @local bRunRows - TRUE when each display-centric glyph row is drawn as one run
' @local packedFg - the foreground's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed
' @local bDrawnAsBlock - TRUE when the whole glyph was drawn as one block (screenUtils copyGlyphBlock())
' @local runColors - one glyph row's packed colors, one LONG per pixel

  bRunRows := eDrawMode == DRAW_WHOLE_DISPLAY and charWidthInPix <= pixels.GLYPH_RUN_PIXELS and pixels.isRunDrawable(rgbColor) == TRUE
  bDrawnAsBlock := FALSE
  if bRunRows == TRUE
    packedFg := pixels.packedColorOf(chainIndex, rgbColor)
    packedBlack := pixels.packedColorOf(chainIndex, color.CBLACK)
    ' the whole glyph as one block when it lies inside one cell, else row by row
    bDrawnAsBlock := pixels.copyGlyphBlock(chainIndex, sRowPixIdx, sColumnPixIdx, charHeightInPix, charWidthInPix, pCharBitMap, FALSE, charWidthInPix, 0, 0, packedFg, packedFg, packedBlack)
  if bDrawnAsBlock == FALSE
    repeat cRowOffset from 0 TO charHeightInPix - 1
      cRowBits := BYTE[pCharBitMap][cRowOffset]
      ' the mode is tested once per row, not per pixel: each variant's column loop holds only
      ' the one-line bit-to-color step and its own draw step
      if bRunRows == TRUE
        repeat cColOffset from 0 TO charWidthInPix - 1
          cBitOffset := (charWidthInPix - 1) - cColOffset
          runColors[cColOffset] := ((cRowBits & (1 << cBitOffset)) > 0) ? packedFg : packedBlack
        pixels.copyRowRun(chainIndex, sRowPixIdx + cRowOffset, sColumnPixIdx, charWidthInPix, @runColors)
      elseif eDrawMode == DRAW_WHOLE_DISPLAY
        repeat cColOffset from 0 TO charWidthInPix - 1
          cBitOffset := (charWidthInPix - 1) - cColOffset
          pixColor := ((cRowBits & (1 << cBitOffset)) > 0) ? rgbColor : color.CBLACK
          pixels.drawPixelAtRC(chainIndex, sRowPixIdx + cRowOffset, sColumnPixIdx + cColOffset, pixColor)
      else
        repeat cColOffset from 0 TO charWidthInPix - 1
          cBitOffset := (charWidthInPix - 1) - cColOffset
          pixColor := ((cRowBits & (1 << cBitOffset)) > 0) ? rgbColor : color.CBLACK
          drawPixelInternal(sRowPixIdx + cRowOffset, sColumnPixIdx + cColOffset, pixColor, eDrawMode, drawTarget)

PRI placeDitheredCharBitmap(pCharBitMap, sRowPixIdx, sColumnPixIdx, rgbColor, eDrawMode, drawTarget) | cRowOffset, cRowBits, cColOffset, ditheredRGBColor, cBitOffset, pixVal, pixColor, bRunRows, packedFg, packedHalf, packedBlack, runColors[pixels.GLYPH_RUN_PIXELS], bDrawnAsBlock
' Render a dithered character bitmap to the screen buffer using two brightness levels. A
' display-centric glyph wholly inside one panel is one block (screenUtils copyGlyphBlock());
' otherwise each glyph row is one run (screenUtils copyRowRun()), each pixel full, reduced or
' black; with cRainbow, or while the instrument build's self-test draws its reference, each pixel
' goes straight to the screen buffer. A face-centric pixel goes through the one drawing core,
' drawPixelInternal().
'
' @param pCharBitMap - pointer to the character bitmap data
' @param sRowPixIdx - screen row in pixels for top of character
' @param sColumnPixIdx - screen column in pixels for left of character
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, or the face (FACE_*) the coordinates are on

' Local Variables:
' @local cRowOffset - row offset within character bitmap
' @local cRowBits - word-sized bit pattern for current row
' @local cColOffset - column offset within character bitmap
' @local ditheredRGBColor - reduced brightness color for dithered pixels
' @local cBitOffset - bit position within the row word
' @local pixVal - 2-bit pixel value from the dithered font
' @local pixColor - resolved pixel color for this position
' @local bRunRows - TRUE when each display-centric glyph row is drawn as one run
' @local packedFg - the full-brightness color's corrected bytes, packed
' @local packedHalf - the reduced-brightness color's corrected bytes, packed
' @local packedBlack - black's corrected bytes, packed
' @local bDrawnAsBlock - TRUE when the whole glyph was drawn as one block (screenUtils copyGlyphBlock())
' @local runColors - one glyph row's packed colors, one LONG per pixel

  ditheredRGBColor := colorUtils.reducedBrightnessOfCValue(rgbColor, scroller.DITHER_BRIGHTNESS_PCT)  ' half-pixel brightness arg (36, not 50)
  ' debug(" COLOR PERCENT ", uhex_long_(rgbColor), " -> ", uhex_long_(ditheredRGBColor))
  bRunRows := eDrawMode == DRAW_WHOLE_DISPLAY and charWidthInPix <= pixels.GLYPH_RUN_PIXELS and pixels.isRunDrawable(rgbColor) == TRUE
  bDrawnAsBlock := FALSE
  if bRunRows == TRUE
    packedFg := pixels.packedColorOf(chainIndex, rgbColor)
    packedHalf := pixels.packedColorOf(chainIndex, ditheredRGBColor)
    packedBlack := pixels.packedColorOf(chainIndex, color.CBLACK)
    ' the whole glyph as one block when it lies inside one cell, else row by row
    bDrawnAsBlock := pixels.copyGlyphBlock(chainIndex, sRowPixIdx, sColumnPixIdx, charHeightInPix, charWidthInPix, pCharBitMap, TRUE, charWidthInPix, 0, 0, packedFg, packedHalf, packedBlack)
  if bDrawnAsBlock == FALSE
    repeat cRowOffset from 0 TO charHeightInPix - 1
      cRowBits := WORD[pCharBitMap][cRowOffset]                                   ' ms 12 bits are char def'n (of the 16bits)
      ' debug(" FONT row ", ubin_word_(cRowBits))
      ' the mode is tested once per row, not per pixel; the bit-to-color step is the same in every
      ' column loop (see placeCharBitmap())
      if bRunRows == TRUE
        repeat cColOffset from 0 TO charWidthInPix - 1
          cBitOffset := cColOffset * scroller.DITH_BITS_PER_PIX
          pixVal := ((cRowBits << cBitOffset) & scroller.DITH_PIX_MASK) >> scroller.DITH_PIX_TOP_SHIFT
          runColors[cColOffset] := packedFg
          if pixVal <> scroller.DITH_PIX_FULL
            runColors[cColOffset] := (pixVal == scroller.DITH_PIX_HALF) ? packedHalf : packedBlack  ' val == [2,0] = black
        pixels.copyRowRun(chainIndex, sRowPixIdx + cRowOffset, sColumnPixIdx, charWidthInPix, @runColors)
      elseif eDrawMode == DRAW_WHOLE_DISPLAY
        repeat cColOffset from 0 TO charWidthInPix - 1
          cBitOffset := cColOffset * scroller.DITH_BITS_PER_PIX
          pixVal := ((cRowBits << cBitOffset) & scroller.DITH_PIX_MASK) >> scroller.DITH_PIX_TOP_SHIFT
          pixColor := rgbColor
          if pixVal <> scroller.DITH_PIX_FULL
            pixColor := (pixVal == scroller.DITH_PIX_HALF) ? ditheredRGBColor : color.CBLACK  ' val == [2,0] = black
          pixels.drawPixelAtRC(chainIndex, sRowPixIdx + cRowOffset, sColumnPixIdx + cColOffset, pixColor)
      else
        repeat cColOffset from 0 TO charWidthInPix - 1
          cBitOffset := cColOffset * scroller.DITH_BITS_PER_PIX
          pixVal := ((cRowBits << cBitOffset) & scroller.DITH_PIX_MASK) >> scroller.DITH_PIX_TOP_SHIFT
          pixColor := rgbColor
          if pixVal <> scroller.DITH_PIX_FULL
            pixColor := (pixVal == scroller.DITH_PIX_HALF) ? ditheredRGBColor : color.CBLACK  ' val == [2,0] = black
          drawPixelInternal(sRowPixIdx + cRowOffset, sColumnPixIdx + cColOffset, pixColor, eDrawMode, drawTarget)

PRI incrCursorWithWrap()
' Increment the cursor position, wrapping at end of line and end of screen.
'

  cursorColumn++
  if cursorColumn > maxTextColumns - 1
    cursorColumn := 0
    cursorLine++
    if cursorLine > maxTextLines - 1
      cursorLine := 0
    ' debug("incr curPOS RC(", udec_(priorRow), ",", udec_(priorCol), ") -> RC(", udec_(cursorLine), ",", udec_(cursorColumn), ")")

PRI nextFreeScroller() : scrollerIndexToUse | scrollerIndex
' Find and return the index of the next available idle scroller region.
'
' @returns scrollerIndexToUse - index of the free scroller (aborts when every scroller region is in use)

' Local Variables:
' @local scrollerIndex - loop index for searching scrollers

  scrollerIndexToUse := NOT_FOUND
  repeat scrollerIndex from 0 TO MAX_SCROLLING_REGIONS - 1
    if scroller[scrollerIndex].isIdle()
      scrollerIndexToUse := scrollerIndex
      quit
  if scrollerIndexToUse == NOT_FOUND
    DEBUG("Failed to locate free scroller!")
    abort
    ' debug("DSP: nextFreeScroller() ", udec(scrollerIndexToUse))

PRI fillPanelPixels(panelIndex, rgbColor) : offsetPixelRows, offsetPixelColumns | layoutTopRow, layoutLeftColumn, layoutRows, layoutColumns
' Fill one panel with a 24-bit color value: every pixel of the panel's rectangle in the
' layout goes through the one mapping. The panel position is numbered as mounted, and the
' fill skips display rotation, so it fills the panel the viewer calls panelIndex at every rotation.
'
' @param panelIndex - panel position of the target panel (P0 is the top-left panel as mounted)
' @param rgbColor - 24-bit RGB color value
' @returns offsetPixelRows - display row of the panel's top-left pixel, as mounted
' @returns offsetPixelColumns - display column of the panel's top-left pixel, as mounted

' Local Variables:
' @local layoutTopRow - layout row of the panel's top-left pixel
' @local layoutLeftColumn - layout column of the panel's top-left pixel
' @local layoutRows - pixel rows of the panel in the layout
' @local layoutColumns - pixel columns of the panel in the layout

  offsetPixelRows, offsetPixelColumns := hub75Bffrs.offsetToPanel(chainIndex, panelIndex)
  if pixels.isRunDrawable(rgbColor) == TRUE
    ' one color: the panel is one cell of the mounted grid, filled as one block
    pixels.fillMountedArea(chainIndex, offsetPixelRows, offsetPixelColumns, rowsPerPanel, columnsPerPanel, pixels.packedColorOf(chainIndex, rgbColor))
  else
    ' cRainbow follows the layout column: the layout rectangle, pixel by pixel
    layoutTopRow, layoutLeftColumn, layoutRows, layoutColumns := hub75Bffrs.layoutAreaOfPanel(chainIndex, panelIndex)
    pixels.fillLayoutArea(chainIndex, layoutTopRow, layoutLeftColumn, layoutRows, layoutColumns, rgbColor)

PRI drawLineInternal(fmRow, fmColumn, toRow, toColumn, rgbColor, eDrawMode, drawTarget) | row, column
' Internal line drawing for display-centric, panel-centric and face-centric lines: the one line
' primitive, told whether its pixels clip or fold
'
' @param fmRow - starting pixel row
' @param fmColumn - starting pixel column
' @param toRow - ending pixel row
' @param toColumn - ending pixel column
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY (display coordinates, end points held to the display), DRAW_CLIP_TO_PANEL (display coordinates, clipped to one panel) or DRAW_FOLD_ON_FACE (face coordinates, folded across the cube's edges)
' @param drawTarget - DRAW_NO_TARGET, the panel position whose pixels alone are drawn, or the face (FACE_*) the coordinates are on

' Local Variables:
' @local row - pixel row loop index
' @local column - pixel column loop index

  if eDrawMode == DRAW_WHOLE_DISPLAY
    fmRow :=  0 #> fmRow <# maxDisplayRows - 1
    fmColumn :=  0 #> fmColumn <# maxDisplayColumns - 1
    toRow :=  0 #> toRow <# maxDisplayRows - 1
    toColumn :=  0 #> toColumn <# maxDisplayColumns - 1

  if fmRow == toRow
    ' draw Horizontal Line: one row run, unless its pixels must go one by one
    if isRunLine(rgbColor, eDrawMode) == TRUE
      drawLineRun(fmRow, fmColumn, toColumn, FALSE, rgbColor, eDrawMode, drawTarget)
    else
      repeat column from fmColumn to toColumn
        drawPixelInternal(fmRow, column, rgbColor, eDrawMode, drawTarget)
  elseif fmColumn == toColumn
    ' draw Vertical Line: one column run, unless its pixels must go one by one
    if isRunLine(rgbColor, eDrawMode) == TRUE
      drawLineRun(fmColumn, fmRow, toRow, TRUE, rgbColor, eDrawMode, drawTarget)
    else
      repeat row from fmRow to toRow
        drawPixelInternal(row, fmColumn, rgbColor, eDrawMode, drawTarget)
  else
    if abs(toRow - fmRow) < abs(toColumn - fmColumn)
      if fmColumn > toColumn
        plotLineLowInternal(toColumn, toRow, fmColumn, fmRow, rgbColor, eDrawMode, drawTarget)
      else
        plotLineLowInternal(fmColumn, fmRow, toColumn, toRow, rgbColor, eDrawMode, drawTarget)
    else
      if fmRow > toRow
        plotLineHighInternal(toColumn, toRow, fmColumn, fmRow, rgbColor, eDrawMode, drawTarget)
      else
        plotLineHighInternal(fmColumn, fmRow, toColumn, toRow, rgbColor, eDrawMode, drawTarget)


PRI isFastPlot(rgbColor, eDrawMode) : bFast
' Return TRUE when a shape drawn pixel by pixel (a sloped line, a circle) goes through one plot
' context in PASM (screenUtils plotPacked()): a display-centric shape in one color. cRainbow
' changes color along a row, panel-centric pixels are clipped and face-centric pixels fold, so
' those go through drawPixelInternal(); so does every shape while the instrument build's
' self-test draws its reference (screenUtils isRunDrawable()).
'
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL or DRAW_FOLD_ON_FACE
' @returns bFast - TRUE to plot through one context

  bFast := eDrawMode == DRAW_WHOLE_DISPLAY and pixels.isRunDrawable(rgbColor) == TRUE

PRI isRunLine(rgbColor, eDrawMode) : bRunLine
' Return TRUE when a horizontal or vertical line is drawn as one run: a display-centric or
' panel-centric line in one color. A face-centric line folds across the cube's edges pixel by
' pixel, and cRainbow changes color along a row, so those go pixel by pixel; so does every line
' while the instrument build's self-test draws its reference (screenUtils isRunDrawable()).
'
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @returns bRunLine - TRUE to draw the line with drawLineRun(), FALSE to draw it pixel by pixel

  bRunLine := eDrawMode <> DRAW_FOLD_ON_FACE and pixels.isRunDrawable(rgbColor) == TRUE

PRI drawLineRun(fixedIdx, fmIdx, toIdx, bColumn, rgbColor, eDrawMode, drawTarget) | firstIdx, lastIdx, bOnPanel, panelTopRow, panelLeftColumn, panelFixedFirst, panelFixedSize, panelAlongFirst, panelAlongSize
' Draw a display-centric or panel-centric horizontal (bColumn FALSE) or vertical (TRUE) line in
' one color as one run (screenUtils fillRowRun() or fillColumnRun()). It writes the same pixels
' drawPixelInternal() writes one by one: a display-centric line's end points are already held to
' the display, and the run is held as drawPixelAtRCwithRGB() holds each pixel; a panel-centric
' line is clipped here to its panel's rectangle (panel positions as mounted), worked out once per
' line, not once per pixel.
'
' @param fixedIdx - the line's row (horizontal) or column (vertical), display coordinates as mounted
' @param fmIdx - starting pixel column (horizontal) or row (vertical)
' @param toIdx - ending pixel column or row (either side of fmIdx)
' @param bColumn - TRUE for a vertical line, FALSE for a horizontal one
' @param rgbColor - 24-bit RGB color value (not cRainbow)
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_CLIP_TO_PANEL (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, or the panel position whose pixels alone are drawn

' Local Variables:
' @local firstIdx - first column (or row) of the run
' @local lastIdx - last column (or row) of the run
' @local bOnPanel - FALSE when a panel-centric line's row (or column) is outside its panel
' @local panelTopRow - display row of the target panel's top-left pixel, as mounted
' @local panelLeftColumn - display column of the target panel's top-left pixel, as mounted
' @local panelFixedFirst - the panel's first row (or column) across the line
' @local panelFixedSize - the panel's rows (or columns) across the line
' @local panelAlongFirst - the panel's first column (or row) along the line
' @local panelAlongSize - the panel's columns (or rows) along the line

  firstIdx := fmIdx <# toIdx
  lastIdx := fmIdx #> toIdx
  bOnPanel := TRUE
  if eDrawMode == DRAW_CLIP_TO_PANEL
    ' the panel's rectangle is its cell of the mounted grid: exactly the pixels whose
    ' positionAtDisplayPixel() is the target panel
    panelTopRow, panelLeftColumn := hub75Bffrs.offsetToPanel(chainIndex, drawTarget)
    if bColumn == TRUE
      panelFixedFirst, panelFixedSize, panelAlongFirst, panelAlongSize := panelLeftColumn, columnsPerPanel, panelTopRow, rowsPerPanel
    else
      panelFixedFirst, panelFixedSize, panelAlongFirst, panelAlongSize := panelTopRow, rowsPerPanel, panelLeftColumn, columnsPerPanel
    bOnPanel := fixedIdx >= panelFixedFirst and fixedIdx < panelFixedFirst + panelFixedSize
    firstIdx #>= panelAlongFirst
    lastIdx <#= panelAlongFirst + panelAlongSize - 1
  if bOnPanel == TRUE and firstIdx <= lastIdx
    if bColumn == TRUE
      pixels.fillColumnRun(chainIndex, fixedIdx, firstIdx, lastIdx - firstIdx + 1, pixels.packedColorOf(chainIndex, rgbColor))
    else
      pixels.fillRowRun(chainIndex, fixedIdx, firstIdx, lastIdx - firstIdx + 1, pixels.packedColorOf(chainIndex, rgbColor))

PRI plotLineLowInternal(fromColumn, fromRow, toColumn, toRow, rgbColor, eDrawMode, drawTarget) | row, column, dy, dx, decisionAccum, yi, bFast, packedColor, plotCtx[hub75Bffrs.PLOT_CONTEXT_LONGS]
' Bresenham line algorithm for shallow slopes
'
' @param fromColumn - starting pixel column
' @param fromRow - starting pixel row
' @param toColumn - ending pixel column
' @param toRow - ending pixel row
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, the panel position, or the face (see drawLineInternal())

' Local Variables:
' @local row - current pixel row
' @local column - current pixel column loop index
' @local dy - delta in row
' @local dx - delta in column
' @local decisionAccum - Bresenham decision accumulator
' @local yi - row step direction
' @local bFast - TRUE when the line's pixels go through one plot context (display-centric, one color)
' @local packedColor - the line color's corrected bytes, packed (bFast only)
' @local plotCtx - the plot context (bFast only)

  dx := toColumn - fromColumn
  dy := toRow - fromRow
  yi := 1
  if dy < 0
    yi := -1
    dy := -dy
  decisionAccum := (BRESENHAM_TWO * dy) - dx
  row := fromRow

  ' a display-centric line in one color: the context and the color once, each pixel in PASM
  bFast := isFastPlot(rgbColor, eDrawMode)
  if bFast == TRUE
    hub75Bffrs.plotContext(chainIndex, @plotCtx)
    packedColor := pixels.packedColorOf(chainIndex, rgbColor)
    hub75Bffrs.noteDrawn(chainIndex, fromRow, fromColumn, toRow, toColumn)   ' the line's bounding box, for the window watch
  repeat column from fromColumn to toColumn
    if bFast == TRUE
      pixels.plotPacked(@plotCtx, row, column, packedColor)
    else
      drawPixelInternal(row, column, rgbColor, eDrawMode, drawTarget)
    if decisionAccum > 0
      row := row + yi
      decisionAccum := decisionAccum +(BRESENHAM_TWO * (dy - dx))
    else
      decisionAccum := decisionAccum +BRESENHAM_TWO * dy

PRI plotLineHighInternal(fromColumn, fromRow, toColumn, toRow, rgbColor, eDrawMode, drawTarget) | row, column, dy, dx, decisionAccum, xi, bFast, packedColor, plotCtx[hub75Bffrs.PLOT_CONTEXT_LONGS]
' Bresenham line algorithm for steep slopes
'
' @param fromColumn - starting pixel column
' @param fromRow - starting pixel row
' @param toColumn - ending pixel column
' @param toRow - ending pixel row
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, the panel position, or the face (see drawLineInternal())

' Local Variables:
' @local row - current pixel row loop index
' @local column - current pixel column
' @local dy - delta in row
' @local dx - delta in column
' @local decisionAccum - Bresenham decision accumulator
' @local xi - column step direction
' @local bFast - TRUE when the line's pixels go through one plot context (display-centric, one color)
' @local packedColor - the line color's corrected bytes, packed (bFast only)
' @local plotCtx - the plot context (bFast only)

  dx := toColumn - fromColumn
  dy := toRow - fromRow
  xi := 1
  if dx < 0
    xi := -1
    dx := -dx
  decisionAccum := (BRESENHAM_TWO * dx) - dy
  column := fromColumn

  ' a display-centric line in one color: the context and the color once, each pixel in PASM
  bFast := isFastPlot(rgbColor, eDrawMode)
  if bFast == TRUE
    hub75Bffrs.plotContext(chainIndex, @plotCtx)
    packedColor := pixels.packedColorOf(chainIndex, rgbColor)
    hub75Bffrs.noteDrawn(chainIndex, fromRow, fromColumn, toRow, toColumn)   ' the line's bounding box, for the window watch
  repeat row from fromRow to toRow
    if bFast == TRUE
      pixels.plotPacked(@plotCtx, row, column, packedColor)
    else
      drawPixelInternal(row, column, rgbColor, eDrawMode, drawTarget)
    if decisionAccum > 0
      column := column + xi
      decisionAccum := decisionAccum +(BRESENHAM_TWO * (dx - dy))
    else
      decisionAccum := decisionAccum +BRESENHAM_TWO*dx

PRI drawPixelInternal(row, column, rgbColor, eDrawMode, drawTarget)
' Draw a single pixel. A display-centric pixel is at display coordinates as mounted. A
' panel-centric pixel is drawn only when it lies on its own panel (panel positions as mounted);
' a pixel past that panel's edge is clipped. A face-centric pixel is at face coordinates: it is
' folded across the cube's edges onto the face that holds it, never clipped, and a pixel in a
' corner gap is not drawn. Clip and fold are separate branches. The whole-display test comes
' first and costs one compare, because it is the common case on every flat display.
'
' @param row - pixel row position (display or face coordinates, by eDrawMode)
' @param column - pixel column position (display or face coordinates, by eDrawMode)
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, the panel position whose pixels alone are drawn, or the face (FACE_*) the coordinates are on

  if eDrawMode == DRAW_WHOLE_DISPLAY
    pixels.drawPixelAtRC(chainIndex, row, column, rgbColor)
  elseif eDrawMode == DRAW_CLIP_TO_PANEL
    if hub75Bffrs.positionAtDisplayPixel(chainIndex, row, column) == drawTarget
      pixels.drawPixelAtRC(chainIndex, row, column, rgbColor)
  else
    drawFoldedPixel(row, column, rgbColor, drawTarget)

PRI drawFoldedPixel(faceRow, faceColumn, rgbColor, eHomeFace) | displayRow, displayColumn
' Draw one face-centric pixel: carry it into its object's home frame (the home transform that
' faceHomeOf() left), fold it across the cube's edges onto the face that holds it and draw it
' there; a pixel in a corner gap is not drawn. Kept apart from drawPixelInternal() so flat
' pixels do not carry these locals. The cube answers with display coordinates only, no panel.
' The display coordinates it draws at are passed straight to drawPixelAtRC(), which applies
' display rotation; that is correct only because a cube's rotation is forced to ROT_NONE at
' startup (hub75Bffrs, ignoreCubeRotation). A rotated cube would need the rotation undone here.
'
' @param faceRow - pixel row in face coordinates (may run past the face's edges)
' @param faceColumn - pixel column in face coordinates (may run past the face's edges)
' @param rgbColor - 24-bit RGB color value
' @param eHomeFace - the face (FACE_*) the object is homed on

' Local Variables:
' @local displayRow - display row the pixel lands on, or NO_DISPLAY_PIXEL
' @local displayColumn - display column the pixel lands on

  displayRow, displayColumn := cube.homeFoldToDisplay(chainIndex, eHomeFace, faceHomeTurn, faceHomeAddRow, faceHomeAddColumn, faceRow, faceColumn)
  if displayRow <> cube.NO_DISPLAY_PIXEL
    pixels.drawPixelAtRC(chainIndex, displayRow, displayColumn, rgbColor)

PRI faceFrameOf(eFace) : eHomeFace
' Begin a face-centric object drawn in the frame of the face it is given: the home transform is
' the identity. A display that is not a cube has no faces: say so, and return NO_FACE.
'
' @param eFace - the face the object's coordinates are on (FACE_*)
' @returns eHomeFace - the face to draw from (eFace), or NO_FACE when the display is not a cube

  eHomeFace := eFace
  faceHomeTurn := cube.QTURN_NONE
  faceHomeAddRow := faceHomeAddColumn := 0
  if hub75Bffrs.displayShape(chainIndex) <> hwEnum.SHAPE_CUBE
    DEBUG("* Warning: face-centric drawing needs DISP", udec_(chainIndex), "_SHAPE = SHAPE_CUBE")
    eHomeFace := cube.NO_FACE

PRI faceHomeOf(eFace, firstRow, firstColumn, lastRow, lastColumn) : eHomeFace
' Home a face-centric object: the one place every face primitive finds where to draw. The home
' face is the face that holds the centre of the rectangle of pixels the object spans (a line's
' end points, a box's corners, a run of text, a circle's centre); the home transform from the
' given face's frame into the home frame is left in faceHomeTurn, faceHomeAddRow and
' faceHomeAddColumn, and drawFoldedPixel() applies it to every pixel of the object. Drawing in
' the home frame puts the one unavoidable seam of every corner the object straddles on that
' corner's edge farthest from the centre. A display that is not a cube has no faces: say so, and
' return NO_FACE.
'
' @param eFace - the face the object's coordinates are on (FACE_*)
' @param firstRow - first row of the object on that face (any value)
' @param firstColumn - first column of the object on that face (any value)
' @param lastRow - last row of the object on that face (any value)
' @param lastColumn - last column of the object on that face (any value)
' @returns eHomeFace - the face that holds the object's centre, or NO_FACE for an invalid face or a display that is not a cube

  eHomeFace := faceFrameOf(eFace)
  if eHomeFace <> cube.NO_FACE
    eHomeFace, faceHomeTurn, faceHomeAddRow, faceHomeAddColumn := cube.homeOnFaceOfExtent(chainIndex, eFace, firstRow, firstColumn, lastRow, lastColumn)

PRI drawBoxInternal(topRow, leftColumn, width, height, filled, rgbColor, eDrawMode, drawTarget) | rightColumn, bottomRow, rowIndex
' Internal box drawing for display-centric, panel-centric and face-centric boxes: the one box
' primitive, built from the one line primitive and told whether its pixels clip or fold.
'
' @param topRow - row number of top left corner
' @param leftColumn - column number of top left corner
' @param width - width of box in pixels (including outline)
' @param height - height of box in pixels
' @param filled - T/F where T = filled
' @param rgbColor - the 24-bit color value to use for the box & fill
' @param eDrawMode - DRAW_WHOLE_DISPLAY, DRAW_CLIP_TO_PANEL or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, the panel position, or the face (see drawLineInternal())

' Local Variables:
' @local rightColumn - column number of the right edge
' @local bottomRow - row number of the bottom edge
' @local rowIndex - row (or column) loop index when filling

  rightColumn := leftColumn + width - 1
  bottomRow := topRow + height - 1
  if filled == TRUE and width > 0 and height > 0 and isRunLine(rgbColor, eDrawMode) == TRUE
    ' one color, flat: the same pixels as row by row, as one rectangle (blocks per panel)
    fillBoxArea(topRow, leftColumn, bottomRow, rightColumn, rgbColor, eDrawMode, drawTarget)
  elseif filled == TRUE
    if width < height and width > 0 and isRunLine(rgbColor, eDrawMode) == TRUE
      ' narrower than tall: one column run per column, so a box one pixel wide is one run,
      ' not one run per pixel (the same pixels as row by row, in one color)
      repeat rowIndex from 0 to width - 1
        drawLineInternal(topRow, leftColumn + rowIndex, bottomRow, leftColumn + rowIndex, rgbColor, eDrawMode, drawTarget)    ' vert column
    else
      repeat rowIndex from 0 to height - 1
        drawLineInternal(topRow + rowIndex, leftColumn, topRow + rowIndex, rightColumn, rgbColor, eDrawMode, drawTarget)    ' horiz row
  else
    drawLineInternal(topRow, leftColumn, topRow, rightColumn, rgbColor, eDrawMode, drawTarget)          ' horiz top
    drawLineInternal(topRow, rightColumn, bottomRow, rightColumn, rgbColor, eDrawMode, drawTarget)      ' vert right
    drawLineInternal(bottomRow, leftColumn, bottomRow, rightColumn, rgbColor, eDrawMode, drawTarget)    ' horiz bottom
    drawLineInternal(topRow, leftColumn, bottomRow, leftColumn, rgbColor, eDrawMode, drawTarget)        ' vert left

PRI fillBoxArea(topRow, leftColumn, bottomRow, rightColumn, rgbColor, eDrawMode, drawTarget) | panelTopRow, panelLeftColumn
' Fill a display-centric or panel-centric box in one color as one rectangle (screenUtils
' fillMountedArea()). It writes the pixels the box's row runs write: a display-centric box's
' rows and columns are held to the display, so its rectangle is its corners held to the display;
' a panel-centric box's rows are clipped to its panel, so its rectangle is the box clipped to the
' panel's rectangle (positions as mounted), and nothing when they do not meet.
'
' @param topRow - top row of the box
' @param leftColumn - left column of the box
' @param bottomRow - bottom row of the box
' @param rightColumn - right column of the box
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_CLIP_TO_PANEL
' @param drawTarget - DRAW_NO_TARGET, or the panel position the box is clipped to

' Local Variables:
' @local panelTopRow - display row of the panel's top-left pixel, as mounted
' @local panelLeftColumn - display column of the panel's top-left pixel, as mounted

  if eDrawMode == DRAW_CLIP_TO_PANEL
    panelTopRow, panelLeftColumn := hub75Bffrs.offsetToPanel(chainIndex, drawTarget)
    topRow #>= panelTopRow
    leftColumn #>= panelLeftColumn
    bottomRow <#= panelTopRow + rowsPerPanel - 1
    rightColumn <#= panelLeftColumn + columnsPerPanel - 1
  else
    topRow := 0 #> topRow <# maxDisplayRows - 1
    leftColumn := 0 #> leftColumn <# maxDisplayColumns - 1
    bottomRow := 0 #> bottomRow <# maxDisplayRows - 1
    rightColumn := 0 #> rightColumn <# maxDisplayColumns - 1
  if topRow <= bottomRow and leftColumn <= rightColumn
    pixels.fillMountedArea(chainIndex, topRow, leftColumn, bottomRow - topRow + 1, rightColumn - leftColumn + 1, pixels.packedColorOf(chainIndex, rgbColor))

PRI drawCircleInternal(ctrRow, ctrColumn, radius, rgbColor, eDrawMode, drawTarget) | column, row, decision, bFast, packedColor, plotCtx[hub75Bffrs.PLOT_CONTEXT_LONGS]
' Internal circle drawing for display-centric and face-centric circles: the one circle primitive
' (Bresenham's algorithm), told whether its pixels go straight to the display or fold.
'
' @param ctrRow - row number of center-point
' @param ctrColumn - column number of center-point
' @param radius - radius of circle
' @param rgbColor - draw outline using this 24-bit color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, or the face (FACE_*) the coordinates are on

' Local Variables:
' @local column - current column offset from center
' @local row - current row offset from center
' @local decision - Bresenham circle decision accumulator
' @local bFast - TRUE when the circle's pixels go through one plot context (display-centric, one color)
' @local packedColor - the circle color's corrected bytes, packed (bFast only)
' @local plotCtx - the plot context (bFast only)

  ' a display-centric circle in one color: the context and the color once, each pixel in PASM
  bFast := isFastPlot(rgbColor, eDrawMode)
  if bFast == TRUE
    hub75Bffrs.plotContext(chainIndex, @plotCtx)
    packedColor := pixels.packedColorOf(chainIndex, rgbColor)
    hub75Bffrs.noteDrawn(chainIndex, ctrRow - radius, ctrColumn - radius, ctrRow + radius, ctrColumn + radius)   ' the circle's bounding box, for the window watch
  column := 0
  row := radius
  decision := CIRCLE_DECISION_INIT - CIRCLE_DECISION_RADIUS_MUL * radius
  drawCirclePoints(ctrRow, ctrColumn, row, column, rgbColor, eDrawMode, drawTarget, bFast, @plotCtx, packedColor)
  repeat while (row >= column)
    column++
    ' check for decision parameter
    ' and correspondingly
    ' update decision, column, row
    if (decision > 0)
      row--
      decision := decision + CIRCLE_DELTA_MUL * (column - row) + CIRCLE_DELTA_DIAG_ADD
    else
      decision := decision + CIRCLE_DELTA_MUL * column + CIRCLE_DELTA_AXIS_ADD
    drawCirclePoints(ctrRow, ctrColumn, row, column, rgbColor, eDrawMode, drawTarget, bFast, @plotCtx, packedColor)

PRI drawCirclePoints(ctrRow, ctrColumn, row, column, rgbColor, eDrawMode, drawTarget, bFast, pPlotCtx, packedColor)
' Draw the eight symmetric points of a circle for the given octant offsets. A display-centric
' circle in one color plots through its plot context in PASM (screenUtils plotPacked()); another
' display-centric pixel goes straight to the screen buffer; any other goes through the one drawing
' core, drawPixelInternal(). The mode is tested once per eight pixels.
'
' @param ctrRow - row number of center-point
' @param ctrColumn - column number of center-point
' @param row - row offset from center
' @param column - column offset from center
' @param rgbColor - 24-bit RGB color value
' @param eDrawMode - DRAW_WHOLE_DISPLAY or DRAW_FOLD_ON_FACE (see drawLineInternal())
' @param drawTarget - DRAW_NO_TARGET, or the face (FACE_*) the coordinates are on
' @param bFast - TRUE to plot through the plot context (isFastPlot())
' @param pPlotCtx - hub address of the circle's plot context (bFast only)
' @param packedColor - the circle color's corrected bytes, packed (bFast only)

  ' for each pixel we will
  ' draw all eight pixels
  ' NOTE: row/column here are offsets from center, not absolute coordinates
  '       The drawPixelAtRC signature is (chainIdx, row, column, color)
  if bFast == TRUE
    pixels.plotPacked(pPlotCtx, ctrRow+row, ctrColumn+column, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow+row, ctrColumn-column, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow-row, ctrColumn+column, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow-row, ctrColumn-column, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow+column, ctrColumn+row, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow+column, ctrColumn-row, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow-column, ctrColumn+row, packedColor)
    pixels.plotPacked(pPlotCtx, ctrRow-column, ctrColumn-row, packedColor)
  elseif eDrawMode == DRAW_WHOLE_DISPLAY
    pixels.drawPixelAtRC(chainIndex, ctrRow+row, ctrColumn+column, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow+row, ctrColumn-column, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow-row, ctrColumn+column, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow-row, ctrColumn-column, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow+column, ctrColumn+row, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow+column, ctrColumn-row, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow-column, ctrColumn+row, rgbColor)
    pixels.drawPixelAtRC(chainIndex, ctrRow-column, ctrColumn-row, rgbColor)
  else
    drawPixelInternal(ctrRow+row, ctrColumn+column, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow+row, ctrColumn-column, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow-row, ctrColumn+column, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow-row, ctrColumn-column, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow+column, ctrColumn+row, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow+column, ctrColumn-row, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow-column, ctrColumn+row, rgbColor, eDrawMode, drawTarget)
    drawPixelInternal(ctrRow-column, ctrColumn-row, rgbColor, eDrawMode, drawTarget)


