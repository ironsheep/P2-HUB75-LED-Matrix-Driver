'
'  Interface constants used to describe HUB75 panel connection and configuration

' -----------------
' User Setup Notes:
' -----------------
'   Nothing in this file needs editing to choose how many hub75 adapter boards are in use.  The descriptor
'   for each of the three adapter boards is always present, and each is filled from that adapter's
'   DISPn_ settings in isp_hub75_hwPanelConfig.spin2.

CON ' ---- Interface Constant Forwarding ----
    {Spin2_Doc_CON}

    ' this reduces include complexity for demo's
    HUB75_ADAPTER_1  = hwEnum.HUB75_ADAPTER_1
    HUB75_ADAPTER_2  = hwEnum.HUB75_ADAPTER_2
    HUB75_ADAPTER_3  = hwEnum.HUB75_ADAPTER_3

    DEPTH_3BIT       = hwEnum.DEPTH_3BIT
    DEPTH_4BIT       = hwEnum.DEPTH_4BIT
    DEPTH_5BIT       = hwEnum.DEPTH_5BIT
    DEPTH_6BIT       = hwEnum.DEPTH_6BIT
    DEPTH_7BIT       = hwEnum.DEPTH_7BIT
    DEPTH_8BIT       = hwEnum.DEPTH_8BIT

    ROT_NONE         = hwEnum.ROT_NONE
    ROT_LEFT_90      = hwEnum.ROT_LEFT_90
    ROT_RIGHT_90     = hwEnum.ROT_RIGHT_90
    ROT_180          = hwEnum.ROT_180
    ROT_270          = hwEnum.ROT_270

CON ' ---- Driver Limits ----
    {Spin2_Doc_CON}

    ' The hard limits on how many panels one adapter can drive. The startup check in
    ' configure() enforces them; the limits table in the wiring guide is computed
    ' from them.
    '
    ' The panel limit for a display is the smaller of:
    '   LINE_BUFFER_MAX_COLUMNS / (panel columns x column factor), where the column
    '     factor is SCAN_4_COLUMN_FACTOR for a panel whose chip flags include SCAN_4,
    '     and SINGLE_COLUMN_FACTOR otherwise; and
    '   CONVERTER_MAX_PANELS.
    ' Hub RAM is the third limit. The compiler enforces it: the buffers are DAT
    ' arrays sized from DISPn_PANEL_COUNT, so a display too large for hub RAM does
    ' not compile.

    ' cable positions a display can name: the wiring words C0 .. C15
    MAX_CABLE_POSITIONS     = 16

    ' panels the screen-to-PWM converter is built to handle on one adapter
    CONVERTER_MAX_PANELS    = 16

    ' the refresh core's line buffer (cogBuffer in isp_hub75_rgb3bit.spin2), in bytes.
    ' The refresh core sizes its buffer from this value. It shifts one byte per
    ' column clock, so one row along the cable must fit in this buffer.
    LINE_BUFFER_BYTES       = 512

    ' bytes the refresh core shifts per column clock (one byte carries RGB1 and RGB2)
    BYTES_PER_COLUMN_CLOCK  = 1

    ' the longest row along the cable that the line buffer holds, in columns
    LINE_BUFFER_MAX_COLUMNS = LINE_BUFFER_BYTES / BYTES_PER_COLUMN_CLOCK

    ' a panel that lights four rows at once (chip flags include SCAN_4) shifts twice
    ' its width for each row address; every other panel shifts its width once
    SCAN_4_COLUMN_FACTOR    = 2
    SINGLE_COLUMN_FACTOR    = 1

CON ' ---- Drawing Path Results ----
    {Spin2_Doc_CON}

    ' displayPixelAddress() result for a pixel that no panel holds (outside the display, or
    ' in a cell of the grid that holds no panel); no buffer is at hub address 0
    NO_PIXEL                = 0

    ' positionAtDisplayPixel() result for a pixel that no panel holds
    NO_PANEL_POSITION       = $FF

    ' face-pixel result (foldFacePixel(), homeOnFace()) for a pixel that no face holds: one in
    ' a corner gap, a face that is not one of hwEnum.FACE_TOP .. FACE_RIGHT, or a display that
    ' is not a cube
    NO_FACE                 = $FF

OBJ

    hwEnum      : "isp_hub75_hwEnums"                               ' hub75 attachment, set up constants
    user        : "isp_hub75_hwPanelConfig"                         ' user's panels configuration constants
    scrnBuffers : "isp_hub75_hwBuffers"                             ' the large buffers storing pixel data

DAT { Buffers and configuration values for each HUB75 adapter/chain of panels }

screenTableEnt0         ' The start of the 1st HUB75 chain descriptor table
    ' 1st HUB75 chain
'                    LONG    @hub75Buffer0, @pwmFrames0_1, @pwmFrames0_2
'-------+-----+---------+-------+---------------+-------+-----------------------+
        LONG    PLACEHOLDER_ADDRESS, PLACEHOLDER_ADDRESS, PLACEHOLDER_ADDRESS
        LONG    user.DISP0_COLOR_DEPTH, user.DISP0_BYTES_PER_COLOR
        LONG    user.DISP0_SCRN_SIZE_IN_LONGS, user.DISP0_PWM_FRAME_SIZE_IN_BYTES, user.DISP0_ROTATION
        LONG    user.DISP0_MAX_PANEL_COLUMNS, user.DISP0_MAX_PANEL_ROWS
        LONG    PLACEHOLDER_CHIP_TYPE, PLACEHOLDER_PIN_BASE, PLACEHOLDER_ADDR_LINES
screenTableEnt0End      ' The end of the 1st HUB75 chain descriptor table

screenTableEnt1         ' The start of the 2nd HUB75 adapter's descriptor (display DISP1)
'                    LONG    @hub75Buffer1, @pwmFrames1_1, @pwmFrames1_2
        LONG    PLACEHOLDER_ADDRESS, PLACEHOLDER_ADDRESS, PLACEHOLDER_ADDRESS
        LONG    user.DISP1_COLOR_DEPTH, user.DISP1_BYTES_PER_COLOR
        LONG    user.DISP1_SCRN_SIZE_IN_LONGS, user.DISP1_PWM_FRAME_SIZE_IN_BYTES, user.DISP1_ROTATION
        LONG    user.DISP1_MAX_PANEL_COLUMNS, user.DISP1_MAX_PANEL_ROWS
        LONG    PLACEHOLDER_CHIP_TYPE, PLACEHOLDER_PIN_BASE, PLACEHOLDER_ADDR_LINES

screenTableEnt2         ' The start of the 3rd HUB75 adapter's descriptor (display DISP2)
'                    LONG    @hub75Buffer2, @pwmFrames2_1, @pwmFrames2_2
        LONG    PLACEHOLDER_ADDRESS, PLACEHOLDER_ADDRESS, PLACEHOLDER_ADDRESS
        LONG    user.DISP2_COLOR_DEPTH, user.DISP2_BYTES_PER_COLOR
        LONG    user.DISP2_SCRN_SIZE_IN_LONGS, user.DISP2_PWM_FRAME_SIZE_IN_BYTES, user.DISP2_ROTATION
        LONG    user.DISP2_MAX_PANEL_COLUMNS, user.DISP2_MAX_PANEL_ROWS
        LONG    PLACEHOLDER_CHIP_TYPE, PLACEHOLDER_PIN_BASE, PLACEHOLDER_ADDR_LINES

screenTableEntEnd      ' The end of the all of the chain descriptor tables

screenTable             ' A table of addresses, pointers to each HUB75 chain descriptor table
                        LONG                    @screenTableEnt0
                        LONG                    @screenTableEnt1        ' 2nd HUB75 adapter board
                        LONG                    @screenTableEnt2        ' 3rd HUB75 adapter board
screenTableEnd          ' End of the pointers table

    entrySizeInBytes    LONG                    (@screenTableEnt0End - @screenTableEnt0)
    tableSizeInBytes    LONG                    (@screenTableEntEnd - @screenTableEnt0)
    numberScreens       LONG                    (@screenTableEnd - @screenTable) >> 2  ' this can't be compile-time initialized

    bFirstTime          LONG                    TRUE                                   ' for debug/testing use

CON { PRIVATE internal constants }

    NOT_INITIALIZED         = -1
    PLACEHOLDER_CHIP_TYPE   = 0
    PLACEHOLDER_PIN_BASE    = 0
    PLACEHOLDER_ADDR_LINES  = 0
    PLACEHOLDER_ADDRESS     = $0DF0ADDE

    ' PWM frame counts per color depth: (1 << depth) - 1
    PWM_FRAMES_3BIT         = 7
    PWM_FRAMES_4BIT         = 15
    PWM_FRAMES_5BIT         = 31
    PWM_FRAMES_6BIT         = 63
    PWM_FRAMES_7BIT         = 127
    PWM_FRAMES_8BIT         = 255

    ' number of leading buffer-address LONGs in a chain descriptor entry
    ENTR_ADDR_LONGS_COUNT   = 3

    ' chip-type field width within the combined driver-flags value
    CHIP_TYPE_MASK          = $ff

    ' debug memory-dump (dbgMemDump) row geometry and pacing delays
    DUMP_BYTES_PER_ROW      = 16
    DUMP_MAX_COL            = DUMP_BYTES_PER_ROW - 1
    DUMP_SINGLE_DIGIT_LIMIT = 10
    DUMP_HALF_ROW_IDX       = 7
    DUMP_HDR_DELAY_US       = 35
    DUMP_ROW_DELAY_US       = 85
    DUMP_END_DELAY_MS       = 2


    ' chain descriptor table entry offsets (LONG index within one table entry):
    '  ENTR_SCRN_BUFFER_ADDR_OFST   - screen buffer address
    '  ENTR_FRM1_BUFFER_ADDR_OFST   - PWM frame-set 1 buffer address
    '  ENTR_FRM2_BUFFER_ADDR_OFST   - PWM frame-set 2 buffer address
    '  ENTR_COLOR_DEPTH             - color depth in bits per channel
    '  ENTR_BYTES_PER_COLOR_OFST    - bytes per pixel color
    '  ENTR_SCRN_SIZE_IN_LONGS_OFST - screen buffer size in LONGs
    '  ENTR_FRM_SIZE_IN_BYTES_OFST  - PWM frame size in bytes
    '  ENTR_ROTATION_OFST           - display rotation enum
    '  ENTR_PANEL_COLUMNS_OFST      - pixel columns per panel (native)
    '  ENTR_PANEL_ROWS_OFST         - pixel rows per panel (native)
    '  ENTR_CHIP_TYPE_OFST          - LED driver chip type enum
    '  ENTR_HUB75_PIN_BASE_OFST     - base pin group enum
    '  ENTR_HPANEL_ADDR_LINES_OFST  - address line count enum
    ' The display's size and its grid of panels are not in the descriptor: they are
    ' derived from the wiring sentences at startup (layoutPixelRows and the tables below them).
    #0, ENTR_SCRN_BUFFER_ADDR_OFST, ENTR_FRM1_BUFFER_ADDR_OFST, ENTR_FRM2_BUFFER_ADDR_OFST, ...
    ENTR_COLOR_DEPTH, ENTR_BYTES_PER_COLOR_OFST, ...
    ENTR_SCRN_SIZE_IN_LONGS_OFST, ENTR_FRM_SIZE_IN_BYTES_OFST, ENTR_ROTATION_OFST, ...
    ENTR_PANEL_COLUMNS_OFST, ENTR_PANEL_ROWS_OFST, ...
    ENTR_CHIP_TYPE_OFST, ENTR_HUB75_PIN_BASE_OFST, ENTR_HPANEL_ADDR_LINES_OFST

PUB null()
'' Placeholder to prevent this object from being used as a top-level file.
''

PUB configureAdapter(eHub75Adapter) : nChainIdx | pEntry, ePinBase, eChipType, eAddrLines, bValidPins, pScrnBuffer, pPwmFrameSet1, pPwmFrameSet2, longsInEntry
'' Set up one HUB75 adapter for the display driver, in one call. Adapter k drives display
'' DISPn with n = k-1, so this reads that display's base pin, chip type and address lines from
'' isp_hub75_hwPanelConfig.spin2, checks its wiring sentences (DISPn_C0 .. DISPn_C15) and
'' derives its layout, then records the adapter's buffer pointers (from isp_hub75_hwBuffers.spin2).
'' Each wiring mistake prints one debug line naming the setting and the problem; after
'' the last message, startup stops (the program shuts down). An adapter whose DISPn_C0 .. C15
'' are all NO_PANEL has no panels and cannot be started.
'' The display object's start call makes this call; programs do not.
''
'' @param eHub75Adapter - the HUB75 adapter identifier (HUB75_ADAPTER_1, HUB75_ADAPTER_2 or HUB75_ADAPTER_3)
'' @returns nChainIdx - the zero-based index of this adapter's descriptor (0, 1, or 2)

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry
' @local ePinBase - the base pin group of this adapter's display
' @local eChipType - the LED driver chip type enum value of this adapter's display
' @local eAddrLines - the number of address lines enum value of this adapter's display
' @local bValidPins - TRUE if the pin group is valid for HUB75
' @local pScrnBuffer - address of screen Buffer (2-3 bytes per pixel)
' @local pPwmFrameSet1 - address of PWM Frame-Set 1
' @local pPwmFrameSet2 - address of PWM Frame-Set 2
' @local longsInEntry - number of LONGs in the chain descriptor tables

  nChainIdx := indexForHub75ChainId(eHub75Adapter)      ' 10, 20, 30 -> 0, 1, 2 (aborts on any other value)
  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  ePinBase := eChipType := eAddrLines := 0
  case eHub75Adapter                                    ' this adapter's display settings
    HUB75_ADAPTER_1:
      ePinBase := user.DISP0_ADAPTER_BASE_PIN
      eChipType := user.DISP0_PANEL_DRIVER_CHIP
      eAddrLines := user.DISP0_PANEL_ADDR_LINES
    HUB75_ADAPTER_2:
      ePinBase := user.DISP1_ADAPTER_BASE_PIN
      eChipType := user.DISP1_PANEL_DRIVER_CHIP
      eAddrLines := user.DISP1_PANEL_ADDR_LINES
    HUB75_ADAPTER_3:
      ePinBase := user.DISP2_ADAPTER_BASE_PIN
      eChipType := user.DISP2_PANEL_DRIVER_CHIP
      eAddrLines := user.DISP2_PANEL_ADDR_LINES
  bValidPins := TRUE
  case ePinBase
    hwEnum.PIN_GROUP_P0_P15:
    hwEnum.PIN_GROUP_P16_P31:
    hwEnum.PIN_GROUP_P32_P47:
    other:
      bValidPins := FALSE                               ' only the 3 valid 16-pin groups; P48_P63 overlaps the P2's reserved pins

  if NOT bValidPins
    DEBUG("HUB75: configureAdapter() Invalid PinBase/PinGroup specfied: [isp_hub75_hwBufferAccess.spin2] Aborted!")
    abort                                               ' we can't continue given this error
  else
    LONG[pEntry][ENTR_CHIP_TYPE_OFST] := eChipType
    LONG[pEntry][ENTR_HUB75_PIN_BASE_OFST] := ePinBase
    LONG[pEntry][ENTR_HPANEL_ADDR_LINES_OFST] := eAddrLines
    if bFirstTime
      'dbgMemDump(@"PTRs", @screenTable, numberScreens * 4)
      'dbgMemDump(@"Entry 0", @screenTableEnt0, entrySizeInBytes)
      bFirstTime := FALSE
    DEBUG("HUB75: configureAdapter() idx=", udec_(nChainIdx), udec(nChainIdx), udec(ePinBase), udec(eAddrLines))
    ' decode and check the wiring sentences, then derive the layout tables (stops on a mistake)
    checkAndDeriveLayout(nChainIdx)
    ' the adapter is in use: record the absolute-address of its buffers in HUB RAM
    pScrnBuffer, pPwmFrameSet1, pPwmFrameSet2 := scrnBuffers.adapterPtrs(eHub75Adapter)
    LONG[pEntry][ENTR_SCRN_BUFFER_ADDR_OFST] := pScrnBuffer
    LONG[pEntry][ENTR_FRM1_BUFFER_ADDR_OFST] := pPwmFrameSet1
    LONG[pEntry][ENTR_FRM2_BUFFER_ADDR_OFST] := pPwmFrameSet2
    DEBUG("HUB75: buffer pointers idx[", udec_(nChainIdx), "] ", uhex_long(pScrnBuffer, pPwmFrameSet1, pPwmFrameSet2))
    longsInEntry := tableSizeInBytes / 4
    DEBUG("HUB75: chain table size=", udec_(tableSizeInBytes), " entries [0-2]", uhex_long_array(@screenTableEnt0, ENTR_ADDR_LONGS_COUNT))
    DEBUG("HUB75: chain table values[3-13]: ", udec_long_array(@LONG[@screenTableEnt0][ENTR_ADDR_LONGS_COUNT], longsInEntry - ENTR_ADDR_LONGS_COUNT ))

PUB maxDisplayColumns(nChainIdx) : nMaxColumns
'' Return the number of pixels in a horizontal display row for the nChainIdx HUB75 adapter,
'' as the display is mounted: the width of displaySizeInPixels().
''
'' @param nChainIdx - the index of the desired chain
'' @returns nMaxColumns - the number of pixels horizontally in display, as mounted

  _, nMaxColumns := displaySizeInPixels(nChainIdx)

PUB maxDisplayRows(nChainIdx) : nMaxRows
'' Return the number of pixels in a display column for the specified HUB75 adapter, as the
'' display is mounted: the height of displaySizeInPixels().
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nMaxRows - total pixel rows across the full display, as mounted

  nMaxRows, _ := displaySizeInPixels(nChainIdx)

PUB displaySizeInPixels(nChainIdx) : nMaxRows, nMaxColumns | layoutIdx, eRotation
'' Return the number of pixels in a display row and column for the nChainIdx HUB75 adapter,
'' as the display is mounted: the size of the display's bounding box, derived from the wiring
'' sentences at startup. When the display rotation is 90 or 270 degrees, the width and height swap.
'' Display coordinates run over this size.
''
'' @param nChainIdx - the index of the desired chain
'' @returns nMaxRows - the number of pixels vertically in display, as mounted
'' @returns nMaxColumns - the number of pixels horizontally in display, as mounted

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local eRotation - the display rotation: how the display is mounted

  layoutIdx := validChainIndex(nChainIdx)
  eRotation := displayRotation(layoutIdx)
  nMaxRows := layoutPixelRows[layoutIdx]
  nMaxColumns := layoutPixelColumns[layoutIdx]
  if (eRotation == ROT_LEFT_90) OR (eRotation == ROT_RIGHT_90)
    nMaxRows := layoutPixelColumns[layoutIdx]
    nMaxColumns := layoutPixelRows[layoutIdx]

PUB layoutSizeAndRotation(nChainIdx) : nLayoutRows, nLayoutColumns, eDisplayRotation | layoutIdx, pEntry
'' Return the size of the display as its panels are laid out (the wiring's bounding box, before
'' display rotation) and the display rotation, in one call. displayPixelAddress() takes
'' coordinates over this size. It is the per-pixel read for isp_hub75_screenUtils, which runs it
'' for every pixel drawn; other drawing code uses displaySizeInPixels() (the size as mounted).
''
'' @param nChainIdx - the index of the desired chain
'' @returns nLayoutRows - the number of pixels vertically in the layout
'' @returns nLayoutColumns - the number of pixels horizontally in the layout
'' @returns eDisplayRotation - how the display is mounted (see displayRotation())

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local pEntry - pointer to the chain descriptor table entry

  layoutIdx := validChainIndex(nChainIdx)
  nLayoutRows := layoutPixelRows[layoutIdx]
  nLayoutColumns := layoutPixelColumns[layoutIdx]
  pEntry := @@LONG[@screenTable][layoutIdx]
  eDisplayRotation := LONG[pEntry][ENTR_ROTATION_OFST]

PUB displaySizeInPanels(nChainIdx) : nPanelsPerColumn, nPanelsPerRow | layoutIdx
'' Return the size of the display's grid of cells for the nChainIdx HUB75 adapter as its panels
'' are laid out (before display rotation, the geometry of the screen buffer), derived from the
'' wiring sentences at startup. A cell may hold no panel (an L shape, for example), so the grid
'' can have more cells than the display has panels; maxPanels() is the panel count. At 90 and
'' 270 degrees the display as mounted has these two numbers exchanged.
''
'' @param nChainIdx - the index of the desired chain
'' @returns nPanelsPerColumn - the number of cells vertically in the display's grid, as laid out
'' @returns nPanelsPerRow - the number of cells horizontally in the display's grid, as laid out

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist

  layoutIdx := validChainIndex(nChainIdx)
  nPanelsPerColumn := layoutGridRows[layoutIdx]
  nPanelsPerRow := layoutGridColumns[layoutIdx]

PUB cellSizeInPixels(nChainIdx) : nCellRows, nCellColumns | layoutIdx
'' Return the size of one panel as the viewer sees it, in pixels, with the display as mounted:
'' the size of one cell of the display's grid as mounted. Panel coordinates run over this size.
'' It is the panel's own size, with rows and columns exchanged when the panels are turned
'' sideways (C0's arrow is ARROW_LEFT or ARROW_RIGHT), and exchanged again when the display
'' is mounted at 90 or 270 degrees.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nCellRows - pixel rows of one panel, as the viewer sees it with the display as mounted
'' @returns nCellColumns - pixel columns of one panel, as the viewer sees it with the display as mounted

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist

  layoutIdx := validChainIndex(nChainIdx)
  nCellRows := mountedCellRows[layoutIdx]
  nCellColumns := mountedCellColumns[layoutIdx]

PUB colorDepth(nChainIdx) : nDepthInBits | pEntry
'' Return the number of bits for a color (red, green, or blue) [3-8 bits] for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nDepthInBits - color depth in bits per color channel

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nDepthInBits := LONG[pEntry][ENTR_COLOR_DEPTH]

PUB bytesPerColor(nChainIdx) : nBytes | pEntry
'' Return the number of bytes needed to store a pixel color (r+g+b) for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nBytes - bytes per pixel color value

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nBytes := LONG[pEntry][ENTR_BYTES_PER_COLOR_OFST]

PUB displaySizeInLongs(nChainIdx) : nLongs | pEntry
'' Return the number of LONGs needed to store an entire display image for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nLongs - display buffer size in LONGs

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nLongs := LONG[pEntry][ENTR_SCRN_SIZE_IN_LONGS_OFST]

PUB pwmFrameSizeInBytes(nChainIdx) : nBytes | pEntry
'' Return the number of bytes needed to store a single PWM frame for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nBytes - PWM frame size in bytes

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nBytes := LONG[pEntry][ENTR_FRM_SIZE_IN_BYTES_OFST]

PUB pwmFrameSizeInLongs(nChainIdx) : nLongs | nBytes
'' Return the number of LONGs needed to store a single PWM frame for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nLongs - PWM frame size in LONGs

' Local Variables:
' @local nBytes - intermediate byte count from pwmFrameSizeInBytes

  nBytes := pwmFrameSizeInBytes(nChainIdx)              ' count of bytes
  nLongs := (nBytes + 3) / 4

PUB displayRotation(nChainIdx) : eDisplayRotation | pEntry
'' Return the display rotation of the specified HUB75 adapter: how the whole assembled display
'' is mounted (DISPn_ROTATION). ROT_RIGHT_90 means the display hangs turned 90 degrees
'' clockwise, so content is drawn with its top along the layout's left edge and reads upright
'' once mounted. It is not a panel rotation; each panel's own rotation comes from its wiring
'' sentence.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns eDisplayRotation - rotation enum value (ROT_NONE, ROT_LEFT_90, ROT_RIGHT_90 or ROT_180)

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  eDisplayRotation := LONG[pEntry][ENTR_ROTATION_OFST]

PUB columnsPerPanel(nChainIdx) : nPanelColumns | pEntry
'' Return the number of pixels in a single panel row for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nPanelColumns - pixel columns per individual panel

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nPanelColumns := LONG[pEntry][ENTR_PANEL_COLUMNS_OFST]

PUB rowsPerPanel(nChainIdx) : nPanelRows | pEntry
'' Return the number of pixels in a single panel column for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nPanelRows - pixel rows per individual panel

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nPanelRows := LONG[pEntry][ENTR_PANEL_ROWS_OFST]

PUB panelSizeInPixels(nChainIdx) : nPanelRows, nPanelColumns | pEntry
'' Return the number of pixels in a single panel row of pixels for the nChainIdx HUB75 adapter
''
'' @param nChainIdx - the index of the desired chain
'' @returns nPanelRows - pixel rows per individual panel
'' @returns nPanelColumns - pixel columns per individual panel

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nPanelColumns := LONG[pEntry][ENTR_PANEL_COLUMNS_OFST]
  nPanelRows := LONG[pEntry][ENTR_PANEL_ROWS_OFST]

PUB displayBufferAddress(nChainIdx) : pDisplayBuffer | pEntry
'' Return the address of the display memory buffer for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns pDisplayBuffer - hub address of the screen pixel buffer

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  pDisplayBuffer := LONG[pEntry][ENTR_SCRN_BUFFER_ADDR_OFST]

PUB pwmFrame1BufferAddress(nChainIdx) : pPwmFrm1Buffer | pEntry
'' Return the address of the 1st PWM Frame buffer for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns pPwmFrm1Buffer - hub address of PWM frame-set 1 buffer

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  pPwmFrm1Buffer := LONG[pEntry][ENTR_FRM1_BUFFER_ADDR_OFST]

PUB pwmFrame2BufferAddress(nChainIdx) : pPwmFrm2Buffer | pEntry
'' Return the address of the 2nd PWM Frame buffer for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns pPwmFrm2Buffer - hub address of PWM frame-set 2 buffer

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  pPwmFrm2Buffer := LONG[pEntry][ENTR_FRM2_BUFFER_ADDR_OFST]

PUB chipType(nChainIdx) : nChipType | pEntry
'' Return the chip-type for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nChipType - LED driver chip type enum value

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nChipType := LONG[pEntry][ENTR_CHIP_TYPE_OFST]

PUB pinBase(nChainIdx) : nPinBase | pEntry
'' Return the base pin for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nPinBase - base pin group enum value

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nPinBase := LONG[pEntry][ENTR_HUB75_PIN_BASE_OFST]

PUB addressLines(nChainIdx) : nAddrLines | pEntry
'' Return the number of HUB75 address lines for the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nAddrLines - address line count enum value (ABC, ABCD, ABCDE)

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

  pEntry := ptrTableEntry(nChainIdx)                    ' get ptr to table entry
  nAddrLines := LONG[pEntry][ENTR_HPANEL_ADDR_LINES_OFST]

PUB maxPanels(nChainIdx) : nMaxPanels
'' Return the total number of panels connected to the nChainIdx HUB75 adapter: the cable
'' positions in use in its wiring sentences. Panel positions run from 0 to this count - 1.
''
'' @param nChainIdx - the index of the desired chain
'' @returns nMaxPanels - total number of panels connected to the nChainIdx HUB75 adapter

  nMaxPanels := layoutPanelCount[validChainIndex(nChainIdx)]

PUB zeroFillBuffer(nChainIdx) | pBffr, nBffrLen
'' Zero fill the display buffer associated with the specified HUB75 adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)

' Local Variables:
' @local pBffr - pointer to the display buffer
' @local nBffrLen - buffer length in LONGs

  nBffrLen := displaySizeInLongs(nChainIdx)
  pBffr := displayBufferAddress(nChainIdx)
  longfill(pBffr, 0, nBffrLen)

PUB indexForHub75ChainId(eHub75Chain) : nChainIdx | bValidChain
'' Return the zero-based index into our table for a given HUB75 adapter identifier.
''
'' @param eHub75Chain - the HUB75 adapter chain identifier (10, 20, or 30)
'' @returns nChainIdx - zero-based index (0, 1, or 2)

' Local Variables:
' @local bValidChain - TRUE if the chain identifier is recognized

  nChainIdx := 0                                        ' default to first or only panel
  bValidChain := TRUE
  case eHub75Chain
    HUB75_ADAPTER_1:
    HUB75_ADAPTER_2:
    HUB75_ADAPTER_3:
    other:
      bValidChain := FALSE
      DEBUG("ERROR: unknown chain id (", udec_(eHub75Chain), ") must be [10, 20, or 30]")
      abort
  if bValidChain
    nChainIdx := (eHub75Chain / hwEnum.HUB75_ADAPTER_STEP) - 1   ' 10, 20, 30 -> 1,2,3 -> 0,1,2

PUB pwmFrameCount(nChainIdx) : nbrPwmFrames | nColorDepth
'' Return the number of PWM frames to display for the selected bit depth.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nbrPwmFrames - number of PWM frames for the configured color depth

' Local Variables:
' @local nColorDepth - color depth in bits per channel

  nColorDepth := colorDepth(nChainIdx)
  case nColorDepth
    hwEnum.DEPTH_3BIT:
      nbrPwmFrames := PWM_FRAMES_3BIT
    hwEnum.DEPTH_4BIT:
      nbrPwmFrames := PWM_FRAMES_4BIT
    hwEnum.DEPTH_5BIT:
      nbrPwmFrames := PWM_FRAMES_5BIT
    hwEnum.DEPTH_6BIT:
      nbrPwmFrames := PWM_FRAMES_6BIT
    hwEnum.DEPTH_7BIT:
      nbrPwmFrames := PWM_FRAMES_7BIT
    hwEnum.DEPTH_8BIT:
      nbrPwmFrames := PWM_FRAMES_8BIT
    other:
      nbrPwmFrames := PWM_FRAMES_4BIT                  ' default to DEPTH_4BIT if set badly

PUB displayPixelAddress(nChainIdx, row, column) : pPixel | layoutIdx, panelPosn, panelRow, panelCol, tableBase, pEntry, nativeRows, nativeCols, nativeRow, nativeCol
'' Return the hub address of the pixel at display coordinates (row, column). This is the one
'' mapping every drawing path goes through; each step is a table lookup, built at startup:
''   display coordinates -> cell of the display's grid -> panel position (a cell that holds no
''   panel has none) -> panel coordinates -> panel rotation -> native coordinates -> buffer
''   slot -> address in the screen buffer.
'' Display rotation is applied before this call, by isp_hub75_screenUtils: row and column are
'' display coordinates with the rotation already undone, so they run over the display as its
'' panels are laid out (the size of the wiring's bounding box), not over the display as mounted.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display as laid out (display rotation already applied)
'' @param column - pixel column on the display as laid out (display rotation already applied)
'' @returns pPixel - hub address of the pixel's red byte, or NO_PIXEL when no panel holds (row, column)

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local panelPosn - panel position (P) of the panel that holds the pixel
' @local panelRow - row within that panel, as the viewer sees it
' @local panelCol - column within that panel, as the viewer sees it
' @local tableBase - first entry of this adapter in the per-position tables
' @local pEntry - pointer to the chain descriptor table entry
' @local nativeRows - pixel rows of the panel, as its own chips address them
' @local nativeCols - pixel columns of the panel, as its own chips address them
' @local nativeRow - the pixel's row in native coordinates
' @local nativeCol - the pixel's column in native coordinates

  pPixel := NO_PIXEL
  layoutIdx := validChainIndex(nChainIdx)
  panelPosn, panelRow, panelCol := panelCoordsAt(layoutIdx, row, column)
  if panelPosn <> NO_POSITION
    tableBase := layoutIdx * MAX_CABLE_POSITIONS
    pEntry := @@LONG[@screenTable][layoutIdx]
    nativeRows := LONG[pEntry][ENTR_PANEL_ROWS_OFST]
    nativeCols := LONG[pEntry][ENTR_PANEL_COLUMNS_OFST]
    ' panel rotation: panel coordinates (as the viewer sees them) -> native coordinates
    case positionToRotation[tableBase + panelPosn]
      hwEnum.ROT_180:
        ' ARROW_DOWN: the panel's own top is at the viewer's bottom
        nativeRow := (nativeRows - 1) - panelRow
        nativeCol := (nativeCols - 1) - panelCol
      hwEnum.ROT_LEFT_90:
        ' ARROW_LEFT: the panel's own top is at the viewer's left, its own left at the viewer's bottom
        nativeRow := panelCol
        nativeCol := (nativeCols - 1) - panelRow
      hwEnum.ROT_RIGHT_90:
        ' ARROW_RIGHT: the panel's own top is at the viewer's right, its own left at the viewer's top
        nativeRow := (nativeRows - 1) - panelCol
        nativeCol := panelRow
      other:
        ' ARROW_UP: native coordinates are the panel coordinates
        nativeRow := panelRow
        nativeCol := panelCol
    ' buffer slot: the screen buffer holds the panels one after another, in buffer-slot order
    pPixel := LONG[pEntry][ENTR_SCRN_BUFFER_ADDR_OFST] + ((((positionToSlot[tableBase + panelPosn] * nativeRows) + nativeRow) * nativeCols) + nativeCol) * LONG[pEntry][ENTR_BYTES_PER_COLOR_OFST]

PUB positionAtDisplayPixel(nChainIdx, row, column) : nPanelPosn | layoutIdx
'' Return the panel position (P) of the panel that holds display coordinates (row, column), with
'' the display as mounted: the coordinates are the ones drawing uses (display rotation not yet
'' applied) and P is numbered in reading order as mounted. Panel-centric drawing uses it to clip:
'' a pixel whose panel position is not the panel being drawn on lies outside that panel. It is a
'' table lookup in the mounted grid built at startup, the same cost at every rotation.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param row - pixel row on the display, as mounted
'' @param column - pixel column on the display, as mounted
'' @returns nPanelPosn - panel position (P0 is the top-left panel as mounted), or NO_PANEL_POSITION when the pixel is outside the display or in a cell that holds no panel

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist

  layoutIdx := validChainIndex(nChainIdx)
  nPanelPosn := NO_PANEL_POSITION
  if row >= 0 and column >= 0 and row < mountedPixelRows[layoutIdx] and column < mountedPixelColumns[layoutIdx]
    nPanelPosn := mountedCellToPosition[(layoutIdx * MAX_GRID_CELLS) + ((row / mountedCellRows[layoutIdx]) * mountedGridColumns[layoutIdx]) + (column / mountedCellColumns[layoutIdx])]

PUB positionForCable(nChainIdx, nCablePos) : nPanelPosn | layoutIdx
'' Return the panel position (P) where the panel at cable position nCablePos sits, with the
'' display as mounted: the inverse of the panel-position to cable-position table, built from the
'' wiring sentences and the display rotation at startup. The identify routine reads it to say
'' which cable position (C) each panel position (P) is.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param nCablePos - cable position of the panel (C0 is the panel the adapter plugs into)
'' @returns nPanelPosn - panel position (reading order from the top-left panel as mounted), or NO_PANEL_POSITION when no panel is at that cable position

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist

  layoutIdx := validChainIndex(nChainIdx)
  nPanelPosn := NO_PANEL_POSITION
  if nCablePos >= 0 and nCablePos < layoutPanelCount[layoutIdx]
    nPanelPosn := cableToPosition[(layoutIdx * MAX_CABLE_POSITIONS) + nCablePos]

PUB offsetToPanel(nChainIdx, nPanelIndex) : offsetPixelRows, offsetPixelColumns | layoutIdx, nMaxPanels, panelPosn, tableBase
'' Return the display coordinates of the top-left pixel of the panel at a panel position, with
'' the display as mounted: the offset that turns panel coordinates on that panel (as the viewer
'' sees it) into display coordinates, the ones drawing uses. The panel position is numbered in
'' reading order as mounted. It is read from the mounted grid, derived from the wiring sentences
'' and the display rotation at startup; with DISPn_ROTATION = ROT_NONE it is the layout.
''
'' @param nChainIdx - the index of the desired chain
'' @param nPanelIndex - panel position of the panel (P0 is the top-left panel as mounted, then reading order)
'' @returns offsetPixelRows - display row of the panel's top-left pixel, as mounted
'' @returns offsetPixelColumns - display column of the panel's top-left pixel, as mounted

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local nMaxPanels - total number of panels in the chain
' @local panelPosn - panel position clamped to the panels in use
' @local tableBase - first entry of this adapter in the per-position tables

  offsetPixelRows := offsetPixelColumns := 0
  layoutIdx := validChainIndex(nChainIdx)
  nMaxPanels := layoutPanelCount[layoutIdx]
  if nMaxPanels > 0
    panelPosn := 0 #> nPanelIndex <# nMaxPanels - 1
    if nPanelIndex <> panelPosn
      DEBUG("* Warning invalid nPanelIndex (", udec_(nPanelIndex), ") for display! of ", udec_(nMaxPanels), " panels")
    tableBase := layoutIdx * MAX_CABLE_POSITIONS
    offsetPixelRows := mountedCellRow[tableBase + panelPosn] * mountedCellRows[layoutIdx]
    offsetPixelColumns := mountedCellCol[tableBase + panelPosn] * mountedCellColumns[layoutIdx]

PUB layoutAreaOfPanel(nChainIdx, nPanelIndex) : nLayoutTopRow, nLayoutLeftColumn, nLayoutRows, nLayoutColumns | layoutIdx, panelPosn, tableBase, layoutPosn
'' Return the rectangle that the panel at a panel position covers on the display as its panels
'' are laid out (display rotation not applied): the place the screen buffer holds that panel.
'' The panel position is numbered in reading order as mounted, so a fill of this rectangle
'' fills the panel the viewer calls P. A panel position past the panels in use is held to the
'' last panel (offsetToPanel() reports it).
''
'' @param nChainIdx - the index of the desired chain
'' @param nPanelIndex - panel position of the panel (P0 is the top-left panel as mounted, then reading order)
'' @returns nLayoutTopRow - layout row of the panel's top-left pixel
'' @returns nLayoutLeftColumn - layout column of the panel's top-left pixel
'' @returns nLayoutRows - pixel rows of the panel in the layout
'' @returns nLayoutColumns - pixel columns of the panel in the layout

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local panelPosn - panel position clamped to the panels in use
' @local tableBase - first entry of this adapter in the per-position tables
' @local layoutPosn - the panel's position in the layout's own reading order

  nLayoutTopRow := nLayoutLeftColumn := nLayoutRows := nLayoutColumns := 0
  layoutIdx := validChainIndex(nChainIdx)
  if layoutPanelCount[layoutIdx] > 0
    panelPosn := 0 #> nPanelIndex <# layoutPanelCount[layoutIdx] - 1
    tableBase := layoutIdx * MAX_CABLE_POSITIONS
    layoutPosn := mountedToLayout[tableBase + panelPosn]
    nLayoutRows := layoutCellRows[layoutIdx]
    nLayoutColumns := layoutCellColumns[layoutIdx]
    nLayoutTopRow := positionToCellRow[tableBase + layoutPosn] * nLayoutRows
    nLayoutLeftColumn := positionToCellCol[tableBase + layoutPosn] * nLayoutColumns

PUB getDriverFlags(nChainIdx) : desiredFlags, eChipType
'' Return flags describing the compiled driver configuration for the specified adapter.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns desiredFlags - combined driver capability flags for the chip type
'' @returns eChipType - LED driver chip type enum value

  desiredFlags := eChipType := chipType(nChainIdx)
  if eChipType == hwEnum.CHIP_FM6126A
    desiredFlags := hwEnum.CHIP_MANUAL_SPEC | hwEnum.LAT_POSN_OVERLAP | hwEnum.LAT_STYLE_OFFSET | hwEnum.INIT_PANEL_REQUIRED
  elseif eChipType == hwEnum.CHIP_GS6238S
    desiredFlags := hwEnum.CHIP_MANUAL_SPEC | hwEnum.LAT_POSN_OVERLAP | hwEnum.LAT_STYLE_OFFSET | hwEnum.GB_SWAP
  elseif eChipType == hwEnum.CHIP_DP5125D
    desiredFlags := hwEnum.CHIP_MANUAL_SPEC | hwEnum.LAT_POSN_OVERLAP | hwEnum.LAT_STYLE_OFFSET | hwEnum.SCAN_4
  elseif eChipType == hwEnum.CHIP_MBI5124GP
    desiredFlags := hwEnum.CHIP_MANUAL_SPEC | hwEnum.CHIP_UNK_LAT_END_ENCL | hwEnum.SCAN_4 | hwEnum.INIT_PANEL_REQUIRED
  elseif eChipType == hwEnum.CHIP_FM6124 OR eChipType == hwEnum.CHIP_UNK_LAT_END_ENCL
    if eChipType == hwEnum.CHIP_FM6124
      desiredFlags := hwEnum.CHIP_MANUAL_SPEC
  elseif eChipType == hwEnum.CHIP_ICN2037 OR eChipType == hwEnum.CHIP_ICN2038S OR eChipType == hwEnum.CHIP_UNK_LAT_END_ENCL_SLO_CLK
    if eChipType == hwEnum.CHIP_ICN2037
      desiredFlags := hwEnum.CHIP_MANUAL_SPEC | hwEnum.CLK_WIDE_PULSE | hwEnum.RB_SWAP
    elseif eChipType == hwEnum.CHIP_ICN2038S
      desiredFlags := hwEnum.CHIP_MANUAL_SPEC | hwEnum.CLK_WIDE_PULSE | hwEnum.SCAN_4
  elseif eChipType & CHIP_TYPE_MASK <> hwEnum.CHIP_MANUAL_SPEC
    ' report ERROR and exit
    DEBUG("- have unknown CHIP ", ubin_word(desiredFlags))
    abort

PUB displayShape(nChainIdx) : eShape
'' Return the shape of the nChainIdx display: its DISPn_SHAPE setting, hwEnum.SHAPE_FLAT or
'' hwEnum.SHAPE_CUBE. Startup stops on any other value.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns eShape - hwEnum.SHAPE_FLAT or hwEnum.SHAPE_CUBE

  eShape := cubeSetting(validChainIndex(nChainIdx), CUBE_SHAPE_OFST)

PUB faceSizeInPixels(nChainIdx) : nFaceSize
'' Return the size of one face of the nChainIdx cube, in pixels: face coordinates run from 0 to
'' this size - 1 on each axis. A display that is not a cube (or not yet folded) has no faces.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @returns nFaceSize - pixel rows (and columns) of one face, or 0 when the display is not a cube

  nFaceSize := cubeFaceSize[validChainIndex(nChainIdx)]

PUB facePixelToPanel(nChainIdx, eFace, row, column) : panelPosn, panelRow, panelColumn, displayRow, displayColumn | layoutIdx, faceIdx, pFace
'' Return where a pixel in face coordinates lands on the cube's panels. Row and column may run
'' past the face's edges: the pixel is folded across as many edges as it crosses, using the edge
'' table built at startup, so it is never clipped. A pixel past two edges of one face at once
'' lies in a corner gap (a cube corner has 270 degrees, not 360) and has no panel. This is the
'' per-pixel entry of face-centric drawing; the display coordinates it returns go to
'' isp_hub75_screenUtils.drawPixelAtRC() like any other pixel (a cube is never rotated).
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param eFace - the face the coordinates are on (hwEnum.FACE_TOP .. hwEnum.FACE_RIGHT)
'' @param row - pixel row on that face, 0 at the face's up edge (any value)
'' @param column - pixel column on that face, 0 at the face's left edge (any value)
'' @returns panelPosn - panel position (P) the pixel lands on, or NO_PANEL_POSITION for a corner gap, an invalid face, or a display that is not a cube
'' @returns panelRow - row within that panel, as the viewer sees the flat picture of the net
'' @returns panelColumn - column within that panel, as the viewer sees the flat picture of the net
'' @returns displayRow - display row of the pixel (0 when there is no panel)
'' @returns displayColumn - display column of the pixel (0 when there is no panel)

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local faceIdx - the face the pixel lands on (0 = TOP .. 5 = RIGHT), or NO_FACE_INDEX
' @local pFace - pointer to that face's record in the face table

  panelPosn := NO_PANEL_POSITION
  panelRow := panelColumn := displayRow := displayColumn := 0
  layoutIdx := validChainIndex(nChainIdx)
  faceIdx, row, column := foldPoint(layoutIdx, eFace, row, column)
  if faceIdx <> NO_FACE_INDEX
    ' face coordinates -> panel coordinates (the face's turn in its cell) -> display coordinates
    pFace := @cubeFaces[((layoutIdx * CUBE_FACES) + faceIdx) * FACE_RECORD_LONGS]
    panelPosn := LONG[pFace][FACE_POSITION]
    panelRow, panelColumn := turnFaceCoords(LONG[pFace][FACE_TURN], LONG[pFace][FACE_ADD_ROW], LONG[pFace][FACE_ADD_COL], row, column)
    displayRow := panelRow + LONG[pFace][FACE_ORIGIN_ROW]
    displayColumn := panelColumn + LONG[pFace][FACE_ORIGIN_COL]

PUB foldFacePixel(nChainIdx, eFace, row, column) : eFaceOut, faceRow, faceColumn | faceIdx
'' Fold a pixel in face coordinates onto the face that holds it: the face-to-face half of
'' facePixelToPanel(). Row and column may run past the face's edges; the pixel is folded across
'' as many edges as it crosses. A pixel past two edges of one face at once lies in a corner gap.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param eFace - the face the coordinates are on (hwEnum.FACE_TOP .. hwEnum.FACE_RIGHT)
'' @param row - pixel row on that face, 0 at the face's up edge (any value)
'' @param column - pixel column on that face, 0 at the face's left edge (any value)
'' @returns eFaceOut - the face that holds the pixel (hwEnum.FACE_*), or NO_FACE for a corner gap, an invalid face, or a display that is not a cube
'' @returns faceRow - the pixel's row on that face (0 when there is no face)
'' @returns faceColumn - the pixel's column on that face (0 when there is no face)

' Local Variables:
' @local faceIdx - the face that holds the pixel (0 = TOP .. 5 = RIGHT), or NO_FACE_INDEX

  eFaceOut := NO_FACE
  faceIdx, faceRow, faceColumn := foldPoint(validChainIndex(nChainIdx), eFace, row, column)
  if faceIdx <> NO_FACE_INDEX
    eFaceOut := hwEnum.FACE_TOP + faceIdx

PUB homeOnFace(nChainIdx, eFace, ctrRow, ctrColumn) : eHomeFace, homeTurn, homeAddRow, homeAddColumn | layoutIdx, faceIdx, faceSize, rowOver, columnOver, edge, pEdge
'' Return the home of an object drawn in face coordinates: the face that holds the object's
'' centre, and the transform from the given face's frame into the home face's frame. Drawing
'' the object in its home frame puts the one unavoidable seam of every corner it straddles on
'' that corner's edge farthest from the centre. A centre in a corner gap first moves to the
'' nearest surface point: the axis with the smaller overshoot is held to the face (on a tie,
'' the column). Map each coordinate of the object with turnFaceCoords(homeTurn, homeAddRow,
'' homeAddColumn, row, column), then draw it on the home face.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param eFace - the face the object's coordinates are on (hwEnum.FACE_TOP .. hwEnum.FACE_RIGHT)
'' @param ctrRow - row of the object's centre on that face (any value)
'' @param ctrColumn - column of the object's centre on that face (any value)
'' @returns eHomeFace - the face that holds the centre (hwEnum.FACE_*), or NO_FACE for an invalid face or a display that is not a cube
'' @returns homeTurn - clockwise quarter turns from the given face's frame to the home frame (0 .. 3)
'' @returns homeAddRow - row added after the turn
'' @returns homeAddColumn - column added after the turn

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local faceIdx - the face the centre is on so far (0 = TOP .. 5 = RIGHT)
' @local faceSize - pixel rows (and columns) of one face
' @local rowOver - how far the centre's row lies past the face
' @local columnOver - how far the centre's column lies past the face
' @local edge - the edge the centre lies past (EDGE_N .. EDGE_W)
' @local pEdge - pointer to that edge's record in the edge table

  eHomeFace := NO_FACE
  homeTurn := QTURN_NONE
  homeAddRow := homeAddColumn := 0
  layoutIdx := validChainIndex(nChainIdx)
  faceSize := cubeFaceSize[layoutIdx]
  faceIdx := eFace - hwEnum.FACE_TOP
  if faceSize > 0 and faceIdx >= 0 and faceIdx < CUBE_FACES
    ' a centre in a corner gap: hold the axis with the smaller overshoot to the face
    if (ctrRow < 0 or ctrRow >= faceSize) and (ctrColumn < 0 or ctrColumn >= faceSize)
      rowOver := ctrRow < 0 ? -ctrRow : ctrRow - (faceSize - 1)
      columnOver := ctrColumn < 0 ? -ctrColumn : ctrColumn - (faceSize - 1)
      if columnOver <= rowOver
        ctrColumn := 0 #> ctrColumn <# faceSize - 1
      else
        ctrRow := 0 #> ctrRow <# faceSize - 1
    ' fold the centre home, composing each crossing into one transform:
    '   E(T(p)) = L_k(L_t(p) + a) + b = L_(k+t)(p) + (L_k(a) + b)
    repeat
      if ctrRow < 0
        edge := EDGE_N
      elseif ctrRow >= faceSize
        edge := EDGE_S
      elseif ctrColumn >= faceSize
        edge := EDGE_E
      elseif ctrColumn < 0
        edge := EDGE_W
      else
        quit
      pEdge := @cubeEdges[edgeRecordIndex(layoutIdx, faceIdx, edge)]
      ctrRow, ctrColumn := turnFaceCoords(LONG[pEdge][EDGE_TURN], LONG[pEdge][EDGE_ADD_ROW], LONG[pEdge][EDGE_ADD_COL], ctrRow, ctrColumn)
      homeAddRow, homeAddColumn := turnFaceCoords(LONG[pEdge][EDGE_TURN], LONG[pEdge][EDGE_ADD_ROW], LONG[pEdge][EDGE_ADD_COL], homeAddRow, homeAddColumn)
      homeTurn := (homeTurn + LONG[pEdge][EDGE_TURN]) & QTURN_MASK
      faceIdx := LONG[pEdge][EDGE_NEIGHBOUR]
    eHomeFace := hwEnum.FACE_TOP + faceIdx

PUB turnFaceCoords(turn, addRow, addColumn, row, column) : newRow, newColumn
'' Turn coordinates by whole quarter turns, then add an offset: the one definition of every
'' transform the cube uses (across an edge, from a face into its panel, and into an object's
'' home frame). One clockwise quarter turn carries up (-1, 0) to right (0, +1):
''   0: (row, column)  1: (column, -row)  2: (-row, -column)  3: (-column, row)
''
'' @param turn - clockwise quarter turns (0 .. 3; higher values wrap)
'' @param addRow - row added after the turn
'' @param addColumn - column added after the turn
'' @param row - the row to transform
'' @param column - the column to transform
'' @returns newRow - the transformed row
'' @returns newColumn - the transformed column

  case turn & QTURN_MASK
    QTURN_CLOCKWISE:
      newRow := column
      newColumn := -row
    QTURN_HALF:
      newRow := -row
      newColumn := -column
    QTURN_ANTICLOCKWISE:
      newRow := -column
      newColumn := row
    other:
      newRow := row
      newColumn := column
  newRow += addRow
  newColumn += addColumn

PUB foldNet(nChainIdx, pCellRows, pCellColumns, pCablePositions, topCable, frontCable, faceSize) : mistakeCount | layoutIdx, cableA, cableB, lineLen
'' Fold a net of six panels into a cube and build the nChainIdx cube's tables: the face table
'' (each face's cable position, panel position and turn in its cell) and the edge table (all 12
'' edges, in both directions: the neighbour across each edge of each face and the transform of
'' coordinates across it). configure() calls it for a display with DISPn_SHAPE = SHAPE_CUBE;
'' the fold self-test (test_hub75_cube_fold.spin2) calls it with a reference net. A net that is
'' not one of the 11 cube nets, or a front face that does not share an edge with the top face,
'' prints its message and leaves the display without faces; the caller decides whether to stop.
''
'' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
'' @param pCellRows - address of LONG[6]: the grid row of each cable position's cell (any origin)
'' @param pCellColumns - address of LONG[6]: the grid column of each cable position's cell (any origin)
'' @param pCablePositions - address of BYTE[6]: the panel position (P) of each cable position
'' @param topCable - cable position of the top face (0 .. 5)
'' @param frontCable - cable position of the front face (0 .. 5)
'' @param faceSize - pixel rows (and columns) of one square panel
'' @returns mistakeCount - number of problems reported (0 when the cube's tables are built)

' Local Variables:
' @local layoutIdx - the chain index, checked against the adapters that exist
' @local cableA - the earlier of two cable positions that fold onto one face
' @local cableB - the later of those two, or a cable position that shares no edge with the others
' @local lineLen - characters written to the picture line so far

  mistakeCount := 0
  layoutIdx := validChainIndex(nChainIdx)
  cubeFaceSize[layoutIdx] := 0                          ' no faces until the fold succeeds
  rollNet(pCellRows, pCellColumns)
  cableA, cableB := findFoldCollision()
  if cableB <> NO_POSITION
    if cableA == NO_POSITION
      ' cannot happen after placePanels(), which places every panel next to its neighbour
      lineLen := appendText(0, @"the panels do not fold into a cube (C")
      lineLen := appendNumber(lineLen, cableB)
      lineLen := appendText(lineLen, @" shares no edge with the other panels); arrange the six panels as one of the 11 cube nets")
    else
      lineLen := appendText(0, @"the panels do not fold into a cube (C")
      lineLen := appendNumber(lineLen, cableA)
      lineLen := appendText(lineLen, @" and C")
      lineLen := appendNumber(lineLen, cableB)
      lineLen := appendText(lineLen, @" fold onto the same face); arrange the six panels as one of the 11 cube nets")
    pictureLine[lineLen] := 0
    debug("HUB75: DISP", udec_(layoutIdx), ": ", zstr_(@pictureLine))
    mistakeCount++
  elseif (rollNormal[frontCable] >> AXIS_SIGN_BITS) == (rollNormal[topCable] >> AXIS_SIGN_BITS)
    ' the front's normal lies on the top's axis: it is the face opposite the top
    lineLen := appendText(0, @"C")
    lineLen := appendNumber(lineLen, frontCable)
    lineLen := appendText(lineLen, @" is opposite the top face (C")
    lineLen := appendNumber(lineLen, topCable)
    lineLen := appendText(lineLen, @") when the panels are folded; the front face must share an edge with the top face")
    pictureLine[lineLen] := 0
    debug("HUB75: DISP", udec_(layoutIdx), "_CUBE_FRONT: ", zstr_(@pictureLine))
    mistakeCount++
  else
    buildFaceFrames(topCable, frontCable)
    buildFaceRecords(layoutIdx, pCellRows, pCellColumns, pCablePositions, faceSize)
    buildEdgeRecords(layoutIdx, faceSize)
    cubeFaceSize[layoutIdx] := faceSize

#ifdef DBG_PWM
PUB dbgMemDump(pMessage, pBytes, lenBytes) | bytBffr, colIdx, rowIdx, maxCol, maxRow, dispLen
'' Dump bytes in hex format to the debug() terminal.
''
'' @param pMessage - pointer to a zero-terminated label string
'' @param pBytes - hub address of the memory region to dump
'' @param lenBytes - number of bytes to display

' Local Variables:
' @local bytBffr - current read pointer into the memory region
' @local colIdx - column index within the current row
' @local rowIdx - current row number being displayed
' @local maxCol - maximum column index per row
' @local maxRow - total number of rows to display
' @local dispLen - running count of bytes displayed so far

  DEBUG("`temp '", zstr_(pMessage), ": bffr=", uhex_long_(pBytes), "(", udec_(lenBytes), ")' 13")
  maxCol := lenBytes >= DUMP_BYTES_PER_ROW ? DUMP_MAX_COL : lenBytes
  maxRow := (lenBytes / DUMP_BYTES_PER_ROW)
  if maxRow * DUMP_BYTES_PER_ROW < lenBytes
    maxRow++
  if maxRow == 0
    maxRow := 1

  bytBffr := pBytes
  waitus(DUMP_HDR_DELAY_US)
  dispLen := 0
  repeat rowIdx from 1 TO maxRow
    if rowIdx < DUMP_SINGLE_DIGIT_LIMIT
      DEBUG("`temp ' '")                                ' space
    DEBUG("`temp '  ", uhex_long_(bytBffr), ": '")
    repeat colIdx from 0 TO maxCol
      DEBUG("`temp '", uhex_byte_(BYTE[bytBffr+colIdx]), " '")
      dispLen++
      if dispLen >= lenBytes
        quit
      if colIdx == DUMP_HALF_ROW_IDX
        DEBUG("`temp ' '")                              ' space

    bytBffr += DUMP_BYTES_PER_ROW
    DEBUG("`temp 13")                                   ' newline
    waitus(DUMP_ROW_DELAY_US)                           ' 50 too short, 70 less issue, 75 better,
  waitms(DUMP_END_DELAY_MS)
#endif

PRI ptrTableEntry(nChainIdx) : pEntry
' Return the hub address of the chain descriptor table entry for the given index.
'
' @param nChainIdx - zero-based chain index
' @returns pEntry - pointer to the chain descriptor table entry

' debug("HUB75dbg: ", udec(nChainIdx), udec(numberScreens), udec(tableSizeInBytes), udec(entrySizeInBytes))

  pEntry := @@LONG[@screenTable][validChainIndex(nChainIdx)]   ' get ptr to table entry

PRI validChainIndex(nChainIdx) : validScreenIdx
' Return the chain index after checking it names an adapter that exists; stop on any other.
'
' @param nChainIdx - zero-based chain index
' @returns validScreenIdx - the same index, within the valid range

  validScreenIdx := 0 #> nChainIdx <# numberScreens - 1
  if nChainIdx <> validScreenIdx
    DEBUG("HUB75: not enough HUB75 buffers allocated: [isp_hub75_hwBufferAccess.spin2]")
    abort

CON { PRIVATE wiring check and layout constants }

    ' number of HUB75 adapters, and so of displays (DISP0 .. DISP2)
    ADAPTER_COUNT           = (hwEnum.HUB75_ADAPTER_3 - hwEnum.HUB75_ADAPTER_1) / hwEnum.HUB75_ADAPTER_STEP + 1

    ' every bit that some wiring word uses; any other bit set means words were joined with +
    WIRING_WORD_BITS        = hwEnum.NEIGHBOR_MASK | hwEnum.DIRECTION_MASK | hwEnum.ARROW_MASK | hwEnum.FIRST_PANEL_MASK | hwEnum.NO_PANEL_MASK

    ' a well-formed sentence holds exactly this many words of each kind it needs
    ONE_WORD                = 1

    ' the arrows of a panel turned sideways (its columns run up and down the display)
    SIDEWAYS_ARROWS         = hwEnum.ARROW_LEFT | hwEnum.ARROW_RIGHT

    ' cable position of the panel the adapter plugs into
    FIRST_CABLE_POSITION    = 0

    ' grid steps from a panel's neighbour to the panel (rows grow downward, columns rightward)
    STEP_BACK               = -1
    STEP_NONE               = 0
    STEP_FORWARD            = 1

    ' The cells of a connected display of N panels fit a grid whose rows plus columns
    ' is at most N + 1, so 16 panels need at most 8 x 9 = 72 cells.
    MAX_GRID_CELLS          = ((MAX_CABLE_POSITIONS + 1) / 2) * ((MAX_CABLE_POSITIONS + 2) / 2)

    ' table entry for a cell that holds no panel, or for a position no panel takes
    NO_POSITION             = NO_PANEL_POSITION

    ' the picture printed at startup: one cell reads "[C2 v]", padded to "[C2  v]" when
    ' the display has more than ten panels; the longest line is the inverse-table line,
    ' MAX_CABLE_POSITIONS entries of " C15->P15"
    DECIMAL_BASE            = 10
    LONGEST_ENTRY_CHARS     = 9
    PICTURE_LINE_BYTES      = MAX_CABLE_POSITIONS * LONGEST_ENTRY_CHARS + 1
    DEGREES_PER_QUARTER     = 90

    ' stopping after wiring mistakes
    HALT_DRAIN_MS           = 200                               ' let the last message leave the serial port
    LAST_COG_ID             = 7

CON { PRIVATE cube fold constants }

    ' the cube settings of one display, CUBE_SETTING_LONGS per adapter in cubeSettings:
    '  CUBE_SHAPE_OFST - DISPn_SHAPE
    '  CUBE_TOP_OFST   - DISPn_CUBE_TOP
    '  CUBE_FRONT_OFST - DISPn_CUBE_FRONT
    #0, CUBE_SHAPE_OFST, CUBE_TOP_OFST, CUBE_FRONT_OFST, CUBE_SETTING_LONGS

    ' face indices into the cube tables, in hwEnum.FACE_* order (index = eFace - hwEnum.FACE_TOP)
    FACE_IDX_TOP            = hwEnum.FACE_TOP - hwEnum.FACE_TOP
    FACE_IDX_BOTTOM         = hwEnum.FACE_BOTTOM - hwEnum.FACE_TOP
    FACE_IDX_FRONT          = hwEnum.FACE_FRONT - hwEnum.FACE_TOP
    FACE_IDX_BACK           = hwEnum.FACE_BACK - hwEnum.FACE_TOP
    FACE_IDX_LEFT           = hwEnum.FACE_LEFT - hwEnum.FACE_TOP
    FACE_IDX_RIGHT          = hwEnum.FACE_RIGHT - hwEnum.FACE_TOP
    CUBE_FACES              = FACE_IDX_RIGHT + 1                ' faces of a cube, and panels in a cube
    NO_FACE_INDEX           = -1                                ' a pixel that no face holds

    ' the edges of a face, clockwise from its up edge, as seen from outside the cube:
    '  EDGE_N - the up edge (the row -1 side)
    '  EDGE_E - the right edge (the column N side)
    '  EDGE_S - the down edge (the row N side)
    '  EDGE_W - the left edge (the column -1 side)
    #0, EDGE_N, EDGE_E, EDGE_S, EDGE_W, FACE_EDGES
    EDGE_OPPOSITE           = 2                                 ' (edge + EDGE_OPPOSITE) & QTURN_MASK is the edge across the face

    ' clockwise quarter turns of a face's frame (turnFaceCoords()):
    '  QTURN_NONE          - (row, column)
    '  QTURN_CLOCKWISE     - (column, -row): up becomes right
    '  QTURN_HALF          - (-row, -column)
    '  QTURN_ANTICLOCKWISE - (-column, row): up becomes left
    #0, QTURN_NONE, QTURN_CLOCKWISE, QTURN_HALF, QTURN_ANTICLOCKWISE
    QTURN_MASK              = FACE_EDGES - 1                    ' turns wrap after four quarter turns

    ' 3-D axis codes, used only while folding at startup:
    '  AXIS_POS_X .. AXIS_NEG_Z - the six directions; code >> AXIS_SIGN_BITS is the axis (X 0, Y 1, Z 2)
    '  AXIS_NONE               - not yet folded
    #0, AXIS_POS_X, AXIS_NEG_X, AXIS_POS_Y, AXIS_NEG_Y, AXIS_POS_Z, AXIS_NEG_Z, AXIS_NONE
    AXIS_NEGATE_BIT         = 1                                 ' code ^ AXIS_NEGATE_BIT is the opposite direction
    AXIS_SIGN_BITS          = 1                                 ' the sign is the low bit of a code
    AXIS_COUNT              = 3                                 ' X, Y and Z
    AXIS_INDEX_SUM          = 3                                 ' 0 + 1 + 2: the third axis is this minus the other two

    ' one record of the edge table, per edge of each face:
    '  EDGE_NEIGHBOUR - the face across the edge (face index)
    '  EDGE_ENTRY     - the neighbour's edge that the edge meets (EDGE_N .. EDGE_W; printed only)
    '  EDGE_TURN      - clockwise quarter turns from this face's frame to the neighbour's
    '  EDGE_ADD_ROW   - row added after the turn
    '  EDGE_ADD_COL   - column added after the turn
    #0, EDGE_NEIGHBOUR, EDGE_ENTRY, EDGE_TURN, EDGE_ADD_ROW, EDGE_ADD_COL, EDGE_RECORD_LONGS
    CUBE_EDGE_SLOTS         = CUBE_FACES * FACE_EDGES           ' 24 directed entries: the 12 edges, each both ways

    ' one record of the face table, per face:
    '  FACE_CABLE      - cable position of the face's panel
    '  FACE_POSITION   - panel position (P) of the face's panel
    '  FACE_TURN       - clockwise quarter turns from face coordinates to panel coordinates
    '  FACE_ADD_ROW    - row added after the turn
    '  FACE_ADD_COL    - column added after the turn
    '  FACE_ORIGIN_ROW - display row of the panel's top-left pixel
    '  FACE_ORIGIN_COL - display column of the panel's top-left pixel
    #0, FACE_CABLE, FACE_POSITION, FACE_TURN, FACE_ADD_ROW, FACE_ADD_COL, FACE_ORIGIN_ROW, FACE_ORIGIN_COL, FACE_RECORD_LONGS

    ' two grid cells share an edge when |row step| + |column step| is this
    NEIGHBOUR_DISTANCE      = 1

DAT { Wiring sentences, and the layout derived from them at startup }

' The wiring sentences of every display: DISPn_C0 .. DISPn_C15, MAX_CABLE_POSITIONS per adapter.
wiringSentences     LONG    user.DISP0_C0, user.DISP0_C1, user.DISP0_C2, user.DISP0_C3
                    LONG    user.DISP0_C4, user.DISP0_C5, user.DISP0_C6, user.DISP0_C7
                    LONG    user.DISP0_C8, user.DISP0_C9, user.DISP0_C10, user.DISP0_C11
                    LONG    user.DISP0_C12, user.DISP0_C13, user.DISP0_C14, user.DISP0_C15
                    LONG    user.DISP1_C0, user.DISP1_C1, user.DISP1_C2, user.DISP1_C3
                    LONG    user.DISP1_C4, user.DISP1_C5, user.DISP1_C6, user.DISP1_C7
                    LONG    user.DISP1_C8, user.DISP1_C9, user.DISP1_C10, user.DISP1_C11
                    LONG    user.DISP1_C12, user.DISP1_C13, user.DISP1_C14, user.DISP1_C15
                    LONG    user.DISP2_C0, user.DISP2_C1, user.DISP2_C2, user.DISP2_C3
                    LONG    user.DISP2_C4, user.DISP2_C5, user.DISP2_C6, user.DISP2_C7
                    LONG    user.DISP2_C8, user.DISP2_C9, user.DISP2_C10, user.DISP2_C11
                    LONG    user.DISP2_C12, user.DISP2_C13, user.DISP2_C14, user.DISP2_C15

' The layout of each display, derived once by configure(); one entry per adapter.
layoutPanelCount    LONG    0[ADAPTER_COUNT]                    ' N, the panels in use
layoutGridRows      LONG    0[ADAPTER_COUNT]                    ' bounding box height, in panels
layoutGridColumns   LONG    0[ADAPTER_COUNT]                    ' bounding box width, in panels
layoutPixelRows     LONG    0[ADAPTER_COUNT]                    ' bounding box height, in pixels
layoutPixelColumns  LONG    0[ADAPTER_COUNT]                    ' bounding box width, in pixels
layoutCellRows      LONG    0[ADAPTER_COUNT]                    ' one cell's height, in pixels (a panel as the viewer sees it)
layoutCellColumns   LONG    0[ADAPTER_COUNT]                    ' one cell's width, in pixels

' The same display as mounted (display rotation applied): the sizes the viewer sees.
' At 90 and 270 degrees rows and columns exchange; otherwise they equal the layout's.
mountedPixelRows    LONG    0[ADAPTER_COUNT]                    ' display height as mounted, in pixels
mountedPixelColumns LONG    0[ADAPTER_COUNT]                    ' display width as mounted, in pixels
mountedGridColumns  LONG    0[ADAPTER_COUNT]                    ' mounted bounding box width, in panels
mountedCellRows     LONG    0[ADAPTER_COUNT]                    ' one mounted cell's height, in pixels
mountedCellColumns  LONG    0[ADAPTER_COUNT]                    ' one mounted cell's width, in pixels

' Lookup tables for the drawing path, MAX_CABLE_POSITIONS entries per adapter; an entry
' past the last panel holds NO_POSITION. The first four are indexed by the layout's own panel
' position (reading order over the layout, the screen buffer's geometry, called L below);
' the mounted tables are indexed by the panel position the program sees (P, reading order as
' mounted). At ROT_NONE, L and P are the same number.
positionToSlot      BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' L -> buffer slot (N-1-C)
positionToRotation  BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' L -> panel rotation (hwEnum.ROT_*)
positionToCellRow   BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' L -> layout grid row of its cell
positionToCellCol   BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' L -> layout grid column of its cell
mountedToLayout     BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' P -> L (the mounting table)
mountedCellRow      BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' P -> mounted grid row of its cell
mountedCellCol      BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' P -> mounted grid column of its cell
cableToPosition     BYTE    NO_POSITION[ADAPTER_COUNT * MAX_CABLE_POSITIONS]  ' cable position C -> P (inverse, for identify)

' The derived grids, MAX_GRID_CELLS entries per adapter: cell (row x grid columns + column) -> L
' (the layout grid) or -> P (the mounted grid), or NO_POSITION for a cell that holds no panel.
cellToPosition      BYTE    NO_POSITION[ADAPTER_COUNT * MAX_GRID_CELLS]
mountedCellToPosition BYTE  NO_POSITION[ADAPTER_COUNT * MAX_GRID_CELLS]

' Work area for one configure() call; startup configures one adapter at a time.
cableCellRow        LONG    0[MAX_CABLE_POSITIONS]              ' cable position -> grid row, relative to C0
cableCellColumn     LONG    0[MAX_CABLE_POSITIONS]              ' cable position -> grid column, relative to C0
cablePlaced         LONG    0[MAX_CABLE_POSITIONS]              ' cable position -> TRUE once its cell is known
pictureLine         BYTE    0[PICTURE_LINE_BYTES]               ' one line of the printed picture
emptyCellText       BYTE    "  --  ", 0                         ' a cell that holds no panel
emptyText           BYTE    0                                   ' nothing follows the cable number

' Wiring messages printed from more than one check (the catalogue in the sprint plan quotes them)
msgPlusCarry        BYTE    "looks like + joined a word to itself and carried into the next kind of word; join the words with | only, never +", 0
msgC0NotFirst       BYTE    "must be FIRST_PANEL | arrow, because panels are in use", 0
msgNoArrow          BYTE    "has no arrow word; add one of ARROW_UP, ARROW_DOWN, ARROW_LEFT, ARROW_RIGHT", 0
msgManyArrows       BYTE    "has more than one arrow word; use exactly one of ARROW_UP, ARROW_DOWN, ARROW_LEFT, ARROW_RIGHT", 0

DAT { The cube: its settings, and the tables folded from its net at startup }

{ The cube's faces and edges (DISPn_SHAPE = SHAPE_CUBE).

  Each face has a fixed frame, seen from outside the cube: an outward normal n, an up U and
  a right R = U x n. Face coordinates (row, column) put row 0 at the face's up edge and
  column 0 at its left edge.

  STABLE -- the image-mapping sprint depends on these up directions:
    FRONT, BACK, LEFT, RIGHT - up points toward TOP
    TOP                      - up points toward BACK (standing at FRONT, text on TOP reads correctly)
    BOTTOM                   - up points toward FRONT

  TOP and FRONT are the faces at DISPn_CUBE_TOP and DISPn_CUBE_FRONT; BOTTOM and BACK are
  opposite them; RIGHT is on the viewer's right standing at FRONT, and LEFT is opposite it.

  Because the up directions are fixed, the edge table is the same for every net; foldNet()
  derives it from the frames rather than reading it from here. With N the face size, a pixel
  past edge F.e of face F lands on face G at L_k(row, column) + (addRow, addColumn), where L_k
  is k clockwise quarter turns (turnFaceCoords()):

    F.e       G.e'      k  (addRow, addColumn)       F.e       G.e'      k  (addRow, addColumn)
    TOP.N     BACK.N    2  (-1, N-1)                 BACK.N    TOP.N     2  (-1, N-1)
    TOP.E     RIGHT.N   1  (-N, N-1)                 BACK.E    LEFT.W    0  (0, -N)
    TOP.S     FRONT.N   0  (-N, 0)                   BACK.S    BOTTOM.S  2  (2N-1, N-1)
    TOP.W     LEFT.N    3  (-1, 0)                   BACK.W    RIGHT.E   0  (0, N)
    BOTTOM.N  FRONT.S   0  (N, 0)                    LEFT.N    TOP.W     1  (0, -1)
    BOTTOM.E  RIGHT.S   3  (2N-1, 0)                 LEFT.E    FRONT.W   0  (0, -N)
    BOTTOM.S  BACK.S    2  (2N-1, N-1)               LEFT.S    BOTTOM.W  3  (N-1, -N)
    BOTTOM.W  LEFT.S    1  (N, N-1)                  LEFT.W    BACK.E    0  (0, N)
    FRONT.N   TOP.S     0  (N, 0)                    RIGHT.N   TOP.E     3  (N-1, N)
    FRONT.E   RIGHT.W   0  (0, -N)                   RIGHT.E   BACK.W    0  (0, -N)
    FRONT.S   BOTTOM.N  0  (-N, 0)                   RIGHT.S   BOTTOM.E  1  (0, 2N-1)
    FRONT.W   LEFT.E    0  (0, N)                    RIGHT.W   FRONT.E   0  (0, N)

  The net decides only which panel holds each face and how the face is turned in that
  panel's cell of the flat picture (the face table).
}

' The cube settings of every display: DISPn_SHAPE, DISPn_CUBE_TOP, DISPn_CUBE_FRONT.
cubeSettings        LONG    user.DISP0_SHAPE, user.DISP0_CUBE_TOP, user.DISP0_CUBE_FRONT
                    LONG    user.DISP1_SHAPE, user.DISP1_CUBE_TOP, user.DISP1_CUBE_FRONT
                    LONG    user.DISP2_SHAPE, user.DISP2_CUBE_TOP, user.DISP2_CUBE_FRONT

' The tables of each cube, built once by foldNet(); one set per adapter. LONGs throughout,
' because the adds are negative and BYTE and WORD reads are unsigned.
cubeFaceSize        LONG    0[ADAPTER_COUNT]                                        ' N, or 0 when the display has no faces
cubeEdges           LONG    0[ADAPTER_COUNT * CUBE_EDGE_SLOTS * EDGE_RECORD_LONGS]  ' the edge table: (face, edge) -> record
cubeFaces           LONG    0[ADAPTER_COUNT * CUBE_FACES * FACE_RECORD_LONGS]       ' the face table: face -> record

' Work area for one fold; startup folds one adapter at a time.
rollNormal          BYTE    0[CUBE_FACES]                       ' cable position -> outward normal once folded (axis code)
rollUp              BYTE    0[CUBE_FACES]                       ' cable position -> its cell's up, folded (axis code)
rollRight           BYTE    0[CUBE_FACES]                       ' cable position -> its cell's right, folded (axis code)
frameNormal         BYTE    0[CUBE_FACES]                       ' face -> outward normal (axis code)
frameUp             BYTE    0[CUBE_FACES]                       ' face -> up (axis code)
frameRight          BYTE    0[CUBE_FACES]                       ' face -> right (axis code)

' Characters of the printed cube lines
faceUpArrows        BYTE    "^>v<"                              ' a face's up in its cell, by its turn
edgeLetters         BYTE    "NESW"                              ' an edge, by its index

PRI checkAndDeriveLayout(nChainIdx) | mistakeCount, panelCount, bCube
' Decode and check one display's wiring sentences and shape settings, then derive its layout
' tables (and, for a cube, fold its net) and print its picture. If any check fails, stop the
' program after all the messages.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)

' Local Variables:
' @local mistakeCount - number of wiring problems reported
' @local panelCount - number of cable positions in use (not NO_PANEL)
' @local bCube - TRUE when the display's shape is SHAPE_CUBE

    ' checks on each sentence alone, and on the numbering
    mistakeCount, panelCount := checkSentences(nChainIdx)
    if panelCount == 0
        debug("HUB75: DISP", udec_(nChainIdx), ": has no panels (every DISP", udec_(nChainIdx), "_C0 .. DISP", udec_(nChainIdx), "_C15 is NO_PANEL), so its adapter cannot be started")
        mistakeCount++
    else
        mistakeCount += checkPanelLimit(nChainIdx, panelCount)
        mistakeCount += checkShape(nChainIdx, panelCount)
        ' the walk needs well-formed sentences; it runs only when the checks above pass
        if mistakeCount == 0
            mistakeCount := placePanels(nChainIdx, panelCount)
            if mistakeCount == 0
                bCube := cubeSetting(nChainIdx, CUBE_SHAPE_OFST) == hwEnum.SHAPE_CUBE
                if bCube == TRUE
                    ignoreCubeRotation(nChainIdx)           ' before the layout tables read the rotation
                buildLayoutTables(nChainIdx, panelCount)
                if bCube == TRUE
                    ' checkShape() has checked that each setting names one cable position in use
                    mistakeCount := foldNet(nChainIdx, @cableCellRow, @cableCellColumn, @cableToPosition[nChainIdx * MAX_CABLE_POSITIONS], ...
                                            ENCOD cubeSetting(nChainIdx, CUBE_TOP_OFST), ENCOD cubeSetting(nChainIdx, CUBE_FRONT_OFST), ...
                                            columnsPerPanel(nChainIdx))
                if mistakeCount == 0
                    printLayout(nChainIdx)
                    if bCube == TRUE
                        printCube(nChainIdx)
    if mistakeCount > 0
        haltAfterMistakes(nChainIdx, mistakeCount)

PRI checkSentences(nChainIdx) : mistakeCount, panelCount | cablePos, sentence
' Check each wiring sentence of one display on its own, then check the numbering and
' that the arrows agree on one axis.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @returns mistakeCount - number of wiring problems reported
' @returns panelCount - number of cable positions in use (not NO_PANEL)

' Local Variables:
' @local cablePos - cable position being checked
' @local sentence - the wiring sentence at that cable position

    mistakeCount := 0
    panelCount := 0
    repeat cablePos from 0 to MAX_CABLE_POSITIONS - 1
        sentence := wiringSentence(nChainIdx, cablePos)
        if sentence <> hwEnum.NO_PANEL
            panelCount++
            mistakeCount += checkOneSentence(nChainIdx, cablePos, sentence)
            ' a gap in the numbering; C1 after an unused C0 is reported by the C0 check below
            if cablePos > FIRST_CABLE_POSITION + 1 and wiringSentence(nChainIdx, cablePos - 1) == hwEnum.NO_PANEL
                reportSentenceRef(nChainIdx, cablePos, @"is in use, but C", cablePos - 1, @" before it is NO_PANEL; number the panels in use C0, C1, C2 ... with no gaps")
                mistakeCount++
    if panelCount > 0 and wiringSentence(nChainIdx, FIRST_CABLE_POSITION) == hwEnum.NO_PANEL
        reportSentence(nChainIdx, FIRST_CABLE_POSITION, @msgC0NotFirst)
        mistakeCount++
    mistakeCount += checkArrowAxes(nChainIdx)

PRI checkArrowAxes(nChainIdx) : mistakeCount | panelRows, panelCols, firstArrow, cablePos, sentence, arrowBits
' Report a panel whose arrow is at right angles to C0's arrow, on panels that are not
' square: a panel turned sideways fills a cell of a different shape, so mixed arrows
' cannot form a grid. Square panels may point any way.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @returns mistakeCount - number of wiring problems reported

' Local Variables:
' @local panelRows - pixel rows per individual panel
' @local panelCols - pixel columns per individual panel
' @local firstArrow - the arrow word of C0
' @local cablePos - cable position being checked
' @local sentence - the wiring sentence at that cable position
' @local arrowBits - the arrow word of that sentence

    mistakeCount := 0
    panelRows, panelCols := panelSizeInPixels(nChainIdx)
    firstArrow := wiringSentence(nChainIdx, FIRST_CABLE_POSITION) & hwEnum.ARROW_MASK
    ' compare only arrows that are well formed; the sentence checks report the rest
    if panelRows <> panelCols and (ONES firstArrow) == ONE_WORD
        repeat cablePos from FIRST_CABLE_POSITION + 1 to MAX_CABLE_POSITIONS - 1
            sentence := wiringSentence(nChainIdx, cablePos)
            arrowBits := sentence & hwEnum.ARROW_MASK
            if (sentence & (hwEnum.NO_PANEL | !WIRING_WORD_BITS)) == 0 and (ONES arrowBits) == ONE_WORD
                if ((arrowBits & SIDEWAYS_ARROWS) <> 0) <> ((firstArrow & SIDEWAYS_ARROWS) <> 0)
                    reportSentence(nChainIdx, cablePos, @"has its arrow at right angles to C0's arrow; on panels that are not square, every arrow is ARROW_UP or ARROW_DOWN, or every arrow is ARROW_LEFT or ARROW_RIGHT")
                    mistakeCount++

PRI checkOneSentence(nChainIdx, cablePos, sentence) : mistakeCount | nbrBits, dirBits, arrowBits, bNbrDone, bDirDone, bArrowDone, nbrPos
' Check one wiring sentence that is in use (not NO_PANEL) against the three forms.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param cablePos - cable position of the sentence
' @param sentence - the wiring sentence at that cable position
' @returns mistakeCount - number of wiring problems reported

' Local Variables:
' @local nbrBits - the neighbour words of the sentence
' @local dirBits - the direction words of the sentence
' @local arrowBits - the arrow words of the sentence
' @local bNbrDone - TRUE once the neighbour field has been reported on
' @local bDirDone - TRUE once the direction field has been reported on
' @local bArrowDone - TRUE once the arrow field has been reported on
' @local nbrPos - cable position named as the neighbour

    mistakeCount := 0
    nbrBits := sentence & hwEnum.NEIGHBOR_MASK
    dirBits := sentence & hwEnum.DIRECTION_MASK
    arrowBits := sentence & hwEnum.ARROW_MASK
    if (sentence & !WIRING_WORD_BITS) <> 0
        ' a carry out of the top word (NO_PANEL + NO_PANEL), or a value that is no sentence
        reportSentence(nChainIdx, cablePos, @"has bits that no wiring word uses; join the words with | only, never +")
        mistakeCount++
    elseif (sentence & hwEnum.NO_PANEL) <> 0
        reportSentence(nChainIdx, cablePos, @"joins NO_PANEL with other words; NO_PANEL stands alone")
        mistakeCount++
    elseif cablePos == FIRST_CABLE_POSITION
        if (sentence & hwEnum.FIRST_PANEL) == 0
            reportSentence(nChainIdx, cablePos, @msgC0NotFirst)
            mistakeCount++
        else
            if (dirBits | nbrBits) <> 0
                reportSentence(nChainIdx, cablePos, @"takes only FIRST_PANEL and an arrow; remove its direction and neighbour words")
                mistakeCount++
            mistakeCount += checkWordCount(nChainIdx, cablePos, arrowBits, @msgNoArrow, @msgManyArrows)
    elseif (sentence & hwEnum.FIRST_PANEL) <> 0
        if arrowBits == 0 and dirBits <> 0 and nbrBits <> 0
            ' ARROW_RIGHT + ARROW_RIGHT carries into FIRST_PANEL
            reportSentence(nChainIdx, cablePos, @msgPlusCarry)
        else
            reportSentence(nChainIdx, cablePos, @"uses FIRST_PANEL, which belongs only to C0; write direction | neighbour | arrow")
        mistakeCount++
    else
        bNbrDone := bDirDone := bArrowDone := FALSE
        ' a word joined to itself with + carries into the lowest word of the next kind:
        ' C15 + C15 becomes ABOVE, RIGHT_OF + RIGHT_OF becomes ARROW_UP
        if nbrBits == 0 and (dirBits & hwEnum.ABOVE) <> 0 and (ONES dirBits) > ONE_WORD
            reportSentence(nChainIdx, cablePos, @msgPlusCarry)
            mistakeCount++
            bNbrDone := bDirDone := TRUE
        elseif dirBits == 0 and (arrowBits & hwEnum.ARROW_UP) <> 0 and (ONES arrowBits) > ONE_WORD
            reportSentence(nChainIdx, cablePos, @msgPlusCarry)
            mistakeCount++
            bDirDone := bArrowDone := TRUE
        if bDirDone == FALSE
            mistakeCount += checkWordCount(nChainIdx, cablePos, dirBits, @"has no direction word; add one of ABOVE, BELOW, LEFT_OF, RIGHT_OF", @"has more than one direction word; use exactly one of ABOVE, BELOW, LEFT_OF, RIGHT_OF")
        if bNbrDone == FALSE
            mistakeCount += checkWordCount(nChainIdx, cablePos, nbrBits, @"has no neighbour word; add the cable position (C0 .. C15) of the panel it sits next to", @"has more than one neighbour word; use exactly one of C0 .. C15")
        if bArrowDone == FALSE
            mistakeCount += checkWordCount(nChainIdx, cablePos, arrowBits, @msgNoArrow, @msgManyArrows)
        ' count the neighbour bits before converting them: ENCOD of an empty field is C0
        if (ONES nbrBits) == ONE_WORD
            nbrPos := ENCOD nbrBits
            if nbrPos == cablePos
                reportSentence(nChainIdx, cablePos, @"names itself as its neighbour; name the panel it sits next to")
                mistakeCount++
            elseif wiringSentence(nChainIdx, nbrPos) == hwEnum.NO_PANEL
                reportSentenceRef(nChainIdx, cablePos, @"names C", nbrPos, @" as its neighbour, but that cable position is NO_PANEL")
                mistakeCount++

PRI checkWordCount(nChainIdx, cablePos, fieldBits, pNoneText, pManyText) : mistakeCount
' Report a field of a sentence that holds no word, or more than one word.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param cablePos - cable position of the sentence
' @param fieldBits - the bits of one kind of word, taken from the sentence
' @param pNoneText - message for a field that holds no word
' @param pManyText - message for a field that holds more than one word
' @returns mistakeCount - number of wiring problems reported (0 or 1)

    mistakeCount := 0
    if fieldBits == 0
        reportSentence(nChainIdx, cablePos, pNoneText)
        mistakeCount++
    elseif (ONES fieldBits) > ONE_WORD
        reportSentence(nChainIdx, cablePos, pManyText)
        mistakeCount++

PRI checkPanelLimit(nChainIdx, panelCount) : mistakeCount | panelCols, columnFactor, panelLimit, driverFlags
' Report a display with more panels than the driver limit for its panel type.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param panelCount - number of cable positions in use (not NO_PANEL)
' @returns mistakeCount - number of wiring problems reported (0 or 1)

' Local Variables:
' @local panelCols - pixel columns per individual panel
' @local columnFactor - columns the refresh core shifts per panel column
' @local panelLimit - the most panels of this type one adapter can drive
' @local driverFlags - combined driver capability flags for the chip type

    mistakeCount := 0
    panelCols := columnsPerPanel(nChainIdx)
    driverFlags, _ := getDriverFlags(nChainIdx)                ' the chip type is not needed here
    columnFactor := SINGLE_COLUMN_FACTOR
    if (driverFlags & hwEnum.SCAN_4) <> 0
        columnFactor := SCAN_4_COLUMN_FACTOR
    panelLimit := (LINE_BUFFER_MAX_COLUMNS / (panelCols * columnFactor)) <# CONVERTER_MAX_PANELS
    if panelCount > panelLimit
        debug("HUB75: DISP", udec_(nChainIdx), ": ", udec_(panelCount), " panels exceed the driver limit of ", udec_(panelLimit), " for panels ", udec_(panelCols), " columns wide; one row along the cable would be ", udec_(panelCount * panelCols * columnFactor), " columns, and the refresh line buffer holds ", udec_(LINE_BUFFER_MAX_COLUMNS))
        mistakeCount++

PRI checkShape(nChainIdx, panelCount) : mistakeCount | eShape, panelRows, panelCols, topCount, topCable, frontCount, frontCable
' Check the display's shape settings: DISPn_SHAPE is one of the two shapes, and a cube has
' exactly six square panels and names its top and front faces with two different cable
' positions in use. Whether the net folds into a cube, and whether the front shares an edge
' with the top, is checked after the walk, by foldNet().
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param panelCount - number of cable positions in use (not NO_PANEL)
' @returns mistakeCount - number of problems reported

' Local Variables:
' @local eShape - the DISPn_SHAPE setting
' @local panelRows - pixel rows per individual panel
' @local panelCols - pixel columns per individual panel
' @local topCount - problems reported for DISPn_CUBE_TOP (0 or 1)
' @local topCable - cable position named by DISPn_CUBE_TOP, or NO_POSITION
' @local frontCount - problems reported for DISPn_CUBE_FRONT (0 or 1)
' @local frontCable - cable position named by DISPn_CUBE_FRONT, or NO_POSITION

    mistakeCount := 0
    eShape := cubeSetting(nChainIdx, CUBE_SHAPE_OFST)
    if eShape == hwEnum.SHAPE_CUBE
        if panelCount <> CUBE_FACES
            debug("HUB75: DISP", udec_(nChainIdx), ": a cube needs exactly ", udec_(CUBE_FACES), " panels, but ", udec_(panelCount), " are in use")
            mistakeCount++
        panelRows, panelCols := panelSizeInPixels(nChainIdx)
        if panelRows <> panelCols
            debug("HUB75: DISP", udec_(nChainIdx), ": a cube needs square panels, but each panel is ", udec_(panelCols), " columns x ", udec_(panelRows), " rows (DISP", udec_(nChainIdx), "_MAX_PANEL_COLUMNS, DISP", udec_(nChainIdx), "_MAX_PANEL_ROWS)")
            mistakeCount++
        topCount, topCable := checkCubeFace(nChainIdx, panelCount, CUBE_TOP_OFST, @"TOP", @"top")
        frontCount, frontCable := checkCubeFace(nChainIdx, panelCount, CUBE_FRONT_OFST, @"FRONT", @"front")
        mistakeCount += topCount + frontCount
        if topCount == 0 and frontCount == 0 and topCable == frontCable
            debug("HUB75: DISP", udec_(nChainIdx), "_CUBE_FRONT: names the same panel as DISP", udec_(nChainIdx), "_CUBE_TOP; the front face is a different panel that shares an edge with the top face")
            mistakeCount++
    elseif eShape <> hwEnum.SHAPE_FLAT
        debug("HUB75: DISP", udec_(nChainIdx), ": DISP", udec_(nChainIdx), "_SHAPE must be SHAPE_FLAT or SHAPE_CUBE")
        mistakeCount++

PRI checkCubeFace(nChainIdx, panelCount, settingOfst, pFaceName, pFaceWord) : mistakeCount, cablePos | setting
' Check one cube face setting (DISPn_CUBE_TOP or DISPn_CUBE_FRONT): it is exactly one of the
' words C0 .. C15, and it names a cable position in use.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param panelCount - number of cable positions in use (not NO_PANEL)
' @param settingOfst - CUBE_TOP_OFST or CUBE_FRONT_OFST
' @param pFaceName - the setting's name after DISPn_CUBE_ ("TOP" or "FRONT")
' @param pFaceWord - the face, as the message names it ("top" or "front")
' @returns mistakeCount - number of problems reported (0 or 1)
' @returns cablePos - the cable position the setting names, or NO_POSITION when it is not valid

' Local Variables:
' @local setting - the setting's value

    mistakeCount := 0
    cablePos := NO_POSITION
    setting := cubeSetting(nChainIdx, settingOfst)
    ' count the bits before converting them: ENCOD of an empty value is C0
    if (setting & !hwEnum.NEIGHBOR_MASK) <> 0 or (ONES setting) <> ONE_WORD
        debug("HUB75: DISP", udec_(nChainIdx), "_CUBE_", zstr_(pFaceName), ": must be exactly one of C0 .. C5, the cable position of the ", zstr_(pFaceWord), " face")
        mistakeCount++
    else
        cablePos := ENCOD setting
        if cablePos >= panelCount
            debug("HUB75: DISP", udec_(nChainIdx), "_CUBE_", zstr_(pFaceName), ": names C", udec_(cablePos), ", but that cable position is NO_PANEL")
            mistakeCount++
            cablePos := NO_POSITION

PRI ignoreCubeRotation(nChainIdx) | pEntry
' A cube is not rotated: when DISPn_ROTATION is not ROT_NONE, say that it is ignored (a notice,
' not a mistake), then record ROT_NONE in the descriptor, so the mounted tables, the per-pixel
' path and displayRotation() all see a cube as unrotated.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)

' Local Variables:
' @local pEntry - pointer to the chain descriptor table entry

    pEntry := ptrTableEntry(nChainIdx)
    if LONG[pEntry][ENTR_ROTATION_OFST] <> ROT_NONE
        debug("HUB75: DISP", udec_(nChainIdx), ": DISP", udec_(nChainIdx), "_ROTATION does not apply to a cube and is ignored")
        LONG[pEntry][ENTR_ROTATION_OFST] := ROT_NONE

PRI placePanels(nChainIdx, panelCount) : mistakeCount | cablePos, nbrPos, otherPos, sentence, rowStep, colStep, bPlacedOne
' Find each panel's grid cell by walking the neighbour links out from C0, and report
' two panels in one cell and panels that do not connect back to C0.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param panelCount - number of cable positions in use (C0 .. C(N-1), no gaps)
' @returns mistakeCount - number of wiring problems reported

' Local Variables:
' @local cablePos - cable position being placed
' @local nbrPos - cable position of its neighbour
' @local otherPos - cable position of a panel already in the same cell
' @local sentence - the wiring sentence at that cable position
' @local rowStep - grid row step from the neighbour to this panel
' @local colStep - grid column step from the neighbour to this panel
' @local bPlacedOne - TRUE when a pass placed at least one panel

    mistakeCount := 0
    longfill(@cablePlaced, FALSE, MAX_CABLE_POSITIONS)
    cableCellRow[FIRST_CABLE_POSITION] := 0
    cableCellColumn[FIRST_CABLE_POSITION] := 0
    cablePlaced[FIRST_CABLE_POSITION] := TRUE
    ' a neighbour may come later in the cable, so repeat until a pass places nothing
    repeat
        bPlacedOne := FALSE
        repeat cablePos from 0 to panelCount - 1
            if cablePlaced[cablePos] == FALSE
                sentence := wiringSentence(nChainIdx, cablePos)
                nbrPos := ENCOD (sentence & hwEnum.NEIGHBOR_MASK)
                if cablePlaced[nbrPos] == TRUE
                    rowStep, colStep := cellStepForDirection(sentence & hwEnum.DIRECTION_MASK)
                    cableCellRow[cablePos] := cableCellRow[nbrPos] + rowStep
                    cableCellColumn[cablePos] := cableCellColumn[nbrPos] + colStep
                    otherPos := cableInCell(panelCount, cableCellRow[cablePos], cableCellColumn[cablePos])
                    if otherPos <> NO_POSITION
                        reportSentenceRef(nChainIdx, cablePos, @"sits in the same cell as C", otherPos, @emptyText)
                        mistakeCount++
                    cablePlaced[cablePos] := TRUE
                    bPlacedOne := TRUE
    while bPlacedOne == TRUE
    repeat cablePos from 0 to panelCount - 1
        if cablePlaced[cablePos] == FALSE
            reportSentence(nChainIdx, cablePos, @"does not connect back to C0 through its neighbours")
            mistakeCount++

PRI cableInCell(panelCount, cellRow, cellColumn) : otherPos | cablePos
' Return the cable position of a placed panel in the given cell, or NO_POSITION.
'
' @param panelCount - number of cable positions in use
' @param cellRow - grid row, relative to C0
' @param cellColumn - grid column, relative to C0
' @returns otherPos - cable position of the panel in that cell, or NO_POSITION

' Local Variables:
' @local cablePos - cable position being compared

    otherPos := NO_POSITION
    repeat cablePos from 0 to panelCount - 1
        if cablePlaced[cablePos] == TRUE and cableCellRow[cablePos] == cellRow and cableCellColumn[cablePos] == cellColumn
            otherPos := cablePos
            quit

PRI buildLayoutTables(nChainIdx, panelCount) | cablePos, minRow, maxRow, minCol, maxCol, gridRows, gridCols, cellIdx, posn, tableBase, cellBase, panelRows, panelCols
' Derive the bounding box, number the panels in reading order, and build the lookup
' tables the drawing path uses. Runs once, at startup.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param panelCount - number of cable positions in use (C0 .. C(N-1), all placed)

' Local Variables:
' @local cablePos - cable position of a panel
' @local minRow - top grid row, relative to C0
' @local maxRow - bottom grid row, relative to C0
' @local minCol - left grid column, relative to C0
' @local maxCol - right grid column, relative to C0
' @local gridRows - bounding box height, in panels
' @local gridCols - bounding box width, in panels
' @local cellIdx - cell index (row x grid columns + column)
' @local posn - panel position being numbered
' @local tableBase - first entry of this adapter in the per-position tables
' @local cellBase - first entry of this adapter in the grid table
' @local panelRows - pixel rows of one cell
' @local panelCols - pixel columns of one cell

    minRow := maxRow := cableCellRow[FIRST_CABLE_POSITION]
    minCol := maxCol := cableCellColumn[FIRST_CABLE_POSITION]
    repeat cablePos from 0 to panelCount - 1
        minRow <#= cableCellRow[cablePos]
        maxRow #>= cableCellRow[cablePos]
        minCol <#= cableCellColumn[cablePos]
        maxCol #>= cableCellColumn[cablePos]
    gridRows := maxRow - minRow + 1
    gridCols := maxCol - minCol + 1

    tableBase := nChainIdx * MAX_CABLE_POSITIONS
    cellBase := nChainIdx * MAX_GRID_CELLS
    bytefill(@positionToSlot[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@positionToRotation[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@positionToCellRow[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@positionToCellCol[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@cableToPosition[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@cellToPosition[cellBase], NO_POSITION, MAX_GRID_CELLS)

    ' first mark each occupied cell with the cable position of its panel
    repeat cablePos from 0 to panelCount - 1
        cellIdx := (cableCellRow[cablePos] - minRow) * gridCols + (cableCellColumn[cablePos] - minCol)
        cellToPosition[cellBase + cellIdx] := cablePos

    ' then number the panels in reading order over the layout (L), replacing each cable position
    ' with its layout position; buildMountedTables() renumbers them as mounted (P)
    posn := 0
    repeat cellIdx from 0 to (gridRows * gridCols) - 1
        cablePos := cellToPosition[cellBase + cellIdx]
        if cablePos <> NO_POSITION
            positionToSlot[tableBase + posn] := panelCount - 1 - cablePos
            positionToRotation[tableBase + posn] := rotationForArrow(wiringSentence(nChainIdx, cablePos) & hwEnum.ARROW_MASK)
            positionToCellRow[tableBase + posn] := cellIdx / gridCols
            positionToCellCol[tableBase + posn] := cellIdx // gridCols
            cellToPosition[cellBase + cellIdx] := posn
            posn++

    ' the cell size follows C0's arrow: a panel turned sideways shows its columns as rows
    ' (checkArrowAxes makes every arrow agree with C0's unless the panels are square)
    panelRows, panelCols := panelSizeInPixels(nChainIdx)
    if (wiringSentence(nChainIdx, FIRST_CABLE_POSITION) & SIDEWAYS_ARROWS) <> 0
        panelRows, panelCols := panelCols, panelRows
    layoutPanelCount[nChainIdx] := panelCount
    layoutGridRows[nChainIdx] := gridRows
    layoutGridColumns[nChainIdx] := gridCols
    layoutPixelRows[nChainIdx] := gridRows * panelRows
    layoutPixelColumns[nChainIdx] := gridCols * panelCols
    layoutCellRows[nChainIdx] := panelRows
    layoutCellColumns[nChainIdx] := panelCols
    buildMountedTables(nChainIdx, panelCount)

PRI buildMountedTables(nChainIdx, panelCount) | eRotation, gridRows, gridCols, mountedRows, mountedCols, posn, mountedPosn, cellRow, cellCol, mountedRow, mountedCol, cellIdx, tableBase, cellBase
' Derive the display as mounted from the layout tables: turn each panel's cell by the display
' rotation, then number the panels in reading order over the mounted grid. This is the one
' mounting table; the drawing path reads it and never works out the mounting per pixel.
' Runs once, at startup, after buildLayoutTables() has built the layout tables.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param panelCount - number of cable positions in use (C0 .. C(N-1), all placed)

' Local Variables:
' @local eRotation - the display rotation: how the display is mounted
' @local gridRows - layout bounding box height, in panels
' @local gridCols - layout bounding box width, in panels
' @local mountedRows - mounted bounding box height, in panels
' @local mountedCols - mounted bounding box width, in panels
' @local posn - panel position in the layout's reading order (L)
' @local mountedPosn - panel position in reading order as mounted (P)
' @local cellRow - layout grid row of the panel's cell
' @local cellCol - layout grid column of the panel's cell
' @local mountedRow - mounted grid row of the panel's cell
' @local mountedCol - mounted grid column of the panel's cell
' @local cellIdx - cell index in the mounted grid (row x grid columns + column)
' @local tableBase - first entry of this adapter in the per-position tables
' @local cellBase - first entry of this adapter in the grid tables

    eRotation := displayRotation(nChainIdx)
    gridRows := layoutGridRows[nChainIdx]
    gridCols := layoutGridColumns[nChainIdx]
    mountedRows, mountedCols := gridRows, gridCols
    mountedPixelRows[nChainIdx] := layoutPixelRows[nChainIdx]
    mountedPixelColumns[nChainIdx] := layoutPixelColumns[nChainIdx]
    mountedCellRows[nChainIdx] := layoutCellRows[nChainIdx]
    mountedCellColumns[nChainIdx] := layoutCellColumns[nChainIdx]
    if eRotation == ROT_LEFT_90 or eRotation == ROT_RIGHT_90
        ' hung turned sideways: rows and columns exchange everywhere
        mountedRows, mountedCols := gridCols, gridRows
        mountedPixelRows[nChainIdx] := layoutPixelColumns[nChainIdx]
        mountedPixelColumns[nChainIdx] := layoutPixelRows[nChainIdx]
        mountedCellRows[nChainIdx] := layoutCellColumns[nChainIdx]
        mountedCellColumns[nChainIdx] := layoutCellRows[nChainIdx]
    mountedGridColumns[nChainIdx] := mountedCols

    tableBase := nChainIdx * MAX_CABLE_POSITIONS
    cellBase := nChainIdx * MAX_GRID_CELLS
    bytefill(@mountedToLayout[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@mountedCellRow[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@mountedCellCol[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@cableToPosition[tableBase], NO_POSITION, MAX_CABLE_POSITIONS)
    bytefill(@mountedCellToPosition[cellBase], NO_POSITION, MAX_GRID_CELLS)

    ' first turn each panel's cell as the display is mounted, and mark it with its layout position;
    ' this is the cell form of the pixel rule in isp_hub75_screenUtils.drawPixelAtRCwithRGB
    repeat posn from 0 to panelCount - 1
        cellRow := positionToCellRow[tableBase + posn]
        cellCol := positionToCellCol[tableBase + posn]
        case eRotation
            ROT_RIGHT_90:
                ' the layout's left edge is the mounted top, its bottom edge the mounted left
                mountedRow := cellCol
                mountedCol := (gridRows - 1) - cellRow
            ROT_LEFT_90:
                ' the layout's right edge is the mounted top, its top edge the mounted left
                mountedRow := (gridCols - 1) - cellCol
                mountedCol := cellRow
            ROT_180:
                mountedRow := (gridRows - 1) - cellRow
                mountedCol := (gridCols - 1) - cellCol
            other:
                mountedRow := cellRow
                mountedCol := cellCol
        mountedCellToPosition[cellBase + (mountedRow * mountedCols) + mountedCol] := posn

    ' then number the panels in reading order as mounted, replacing each layout position with its panel position
    mountedPosn := 0
    repeat cellIdx from 0 to (mountedRows * mountedCols) - 1
        posn := mountedCellToPosition[cellBase + cellIdx]
        if posn <> NO_POSITION
            mountedToLayout[tableBase + mountedPosn] := posn
            mountedCellRow[tableBase + mountedPosn] := cellIdx / mountedCols
            mountedCellCol[tableBase + mountedPosn] := cellIdx // mountedCols
            cableToPosition[tableBase + (panelCount - 1 - positionToSlot[tableBase + posn])] := mountedPosn
            mountedCellToPosition[cellBase + cellIdx] := mountedPosn
            mountedPosn++

PRI printLayout(nChainIdx) | panelCount, gridRows, gridCols, rowIdx, colIdx, posn, cablePos, lineLen, tableBase, cellBase, bWide, layoutPosn
' Print the derived picture (the layout, one line per grid row), then the lookup tables
' (panel positions as mounted).
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)

' Local Variables:
' @local panelCount - number of panels in use
' @local gridRows - bounding box height, in panels
' @local gridCols - bounding box width, in panels
' @local rowIdx - grid row being printed
' @local colIdx - grid column being printed
' @local posn - panel position of a cell
' @local cablePos - cable position of a panel
' @local lineLen - characters written to the picture line so far
' @local tableBase - first entry of this adapter in the per-position tables
' @local cellBase - first entry of this adapter in the grid table
' @local bWide - TRUE when cable numbers can have two digits
' @local layoutPosn - panel position in the layout's reading order of the panel at a mounted position

    panelCount := layoutPanelCount[nChainIdx]
    gridRows := layoutGridRows[nChainIdx]
    gridCols := layoutGridColumns[nChainIdx]
    tableBase := nChainIdx * MAX_CABLE_POSITIONS
    cellBase := nChainIdx * MAX_GRID_CELLS
    bWide := panelCount > DECIMAL_BASE
    debug("HUB75: DISP", udec_(nChainIdx), " wiring: ", udec_(panelCount), " panels in a grid of ", udec_(gridRows), " rows x ", udec_(gridCols), " columns, ", udec_(layoutPixelColumns[nChainIdx]), " x ", udec_(layoutPixelRows[nChainIdx]), " pixels (columns x rows)")
    repeat rowIdx from 0 to gridRows - 1
        lineLen := 0
        repeat colIdx from 0 to gridCols - 1
            posn := cellToPosition[cellBase + (rowIdx * gridCols) + colIdx]
            if posn == NO_POSITION
                lineLen := appendText(lineLen, @emptyCellText)
                if bWide == TRUE
                    pictureLine[lineLen++] := " "
            else
                cablePos := panelCount - 1 - positionToSlot[tableBase + posn]
                lineLen := appendPanelCell(lineLen, cablePos, positionToRotation[tableBase + posn], bWide)
        pictureLine[lineLen] := 0
        debug("HUB75: DISP", udec_(nChainIdx), "   ", zstr_(@pictureLine))
    ' one line per panel position as mounted (P); the cell, slot and rotation are the layout's
    repeat posn from 0 to panelCount - 1
        layoutPosn := mountedToLayout[tableBase + posn]
        cablePos := panelCount - 1 - positionToSlot[tableBase + layoutPosn]
        debug("HUB75: DISP", udec_(nChainIdx), " P", udec_(posn), " = C", udec_(cablePos), ", buffer slot ", udec_(positionToSlot[tableBase + layoutPosn]), ", cell row ", udec_(positionToCellRow[tableBase + layoutPosn]), " column ", udec_(positionToCellCol[tableBase + layoutPosn]), ", rotation ", udec_((positionToRotation[tableBase + layoutPosn] - hwEnum.ROT_0) * DEGREES_PER_QUARTER))
    ' the inverse table, as identify will read it
    lineLen := 0
    repeat cablePos from 0 to panelCount - 1
        lineLen := appendText(lineLen, @" C")
        lineLen := appendNumber(lineLen, cablePos)
        lineLen := appendText(lineLen, @"->P")
        lineLen := appendNumber(lineLen, cableToPosition[tableBase + cablePos])
    pictureLine[lineLen] := 0
    debug("HUB75: DISP", udec_(nChainIdx), " cable -> panel position:", zstr_(@pictureLine))

PRI printCube(nChainIdx) | faceIdx, edge, pFace, pEdge, lineLen
' Print the folded cube, one line per face: its cable and panel positions, the direction its
' up points within its cell of the flat picture, and the face and edge across each of its
' four edges. The six lines together are the 24 entries of the edge table.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)

' Local Variables:
' @local faceIdx - the face being printed (0 = TOP .. 5 = RIGHT)
' @local edge - one of the face's edges (EDGE_N .. EDGE_W)
' @local pFace - pointer to the face's record in the face table
' @local pEdge - pointer to the edge's record in the edge table
' @local lineLen - characters written to the picture line so far

    repeat faceIdx from FACE_IDX_TOP to FACE_IDX_RIGHT
        pFace := @cubeFaces[faceRecordIndex(nChainIdx, faceIdx)]
        lineLen := appendText(0, faceNameText(faceIdx))
        lineLen := appendText(lineLen, @" = C")
        lineLen := appendNumber(lineLen, LONG[pFace][FACE_CABLE])
        lineLen := appendText(lineLen, @" (P")
        lineLen := appendNumber(lineLen, LONG[pFace][FACE_POSITION])
        lineLen := appendText(lineLen, @", up ")
        pictureLine[lineLen++] := faceUpArrows[LONG[pFace][FACE_TURN]]
        lineLen := appendText(lineLen, @"):")
        repeat edge from EDGE_N to EDGE_W
            pEdge := @cubeEdges[edgeRecordIndex(nChainIdx, faceIdx, edge)]
            pictureLine[lineLen++] := " "
            pictureLine[lineLen++] := edgeLetters[edge]
            lineLen := appendText(lineLen, @"->")
            lineLen := appendText(lineLen, faceNameText(LONG[pEdge][EDGE_NEIGHBOUR]))
            pictureLine[lineLen++] := "."
            pictureLine[lineLen++] := edgeLetters[LONG[pEdge][EDGE_ENTRY]]
        pictureLine[lineLen] := 0
        debug("HUB75: DISP", udec_(nChainIdx), " cube ", zstr_(@pictureLine))

PRI appendPanelCell(lineLen, cablePos, ePanelRotation, bWide) : newLen
' Append one panel's cell, such as "[C2 v]", to the picture line.
'
' @param lineLen - characters written to the picture line so far
' @param cablePos - cable position of the panel
' @param ePanelRotation - panel rotation enum (hwEnum.ROT_*)
' @param bWide - TRUE when cable numbers can have two digits
' @returns newLen - characters written to the picture line after this cell

    newLen := lineLen
    pictureLine[newLen++] := "["
    pictureLine[newLen++] := "C"
    newLen := appendNumber(newLen, cablePos)
    if bWide == TRUE and cablePos < DECIMAL_BASE
        pictureLine[newLen++] := " "
    pictureLine[newLen++] := " "
    pictureLine[newLen++] := arrowCharForRotation(ePanelRotation)
    pictureLine[newLen++] := "]"

PRI appendNumber(lineLen, number) : newLen
' Append a number from 0 to 99 to the picture line.
'
' @param lineLen - characters written to the picture line so far
' @param number - the number to append
' @returns newLen - characters written to the picture line after the number

    newLen := lineLen
    if number >= DECIMAL_BASE
        pictureLine[newLen++] := "0" + number / DECIMAL_BASE
    pictureLine[newLen++] := "0" + number // DECIMAL_BASE

PRI appendText(lineLen, pText) : newLen
' Append a zero-terminated string to the picture line.
'
' @param lineLen - characters written to the picture line so far
' @param pText - pointer to the zero-terminated string
' @returns newLen - characters written to the picture line after the string

    newLen := lineLen
    repeat while BYTE[pText] <> 0
        pictureLine[newLen++] := BYTE[pText++]

PRI haltAfterMistakes(nChainIdx, mistakeCount) | cogIdx
' Stop the program after the wiring messages: print the count and the end-of-session
' marker, stop every other cog, then stop this one.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param mistakeCount - number of wiring problems reported

' Local Variables:
' @local cogIdx - cog being stopped

    debug("HUB75: DISP", udec_(nChainIdx), ": ", udec_(mistakeCount), " wiring problem(s) above; startup stopped")
    waitms(HALT_DRAIN_MS)
    debug("END_SESSION")
    repeat cogIdx from 0 to LAST_COG_ID
        if cogIdx <> cogid()
            cogstop(cogIdx)
    cogstop(cogid())

PRI reportSentence(nChainIdx, cablePos, pMessage)
' Print one wiring problem for the sentence at one cable position.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param cablePos - cable position of the sentence
' @param pMessage - pointer to the zero-terminated message

    debug("HUB75: DISP", udec_(nChainIdx), "_C", udec_(cablePos), ": ", zstr_(pMessage))

PRI reportSentenceRef(nChainIdx, cablePos, pBefore, otherCablePos, pAfter) | lineLen
' Print one wiring problem that names a second cable position. The message is built in
' the picture line first, because DEBUG separates consecutive values with commas.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param cablePos - cable position of the sentence
' @param pBefore - pointer to the message text before the second cable number
' @param otherCablePos - the second cable position
' @param pAfter - pointer to the message text after the second cable number

' Local Variables:
' @local lineLen - characters written to the picture line so far

    lineLen := appendText(0, pBefore)
    lineLen := appendNumber(lineLen, otherCablePos)
    lineLen := appendText(lineLen, pAfter)
    pictureLine[lineLen] := 0
    reportSentence(nChainIdx, cablePos, @pictureLine)

PRI wiringSentence(nChainIdx, cablePos) : sentence
' Return the wiring sentence DISPn_Ck of one display.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param cablePos - cable position (0 .. MAX_CABLE_POSITIONS - 1)
' @returns sentence - the wiring sentence at that cable position

    sentence := wiringSentences[(nChainIdx * MAX_CABLE_POSITIONS) + cablePos]

PRI cellStepForDirection(dirBits) : rowStep, colStep
' Return the grid step from a panel's neighbour to the panel, for one direction word.
'
' @param dirBits - the direction word of the sentence
' @returns rowStep - grid row step (rows grow downward)
' @returns colStep - grid column step (columns grow rightward)

    rowStep := colStep := STEP_NONE
    case dirBits
        hwEnum.ABOVE:
            rowStep := STEP_BACK
        hwEnum.BELOW:
            rowStep := STEP_FORWARD
        hwEnum.LEFT_OF:
            colStep := STEP_BACK
        hwEnum.RIGHT_OF:
            colStep := STEP_FORWARD

PRI rotationForArrow(arrowBits) : ePanelRotation
' Return the panel rotation for one arrow word: the arrow is the direction the panel's
' own "up" points, as the viewer sees it.
'
' @param arrowBits - the arrow word of the sentence
' @returns ePanelRotation - panel rotation enum (hwEnum.ROT_*)

    ePanelRotation := hwEnum.ROT_0
    case arrowBits
        hwEnum.ARROW_DOWN:
            ePanelRotation := hwEnum.ROT_180
        hwEnum.ARROW_LEFT:
            ePanelRotation := hwEnum.ROT_LEFT_90                ' up turned to the left: 90 degrees counter-clockwise
        hwEnum.ARROW_RIGHT:
            ePanelRotation := hwEnum.ROT_RIGHT_90               ' up turned to the right: 90 degrees clockwise

PRI arrowCharForRotation(ePanelRotation) : arrowChar
' Return the character that draws a panel's arrow in the printed picture.
'
' @param ePanelRotation - panel rotation enum (hwEnum.ROT_*)
' @returns arrowChar - "^", "v", "<" or ">"

    arrowChar := "^"
    case ePanelRotation
        hwEnum.ROT_180:
            arrowChar := "v"
        hwEnum.ROT_LEFT_90:
            arrowChar := "<"
        hwEnum.ROT_RIGHT_90:
            arrowChar := ">"

PRI panelCoordsAt(layoutIdx, row, column) : panelPosn, panelRow, panelCol | cellRows, cellCols
' Find the panel that holds display coordinates (row, column), and the pixel's panel
' coordinates within it, by table lookup in the display's grid. A pixel outside the
' display's bounding box, or in a cell that holds no panel, has no panel.
'
' @param layoutIdx - the chain index, already checked against the adapters that exist
' @param row - pixel row on the display (display coordinates)
' @param column - pixel column on the display (display coordinates)
' @returns panelPosn - panel position (P) of the panel that holds the pixel, or NO_POSITION
' @returns panelRow - row within that panel, as the viewer sees it
' @returns panelCol - column within that panel, as the viewer sees it

' Local Variables:
' @local cellRows - pixel rows of one cell of the grid
' @local cellCols - pixel columns of one cell of the grid

    panelPosn := NO_POSITION
    panelRow := panelCol := 0
    if row >= 0 and column >= 0 and row < layoutPixelRows[layoutIdx] and column < layoutPixelColumns[layoutIdx]
        cellRows := layoutCellRows[layoutIdx]
        cellCols := layoutCellColumns[layoutIdx]
        panelPosn := cellToPosition[(layoutIdx * MAX_GRID_CELLS) + ((row / cellRows) * layoutGridColumns[layoutIdx]) + (column / cellCols)]
        panelRow := row // cellRows
        panelCol := column // cellCols

PRI cubeSetting(nChainIdx, settingOfst) : settingValue
' Return one cube setting of one display.
'
' @param nChainIdx - the index of the desired chain of panels (hub75 adapter)
' @param settingOfst - CUBE_SHAPE_OFST, CUBE_TOP_OFST or CUBE_FRONT_OFST
' @returns settingValue - DISPn_SHAPE, DISPn_CUBE_TOP or DISPn_CUBE_FRONT

    settingValue := cubeSettings[(nChainIdx * CUBE_SETTING_LONGS) + settingOfst]

PRI foldPoint(layoutIdx, eFace, row, column) : faceIdx, faceRow, faceColumn | faceSize, bRowOff, bColumnOff, edge, pEdge
' Fold face coordinates onto the face that holds them. While exactly one coordinate is past
' the face, it crosses that edge (one quarter turn and two adds from the edge table). A fold
' keeps the coordinate along the edge on the face, so each crossing brings the other one face
' closer and the loop ends. A pixel past two edges of the face it is on at once is in a corner
' gap: it can only be met on the first test.
'
' @param layoutIdx - the chain index, already checked against the adapters that exist
' @param eFace - the face the coordinates are on (hwEnum.FACE_TOP .. hwEnum.FACE_RIGHT)
' @param row - pixel row on that face (any value)
' @param column - pixel column on that face (any value)
' @returns faceIdx - the face that holds the pixel (0 = TOP .. 5 = RIGHT), or NO_FACE_INDEX for a corner gap, an invalid face, or a display without faces
' @returns faceRow - the pixel's row on that face (0 when there is no face)
' @returns faceColumn - the pixel's column on that face (0 when there is no face)

' Local Variables:
' @local faceSize - pixel rows (and columns) of one face
' @local bRowOff - TRUE when the row is past the face
' @local bColumnOff - TRUE when the column is past the face
' @local edge - the edge the pixel lies past (EDGE_N .. EDGE_W)
' @local pEdge - pointer to that edge's record in the edge table

    faceRow := row
    faceColumn := column
    faceSize := cubeFaceSize[layoutIdx]
    faceIdx := eFace - hwEnum.FACE_TOP
    if faceSize == 0 or faceIdx < 0 or faceIdx >= CUBE_FACES
        faceIdx := NO_FACE_INDEX
    repeat while faceIdx <> NO_FACE_INDEX
        bRowOff := faceRow < 0 or faceRow >= faceSize
        bColumnOff := faceColumn < 0 or faceColumn >= faceSize
        if bRowOff == TRUE and bColumnOff == TRUE
            faceIdx := NO_FACE_INDEX                    ' a corner gap: no surface here
        elseif bRowOff == FALSE and bColumnOff == FALSE
            quit                                        ' on a face
        else
            if faceRow < 0
                edge := EDGE_N
            elseif faceRow >= faceSize
                edge := EDGE_S
            elseif faceColumn >= faceSize
                edge := EDGE_E
            else
                edge := EDGE_W
            ' (edgeRecordIndex() written in line, to keep a method call off every crossing)
            pEdge := @cubeEdges[((((layoutIdx * CUBE_FACES) + faceIdx) * FACE_EDGES) + edge) * EDGE_RECORD_LONGS]
            faceRow, faceColumn := turnFaceCoords(LONG[pEdge][EDGE_TURN], LONG[pEdge][EDGE_ADD_ROW], LONG[pEdge][EDGE_ADD_COL], faceRow, faceColumn)
            faceIdx := LONG[pEdge][EDGE_NEIGHBOUR]
    if faceIdx == NO_FACE_INDEX
        faceRow := faceColumn := 0

PRI rollNet(pCellRows, pCellColumns) | cablePos, nbrPos, rowStep, colStep, bRolledOne
' Roll a cube over the six cells of a net, folding every panel away from the viewer so the LED
' sides end up outward, and record each cable position's outward normal, up and right. C0
' starts facing the viewer: normal -Y, up +Z, right +X. A cable position takes the first folded
' cable position whose cell shares an edge with its own; passes repeat until one folds nothing.
' A cable position that shares no edge with a folded one keeps AXIS_NONE.
'
' @param pCellRows - address of LONG[6]: the grid row of each cable position's cell
' @param pCellColumns - address of LONG[6]: the grid column of each cable position's cell

' Local Variables:
' @local cablePos - cable position being folded
' @local nbrPos - a folded cable position it may sit next to
' @local rowStep - grid row step from that neighbour to the cable position
' @local colStep - grid column step from that neighbour to the cable position
' @local bRolledOne - TRUE when a pass folded at least one cable position

    bytefill(@rollNormal, AXIS_NONE, CUBE_FACES)
    bytefill(@rollUp, AXIS_NONE, CUBE_FACES)
    bytefill(@rollRight, AXIS_NONE, CUBE_FACES)
    rollNormal[FIRST_CABLE_POSITION] := AXIS_NEG_Y
    rollUp[FIRST_CABLE_POSITION] := AXIS_POS_Z
    rollRight[FIRST_CABLE_POSITION] := AXIS_POS_X
    repeat
        bRolledOne := FALSE
        repeat cablePos from FIRST_CABLE_POSITION + 1 to CUBE_FACES - 1
            if rollNormal[cablePos] == AXIS_NONE
                repeat nbrPos from FIRST_CABLE_POSITION to CUBE_FACES - 1
                    if rollNormal[nbrPos] <> AXIS_NONE
                        rowStep := LONG[pCellRows][cablePos] - LONG[pCellRows][nbrPos]
                        colStep := LONG[pCellColumns][cablePos] - LONG[pCellColumns][nbrPos]
                        if abs(rowStep) + abs(colStep) == NEIGHBOUR_DISTANCE
                            rollOnto(cablePos, nbrPos, rowStep, colStep)
                            bRolledOne := TRUE
                            quit
    while bRolledOne == TRUE

PRI rollOnto(cablePos, nbrPos, rowStep, colStep)
' Fold one cable position's panel away from the viewer about the edge it shares with a folded
' neighbour, and record its normal, up and right. Each step keeps right = up x normal.
'
' @param cablePos - cable position being folded
' @param nbrPos - the folded cable position whose cell shares an edge with it
' @param rowStep - grid row step from the neighbour (STEP_BACK = above it, STEP_FORWARD = below it)
' @param colStep - grid column step from the neighbour (STEP_BACK = left of it, STEP_FORWARD = right of it)

    if colStep == STEP_FORWARD
        ' right of the neighbour: it now faces the neighbour's right
        rollNormal[cablePos] := rollRight[nbrPos]
        rollUp[cablePos] := rollUp[nbrPos]
        rollRight[cablePos] := rollNormal[nbrPos] ^ AXIS_NEGATE_BIT
    elseif colStep == STEP_BACK
        ' left of the neighbour: it now faces the neighbour's left
        rollNormal[cablePos] := rollRight[nbrPos] ^ AXIS_NEGATE_BIT
        rollUp[cablePos] := rollUp[nbrPos]
        rollRight[cablePos] := rollNormal[nbrPos]
    elseif rowStep == STEP_BACK
        ' above the neighbour: it now faces the neighbour's up
        rollNormal[cablePos] := rollUp[nbrPos]
        rollUp[cablePos] := rollNormal[nbrPos] ^ AXIS_NEGATE_BIT
        rollRight[cablePos] := rollRight[nbrPos]
    else
        ' below the neighbour: it now faces the neighbour's down
        rollNormal[cablePos] := rollUp[nbrPos] ^ AXIS_NEGATE_BIT
        rollUp[cablePos] := rollNormal[nbrPos]
        rollRight[cablePos] := rollRight[nbrPos]

PRI findFoldCollision() : cableA, cableB | laterPos, earlierPos
' Find why a rolled net is not a cube net, if it is not. Six cells form one of the 11 cube nets
' exactly when the roll gives six different normals: a hexomino whose cells form a loop holds a
' 2 x 2 block, which folds two cells onto one face.
'
' @returns cableA - the earlier of the first two cable positions that fold onto one face, or NO_POSITION
' @returns cableB - the later of those two, or a cable position that never folded, or NO_POSITION when the net is a cube net

' Local Variables:
' @local laterPos - the later cable position of a pair
' @local earlierPos - the earlier cable position of a pair

    cableA := cableB := NO_POSITION
    repeat laterPos from FIRST_CABLE_POSITION to CUBE_FACES - 1
        if rollNormal[laterPos] == AXIS_NONE
            cableB := laterPos
            quit
    if cableB == NO_POSITION
        repeat laterPos from FIRST_CABLE_POSITION + 1 to CUBE_FACES - 1
            repeat earlierPos from FIRST_CABLE_POSITION to laterPos - 1
                if rollNormal[earlierPos] == rollNormal[laterPos]
                    cableA := earlierPos
                    cableB := laterPos
                    quit
            if cableB <> NO_POSITION
                quit

PRI buildFaceFrames(topCable, frontCable) | zAxis, yAxis, xAxis
' Name the six faces from the top and front cable positions and fix each face's frame. The
' world axes are Z = the top's normal (up), Y = away from the front (toward the back) and
' X = Y x Z (the viewer's right). The up directions are STABLE (see the table above the cube
' DAT): the sides' up points toward TOP, TOP's toward BACK and BOTTOM's toward FRONT.
'
' @param topCable - cable position of the top face
' @param frontCable - cable position of the front face (not on the top's axis)

' Local Variables:
' @local zAxis - the world up: the top face's normal
' @local yAxis - the world back: opposite the front face's normal
' @local xAxis - the world right, standing at the front

    zAxis := rollNormal[topCable]
    yAxis := rollNormal[frontCable] ^ AXIS_NEGATE_BIT
    xAxis := crossAxes(yAxis, zAxis)
    setFaceFrame(FACE_IDX_TOP, zAxis, yAxis)
    setFaceFrame(FACE_IDX_BOTTOM, zAxis ^ AXIS_NEGATE_BIT, yAxis ^ AXIS_NEGATE_BIT)
    setFaceFrame(FACE_IDX_FRONT, yAxis ^ AXIS_NEGATE_BIT, zAxis)
    setFaceFrame(FACE_IDX_BACK, yAxis, zAxis)
    setFaceFrame(FACE_IDX_LEFT, xAxis ^ AXIS_NEGATE_BIT, zAxis)
    setFaceFrame(FACE_IDX_RIGHT, xAxis, zAxis)

PRI setFaceFrame(faceIdx, normalAxis, upAxis)
' Record one face's frame: its outward normal, its up, and its right = up x normal.
'
' @param faceIdx - the face (FACE_IDX_TOP .. FACE_IDX_RIGHT)
' @param normalAxis - the face's outward normal (axis code)
' @param upAxis - the face's up (axis code)

    frameNormal[faceIdx] := normalAxis
    frameUp[faceIdx] := upAxis
    frameRight[faceIdx] := crossAxes(upAxis, normalAxis)

PRI buildFaceRecords(layoutIdx, pCellRows, pCellColumns, pCablePositions, faceSize) | minRow, minColumn, cablePos, faceIdx, turn, addRow, addColumn, pFace
' Build the face table: for each face, the cable position whose folded normal is the face's
' normal, that panel's position, the quarter turns that carry face coordinates into panel
' coordinates (how the face's up points within its cell of the flat picture), and the display
' coordinates of the panel's top-left pixel.
'
' @param layoutIdx - the chain index, already checked against the adapters that exist
' @param pCellRows - address of LONG[6]: the grid row of each cable position's cell
' @param pCellColumns - address of LONG[6]: the grid column of each cable position's cell
' @param pCablePositions - address of BYTE[6]: the panel position (P) of each cable position
' @param faceSize - pixel rows (and columns) of one face

' Local Variables:
' @local minRow - top grid row of the net
' @local minColumn - left grid column of the net
' @local cablePos - cable position of a face's panel
' @local faceIdx - the face being recorded
' @local turn - clockwise quarter turns from face coordinates to panel coordinates
' @local addRow - row added after the turn
' @local addColumn - column added after the turn
' @local pFace - pointer to the face's record in the face table

    minRow := LONG[pCellRows][FIRST_CABLE_POSITION]
    minColumn := LONG[pCellColumns][FIRST_CABLE_POSITION]
    repeat cablePos from FIRST_CABLE_POSITION to CUBE_FACES - 1
        minRow <#= LONG[pCellRows][cablePos]
        minColumn <#= LONG[pCellColumns][cablePos]
    repeat faceIdx from FACE_IDX_TOP to FACE_IDX_RIGHT
        cablePos := cableWithNormal(frameNormal[faceIdx])
        turn := turnInCell(cablePos, frameUp[faceIdx])
        addRow, addColumn := quarterTurnOffset(turn, faceSize)
        pFace := @cubeFaces[faceRecordIndex(layoutIdx, faceIdx)]
        LONG[pFace][FACE_CABLE] := cablePos
        LONG[pFace][FACE_POSITION] := BYTE[pCablePositions][cablePos]
        LONG[pFace][FACE_TURN] := turn
        LONG[pFace][FACE_ADD_ROW] := addRow
        LONG[pFace][FACE_ADD_COL] := addColumn
        LONG[pFace][FACE_ORIGIN_ROW] := (LONG[pCellRows][cablePos] - minRow) * faceSize
        LONG[pFace][FACE_ORIGIN_COL] := (LONG[pCellColumns][cablePos] - minColumn) * faceSize

PRI buildEdgeRecords(layoutIdx, faceSize) | faceIdx, edge, nbrFace, entry, candidate, turn, addRow, addColumn, stepRow, stepColumn, pEdge
' Build the edge table: for each edge of each face, the face across it, the neighbour's edge it
' meets, and the transform that carries this face's coordinates into the neighbour's. Moving
' out through edge e is moving in from the entered edge e', so the frame turns
' k = (e' + EDGE_OPPOSITE - e) quarter turns, and the face's extended plane then sits one face
' beyond e': add = (the quarter turn's offset) + faceSize x (the step out through e').
'
' @param layoutIdx - the chain index, already checked against the adapters that exist
' @param faceSize - pixel rows (and columns) of one face

' Local Variables:
' @local faceIdx - the face whose edges are recorded
' @local edge - one of its edges (EDGE_N .. EDGE_W)
' @local nbrFace - the face across that edge
' @local entry - the neighbour's edge that the edge meets
' @local candidate - one of the neighbour's edges, while searching for the entry
' @local turn - clockwise quarter turns from this face's frame to the neighbour's
' @local addRow - row offset of the quarter turn about the face
' @local addColumn - column offset of the quarter turn about the face
' @local stepRow - grid row step out through the entered edge
' @local stepColumn - grid column step out through the entered edge
' @local pEdge - pointer to the edge's record in the edge table

    repeat faceIdx from FACE_IDX_TOP to FACE_IDX_RIGHT
        repeat edge from EDGE_N to EDGE_W
            ' the neighbour is the face whose normal is this edge's direction, and the edge it
            ' meets is its edge whose direction is this face's normal
            nbrFace := faceWithNormal(faceEdgeDirection(faceIdx, edge))
            entry := EDGE_N
            repeat candidate from EDGE_N to EDGE_W
                if faceEdgeDirection(nbrFace, candidate) == frameNormal[faceIdx]
                    entry := candidate
                    quit
            turn := (entry + EDGE_OPPOSITE - edge) & QTURN_MASK
            addRow, addColumn := quarterTurnOffset(turn, faceSize)
            stepRow, stepColumn := edgeStep(entry)
            pEdge := @cubeEdges[edgeRecordIndex(layoutIdx, faceIdx, edge)]
            LONG[pEdge][EDGE_NEIGHBOUR] := nbrFace
            LONG[pEdge][EDGE_ENTRY] := entry
            LONG[pEdge][EDGE_TURN] := turn
            LONG[pEdge][EDGE_ADD_ROW] := addRow + (faceSize * stepRow)
            LONG[pEdge][EDGE_ADD_COL] := addColumn + (faceSize * stepColumn)

PRI faceEdgeDirection(faceIdx, edge) : edgeAxis
' Return the 3-D direction an edge of a face lies in, from the face's centre.
'
' @param faceIdx - the face (FACE_IDX_TOP .. FACE_IDX_RIGHT)
' @param edge - one of its edges (EDGE_N .. EDGE_W)
' @returns edgeAxis - the direction (axis code): up, right, down or left

    case edge
        EDGE_N:
            edgeAxis := frameUp[faceIdx]
        EDGE_E:
            edgeAxis := frameRight[faceIdx]
        EDGE_S:
            edgeAxis := frameUp[faceIdx] ^ AXIS_NEGATE_BIT
        other:
            edgeAxis := frameRight[faceIdx] ^ AXIS_NEGATE_BIT

PRI crossAxes(axisA, axisB) : crossAxis | indexA, indexB, signBit
' Return the cross product of two axis directions: the third axis, positive when the two are
' in cyclic order (X x Y = +Z, Y x Z = +X, Z x X = +Y), with each negated factor flipping it.
'
' @param axisA - the first direction (axis code)
' @param axisB - the second direction (axis code)
' @returns crossAxis - axisA x axisB (axis code), or AXIS_NONE when both lie on one axis

' Local Variables:
' @local indexA - the axis of axisA (X 0, Y 1, Z 2)
' @local indexB - the axis of axisB
' @local signBit - AXIS_NEGATE_BIT when the product is negative

    crossAxis := AXIS_NONE
    indexA := axisA >> AXIS_SIGN_BITS
    indexB := axisB >> AXIS_SIGN_BITS
    if indexA <> indexB
        signBit := (axisA ^ axisB) & AXIS_NEGATE_BIT
        if indexB <> (indexA + 1) // AXIS_COUNT
            signBit ^= AXIS_NEGATE_BIT                  ' not in cyclic order
        crossAxis := ((AXIS_INDEX_SUM - indexA - indexB) << AXIS_SIGN_BITS) | signBit

PRI quarterTurnOffset(turn, faceSize) : addRow, addColumn | lastPixel
' Return the offset that makes a quarter turn of face coordinates a turn about the face: with it,
' turnFaceCoords() carries the face's square onto itself.
'
' @param turn - clockwise quarter turns (QTURN_NONE .. QTURN_ANTICLOCKWISE)
' @param faceSize - pixel rows (and columns) of one face
' @returns addRow - row added after the turn
' @returns addColumn - column added after the turn

' Local Variables:
' @local lastPixel - the last row (and column) of a face

    lastPixel := faceSize - 1
    addRow := addColumn := 0
    case turn
        QTURN_CLOCKWISE:
            addColumn := lastPixel
        QTURN_HALF:
            addRow := lastPixel
            addColumn := lastPixel
        QTURN_ANTICLOCKWISE:
            addRow := lastPixel

PRI edgeStep(edge) : rowStep, colStep
' Return the step out of a face through one of its edges, in face coordinates.
'
' @param edge - the edge (EDGE_N .. EDGE_W)
' @returns rowStep - row step (rows grow downward)
' @returns colStep - column step (columns grow rightward)

    rowStep := colStep := STEP_NONE
    case edge
        EDGE_N:
            rowStep := STEP_BACK
        EDGE_E:
            colStep := STEP_FORWARD
        EDGE_S:
            rowStep := STEP_FORWARD
        EDGE_W:
            colStep := STEP_BACK

PRI cableWithNormal(normalAxis) : cablePos | candidate
' Return the cable position whose folded normal is a given direction.
'
' @param normalAxis - the direction (axis code)
' @returns cablePos - the cable position, or NO_POSITION when none folded that way

' Local Variables:
' @local candidate - cable position being compared

    cablePos := NO_POSITION
    repeat candidate from FIRST_CABLE_POSITION to CUBE_FACES - 1
        if rollNormal[candidate] == normalAxis
            cablePos := candidate
            quit

PRI faceWithNormal(normalAxis) : faceIdx | candidate
' Return the face whose outward normal is a given direction.
'
' @param normalAxis - the direction (axis code)
' @returns faceIdx - the face (FACE_IDX_TOP .. FACE_IDX_RIGHT), or NO_FACE_INDEX

' Local Variables:
' @local candidate - face being compared

    faceIdx := NO_FACE_INDEX
    repeat candidate from FACE_IDX_TOP to FACE_IDX_RIGHT
        if frameNormal[candidate] == normalAxis
            faceIdx := candidate
            quit

PRI turnInCell(cablePos, upAxis) : turn
' Return how a face's up points within its panel's cell of the flat picture, as clockwise
' quarter turns from the cell's up: the turn that carries face coordinates into panel
' coordinates.
'
' @param cablePos - cable position of the face's panel
' @param upAxis - the face's up (axis code)
' @returns turn - QTURN_NONE (up), QTURN_CLOCKWISE (right), QTURN_HALF (down) or QTURN_ANTICLOCKWISE (left)

    if upAxis == rollUp[cablePos]
        turn := QTURN_NONE
    elseif upAxis == rollRight[cablePos]
        turn := QTURN_CLOCKWISE
    elseif upAxis == (rollUp[cablePos] ^ AXIS_NEGATE_BIT)
        turn := QTURN_HALF
    else
        turn := QTURN_ANTICLOCKWISE

PRI edgeRecordIndex(layoutIdx, faceIdx, edge) : recordIdx
' Return the index in cubeEdges of the record for one edge of one face of one cube.
'
' @param layoutIdx - the chain index, already checked against the adapters that exist
' @param faceIdx - the face (FACE_IDX_TOP .. FACE_IDX_RIGHT)
' @param edge - the edge (EDGE_N .. EDGE_W)
' @returns recordIdx - LONG index of the record's first entry

    recordIdx := ((((layoutIdx * CUBE_FACES) + faceIdx) * FACE_EDGES) + edge) * EDGE_RECORD_LONGS

PRI faceRecordIndex(layoutIdx, faceIdx) : recordIdx
' Return the index in cubeFaces of the record for one face of one cube.
'
' @param layoutIdx - the chain index, already checked against the adapters that exist
' @param faceIdx - the face (FACE_IDX_TOP .. FACE_IDX_RIGHT)
' @returns recordIdx - LONG index of the record's first entry

    recordIdx := ((layoutIdx * CUBE_FACES) + faceIdx) * FACE_RECORD_LONGS

PRI faceNameText(faceIdx) : pName
' Return the name of a face, as the printed cube lines show it.
'
' @param faceIdx - the face (FACE_IDX_TOP .. FACE_IDX_RIGHT)
' @returns pName - pointer to the zero-terminated name

    case faceIdx
        FACE_IDX_TOP:
            pName := @"TOP"
        FACE_IDX_BOTTOM:
            pName := @"BOTTOM"
        FACE_IDX_FRONT:
            pName := @"FRONT"
        FACE_IDX_BACK:
            pName := @"BACK"
        FACE_IDX_LEFT:
            pName := @"LEFT"
        FACE_IDX_RIGHT:
            pName := @"RIGHT"
        other:
            pName := @"NO_FACE"

